# Lazy source dependency for explicit Torch 2.15 Cuspy variants only.
# Same LLVM revision/archive as the canonical rootfs libclang, not PyPI libclang18.
_cuspy_http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
_cuspy_http_archive(
    name = "llvm23_cuspy_bindings",
    urls = [
        "https://storage.googleapis.com/mirror.tensorflow.org/github.com/llvm/llvm-project/archive/35901313800ea6e6cbeb9226e51c7c4b29bfc40e.tar.gz",
        "https://github.com/llvm/llvm-project/archive/35901313800ea6e6cbeb9226e51c7c4b29bfc40e.tar.gz",
    ],
    sha256 = "c3f06997045e0f9aa43628616df3217f229aa43d478bd78bd445e2448637d4ef",
    strip_prefix = "llvm-project-35901313800ea6e6cbeb9226e51c7c4b29bfc40e/clang/bindings/python",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
exports_files(["clang/__init__.py", "clang/cindex.py"])
filegroup(name = "package", srcs = glob(["clang/**"], allow_empty = False))
""",
)

# Site producer materializes acquired SDK/source/runtime artifacts under this
# canonical Insula projection. No host-private paths or ambient tool fallback.
_cuspy_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")
_cuspy_local_repository(
    name = "b200_cuspy_site",
    path = "/vaso/toolchains/cu133/site",
)
