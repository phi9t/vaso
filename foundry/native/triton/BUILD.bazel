load(":triton_action.bzl", "triton_action_prefix", "triton_token_flag")
load("//native/common:native_output_path_query.bzl", "native_action_prefix_path")
load("//native/common:release_wheel_action.bzl", "release_wheel_action")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "action_driver.py",
    "action_prefix_test.py",
    "action_smoke_test.py",
    "plan.py",
    "plan_test.py",
    "patches/0001-llvm-35901313.patch",
    "patches/SHA256SUMS",
    "synthetic_prefix_path.txt",
    "synthetic_source_anchor.txt",
    "triton_action.bzl",
    "upstream_pins.json",
])

py_binary(
    name = "action_driver",
    srcs = ["action_driver.py"],
)

triton_token_flag(
    name = "token",
    build_setting_default = "",
)

native_action_prefix_path(
    name = "triton_action_prefix_path",
    output_basename = "triton_action",
    profile = "torch",
    tags = ["manual"],
)

triton_action_prefix(
    name = "triton_action",
    cmake_prefix_file = "@cmake_native//:prefix_path.txt",
    cuda_prefix_file = "@cuda_native//:prefix_path.txt",
    execute = True,
    inputs = {
        ":upstream_pins.json": "native/triton/upstream_pins.json",
    },
    llvm_prefix_file = "@rootfs_llvm_23_native//:prefix_path.txt",
    ninja_prefix_file = "@ninja_native//:prefix_path.txt",
    nlohmann_json_prefix_file = "@nlohmann_json_native//:prefix_path.txt",
    patches = {
        ":patches/0001-llvm-35901313.patch": "native/triton/patches/0001-llvm-35901313.patch",
    },
    plan = select({
        "//plans:release_line_cu129": "//plans:torch/cu129/triton.plan.json",
        "//plans:release_line_cu130": "//plans:torch/cu130/triton.plan.json",
    }),
    py_filelock_prefix_file = "@py_filelock_native//:prefix_path.txt",
    py_lit_prefix_file = "@py_lit_native//:prefix_path.txt",
    py_pip_prefix_file = "@py_pip_native//:prefix_path.txt",
    py_pybind11_prefix_file = "@py_pybind11_native//:prefix_path.txt",
    py_setuptools_prefix_file = "@py_setuptools_native//:prefix_path.txt",
    py_wheel_prefix_file = "@py_wheel_native//:prefix_path.txt",
    python_prefix_file = "@python_313_native//:prefix_path.txt",
    python_venv_prefix_file = "@python_venv_native//:prefix_path.txt",
    rootfs_identity = select({
        "//plans:release_line_cu129": "//plans:torch/cu129/rootfs.identity.json",
        "//plans:release_line_cu130": "//plans:torch/cu130/rootfs.identity.json",
    }),
    source_archive = "@triton_v2_14_0_source_archive//file",
    zlib_ng_prefix_file = "@zlib_ng_native//:prefix_path.txt",
)

release_wheel_action(
    name = "triton_release_wheel",
    input = ":triton_action",
    profile = "torch",
    tags = ["manual"],
)

py_test(
    name = "action_prefix_test",
    srcs = ["action_prefix_test.py"],
    args = [
        "--repo-root",
        "$(rootpath //:MODULE.bazel)",
    ],
    data = [
        "//:MODULE.bazel",
        "//native/common:BUILD.bazel",
        "//native/common:plan_executor",
        "//native/common:toolchain_helper_files",
        "//native/common:plan_executor.py",
        "//native/common:plan_schema.py",
        "//plans:committed_plan_files",
        "//tools:nested_bazel_fixture.py",
        ":patches/0001-llvm-35901313.patch",
        ":triton_action.bzl",
        ":upstream_pins.json",
    ],
    env_inherit = [
        "BAZEL",
        "BAZEL_BIN",
        "BAZEL_REAL",
        "VASO_BAZEL_OB",
        "VASO_ESTATE_ROOT",
    ],
    main = "action_prefix_test.py",
    precompile = "disabled",
    size = "small",
    timeout = "short",
    tags = [
        "external",
        "no-cache",
    ],
)

py_test(
    name = "action_driver_test",
    srcs = [
        "action_driver.py",
        "action_driver_test.py",
    ],
    data = [
        "//plans:keys.json",
        "//plans:torch/cu130/triton.plan.json",
    ],
    main = "action_driver_test.py",
)

py_test(
    name = "plan_test",
    srcs = [
        "plan.py",
        "plan_test.py",
    ],
    data = [
        "//:MODULE.bazel",
        "//:dev.MODULE.bazel",
        "//:native_overrides.json",
        ":BUILD.bazel",
        ":action_driver.py",
        ":patches/0001-llvm-35901313.patch",
        ":triton_action.bzl",
        ":upstream_pins.json",
    ],
    deps = ["//native/common:native_action_toolchain_py"],
    main = "plan_test.py",
)
