module(name = "vaso_graph", version = "0.1.0")

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_java", version = "9.3.0", dev_dependency = True)

include("//:dev.MODULE.bazel")

# FC-M2a registers rootfs-owned toolchain identities for analysis-only
# resolution. The private default constraints below keep the default platform on
# Bazel's existing local_config_cc until FC-M2b opts native consumers in.
register_toolchains("//toolchains:gcc_13_3_toolchain")
register_toolchains("//toolchains:clang_23_toolchain")
register_toolchains("//toolchains:python_313_toolchain", dev_dependency = True)
register_toolchains("//toolchains:python_313_info_toolchain", dev_dependency = True)
register_toolchains("//toolchains:cuda_rootfs_toolchain", dev_dependency = True)

