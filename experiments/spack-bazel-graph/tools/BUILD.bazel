    "toolchain_setting_allowlist.txt",
    "triumvirate_acceptance.py",
    "tracker_lint.py",
    "tracker_lint_allowlist.txt",
])

filegroup(
    name = "shell_scripts",
    srcs = glob(["*.sh"]),
)

sh_binary(
    name = "spack_lock",
    srcs = ["spack_lock.sh"],
    args = [
        "$(rootpath @spack_dist//:spack)",
        "$(rootpath :spack_to_bazel.py)",
        "$(rootpath :build_graph.py)",
    ],
    data = [
        ":build_graph.py",
        ":lean_font_resources.sh",
        ":spack_to_bazel.py",
        "@spack_dist//:spack",
    ],
)

