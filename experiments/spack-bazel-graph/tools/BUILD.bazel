# Marks the experiment root as a Bazel package so tools/*.bzl is loadable.

package(default_visibility = ["//visibility:public"])

# The ABI-parity gate script, consumed by //synthetic:zlib_ng_abi_parity.
exports_files([
    "abi_parity.py",
    "abi_invariants.py",
    "build_graph.py",
    "compiler_pathway_guard.py",
    "compiler_pathways.json",
    "compiler_provenance.py",
    "io_hygiene_allowlist.txt",
    "io_hygiene_guard.py",
    "insula_test_routing.py",
    "jaxlib_deps_import_check.py",
    "live_guard_no_cache.py",
    "migration_ledger_check.py",
    "native_build_mechanism_guard.py",
    "native_dep_wiring_check.py",
    "native_lock_versions.py",
    "native_source_versions.py",
    "np17_acceptance_gate_guard.py",
    "one_llvm_graph_guard.py",
    "py_torch_networkx_prune_check.py",
    "python_freeze_proof.py",
    "pytorch_odr_policy_check.py",
    "profile_guard.py",
    "pytorch_python_protobuf_compat.py",
    "rootfs_spack_externals.py",
    "runtime_compiler_assertions.py",
    "single_copy_cuda_graph_guard.py",
