# The consumer never names a Spack prefix or a BUILD edge by hand: it depends on
# @spack_zlib_ng//:lib, a repo generated by the spack_graph module extension
# from the Spack concrete DAG. Edges + structure both come from Spack.
#
# When zlib-ng is flipped to build:native (via native_overrides.json), the SAME
# @spack_zlib_ng//:lib target is an alias to @zlib_ng_native//:lib — so this
# consumer is unchanged across the migration.
cc_test(
    name = "use_zlib",
    srcs = ["use_zlib.c"],
    deps = ["@spack_zlib_ng//:lib"],
)

