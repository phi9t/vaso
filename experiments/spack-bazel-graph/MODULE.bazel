# Pinned, content-addressed tla2tools.jar for the hermetic TLC model checks of
# the build-migration formal model (formal/build_migration/). Bazel fetches it
# by sha256 and runs tlc2.TLC with its own JDK (remotejdk_17 via --config=formal
# in .bazelrc), so no host `java` or TLA_TOOLS_JAR is required. Mirrors the
# ferric_continuum formal setup.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "tla2tools",
    sha256 = "32d64fbbc464559fc7192341b27b885fa4eb6b92d1648d2b49fb9cdcb7aacf81",
    urls = [
        "https://github.com/tlaplus/tlaplus/releases/download/v1.8.0/tla2tools.jar",
    ],
)

# Pinned Lean distribution for the ABI/prefix proof in formal/lean. Bazel
# fetches/extracts this archive from inside the insula, then the test runs the
# bundled lake/lean binaries without host elan or host lake.
http_archive(
    name = "lean_dist",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

exports_files([
    "bin/lake",
    "bin/lean",
])

filegroup(
    name = "dist",
    srcs = glob(["**"]),
)
""",
    sha256 = "caaa98356098c85dc0fcbbd28e1ec66f39eb6551829972b752ff20e1286b646b",
    strip_prefix = "lean-4.34.0-linux",
    urls = [
        "https://github.com/leanprover/lean4/releases/download/v4.34.0/lean-4.34.0-linux.tar.zst",
    ],
)

