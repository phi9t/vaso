"""Native (Bazel-owned) py-protobuf prefix.

The native PyTorch frontier pairs upstream PyTorch's C++ protobuf v3.21.12 with
the matching PyPI protobuf 4.21.12 package. This rule builds that exact Python
provider against native protobuf@21.12 and the Python 3.13 compatibility
provider from Bazel-owned prefixes inside the hermetic insula. Do not
substitute the reference py-torch recipe's older py-protobuf@3.13 edge or a
newer Python protobuf family.

The attempted C++ implementation path runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> \
        --config-settings=--global-option=--cpp_implementation .

This package builds the google.protobuf.pyext CPython extension against the
native protobuf prefix. The Python and C++ protobuf providers are kept in one
concrete version family to avoid mixed protobuf ABIs downstream.

protobuf 4.21.12 predates Python's opaque PyFrameObject API. The checked-in
patch only swaps the descriptor.cc frame introspection helper to public Python
3.11+ accessors; it does not change the protobuf package or protoc versions.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_protobuf_native. Native Bazel build of py-protobuf, intended
# to match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-protobuf exposes Python modules and a CPython extension module. The
# migrated-provider contract still presents @spack_py_protobuf//:lib as a valid
# target for unmigrated consumers; runtime contents are carried as prefix data.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
PATCH_FILE="$3"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-protobuf native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native python prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python prefix" >&2
  exit 2
fi
if [[ "$PYTHON_ABI" != "3.13" ]]; then
  echo "py-protobuf@4.21.12 must build on the Python 3.13 compatibility island; got $PYTHON_ABI" >&2
  exit 2
fi
if [[ ! -d "$PYTHON_PREFIX/include/python${PYTHON_ABI}" || ! -d "$PYTHON_PREFIX/lib" ]]; then
  echo "PYTHON_PREFIX must provide include/python${PYTHON_ABI} and lib" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi
if [[ -z "${PROTOBUF_PREFIX:-}" || ! -d "${PROTOBUF_PREFIX:-}/include/google/protobuf" ]]; then
  echo "PROTOBUF_PREFIX must name the hermetic protobuf dependency prefix" >&2
  exit 2
fi
if [[ ! -x "$PROTOBUF_PREFIX/bin/protoc" ]]; then
  echo "PROTOBUF_PREFIX must provide bin/protoc" >&2
  exit 2
fi
if [[ ! -f "$PATCH_FILE" ]]; then
  echo "py-protobuf Python 3.13 compatibility patch is missing: $PATCH_FILE" >&2
  exit 2
fi
protoc_version="$("$PROTOBUF_PREFIX/bin/protoc" --version)"
if [[ "$protoc_version" != "libprotoc 3.21.12" ]]; then
  echo "PROTOBUF_PREFIX must provide libprotoc 3.21.12, got: $protoc_version" >&2
  exit 2
fi

cd "$SRC"
patch -p1 < "$PATCH_FILE"

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$PROTOBUF_PREFIX/bin:$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:$PYTHON_PREFIX/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="$PYTHON_PREFIX/lib:$PROTOBUF_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CC=/usr/bin/gcc
export CXX=/usr/bin/g++
export PROTOC="$PROTOBUF_PREFIX/bin/protoc"
export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=cpp
export CFLAGS="-I$PYTHON_VENV_PREFIX/include -I$PYTHON_PREFIX/include/python${PYTHON_ABI} -I$PROTOBUF_PREFIX/include ${CFLAGS:-}"
export CXXFLAGS="-I$PYTHON_VENV_PREFIX/include -I$PYTHON_PREFIX/include/python${PYTHON_ABI} -I$PROTOBUF_PREFIX/include ${CXXFLAGS:-}"
export LDFLAGS="-L$PYTHON_PREFIX/lib -Wl,-rpath,$PYTHON_PREFIX/lib -L$PROTOBUF_PREFIX/lib -Wl,-rpath,$PROTOBUF_PREFIX/lib ${LDFLAGS:-}"

"$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -m pip \\
  -vvv \\
  --no-input \\
  --no-cache-dir \\
  --disable-pip-version-check \\
  install \\
  --no-deps \\
  --ignore-installed \\
  --no-build-isolation \\
  --no-warn-script-location \\
  --no-index \\
  --prefix="$PREFIX" \\
  --config-settings=--global-option=--cpp_implementation \\
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
python_ext_suffix="$("$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX") or "")')"
if [[ -z "$python_ext_suffix" ]]; then
  echo "native python did not report EXT_SUFFIX" >&2
  exit 2
fi
test -f "$site_packages/google/protobuf/__init__.py"
test -f "$site_packages/google/protobuf/descriptor_pb2.py"
test -f "$site_packages/google/protobuf/json_format.py"
test -f "$site_packages/google/protobuf/pyext/_message${python_ext_suffix}"
test -f "$site_packages/google/protobuf/struct_pb2.py"
test -f "$site_packages/google/protobuf/internal/_api_implementation${python_ext_suffix}"
dist_info="$site_packages/${DIST_INFO:-protobuf-4.21.12.dist-info}"
test -f "$dist_info/INSTALLER"
test -f "$dist_info/METADATA"
test -f "$dist_info/REQUESTED"
test -f "$dist_info/WHEEL"
test -f "$dist_info/top_level.txt"

export PYTHONPATH="$site_packages:$PYTHONPATH"
cd "$PREFIX"
"$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import importlib.metadata
from google.protobuf import struct_pb2
from google.protobuf.internal import api_implementation

msg = struct_pb2.Struct()
msg.update({"answer": 7})
assert importlib.metadata.version("protobuf") == "4.21.12"
assert api_implementation.Type() == "cpp", api_implementation.Type()
assert int(msg["answer"]) == 7
PY
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-protobuf native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_protobuf_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-protobuf native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    protobuf_prefix = _read_prefix(repository_ctx, attr.protobuf_prefix_file, "protobuf")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix, str(repository_ctx.path(attr.patch_file))],
        timeout = 1800,
        quiet = False,
        environment = {
            "PROTOBUF_PREFIX": protobuf_prefix,
            "PYTHON_ABI": python_abi,
            "PYTHON_PREFIX": python_prefix,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "VASO_IN_INSULA": "1",
            "DIST_INFO": attr.dist_info,
        },
    )
    if res.return_code != 0:
        fail("py-protobuf native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_protobuf_native = repository_rule(
    implementation = _py_protobuf_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "dist_info": attr.string(mandatory = True),
        "patch_file": attr.label(mandatory = True, allow_single_file = True),
        "protobuf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-protobuf from its PyPI source archive into a Spack-prefix-identical tree.",
)
