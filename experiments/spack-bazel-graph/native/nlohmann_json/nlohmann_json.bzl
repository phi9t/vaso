"""Native (Bazel-owned) nlohmann-json header/CMake prefix."""

_BUILD_TEMPLATE = """\
# GENERATED by nlohmann_json_native. Native Bazel build of nlohmann-json.
# Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: cmake
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "nlohmann-json native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-built native CMake prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja-build" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built native Ninja prefix" >&2
  exit 2
fi

CMAKE="$CMAKE_PREFIX/bin/cmake"
NINJA="$NINJA_PREFIX/bin/ninja-build"
: "${TMPDIR:?TMPDIR must be set}"
BUILD="$(mktemp -d -p "$TMPDIR")"
cd "$BUILD"

export PATH="${CMAKE_PREFIX}/bin:${NINJA_PREFIX}/bin:${PATH}"
export CMAKE_PREFIX_PATH="${CMAKE_PREFIX};${NINJA_PREFIX}"

"$CMAKE" -G Ninja "$SRC" \
  -DCMAKE_MAKE_PROGRAM:FILEPATH="$NINJA" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  "-DCMAKE_PREFIX_PATH:STRING=${CMAKE_PREFIX};${NINJA_PREFIX}" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF \
  -DCMAKE_POLICY_DEFAULT_CMP0090:STRING=NEW \
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF \
  -DJSON_BuildTests:BOOL=OFF \
  -DJSON_MultipleHeaders:BOOL=ON
"$NINJA" -v
"$NINJA" install

test -f "$PREFIX/include/nlohmann/json.hpp"
if [[ ! -f "$PREFIX/lib/cmake/nlohmann_json/nlohmann_jsonConfig.cmake" && ! -f "$PREFIX/share/cmake/nlohmann_json/nlohmann_jsonConfig.cmake" ]]; then
  echo "nlohmann-json native build did not install nlohmann_jsonConfig.cmake" >&2
  exit 2
fi
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("nlohmann-json native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _nlohmann_json_native_impl(repository_ctx):
    attr = repository_ctx.attr
    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("nlohmann-json native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")
    ninja_prefix = _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja")
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "NINJA_PREFIX": ninja_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("nlohmann-json native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


nlohmann_json_native = repository_rule(
    implementation = _nlohmann_json_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build nlohmann-json@3.11.3 into a Spack-compatible header/CMake prefix.",
)
