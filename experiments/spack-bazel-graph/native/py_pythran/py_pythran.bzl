"""Native (Bazel-owned) py-pythran prefix.

The hermetic Spack v1.2.2 py-pythran@0.18.1 recipe is a PythonPackage that
installs from source with setuptools:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

Spack supplies pip, setuptools, wheel, NumPy, Gast, Beniget and Ply through
installed Python prefixes. This rule reproduces that dependency channel with
Bazel-native prefix markers and must run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_interpreter_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_pythran_native. Native Bazel build of py-pythran, intended to
# match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-pythran is a Python package prefix carrying scripts and C++ headers. It
# has no C link surface itself, but @spack_py_pythran//:lib must remain a valid
# provider target after migration for unmigrated Python package consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-pythran native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
for var in PY_BENIGET_PREFIX PY_GAST_PREFIX PY_NUMPY_PREFIX PY_PIP_PREFIX PY_PLY_PREFIX PY_SETUPTOOLS_PREFIX PY_WHEEL_PREFIX PYTHON_VENV_PREFIX; do
  if [[ -z "${!var:-}" || ! -d "${!var}" ]]; then
    echo "$var must name a Bazel/hermetic dependency prefix" >&2
    exit 2
  fi
done
if [[ -z "${PYTHON_ABI:-}" || ! -x "$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python-venv prefix" >&2
  exit 2
fi
if [[ ! -d "$PY_BENIGET_PREFIX/lib/python${PYTHON_ABI}/site-packages/beniget" ]]; then
  echo "missing py-beniget for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_GAST_PREFIX/lib/python${PYTHON_ABI}/site-packages/gast" ]]; then
  echo "missing py-gast for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_NUMPY_PREFIX/lib/python${PYTHON_ABI}/site-packages/numpy" ]]; then
  echo "missing py-numpy for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "missing py-pip for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_PLY_PREFIX/lib/python${PYTHON_ABI}/site-packages/ply" ]]; then
  echo "missing py-ply for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "missing py-setuptools for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "missing py-wheel for Python ${PYTHON_ABI}" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONNOUSERSITE=1
export PYTHONPATH="$PY_BENIGET_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_GAST_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_NUMPY_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PLY_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:/usr/bin:/bin"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -x "$PREFIX/bin/pythran"
test -x "$PREFIX/bin/pythran-config"
test -f "$site_packages/pythran/__init__.py"
test -f "$site_packages/pythran/config.py"
test -f "$site_packages/pythran/spec.py"
test -f "$site_packages/pythran/toolchain.py"
test -f "$site_packages/pythran/pythonic/core.hpp"
test -f "$site_packages/pythran/xsimd/xsimd.hpp"
test -f "$site_packages/pythran-0.18.1.dist-info/METADATA"
test -f "$site_packages/pythran-0.18.1.dist-info/WHEEL"
test -f "$site_packages/pythran-0.18.1.dist-info/entry_points.txt"

export PYTHONPATH="$site_packages:$PYTHONPATH"
SMOKE_CWD="$PREFIX/.smoke-cwd"
mkdir -p "$SMOKE_CWD"
cd "$SMOKE_CWD"
out="$("$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import importlib.metadata

import pythran

spec = pythran.spec_parser("#pythran export foo(int)")
print(
    "py-pythran:%s:%s:%s:%s"
    % (
        importlib.metadata.version("pythran"),
        pythran.__version__,
        "foo" in spec.functions,
        pythran.get_include().endswith("/pythran"),
    )
)
PY
)"
if [[ "$out" != "py-pythran:0.18.1:0.18.1:True:True" ]]; then
  echo "unexpected pythran smoke output: $out" >&2
  exit 1
fi
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-pythran native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_pythran_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-pythran native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    python_abi = python_abi_from_interpreter_prefix(repository_ctx, python_venv_prefix, "python-venv")
    prefixes = {
        "PY_BENIGET_PREFIX": _read_prefix(repository_ctx, attr.py_beniget_prefix_file, "py-beniget"),
        "PY_GAST_PREFIX": _read_prefix(repository_ctx, attr.py_gast_prefix_file, "py-gast"),
        "PY_NUMPY_PREFIX": _read_prefix(repository_ctx, attr.py_numpy_prefix_file, "py-numpy"),
        "PY_PIP_PREFIX": _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip"),
        "PY_PLY_PREFIX": _read_prefix(repository_ctx, attr.py_ply_prefix_file, "py-ply"),
        "PY_SETUPTOOLS_PREFIX": _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools"),
        "PY_WHEEL_PREFIX": _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel"),
        "PYTHON_VENV_PREFIX": python_venv_prefix,
    }
    prefix = str(repository_ctx.path("prefix"))

    env = dict(prefixes)
    env["PYTHON_ABI"] = python_abi
    env["VASO_IN_INSULA"] = "1"
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 900,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("py-pythran native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_pythran_native = repository_rule(
    implementation = _py_pythran_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_beniget_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_gast_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_numpy_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_ply_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-pythran@0.18.1 from its PyPI source archive into a Spack-prefix-identical tree.",
)
