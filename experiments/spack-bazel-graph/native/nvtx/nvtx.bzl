"""Native (Bazel-owned) nvtx prefix.

The hermetic Spack v1.2.2 nvtx@3.3.0 recipe is a generic package that copies
the C header/CMake package surface and then installs the Python package from
the source tree's python/ subdirectory with Spack's PythonPipBuilder arguments.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by nvtx_native. Native Bazel build of nvtx, intended to match the
# Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob([
        "prefix/include/**/*.h",
        "prefix/include/**/*.hpp",
    ]),
    includes = [
        "prefix/include",
        "prefix/include/nvtx3",
    ],
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "nvtx native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native python prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python prefix" >&2
  exit 2
fi
if [[ ! -d "$PYTHON_PREFIX/include/python${PYTHON_ABI}" || ! -d "$PYTHON_PREFIX/lib" ]]; then
  echo "PYTHON_PREFIX must provide include/python${PYTHON_ABI} and lib" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ -z "${PY_CYTHON_PREFIX:-}" || ! -d "${PY_CYTHON_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/Cython" ]]; then
  echo "PY_CYTHON_PREFIX must name the Bazel-built native py-cython prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi
python_ext_suffix="$("$PYTHON_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import importlib.machinery

print(importlib.machinery.EXTENSION_SUFFIXES[0])
PY
)"

rm -rf "$PREFIX"
mkdir -p "$PREFIX"

cp -a "$SRC/c/include" "$PREFIX/include"
cp "$SRC/c/CMakeLists.txt" "$PREFIX/CMakeLists.txt"
cp "$SRC/c/nvtxImportedTargets.cmake" "$PREFIX/nvtxImportedTargets.cmake"
cp "$SRC/LICENSE.txt" "$PREFIX/LICENSE.txt"
cat > "$PREFIX/nvtx-config.cmake" <<'EOF'
include("${CMAKE_CURRENT_LIST_DIR}/nvtxImportedTargets.cmake")
set(${CMAKE_FIND_PACKAGE_NAME}_CONFIG "${CMAKE_CURRENT_LIST_FILE}")
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(${CMAKE_FIND_PACKAGE_NAME} CONFIG_MODE)
EOF

"$PYTHON_VENV_PREFIX/bin/python3" - <<'PY' "$SRC/python/setup.py" "$PREFIX/include"
from pathlib import Path
import sys

setup = Path(sys.argv[1])
include_dir = sys.argv[2]
text = setup.read_text()
needle = "include_dirs=include_dirs"
replacement = "include_dirs=['{}']".format(include_dir)
if needle not in text:
    raise SystemExit("setup.py include_dirs hook not found")
setup.write_text(text.replace(needle, replacement))
PY

export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_CYTHON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export LD_LIBRARY_PATH="$PYTHON_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CC=/usr/bin/gcc
export CXX=/usr/bin/g++
export CFLAGS="-I$PYTHON_VENV_PREFIX/include -I$PYTHON_PREFIX/include/python${PYTHON_ABI} -I$PREFIX/include ${CFLAGS:-}"
export LDFLAGS="-L$PYTHON_PREFIX/lib -Wl,-rpath,$PYTHON_PREFIX/lib ${LDFLAGS:-}"

cd "$SRC/python"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \\
  -vvv \\
  --no-input \\
  --no-cache-dir \\
  --disable-pip-version-check \\
  install \\
  --no-deps \\
  --ignore-installed \\
  --no-build-isolation \\
  --no-warn-script-location \\
  --no-index \\
  --prefix="$PREFIX" \\
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -f "$PREFIX/CMakeLists.txt"
test -f "$PREFIX/LICENSE.txt"
test -f "$PREFIX/nvtx-config.cmake"
test -f "$PREFIX/nvtxImportedTargets.cmake"
test -f "$PREFIX/include/nvtx3/nvtx3.hpp"
test -f "$PREFIX/include/nvtx3/nvToolsExt.h"
test -f "$site_packages/nvtx/__init__.py"
test -f "$site_packages/nvtx/nvtx.py"
test -f "$site_packages/nvtx/_lib/lib${python_ext_suffix}"
test -f "$site_packages/nvtx/_lib/profiler${python_ext_suffix}"
test -f "$site_packages/nvtx-0.2.14a1.dist-info/METADATA"
test -f "$site_packages/nvtx-0.2.14a1.dist-info/licenses/LICENSE.txt"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("nvtx native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _nvtx_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("nvtx native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    py_cython_prefix = _read_prefix(repository_ctx, attr.py_cython_prefix_file, "py-cython")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 1200,
        quiet = False,
        environment = {
            "PYTHON_PREFIX": python_prefix,
            "PYTHON_ABI": python_abi,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_CYTHON_PREFIX": py_cython_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("nvtx native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


nvtx_native = repository_rule(
    implementation = _nvtx_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_cython_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install nvtx@3.3.0 from the upstream release archive into a Spack-prefix-identical tree.",
)
