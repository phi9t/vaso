"""Native (Bazel-owned) py-python-dateutil prefix.

The hermetic Spack v1.2.2 py-python-dateutil@2.9.0.post0 recipe is a
PythonPackage that runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

Spack supplies pip, setuptools, setuptools-scm, wheel, and six through already
installed Python prefixes on PYTHONPATH. This rule reproduces that dependency
channel with Bazel-native prefix markers and must run inside the sealed insula.
"""

_BUILD_TEMPLATE = """\
# GENERATED by py_python_dateutil_native. Native Bazel build of
# py-python-dateutil, intended to match the Spack source-installed prefix. Do
# not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-python-dateutil is a pure Python package prefix. It has no C link surface,
# but @spack_py_python_dateutil//:lib must remain a valid provider target after
# migration for unmigrated Python package consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-python-dateutil native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python3.14/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python3.14/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_SCM_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_SCM_PREFIX:-}/lib/python3.14/site-packages/setuptools_scm" ]]; then
  echo "PY_SETUPTOOLS_SCM_PREFIX must name the Bazel-built native py-setuptools-scm prefix" >&2
  exit 2
fi
if [[ -z "${PY_SIX_PREFIX:-}" || ! -f "${PY_SIX_PREFIX:-}/lib/python3.14/site-packages/six.py" ]]; then
  echo "PY_SIX_PREFIX must name the Bazel-built native py-six prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python3.14/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python3.14/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python3.14/site-packages:$PY_SETUPTOOLS_SCM_PREFIX/lib/python3.14/site-packages:$PY_SIX_PREFIX/lib/python3.14/site-packages:$PY_WHEEL_PREFIX/lib/python3.14/site-packages:$PYTHON_VENV_PREFIX/lib/python3.14/site-packages"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python3.14/site-packages"
test -f "$site_packages/dateutil/__init__.py"
test -f "$site_packages/dateutil/_version.py"
test -f "$site_packages/dateutil/parser/isoparser.py"
test -f "$site_packages/dateutil/relativedelta.py"
test -f "$site_packages/dateutil/tz/tz.py"
test -f "$site_packages/dateutil/zoneinfo/dateutil-zoneinfo.tar.gz"
test -f "$site_packages/python_dateutil-2.9.0.post0.dist-info/INSTALLER"
test -f "$site_packages/python_dateutil-2.9.0.post0.dist-info/METADATA"
test -f "$site_packages/python_dateutil-2.9.0.post0.dist-info/REQUESTED"
test -f "$site_packages/python_dateutil-2.9.0.post0.dist-info/WHEEL"
test -f "$site_packages/python_dateutil-2.9.0.post0.dist-info/licenses/LICENSE"
test -f "$site_packages/python_dateutil-2.9.0.post0.dist-info/top_level.txt"
test -f "$site_packages/python_dateutil-2.9.0.post0.dist-info/zip-safe"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-python-dateutil native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_python_dateutil_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-python-dateutil native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_setuptools_scm_prefix = _read_prefix(repository_ctx, attr.py_setuptools_scm_prefix_file, "py-setuptools-scm")
    py_six_prefix = _read_prefix(repository_ctx, attr.py_six_prefix_file, "py-six")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_SETUPTOOLS_SCM_PREFIX": py_setuptools_scm_prefix,
            "PY_SIX_PREFIX": py_six_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-python-dateutil native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_python_dateutil_native = repository_rule(
    implementation = _py_python_dateutil_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_scm_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_six_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-python-dateutil@2.9.0.post0 from its PyPI source archive into a Spack-prefix-identical tree.",
)
