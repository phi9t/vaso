"""Native boundary for the CUDA SDK supplied by the hermetic insula rootfs.

Spack's `cuda` package is a GenericPackage around NVIDIA's binary toolkit
runfile. There is no source-library build to reproduce. The native provider is
therefore an SDK/rootfs boundary: it validates the exact CUDA version, proves it
is running inside the Bazel insula, checks the rootfs bundle provenance, and
requires the same installer build-tool prefixes that Spack declares
(`coreutils`, `gzip`, `libxml2`) to come from Bazel-native prefix files.

This rule must not be used to silently substitute an arbitrary host CUDA. The
expected CUDA and NVCC versions come from the selected rootfs-bundle manifest.
"""

_BUILD_TEMPLATE = """\
# GENERATED by cuda_native. Native boundary for the CUDA SDK in the hermetic
# insula rootfs. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = [
        "-L{lib_dir}",
        "-Wl,-rpath,{lib_dir}",
        "-lcudart",
    ],
)

exports_files([
    "prefix_path.txt",
    "sdk_boundary.json",
])
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
PREFIX="$1"

# sdk-boundary
if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "cuda native boundary must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${VASO_ROOTFS_BUNDLE_MANIFEST:-}" || ! -f "$VASO_ROOTFS_BUNDLE_MANIFEST" ]]; then
  echo "VASO_ROOTFS_BUNDLE_MANIFEST must point at the insula rootfs-bundle.json" >&2
  exit 2
fi
if [[ -z "${VASO_CUDA_HOME:-}" || ! -x "${VASO_CUDA_HOME}/bin/nvcc" ]]; then
  echo "VASO_CUDA_HOME must name the insula CUDA SDK and provide bin/nvcc" >&2
  exit 2
fi
mapfile -t expected_versions < <(python3 - "$VASO_ROOTFS_BUNDLE_MANIFEST" <<'PY'
import json
import re
import sys

manifest = sys.argv[1]
data = json.load(open(manifest, encoding="utf-8"))
components = data.get("verified_versions", {}).get("components", {})
toolkit = components.get("cuda_toolkit", {})
expected = toolkit.get("expected") or data.get("component_versions", {}).get("cuda_toolkit")
nvcc = toolkit.get("nvcc")
if not expected or not nvcc:
    raise SystemExit(
        "rootfs manifest must contain verified_versions.components.cuda_toolkit.expected and nvcc"
    )
image = data.get("base_image", "")
match = re.search(r"(?:cuda:)?([0-9]+\\.[0-9]+\\.[0-9]+)(?=-devel-ubuntu|\\b|@)", image)
if image and match and match.group(1) != expected:
    raise SystemExit(
        f"insula CUDA rootfs image mismatch: expected {expected}, got base_image {image!r}"
    )
print(expected)
print(nvcc)
PY
)
if [[ "${#expected_versions[@]}" -ne 2 ]]; then
  echo "failed to read CUDA expected versions from $VASO_ROOTFS_BUNDLE_MANIFEST" >&2
  exit 2
fi
EXPECTED_TOOLKIT_VERSION="${expected_versions[0]}"
EXPECTED_NVCC_VERSION="${expected_versions[1]}"
for var in COREUTILS_PREFIX GZIP_PREFIX LIBXML2_PREFIX; do
  val="${!var:-}"
  if [[ -z "$val" || ! -d "$val" ]]; then
    echo "$var must name a Bazel-native Spack-installer dependency prefix" >&2
    exit 2
  fi
done
if [[ ! -x "${COREUTILS_PREFIX}/bin/true" || ! -x "${COREUTILS_PREFIX}/bin/mkdir" ]]; then
  echo "COREUTILS_PREFIX must provide the installer coreutils tools" >&2
  exit 2
fi
if [[ ! -x "${GZIP_PREFIX}/bin/gzip" ]]; then
  echo "GZIP_PREFIX must provide bin/gzip" >&2
  exit 2
fi
if [[ ! -e "${LIBXML2_PREFIX}/lib/libxml2.so" && ! -e "${LIBXML2_PREFIX}/lib64/libxml2.so" ]]; then
  echo "LIBXML2_PREFIX must provide libxml2.so for the CUDA installer ABI" >&2
  exit 2
fi

nvcc_version="$("${VASO_CUDA_HOME}/bin/nvcc" --version | sed -n 's/.*release [^,]*, V\\([^[:space:]]*\\).*/\\1/p' | tail -1)"
if [[ "$nvcc_version" != "$EXPECTED_NVCC_VERSION" ]]; then
  echo "insula CUDA nvcc version mismatch: expected ${EXPECTED_NVCC_VERSION}, got ${nvcc_version:-unknown}" >&2
  exit 2
fi
python3 - "$VASO_ROOTFS_BUNDLE_MANIFEST" "$EXPECTED_TOOLKIT_VERSION" <<'PY'
import json
import re
import sys

manifest, expected = sys.argv[1:3]
data = json.load(open(manifest, encoding="utf-8"))
image = data.get("base_image", "")
match = re.search(r"(?:cuda:)?([0-9]+\\.[0-9]+\\.[0-9]+)(?=-devel-ubuntu|\\b|@)", image)
if image and (not match or match.group(1) != expected):
    raise SystemExit(f"insula CUDA rootfs image mismatch: expected {expected}, got {image!r}")
PY

mkdir -p "$PREFIX"
ln -s "${VASO_CUDA_HOME}/bin" "$PREFIX/bin"
ln -s "${VASO_CUDA_HOME}/include" "$PREFIX/include"
if [[ -d "${VASO_CUDA_HOME}/lib64" ]]; then
  ln -s "${VASO_CUDA_HOME}/lib64" "$PREFIX/lib64"
elif [[ -d "${VASO_CUDA_HOME}/lib" ]]; then
  ln -s "${VASO_CUDA_HOME}/lib" "$PREFIX/lib"
else
  echo "VASO_CUDA_HOME must expose lib64/ or lib/" >&2
  exit 2
fi
if [[ -d "${VASO_CUDA_HOME}/targets" ]]; then
  ln -s "${VASO_CUDA_HOME}/targets" "$PREFIX/targets"
fi
for optional in version.json extras nvvm; do
  if [[ -e "${VASO_CUDA_HOME}/${optional}" ]]; then
    ln -s "${VASO_CUDA_HOME}/${optional}" "$PREFIX/${optional}"
  fi
done

python3 - "$PREFIX/sdk_boundary.json" "$EXPECTED_TOOLKIT_VERSION" "$EXPECTED_NVCC_VERSION" "$nvcc_version" \
  "$VASO_CUDA_HOME" "$VASO_ROOTFS_BUNDLE_MANIFEST" \
  "$COREUTILS_PREFIX" "$GZIP_PREFIX" "$LIBXML2_PREFIX" <<'PY'
import json
import sys

out, expected_toolkit, expected_nvcc, actual_nvcc, cuda_home, manifest = sys.argv[1:7]
coreutils, gzip, libxml2 = sys.argv[7:10]
with open(manifest) as fh:
    rootfs = json.load(fh)
data = {
    "schema_version": 1,
    "mechanism": "sdk-boundary",
    "package": "cuda",
    "expected_cuda_version": expected_toolkit,
    "expected_nvcc_version": expected_nvcc,
    "actual_nvcc_version": actual_nvcc,
    "cuda_home": cuda_home,
    "rootfs_bundle": rootfs,
    "installer_build_deps": {
        "coreutils": coreutils,
        "gzip": gzip,
        "libxml2": libxml2,
    },
}
with open(out, "w") as fh:
    json.dump(data, fh, indent=2, sort_keys=True)
    fh.write("\\n")
PY
"""


def _read_prefix(repository_ctx, label):
    return repository_ctx.read(repository_ctx.path(label)).strip()


def _cuda_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("cuda native boundary must run inside the hermetic insula (VASO_IN_INSULA=1)")

    cuda_home = repository_ctx.os.environ.get("VASO_CUDA_HOME", "/usr/local/cuda")
    manifest = repository_ctx.os.environ.get(
        "VASO_ROOTFS_BUNDLE_MANIFEST",
        "/run/vaso/rootfs-bundle.json",
    )

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)
    prefix = str(repository_ctx.path("prefix"))
    env = {
        "COREUTILS_PREFIX": _read_prefix(repository_ctx, attr.coreutils_prefix_file),
        "GZIP_PREFIX": _read_prefix(repository_ctx, attr.gzip_prefix_file),
        "LIBXML2_PREFIX": _read_prefix(repository_ctx, attr.libxml2_prefix_file),
        "VASO_CUDA_HOME": cuda_home,
        "VASO_IN_INSULA": "1",
        "VASO_ROOTFS_BUNDLE_MANIFEST": manifest,
    }
    res = repository_ctx.execute(
        ["./build.sh", prefix],
        timeout = 120,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("cuda native boundary validation failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = prefix + "/lib64"
    if repository_ctx.path("prefix/lib").exists:
        lib_dir = prefix + "/lib"
    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.symlink("prefix/sdk_boundary.json", "sdk_boundary.json")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE.format(lib_dir = lib_dir))


cuda_native = repository_rule(
    implementation = _cuda_native_impl,
    attrs = {
        "coreutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gzip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libxml2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = [
        "VASO_CUDA_HOME",
        "VASO_IN_INSULA",
        "VASO_ROOTFS_BUNDLE_MANIFEST",
    ],
    doc = "Expose the hermetic insula CUDA SDK as an exact-version Spack-native boundary.",
)
