"""Native (Bazel-owned) py-numpy prefix.

Hermetic Spack v1.2.2 resolves the current FC-10 PyTorch frontier's NumPy
node as py-numpy@2.4.6 built by PythonPackage/pip against OpenBLAS. Spack
applies check_executables.patch and runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> \
        --config-settings=builddir=build \
        --config-settings=setup-args=-Dblas=openblas \
        --config-settings=setup-args=-Dlapack=openblas \
        --config-settings=setup-args=-Duse-ilp64=false .

This rule reproduces that build using explicit Bazel-native prefix markers for
the Python packaging island, meson-python backend, Cython, pkgconf, and
OpenBLAS. It must run inside the sealed CUDA insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_numpy_native. Native Bazel build of py-numpy, intended to
# match the concrete Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-numpy exposes Python modules, scripts, and CPython extension modules. The
# runtime surface is carried as data from the generated prefix so
# @spack_py_numpy//:lib remains a valid provider target after migration.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-numpy native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
for var in MESON_PREFIX NINJA_PREFIX OPENBLAS_PREFIX PKGCONF_PREFIX PY_CYTHON_PREFIX PY_MESON_PYTHON_PREFIX PY_PACKAGING_PREFIX PY_PIP_PREFIX PY_PYPROJECT_METADATA_PREFIX PY_WHEEL_PREFIX PYTHON_PREFIX PYTHON_VENV_PREFIX; do
  if [[ -z "${!var:-}" || ! -d "${!var}" ]]; then
    echo "$var must name a Bazel/hermetic dependency prefix" >&2
    exit 2
  fi
done
if [[ -z "${PYTHON_ABI:-}" || ! -x "$PYTHON_PREFIX/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python prefix" >&2
  exit 2
fi
if [[ ! -x "$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -x "$MESON_PREFIX/bin/meson" ]]; then
  echo "missing Meson binary" >&2
  exit 2
fi
if [[ -x "$NINJA_PREFIX/bin/ninja" ]]; then
  NINJA_BIN="$NINJA_PREFIX/bin/ninja"
elif [[ -x "$NINJA_PREFIX/bin/ninja-build" ]]; then
  NINJA_BIN="$NINJA_PREFIX/bin/ninja-build"
else
  echo "missing Ninja binary" >&2
  exit 2
fi
if [[ -x "$PKGCONF_PREFIX/bin/pkgconf" ]]; then
  PKG_CONFIG_BIN="$PKGCONF_PREFIX/bin/pkgconf"
elif [[ -x "$PKGCONF_PREFIX/bin/pkg-config" ]]; then
  PKG_CONFIG_BIN="$PKGCONF_PREFIX/bin/pkg-config"
else
  echo "missing pkgconf/pkg-config binary" >&2
  exit 2
fi

python_include="$PYTHON_PREFIX/include/python${PYTHON_ABI}"
python_libdir="$PYTHON_PREFIX/lib"
if [[ ! -f "$python_include/Python.h" || ! -d "$python_libdir" ]]; then
  echo "PYTHON_PREFIX must provide Python.h and lib for ABI ${PYTHON_ABI}" >&2
  exit 2
fi
ext_suffix="$("$PYTHON_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import sysconfig
print(sysconfig.get_config_var("EXT_SUFFIX") or "")
PY
)"
if [[ -z "$ext_suffix" ]]; then
  echo "native python did not report EXT_SUFFIX" >&2
  exit 2
fi

if [[ ! -d "$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "missing py-pip for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "missing py-wheel for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_CYTHON_PREFIX/lib/python${PYTHON_ABI}/site-packages/Cython" ]]; then
  echo "missing py-cython for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_MESON_PYTHON_PREFIX/lib/python${PYTHON_ABI}/site-packages/mesonpy" ]]; then
  echo "missing py-meson-python for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_PACKAGING_PREFIX/lib/python${PYTHON_ABI}/site-packages/packaging" ]]; then
  echo "missing py-packaging for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_PYPROJECT_METADATA_PREFIX/lib/python${PYTHON_ABI}/site-packages/pyproject_metadata" ]]; then
  echo "missing py-pyproject-metadata for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$MESON_PREFIX/lib/python${PYTHON_ABI}/site-packages/mesonbuild" ]]; then
  echo "missing mesonbuild for Python ${PYTHON_ABI}" >&2
  exit 2
fi

openblas_libdir="$OPENBLAS_PREFIX/lib"
if [[ ! -d "$openblas_libdir" && -d "$OPENBLAS_PREFIX/lib64" ]]; then
  openblas_libdir="$OPENBLAS_PREFIX/lib64"
fi
if [[ ! -d "$openblas_libdir" ]]; then
  echo "OPENBLAS_PREFIX must provide lib or lib64" >&2
  exit 2
fi
if ! compgen -G "$openblas_libdir/libopenblas.so*" >/dev/null; then
  echo "missing OpenBLAS shared library" >&2
  exit 2
fi
if [[ ! -f "$openblas_libdir/pkgconfig/openblas.pc" ]]; then
  echo "missing OpenBLAS pkg-config file" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONNOUSERSITE=1
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_CYTHON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_MESON_PYTHON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PACKAGING_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PYPROJECT_METADATA_PREFIX/lib/python${PYTHON_ABI}/site-packages:$MESON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$MESON_PREFIX/bin:$NINJA_PREFIX/bin:$PKGCONF_PREFIX/bin:$PY_CYTHON_PREFIX/bin:$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:$PYTHON_PREFIX/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="$openblas_libdir:$python_libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PKG_CONFIG="$PKG_CONFIG_BIN"
export PKG_CONFIG_PATH="$openblas_libdir/pkgconfig"
export PKG_CONFIG_LIBDIR="$openblas_libdir/pkgconfig"
export NINJA="$NINJA_BIN"
export NINJAFLAGS="-j${NINJA_JOBS:-$(nproc)} ${NINJAFLAGS:-}"
wrapper_dir="$PWD/.spack-target-wrapper"
rm -rf "$wrapper_dir"
mkdir -p "$wrapper_dir"
spack_target_flags="-march=icelake-client -mtune=icelake-client"
cat >"$wrapper_dir/gcc" <<SH
#!/usr/bin/env bash
exec /usr/bin/gcc $spack_target_flags "\\$@"
SH
cat >"$wrapper_dir/g++" <<SH
#!/usr/bin/env bash
exec /usr/bin/g++ $spack_target_flags "\\$@"
SH
chmod +x "$wrapper_dir/gcc" "$wrapper_dir/g++"
export CC="$wrapper_dir/gcc"
export CXX="$wrapper_dir/g++"
export FC=
export F77=
export F90=
export CFLAGS="-I$OPENBLAS_PREFIX/include -I$python_include ${CFLAGS:-}"
export CXXFLAGS="-I$OPENBLAS_PREFIX/include -I$python_include ${CXXFLAGS:-}"
export LDFLAGS="-L$openblas_libdir -Wl,-rpath,$openblas_libdir -L$python_libdir -Wl,-rpath,$python_libdir ${LDFLAGS:-}"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  --config-settings=builddir=build \
  --config-settings=setup-args=-Dblas=openblas \
  --config-settings=setup-args=-Dlapack=openblas \
  --config-settings=setup-args=-Duse-ilp64=false \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -x "$PREFIX/bin/f2py"
test -x "$PREFIX/bin/numpy-config"
test -d "$site_packages/numpy"
test -f "$site_packages/numpy/__init__.py"
test -f "$site_packages/numpy/_core/_multiarray_umath$ext_suffix"
test -f "$site_packages/numpy/_core/_simd$ext_suffix"
test -f "$site_packages/numpy/linalg/_umath_linalg$ext_suffix"
test -f "$site_packages/numpy/random/_generator$ext_suffix"
test -f "$site_packages/numpy/random/mtrand$ext_suffix"
test -f "$site_packages/numpy-2.4.6.dist-info/METADATA"
test -f "$site_packages/numpy-2.4.6.dist-info/WHEEL"
if ! readelf -d "$site_packages/numpy/linalg/_umath_linalg$ext_suffix" | grep -q 'Shared library: \\[libopenblas'; then
  echo "numpy linalg extension is not linked against OpenBLAS" >&2
  exit 1
fi

export PYTHONPATH="$site_packages:$PYTHONPATH"
SMOKE_CWD="$PREFIX/.smoke-cwd"
mkdir -p "$SMOKE_CWD"
cd "$SMOKE_CWD"
out="$("$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import importlib.metadata
import numpy as np
from numpy._core import _multiarray_umath

a = np.array([[1.0, 2.0], [3.0, 4.0]])
b = np.array([[5.0, 6.0], [7.0, 8.0]])
print(
    "py-numpy:%s:%s:%.1f:%.1f"
    % (
        importlib.metadata.version("numpy"),
        _multiarray_umath.__name__,
        float((a @ b)[0, 0]),
        float(np.linalg.det(a)),
    )
)
PY
)"
if [[ "$out" != "py-numpy:2.4.6:numpy._core._multiarray_umath:19.0:-2.0" ]]; then
  echo "unexpected numpy smoke output: $out" >&2
  exit 1
fi
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-numpy native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _apply_patch(repository_ctx, patch_label):
    res = repository_ctx.execute(
        ["patch", "-p1", "-i", str(repository_ctx.path(patch_label))],
        working_directory = str(repository_ctx.path("src")),
        timeout = 120,
        quiet = False,
    )
    if res.return_code != 0:
        fail("py-numpy check_executables.patch failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))


def _py_numpy_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-numpy native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    _apply_patch(repository_ctx, attr.check_executables_patch)
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    prefixes = {
        "MESON_PREFIX": _read_prefix(repository_ctx, attr.meson_prefix_file, "meson"),
        "NINJA_PREFIX": _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja"),
        "OPENBLAS_PREFIX": _read_prefix(repository_ctx, attr.openblas_prefix_file, "openblas"),
        "PKGCONF_PREFIX": _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf"),
        "PY_CYTHON_PREFIX": _read_prefix(repository_ctx, attr.py_cython_prefix_file, "py-cython"),
        "PY_MESON_PYTHON_PREFIX": _read_prefix(repository_ctx, attr.py_meson_python_prefix_file, "py-meson-python"),
        "PY_PACKAGING_PREFIX": _read_prefix(repository_ctx, attr.py_packaging_prefix_file, "py-packaging"),
        "PY_PIP_PREFIX": _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip"),
        "PY_PYPROJECT_METADATA_PREFIX": _read_prefix(repository_ctx, attr.py_pyproject_metadata_prefix_file, "py-pyproject-metadata"),
        "PY_WHEEL_PREFIX": _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel"),
        "PYTHON_PREFIX": python_prefix,
        "PYTHON_VENV_PREFIX": _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv"),
    }
    prefix = str(repository_ctx.path("prefix"))

    env = dict(prefixes)
    env["PYTHON_ABI"] = python_abi
    env["VASO_IN_INSULA"] = "1"
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 3600,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("py-numpy native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_numpy_native = repository_rule(
    implementation = _py_numpy_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "check_executables_patch": attr.label(mandatory = True, allow_single_file = True),
        "meson_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openblas_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_cython_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_meson_python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_packaging_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pyproject_metadata_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["NINJA_JOBS", "VASO_IN_INSULA"],
    doc = "Build py-numpy@2.4.6 against native OpenBLAS into a concrete Spack-compatible Python prefix.",
)
