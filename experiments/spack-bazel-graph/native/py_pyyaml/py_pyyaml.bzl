"""Native (Bazel-owned) py-pyyaml prefix.

The hermetic Spack v1.2.2 py-pyyaml@6.0.3 recipe is a PythonPackage with the
`+libyaml` variant enabled. Spack runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> \
        --config-settings=--global-option=--with-libyaml .

Spack supplies pip, setuptools, wheel, Cython, and python-venv through
installed Python prefixes and supplies libyaml through CFLAGS/LDFLAGS. This
rule reproduces that dependency channel with Bazel-native prefix markers and
must run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_pyyaml_native. Native Bazel build of py-pyyaml, intended to
# match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-pyyaml exposes Python packages and one CPython extension module linked
# against libyaml. Keep @spack_py_pyyaml//:lib valid for migrated-provider
# dispatch while the runtime surface is carried as data from the generated
# prefix.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-pyyaml native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native python prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python prefix" >&2
  exit 2
fi
if [[ ! -d "$PYTHON_PREFIX/include/python${PYTHON_ABI}" || ! -d "$PYTHON_PREFIX/lib" ]]; then
  echo "PYTHON_PREFIX must provide include/python${PYTHON_ABI} and lib" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi
if [[ -z "${PY_CYTHON_PREFIX:-}" || ! -d "${PY_CYTHON_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/Cython" ]]; then
  echo "PY_CYTHON_PREFIX must name the Bazel-built native py-cython prefix" >&2
  exit 2
fi
if [[ -z "${LIBYAML_PREFIX:-}" || ! -f "${LIBYAML_PREFIX:-}/include/yaml.h" ]]; then
  echo "LIBYAML_PREFIX must name the Bazel-built native libyaml prefix" >&2
  exit 2
fi
if [[ ! -d "$LIBYAML_PREFIX/lib" ]]; then
  echo "LIBYAML_PREFIX must provide lib" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_CYTHON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export LD_LIBRARY_PATH="$PYTHON_PREFIX/lib:$LIBYAML_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$PY_CYTHON_PREFIX/bin:$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:$PYTHON_PREFIX/bin:/usr/bin:/bin"
export CC=/usr/bin/gcc
export CXX=/usr/bin/g++
export CYTHON_FORCE_REGEN=1
export CFLAGS="-I$LIBYAML_PREFIX/include -I$PYTHON_VENV_PREFIX/include -I$PYTHON_PREFIX/include/python${PYTHON_ABI} ${CFLAGS:-}"
export LDFLAGS="-L$LIBYAML_PREFIX/lib -Wl,-rpath,$LIBYAML_PREFIX/lib -L$PYTHON_PREFIX/lib -Wl,-rpath,$PYTHON_PREFIX/lib ${LDFLAGS:-}"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  --config-settings=--global-option=--with-libyaml \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
python_ext_suffix="$("$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX") or "")')"
if [[ -z "$python_ext_suffix" ]]; then
  echo "native python did not report EXT_SUFFIX" >&2
  exit 2
fi
test -d "$site_packages/yaml"
test -d "$site_packages/_yaml"
test -f "$site_packages/_yaml/__init__.py"
test -f "$site_packages/yaml/__init__.py"
test -f "$site_packages/yaml/cyaml.py"
test -f "$site_packages/yaml/_yaml${python_ext_suffix}"
test -f "$site_packages/yaml/loader.py"
test -f "$site_packages/yaml/dumper.py"
test -f "$site_packages/pyyaml-6.0.3.dist-info/INSTALLER"
test -f "$site_packages/pyyaml-6.0.3.dist-info/METADATA"
test -f "$site_packages/pyyaml-6.0.3.dist-info/REQUESTED"
test -f "$site_packages/pyyaml-6.0.3.dist-info/WHEEL"
test -f "$site_packages/pyyaml-6.0.3.dist-info/licenses/LICENSE"
test -f "$site_packages/pyyaml-6.0.3.dist-info/top_level.txt"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-pyyaml native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_pyyaml_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-pyyaml native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    py_cython_prefix = _read_prefix(repository_ctx, attr.py_cython_prefix_file, "py-cython")
    libyaml_prefix = _read_prefix(repository_ctx, attr.libyaml_prefix_file, "libyaml")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 1200,
        quiet = False,
        environment = {
            "PYTHON_ABI": python_abi,
            "PYTHON_PREFIX": python_prefix,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "PY_CYTHON_PREFIX": py_cython_prefix,
            "LIBYAML_PREFIX": libyaml_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-pyyaml native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_pyyaml_native = repository_rule(
    implementation = _py_pyyaml_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_cython_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libyaml_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-pyyaml@6.0.3 +libyaml from its PyPI source archive into a Spack-prefix-identical tree.",
)
