"""Shared rootfs-boundary repository rule for CUDA-family libraries."""

_BUILD_TEMPLATE = """\
# GENERATED by {rule_name}. Native rootfs boundary for {display_name} in the
# selected hermetic insula rootfs. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/cccl",
    ],
    data = [":prefix"],
    linkopts = {linkopts},
    deps = ["@cuda_native//:lib"],
)

exports_files([
    "prefix_path.txt",
    "sdk_boundary.json",
])
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
PREFIX="$1"
COMPONENT="$2"
DISPLAY_NAME="$3"
MANIFEST_COMPONENT="$4"
VERSION_KIND="$5"
REQUIRED_HEADERS="$6"
REQUIRED_LIBS="$7"

# sdk-boundary
if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "${DISPLAY_NAME} native boundary must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${VASO_ROOTFS_BUNDLE_MANIFEST:-}" || ! -f "$VASO_ROOTFS_BUNDLE_MANIFEST" ]]; then
  echo "VASO_ROOTFS_BUNDLE_MANIFEST must point at the insula rootfs-bundle.json" >&2
  exit 2
fi
if [[ -z "${VASO_CUDA_HOME:-}" || ! -x "${VASO_CUDA_HOME}/bin/nvcc" ]]; then
  echo "VASO_CUDA_HOME must name the insula CUDA SDK and provide bin/nvcc" >&2
  exit 2
fi
include_root="${VASO_CUDA_HOME}/include"
if [[ ! -d "$include_root" && -d "${VASO_CUDA_HOME}/targets/x86_64-linux/include" ]]; then
  include_root="${VASO_CUDA_HOME}/targets/x86_64-linux/include"
fi
if [[ ! -d "$include_root" ]]; then
  echo "VASO_CUDA_HOME must expose include/" >&2
  exit 2
fi
if [[ -d "${VASO_CUDA_HOME}/lib64" ]]; then
  ROOTFS_LIB_DIR="${VASO_CUDA_HOME}/lib64"
elif [[ -d "${VASO_CUDA_HOME}/lib" ]]; then
  ROOTFS_LIB_DIR="${VASO_CUDA_HOME}/lib"
else
  echo "VASO_CUDA_HOME must expose lib64/ or lib/" >&2
  exit 2
fi

mapfile -t expected_versions < <(python3 - "$VASO_ROOTFS_BUNDLE_MANIFEST" "$MANIFEST_COMPONENT" "$VERSION_KIND" <<'PY'
import json
import sys

manifest, component, kind = sys.argv[1:4]
data = json.load(open(manifest, encoding="utf-8"))
if data.get("schema_version") != 2:
    raise SystemExit(f"rootfs manifest schema_version must be 2, got {data.get('schema_version')!r}")
entry = data.get("verified_versions", {}).get("components", {}).get(component)
if not entry:
    raise SystemExit(f"rootfs manifest lacks verified version for {component}")
expected = entry.get("expected")
if not expected:
    raise SystemExit(f"rootfs manifest lacks expected version for {component}")

header = entry.get("header")
macros = entry.get("header_macros") or {}
if not header and kind == "cusparselt":
    keys = (
        "CUSPARSELT_VER_MAJOR",
        "CUSPARSELT_VER_MINOR",
        "CUSPARSELT_VER_PATCH",
        "CUSPARSELT_VER_BUILD",
    )
    header = ".".join(str(macros[k]) for k in keys)
elif not header and kind == "cudss":
    keys = (
        "CUDSS_VERSION_MAJOR",
        "CUDSS_VERSION_MINOR",
        "CUDSS_VERSION_PATCH",
    )
    header = ".".join(str(macros[k]) for k in keys)
elif not header:
    header = expected

print(expected)
print(header)
PY
)
if [[ "${#expected_versions[@]}" -ne 2 ]]; then
  echo "failed to read ${DISPLAY_NAME} expected versions from $VASO_ROOTFS_BUNDLE_MANIFEST" >&2
  exit 2
fi
EXPECTED_PACKAGE_VERSION="${expected_versions[0]}"
EXPECTED_HEADER_VERSION="${expected_versions[1]}"

IFS='|' read -r -a headers <<< "$REQUIRED_HEADERS"
for header in "${headers[@]}"; do
  [[ -n "$header" ]] || continue
  if [[ ! -f "${include_root}/${header}" ]]; then
    echo "${DISPLAY_NAME} rootfs boundary lacks include/${header}" >&2
    exit 2
  fi
done
IFS='|' read -r -a libs <<< "$REQUIRED_LIBS"
for lib in "${libs[@]}"; do
  [[ -n "$lib" ]] || continue
  if [[ ! -e "${ROOTFS_LIB_DIR}/${lib}" ]]; then
    echo "${DISPLAY_NAME} rootfs boundary lacks ${ROOTFS_LIB_DIR}/${lib}" >&2
    exit 2
  fi
done

actual_header_version="$(python3 - "$VERSION_KIND" "$include_root" <<'PY'
import re
import sys
from pathlib import Path

kind, include_dir = sys.argv[1:3]
include = Path(include_dir)

def read(rel):
    return (include / rel).read_text(encoding="utf-8", errors="ignore")

if kind == "cudnn":
    text = read("cudnn_version.h")
    defs = dict(re.findall(r"^#define\\s+(CUDNN_(?:MAJOR|MINOR|PATCHLEVEL))\\s+([0-9]+)\\b", text, re.M))
    print(".".join(defs[k] for k in ("CUDNN_MAJOR", "CUDNN_MINOR", "CUDNN_PATCHLEVEL")))
elif kind == "nccl":
    text = read("nccl.h")
    defs = dict(re.findall(r"^#define\\s+(NCCL_(?:MAJOR|MINOR|PATCH))\\s+([0-9]+)\\b", text, re.M))
    print(".".join(defs[k] for k in ("NCCL_MAJOR", "NCCL_MINOR", "NCCL_PATCH")))
elif kind == "cusparselt":
    text = read("cusparseLt.h")
    defs = dict(re.findall(r"^#define\\s+(CUSPARSELT_VER_(?:MAJOR|MINOR|PATCH|BUILD))\\s+([0-9]+)\\b", text, re.M))
    print(".".join(defs[k] for k in (
        "CUSPARSELT_VER_MAJOR",
        "CUSPARSELT_VER_MINOR",
        "CUSPARSELT_VER_PATCH",
        "CUSPARSELT_VER_BUILD",
    )))
elif kind == "cudss":
    text = read("cudss.h")
    defs = dict(re.findall(r"^#define\\s+(CUDSS_(?:VER|VERSION)_(?:MAJOR|MINOR|PATCH))\\s+([0-9]+)\\b", text, re.M))
    values = []
    for name in ("MAJOR", "MINOR", "PATCH"):
        for prefix in ("CUDSS_VERSION_", "CUDSS_VER_"):
            value = defs.get(prefix + name)
            if value is not None:
                values.append(value)
                break
        else:
            raise SystemExit(f"missing cuDSS version macro for {name}")
    print(".".join(values))
elif kind == "nvshmem":
    text = read("non_abi/nvshmem_version.h")
    defs = dict(re.findall(r"^#define\\s+(NVSHMEM_VENDOR_(?:MAJOR|MINOR|PATCH)_VERSION)\\s+([0-9]+)\\b", text, re.M))
    print(".".join(defs[k] for k in (
        "NVSHMEM_VENDOR_MAJOR_VERSION",
        "NVSHMEM_VENDOR_MINOR_VERSION",
        "NVSHMEM_VENDOR_PATCH_VERSION",
    )))
else:
    raise SystemExit(f"unsupported CUDA rootfs component version kind: {kind}")
PY
)"
if [[ "$actual_header_version" != "$EXPECTED_HEADER_VERSION" ]]; then
  echo "${DISPLAY_NAME} header version mismatch: expected ${EXPECTED_HEADER_VERSION}, got ${actual_header_version:-unknown}" >&2
  exit 2
fi

rm -rf "$PREFIX"
mkdir -p "$PREFIX"
mkdir -p "$PREFIX/include"
ln -s "$include_root" "$PREFIX/include/rootfs"
for entry in "$include_root"/*; do
  [[ -e "$entry" ]] || continue
  name="$(basename "$entry")"
  [[ "$name" == "cccl" ]] && continue
  ln -s "$entry" "$PREFIX/include/$name"
done
if [[ -d "${include_root}/cccl" ]]; then
  ln -s "${include_root}/cccl" "$PREFIX/include/cccl"
fi
ln -s "$ROOTFS_LIB_DIR" "$PREFIX/lib"
ln -s "$ROOTFS_LIB_DIR" "$PREFIX/lib64"

python3 - "$PREFIX/sdk_boundary.json" "$COMPONENT" "$DISPLAY_NAME" "$EXPECTED_PACKAGE_VERSION" \
  "$EXPECTED_HEADER_VERSION" "$actual_header_version" "$VASO_CUDA_HOME" "$ROOTFS_LIB_DIR" \
  "$VASO_ROOTFS_BUNDLE_MANIFEST" <<'PY'
import json
import sys

(
    out,
    component,
    display_name,
    expected_package,
    expected_header,
    actual_header,
    cuda_home,
    lib_dir,
    manifest,
) = sys.argv[1:10]
with open(manifest, encoding="utf-8") as fh:
    rootfs = json.load(fh)
data = {
    "schema_version": 1,
    "mechanism": "sdk-boundary",
    "package": component,
    "display_name": display_name,
    "expected_version": expected_package,
    "expected_header_version": expected_header,
    "actual_header_version": actual_header,
    "cuda_home": cuda_home,
    "rootfs_lib_dir": lib_dir,
    "rootfs_bundle": rootfs,
    "dependency_prefixes": {
        "cuda": cuda_home,
    },
}
with open(out, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, sort_keys=True)
    fh.write("\\n")
PY
"""


def rootfs_cuda_component_attrs(
        component,
        display_name,
        version_kind,
        required_headers,
        required_libs,
        link_libraries,
        manifest_component = ""):
    if not manifest_component:
        manifest_component = component
    return {
        "component": attr.string(default = component),
        "display_name": attr.string(default = display_name),
        "manifest_component": attr.string(default = manifest_component),
        "version_kind": attr.string(default = version_kind),
        "required_headers": attr.string_list(default = required_headers),
        "required_libs": attr.string_list(default = required_libs),
        "link_libraries": attr.string_list(default = link_libraries),
    }


def rootfs_cuda_component_impl(repository_ctx):
    attr_values = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("{} native boundary must run inside the hermetic insula (VASO_IN_INSULA=1)".format(
            attr_values.display_name,
        ))

    cuda_home = repository_ctx.os.environ.get("VASO_CUDA_HOME", "/usr/local/cuda")
    manifest = repository_ctx.os.environ.get(
        "VASO_ROOTFS_BUNDLE_MANIFEST",
        "/run/vaso/rootfs-bundle.json",
    )
    prefix = str(repository_ctx.path("prefix"))

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)
    res = repository_ctx.execute(
        [
            "./build.sh",
            prefix,
            attr_values.component,
            attr_values.display_name,
            attr_values.manifest_component,
            attr_values.version_kind,
            "|".join(attr_values.required_headers),
            "|".join(attr_values.required_libs),
        ],
        timeout = 120,
        quiet = False,
        environment = {
            "VASO_CUDA_HOME": cuda_home,
            "VASO_IN_INSULA": "1",
            "VASO_ROOTFS_BUNDLE_MANIFEST": manifest,
        },
    )
    if res.return_code != 0:
        fail("{} native boundary validation failed (rc={}):\n{}\n{}".format(
            attr_values.display_name,
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    linkopts = [
        "-L" + prefix + "/lib64",
        "-L" + prefix + "/lib",
        "-Wl,-rpath," + prefix + "/lib64",
        "-Wl,-rpath," + prefix + "/lib",
    ] + ["-l" + lib for lib in attr_values.link_libraries]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.symlink("prefix/sdk_boundary.json", "sdk_boundary.json")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(
            display_name = attr_values.display_name,
            linkopts = repr(linkopts),
            rule_name = repository_ctx.name,
        ),
    )
