"""Native (Bazel-owned) py-pip prefix.

The hermetic Spack v1.2.2 py-pip@26.1.2 recipe is a generic Python extension
package that bootstraps pip by installing the upstream wheel with the wheel's
own `pip` module:

    <python-venv-prefix>/bin/python3 <unpacked-wheel>/pip -vvv ... \
        --no-index --prefix=<prefix> <wheel>

This rule reproduces that prefix while consuming only Bazel-native Python and
python-venv prefix markers. It must run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_pip_native. Native Bazel build of py-pip, intended to match
# the Spack wheel-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-pip is a Python package prefix. It has no C link surface, but
# @spack_py_pip//:lib must remain a valid provider target after migration.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
WHEEL="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-pip native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native Python prefix with bin/python3" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -d "${PYTHON_PREFIX:-}/include/python${PYTHON_ABI}" || ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native Python prefix include directory" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix for PYTHON_ABI" >&2
  exit 2
fi

rm -rf "$PREFIX" unpacked-wheel
export PYTHONHOME=
export PYTHONPATH=
"$PYTHON_PREFIX/bin/python${PYTHON_ABI}" -m zipfile -e "$WHEEL" unpacked-wheel

"$PYTHON_VENV_PREFIX/bin/python3" unpacked-wheel/pip \\
  -vvv \\
  --no-input \\
  --no-cache-dir \\
  --disable-pip-version-check \\
  install \\
  --no-deps \\
  --ignore-installed \\
  --no-build-isolation \\
  --no-warn-script-location \\
  --no-index \\
  --prefix="$PREFIX" \\
  "$WHEEL"

test -x "$PREFIX/bin/pip"
test -x "$PREFIX/bin/pip3"
test -x "$PREFIX/bin/pip${PYTHON_ABI}"
test -d "$PREFIX/lib/python${PYTHON_ABI}/site-packages/pip"
test -f "$PREFIX/lib/python${PYTHON_ABI}/site-packages/pip-26.1.2.dist-info/METADATA"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-pip native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_pip_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-pip native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    wheel = repository_ctx.path("pip-26.1.2-py3-none-any.whl")
    repository_ctx.download(
        url = attr.urls,
        sha256 = attr.sha256,
        output = wheel,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(wheel), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "PYTHON_ABI": python_abi,
            "PYTHON_PREFIX": python_prefix,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-pip native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_pip_native = repository_rule(
    implementation = _py_pip_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Install py-pip@26.1.2 from its upstream wheel into a Spack-prefix-identical tree.",
)
