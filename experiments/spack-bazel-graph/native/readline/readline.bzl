"""Native (Bazel-owned) build of readline into a Spack-identical prefix.

The hermetic Spack v1.2.2 readline@8.3 recipe applies three upstream patch
files, configures with bash_cv_wcwidth_broken=no, then builds shared libraries
with SHLIB_LIBS from the wide ncurses provider.
"""

_BUILD_TEMPLATE = """\
# GENERATED by readline_native. Native Bazel build of readline, intended to
# match the Spack readline install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/readline",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
shift 2

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "readline native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -d "${NCURSES_PREFIX:-}/lib" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi

cd "$SRC"
for patch_file in "$@"; do
  patch -p0 < "$patch_file"
done

export CPPFLAGS="-I${NCURSES_PREFIX}/include -I${NCURSES_PREFIX}/include/ncursesw ${CPPFLAGS:-}"
export LDFLAGS="-L${NCURSES_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,-rpath,${NCURSES_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export PKG_CONFIG=/bin/false
export PKG_CONFIG_PATH="${NCURSES_PREFIX}/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"

./configure --prefix="$PREFIX" bash_cv_wcwidth_broken=no

shlib_libs="-L${NCURSES_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,-rpath,${NCURSES_PREFIX}/lib -Wl,--disable-new-dtags -lncursesw -ltinfow"
make -j"${MAKE_JOBS:-$(nproc)}" "SHLIB_LIBS=${shlib_libs}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _readline_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if len(attr.patches) != len(attr.patch_sha256s):
        fail("readline native build requires one sha256 per patch URL")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )

    patch_paths = []
    for i in range(len(attr.patches)):
        out = "patches/readline83-" + str(i + 1)
        repository_ctx.download(
            url = attr.patches[i],
            sha256 = attr.patch_sha256s[i],
            output = out,
        )
        patch_paths.append(str(repository_ctx.path(out)))

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    ncurses_prefix = repository_ctx.read(attr.ncurses_prefix_file).strip()
    if not ncurses_prefix:
        fail("readline native build requires a non-empty ncurses prefix path")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix] + patch_paths,
        timeout = 1800,
        quiet = False,
        environment = {
            "NCURSES_PREFIX": ncurses_prefix,
        },
    )
    if res.return_code != 0:
        fail("readline native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    ncurses_lib = "{}/lib".format(ncurses_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lreadline",
        "-lhistory",
        "-L" + ncurses_lib,
        "-Wl,-rpath," + ncurses_lib,
        "-lncursesw",
        "-ltinfow",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


readline_native = repository_rule(
    implementation = _readline_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "patches": attr.string_list(mandatory = True),
        "patch_sha256s": attr.string_list(mandatory = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build readline from source into a Spack-prefix-identical tree.",
)
