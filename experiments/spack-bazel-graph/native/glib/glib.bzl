"""Native (Bazel-owned) build of full GLib into a Spack prefix.

The hermetic Spack v1.2.2 glib@2.88.1 recipe is a MesonPackage. This rule
mirrors the concrete full-GLib variant used by the PyTorch frontier:
introspection and libelf are enabled, libmount/tracing/sysprof/gtk-doc are
disabled, and every build dependency is supplied as a Bazel-owned prefix inside
the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by glib_native. Native Bazel build of full GLib, intended to match
# the Spack glib install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**", "prefix/lib/glib-2.0/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/gio-unix-2.0",
        "prefix/include/glib-2.0",
        "prefix/lib/glib-2.0/include",
    ],
    linkopts = {linkopts},
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: meson
SRC="$1"
PREFIX="$2"
BUILD_DIR="$PWD/build"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "glib native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" ]]; then
  echo "PYTHON_ABI must be derived from the native Python prefix" >&2
  exit 2
fi
if [[ -z "${ELFUTILS_PREFIX:-}" || ! -d "${ELFUTILS_PREFIX:-}/lib" ]]; then
  echo "ELFUTILS_PREFIX must name the Bazel-built elfutils prefix" >&2
  exit 2
fi
if [[ -z "${GETTEXT_PREFIX:-}" || ! -d "${GETTEXT_PREFIX:-}/lib" ]]; then
  echo "GETTEXT_PREFIX must name the Bazel-built gettext prefix" >&2
  exit 2
fi
if [[ -z "${GLIB_BOOTSTRAP_PREFIX:-}" || ! -d "${GLIB_BOOTSTRAP_PREFIX:-}/lib/pkgconfig" ]]; then
  echo "GLIB_BOOTSTRAP_PREFIX must name the Bazel-built glib-bootstrap prefix" >&2
  exit 2
fi
if [[ -z "${GOBJECT_INTROSPECTION_PREFIX:-}" || ! -x "${GOBJECT_INTROSPECTION_PREFIX:-}/bin/g-ir-scanner" ]]; then
  echo "GOBJECT_INTROSPECTION_PREFIX must name the Bazel-built gobject-introspection prefix" >&2
  exit 2
fi
if [[ -z "${LIBFFI_PREFIX:-}" || ! -f "${LIBFFI_PREFIX:-}/include/ffi.h" ]]; then
  echo "LIBFFI_PREFIX must name the Bazel-built libffi prefix" >&2
  exit 2
fi
if [[ -z "${LIBICONV_PREFIX:-}" || ! -d "${LIBICONV_PREFIX:-}/lib" ]]; then
  echo "LIBICONV_PREFIX must name the Bazel-built libiconv prefix" >&2
  exit 2
fi
if [[ -z "${MESON_PREFIX:-}" || ! -x "${MESON_PREFIX:-}/bin/meson" || ! -d "${MESON_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/mesonbuild" ]]; then
  echo "MESON_PREFIX must name the Bazel-built Meson prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built Ninja prefix" >&2
  exit 2
fi
if [[ -z "${PCRE2_PREFIX:-}" || ! -f "${PCRE2_PREFIX:-}/lib/pkgconfig/libpcre2-8.pc" ]]; then
  echo "PCRE2_PREFIX must name the Bazel-built pcre2 prefix" >&2
  exit 2
fi
if [[ -z "${PERL_PREFIX:-}" || ! -x "${PERL_PREFIX:-}/bin/perl" ]]; then
  echo "PERL_PREFIX must name the Bazel-built Perl prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built Python prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" || ! -d "${PYTHON_PREFIX:-}/include/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native Python prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built python-venv prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must match the native Python ABI" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/lib/pkgconfig/zlib.pc" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

rm -rf "$BUILD_DIR" "$PREFIX"
mkdir -p "$BUILD_DIR"

dep_libs=(
  "$ELFUTILS_PREFIX/lib"
  "$GETTEXT_PREFIX/lib"
  "$GOBJECT_INTROSPECTION_PREFIX/lib"
  "$LIBFFI_PREFIX/lib"
  "$LIBICONV_PREFIX/lib"
  "$PCRE2_PREFIX/lib"
  "$PYTHON_PREFIX/lib"
  "$ZLIB_PREFIX/lib"
)
dep_pkgconfigs=(
  "$ELFUTILS_PREFIX/lib/pkgconfig"
  "$GETTEXT_PREFIX/lib/pkgconfig"
  "$GLIB_BOOTSTRAP_PREFIX/lib/pkgconfig"
  "$GOBJECT_INTROSPECTION_PREFIX/lib/pkgconfig"
  "$LIBFFI_PREFIX/lib/pkgconfig"
  "$LIBICONV_PREFIX/lib/pkgconfig"
  "$PCRE2_PREFIX/lib/pkgconfig"
  "$PYTHON_PREFIX/lib/pkgconfig"
  "$ZLIB_PREFIX/lib/pkgconfig"
)

spack_target_flags="-march=icelake-client -mtune=icelake-client"
export PATH="${MESON_PREFIX}/bin:${NINJA_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${GOBJECT_INTROSPECTION_PREFIX}/bin:${PERL_PREFIX}/bin:${PYTHON_PREFIX}/bin:${PYTHON_VENV_PREFIX}/bin:${PATH}"
export PYTHONHOME=
export PYTHONPATH="${MESON_PREFIX}/lib/python${PYTHON_ABI}/site-packages:${PY_SETUPTOOLS_PREFIX}/lib/python${PYTHON_ABI}/site-packages${PYTHONPATH:+:${PYTHONPATH}}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="$(IFS=:; echo "${dep_pkgconfigs[*]}")"
export GI_SCANNER_DISABLE_CACHE=1
export GI_TYPELIB_PATH="${GOBJECT_INTROSPECTION_PREFIX}/lib/girepository-1.0${GI_TYPELIB_PATH:+:${GI_TYPELIB_PATH}}"
export XDG_DATA_DIRS="${GOBJECT_INTROSPECTION_PREFIX}/share${XDG_DATA_DIRS:+:${XDG_DATA_DIRS}}"
export CPPFLAGS="-I${ELFUTILS_PREFIX}/include -I${GETTEXT_PREFIX}/include -I${GOBJECT_INTROSPECTION_PREFIX}/include -I${LIBFFI_PREFIX}/include -I${LIBICONV_PREFIX}/include -I${PCRE2_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CXXFLAGS:-}"
export LDFLAGS="$(printf ' -L%s' "${dep_libs[@]}") -Wl,-rpath,$(IFS=:; echo "${dep_libs[*]}") -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LD_LIBRARY_PATH="$(IFS=:; echo "${dep_libs[*]}")${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

"$MESON_PREFIX/bin/meson" setup "$BUILD_DIR" "$SRC" \
  -Dprefix="$PREFIX" \
  -Dlibdir="$PREFIX/lib" \
  -Dbuildtype=release \
  -Dstrip=false \
  -Ddefault_library=shared \
  -Dwrap_mode=nodownload \
  -Dintrospection=enabled \
  -Dlibmount=disabled \
  -Ddtrace=false \
  -Dsystemtap=false \
  -Dselinux=disabled \
  -Dgtk_doc=false \
  -Dlibelf=enabled \
  -Dsysprof=disabled

"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" -v
"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" install

find "$PREFIX" -type f -name '*.la' -delete || true

test -f "$PREFIX/include/glib-2.0/glib.h"
test -f "$PREFIX/include/glib-2.0/glib-object.h"
test -f "$PREFIX/include/glib-2.0/gmodule.h"
test -f "$PREFIX/include/glib-2.0/glib-unix.h"
test -f "$PREFIX/include/glib-2.0/girepository/girepository.h"
test -f "$PREFIX/lib/glib-2.0/include/glibconfig.h"
test -f "$PREFIX/lib/pkgconfig/glib-2.0.pc"
test -f "$PREFIX/lib/pkgconfig/gobject-2.0.pc"
test -f "$PREFIX/lib/pkgconfig/gio-2.0.pc"
test -f "$PREFIX/lib/pkgconfig/girepository-2.0.pc"
test -x "$PREFIX/bin/glib-compile-schemas"
test -x "$PREFIX/bin/glib-genmarshal"
test -x "$PREFIX/bin/glib-mkenums"
test -d "$PREFIX/lib/girepository-1.0"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("glib native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _glib_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("glib native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    prefixes = {
        "ELFUTILS_PREFIX": _read_prefix(repository_ctx, attr.elfutils_prefix_file, "elfutils"),
        "GETTEXT_PREFIX": _read_prefix(repository_ctx, attr.gettext_prefix_file, "gettext"),
        "GLIB_BOOTSTRAP_PREFIX": _read_prefix(repository_ctx, attr.glib_bootstrap_prefix_file, "glib-bootstrap"),
        "GOBJECT_INTROSPECTION_PREFIX": _read_prefix(repository_ctx, attr.gobject_introspection_prefix_file, "gobject-introspection"),
        "LIBFFI_PREFIX": _read_prefix(repository_ctx, attr.libffi_prefix_file, "libffi"),
        "LIBICONV_PREFIX": _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv"),
        "MESON_PREFIX": _read_prefix(repository_ctx, attr.meson_prefix_file, "meson"),
        "NINJA_PREFIX": _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja"),
        "PCRE2_PREFIX": _read_prefix(repository_ctx, attr.pcre2_prefix_file, "pcre2"),
        "PERL_PREFIX": _read_prefix(repository_ctx, attr.perl_prefix_file, "perl"),
        "PKGCONF_PREFIX": _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf"),
        "PYTHON_PREFIX": _read_prefix(repository_ctx, attr.python_prefix_file, "python"),
        "PYTHON_VENV_PREFIX": _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv"),
        "PY_SETUPTOOLS_PREFIX": _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools"),
        "ZLIB_PREFIX": _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng"),
    }
    prefixes["PYTHON_ABI"] = python_abi_from_prefix(repository_ctx, prefixes["PYTHON_PREFIX"], "python")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    env = dict(prefixes)
    env["VASO_IN_INSULA"] = "1"
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 5400,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("glib native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lgio-2.0",
        "-lgirepository-2.0",
        "-lgobject-2.0",
        "-lgmodule-2.0",
        "-lgthread-2.0",
        "-lglib-2.0",
    ]
    for dep in (
        prefixes["ELFUTILS_PREFIX"],
        prefixes["GETTEXT_PREFIX"],
        prefixes["GOBJECT_INTROSPECTION_PREFIX"],
        prefixes["LIBFFI_PREFIX"],
        prefixes["LIBICONV_PREFIX"],
        prefixes["PCRE2_PREFIX"],
        prefixes["ZLIB_PREFIX"],
    ):
        linkopts.extend([
            "-L{}/lib".format(dep),
            "-Wl,-rpath,{}/lib".format(dep),
        ])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


glib_native = repository_rule(
    implementation = _glib_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "elfutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gettext_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "glib_bootstrap_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gobject_introspection_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libffi_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "meson_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pcre2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build glib@2.88.1 from source into a Spack-prefix-identical tree.",
)
