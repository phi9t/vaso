"""Native (Bazel-owned) build of Ninja into a Spack-identical prefix.

The lean py-torch frontier captures ninja@1.13.2 as Spack's generic package:
Python runs upstream configure.py --bootstrap, re2c is a build-tool dependency,
and install() copies the executable plus misc/ support files.
"""

_BUILD_TEMPLATE = """\
# GENERATED by ninja_native. Native Bazel build of Ninja, intended to match the
# Spack ninja install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# Ninja is an executable/tool-prefix node in this graph. It exposes no public C
# ABI, but @spack_ninja//:lib must remain a valid provider target after a flip.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: python-bootstrap-tool
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "ninja native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built Python prefix" >&2
  exit 2
fi
if [[ -z "${RE2C_PREFIX:-}" || ! -x "${RE2C_PREFIX:-}/bin/re2c" ]]; then
  echo "RE2C_PREFIX must name the Bazel-built re2c prefix" >&2
  exit 2
fi

cd "$SRC"

spack_target_flags="-march=icelake-client -mtune=icelake-client"
export PATH="${PYTHON_PREFIX}/bin:${RE2C_PREFIX}/bin:${PATH}"
export CFLAGS="${spack_target_flags} ${CFLAGS:-}"
export CXXFLAGS="${spack_target_flags} ${CXXFLAGS:-}"

"$PYTHON_PREFIX/bin/python3" configure.py --bootstrap

mkdir -p "$PREFIX/bin"
install -m 755 ninja "$PREFIX/bin/ninja"
cp -a misc "$PREFIX/misc"
(
  cd "$PREFIX/bin"
  ln -sf ninja ninja-build
)
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("ninja native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _ninja_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("ninja native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    re2c_prefix = _read_prefix(repository_ctx, attr.re2c_prefix_file, "re2c")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "PYTHON_PREFIX": python_prefix,
            "RE2C_PREFIX": re2c_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("ninja native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


ninja_native = repository_rule(
    implementation = _ninja_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "re2c_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build Ninja from source into a Spack-prefix-identical tool tree.",
)
