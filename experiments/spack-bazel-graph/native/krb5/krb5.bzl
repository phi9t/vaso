"""Native (Bazel-owned) build of MIT Kerberos into a Spack-identical prefix.

The py-torch frontier captures krb5@1.22.2 as an AutotoolsPackage with a
nested `src` configure directory. The hermetic Spack recipe builds shared
libraries only, uses the bundled libverto implementation, disables keyutils,
and consumes OpenSSL, libedit, gettext, bison, findutils, perl, and pkgconf
through the Spack DAG.
"""

_BUILD_TEMPLATE = """\
# GENERATED by krb5_native. Native Bazel build of MIT Kerberos, intended to
# match the Spack krb5 install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/gssapi",
        "prefix/include/gssrpc",
        "prefix/include/kadm5",
        "prefix/include/krb5",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "krb5 native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BISON_PREFIX:-}" || ! -x "${BISON_PREFIX:-}/bin/bison" ]]; then
  echo "BISON_PREFIX must name the Bazel-built bison prefix" >&2
  exit 2
fi
if [[ -z "${DIFFUTILS_PREFIX:-}" || ! -x "${DIFFUTILS_PREFIX:-}/bin/diff" || ! -x "${DIFFUTILS_PREFIX:-}/bin/cmp" ]]; then
  echo "DIFFUTILS_PREFIX must name the Bazel-built diffutils prefix" >&2
  exit 2
fi
if [[ -z "${FINDUTILS_PREFIX:-}" || ! -x "${FINDUTILS_PREFIX:-}/bin/find" || ! -x "${FINDUTILS_PREFIX:-}/bin/xargs" ]]; then
  echo "FINDUTILS_PREFIX must name the Bazel-built findutils prefix" >&2
  exit 2
fi
if [[ -z "${GETTEXT_PREFIX:-}" || ! -x "${GETTEXT_PREFIX:-}/bin/msgfmt" || ! -f "${GETTEXT_PREFIX:-}/share/gettext/gettext.h" ]]; then
  echo "GETTEXT_PREFIX must name the Bazel-built gettext prefix" >&2
  exit 2
fi
if [[ -z "${LIBEDIT_PREFIX:-}" || ! -f "${LIBEDIT_PREFIX:-}/include/editline/readline.h" ]]; then
  echo "LIBEDIT_PREFIX must name the Bazel-built libedit prefix" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -d "${NCURSES_PREFIX:-}/lib" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi
if [[ -z "${OPENSSL_PREFIX:-}" || ! -f "${OPENSSL_PREFIX:-}/include/openssl/ssl.h" ]]; then
  echo "OPENSSL_PREFIX must name the Bazel-built OpenSSL prefix" >&2
  exit 2
fi
if [[ -z "${PERL_PREFIX:-}" || ! -x "${PERL_PREFIX:-}/bin/perl" ]]; then
  echo "PERL_PREFIX must name the Bazel-built Perl prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi

openssl_libdir="$OPENSSL_PREFIX/lib64"
if [[ ! -d "$openssl_libdir" ]]; then
  openssl_libdir="$OPENSSL_PREFIX/lib"
fi
for path in "$GETTEXT_PREFIX/lib/libgettextpo.so" "$LIBEDIT_PREFIX/lib/libedit.so" \
            "$NCURSES_PREFIX/lib/libtinfo.so" "$openssl_libdir/libssl.so" "$openssl_libdir/libcrypto.so"; do
  [[ -e "$path" ]] || { echo "krb5 dependency library missing: $path" >&2; exit 2; }
done

cd "$SRC"

# Mirror Spack's package-level patch for MIT krb5's configure script.
python3 - <<'PY'
from pathlib import Path

path = Path("src/configure")
text = path.read_text()
needle = "void foo1() __attribute__((constructor));"
replacement = "#include <unistd.h>\\nvoid foo1() __attribute__((constructor));"
if replacement not in text:
    path.write_text(text.replace(needle, replacement, 1))
PY

cd src

export PATH="${BISON_PREFIX}/bin:${DIFFUTILS_PREFIX}/bin:${FINDUTILS_PREFIX}/bin:${GETTEXT_PREFIX}/bin:${PERL_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH}"
export BISON="${BISON_PREFIX}/bin/bison"
export YACC="${BISON_PREFIX}/bin/bison -y"
export PERL="${PERL_PREFIX}/bin/perl"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${LIBEDIT_PREFIX}/lib/pkgconfig:${openssl_libdir}/pkgconfig:${GETTEXT_PREFIX}/lib/pkgconfig:${NCURSES_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${GETTEXT_PREFIX}/include -I${LIBEDIT_PREFIX}/include -I${NCURSES_PREFIX}/include -I${NCURSES_PREFIX}/include/ncursesw -I${OPENSSL_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${GETTEXT_PREFIX}/lib -Wl,-rpath,${GETTEXT_PREFIX}/lib -L${LIBEDIT_PREFIX}/lib -Wl,-rpath,${LIBEDIT_PREFIX}/lib -L${NCURSES_PREFIX}/lib -Wl,-rpath,${NCURSES_PREFIX}/lib -L${openssl_libdir} -Wl,-rpath,${openssl_libdir} -Wl,--disable-new-dtags ${LDFLAGS:-}"

./configure \\
  --prefix="$PREFIX" \\
  --without-system-verto \\
  --without-keyutils \\
  --disable-static \\
  CFLAGS="-fcommon"

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives or static libraries for this
# +shared concrete package.
find "$PREFIX" -type f \\( -name '*.la' -o -name '*.a' \\) -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("krb5 native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _krb5_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("krb5 native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bison_prefix = _read_prefix(repository_ctx, attr.bison_prefix_file, "bison")
    diffutils_prefix = _read_prefix(repository_ctx, attr.diffutils_prefix_file, "diffutils")
    findutils_prefix = _read_prefix(repository_ctx, attr.findutils_prefix_file, "findutils")
    gettext_prefix = _read_prefix(repository_ctx, attr.gettext_prefix_file, "gettext")
    libedit_prefix = _read_prefix(repository_ctx, attr.libedit_prefix_file, "libedit")
    ncurses_prefix = _read_prefix(repository_ctx, attr.ncurses_prefix_file, "ncurses")
    openssl_prefix = _read_prefix(repository_ctx, attr.openssl_prefix_file, "openssl")
    perl_prefix = _read_prefix(repository_ctx, attr.perl_prefix_file, "perl")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "BISON_PREFIX": bison_prefix,
            "DIFFUTILS_PREFIX": diffutils_prefix,
            "FINDUTILS_PREFIX": findutils_prefix,
            "GETTEXT_PREFIX": gettext_prefix,
            "LIBEDIT_PREFIX": libedit_prefix,
            "NCURSES_PREFIX": ncurses_prefix,
            "OPENSSL_PREFIX": openssl_prefix,
            "PERL_PREFIX": perl_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("krb5 native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)

    dep_libs = []
    for dep_prefix in (gettext_prefix, libedit_prefix, ncurses_prefix, openssl_prefix):
        dep_lib = "{}/lib64".format(dep_prefix)
        if not repository_ctx.path(dep_lib).exists:
            dep_lib = "{}/lib".format(dep_prefix)
        dep_libs.append(dep_lib)

    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lgssapi_krb5",
        "-lkrb5",
        "-lk5crypto",
        "-lcom_err",
    ]
    for dep_lib in dep_libs:
        linkopts.extend([
            "-L" + dep_lib,
            "-Wl,-rpath," + dep_lib,
        ])
    linkopts.extend(["-lssl", "-lcrypto", "-ledit", "-ltinfo"])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


krb5_native = repository_rule(
    implementation = _krb5_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bison_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "diffutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "findutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gettext_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libedit_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openssl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build MIT Kerberos from source into a Spack-prefix-identical install tree.",
)
