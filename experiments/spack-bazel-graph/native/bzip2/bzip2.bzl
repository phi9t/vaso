"""Native (Bazel-owned) build of bzip2 into a Spack-identical prefix."""

_BUILD_TEMPLATE = """\
# GENERATED by bzip2_native. Native Bazel build of bzip2, prefix-identical to
# the Spack bzip2 install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
JOBS="${MAKE_JOBS:-$(nproc)}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "bzip2 native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

# Spack's patch() replaces the hardcoded gcc in both upstream Makefiles with
# its compiler wrapper. In the Bazel-owned insula, use the selected C compiler.
for mf in Makefile Makefile-libbz2_so; do
  sed -i "s/^CC=gcc$/CC=${CC:-gcc}/" "$mf"
done

# Reproduce Bzip2.install(): shared build first, then the normal static/tool
# build and upstream install.
make -f Makefile-libbz2_so -j"$JOBS"
make -j"$JOBS"
make install PREFIX="$PREFIX"

# Spack installs the shared-linked compressor over the static-linked upstream
# binary, then installs the shared library and soname symlink chain.
install -m 0755 bzip2-shared "$PREFIX/bin/bzip2"
install -m 0644 libbz2.so.1.0.8 "$PREFIX/lib/libbz2.so.1.0.8"
(
  cd "$PREFIX/lib"
  ln -sfn libbz2.so.1.0.8 libbz2.so
  ln -sfn libbz2.so.1.0.8 libbz2.so.1
  ln -sfn libbz2.so.1.0.8 libbz2.so.1.0
)
(
  cd "$PREFIX/bin"
  rm -f bunzip2 bzcat
  ln -s bzip2 bunzip2
  ln -s bzip2 bzcat
)

mkdir -p "$PREFIX/lib/pkgconfig"
cat > "$PREFIX/lib/pkgconfig/bzip2.pc" <<EOF
prefix=$PREFIX
exec_prefix=\\${prefix}/bin
libdir=$PREFIX/lib
includedir=$PREFIX/include

Name: bzip2
Description: a file compression library
Version: 1.0.8
Libs: -L\\${libdir} -lbz2
Cflags: -I\\${includedir}
EOF
"""


def _bzip2_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("bzip2 native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lbz2"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


bzip2_native = repository_rule(
    implementation = _bzip2_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["CC", "MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build bzip2 from source into a Spack-prefix-identical install tree.",
)
