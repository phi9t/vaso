"""Native (Bazel-owned) py-pillow prefix for the torchvision import surface."""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_pillow_native. Native Bazel build of py-pillow, intended to
# support torchvision's Python import path. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-pillow native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${TMPDIR:-}" ]]; then
  echo "py-pillow native build requires TMPDIR from the insula environment" >&2
  exit 2
fi
case "$TMPDIR" in
  /tmp|/tmp/*|/var/tmp|/var/tmp/*)
    echo "py-pillow native build refuses host tmp path: $TMPDIR" >&2
    exit 2
    ;;
esac
mkdir -p "$TMPDIR"
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native python prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || "$PYTHON_ABI" != "3.13" || ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must be 3.13 and match the native python prefix" >&2
  exit 2
fi
if [[ ! -d "$PYTHON_PREFIX/include/python${PYTHON_ABI}" || ! -d "$PYTHON_PREFIX/lib" ]]; then
  echo "PYTHON_PREFIX must provide include/python${PYTHON_ABI} and lib" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi
if [[ -z "${PY_PYBIND11_PREFIX:-}" || ! -d "${PY_PYBIND11_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pybind11" ]]; then
  echo "PY_PYBIND11_PREFIX must name the Bazel-built native py-pybind11 prefix" >&2
  exit 2
fi
if [[ -z "${LIBJPEG_TURBO_PREFIX:-}" || ! -f "${LIBJPEG_TURBO_PREFIX:-}/include/jpeglib.h" ]]; then
  echo "LIBJPEG_TURBO_PREFIX must name the Bazel-built native libjpeg-turbo prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built native zlib-ng prefix" >&2
  exit 2
fi

first_libdir() {
  local prefix="$1"
  shift
  local libdir
  local name
  for libdir in lib lib64; do
    for name in "$@"; do
      if [[ -e "$prefix/$libdir/$name" ]]; then
        printf '%s/%s\\n' "$prefix" "$libdir"
        return 0
      fi
    done
  done
  return 1
}

jpeg_libdir="$(first_libdir "$LIBJPEG_TURBO_PREFIX" libjpeg.so libjpeg.a)" || {
  echo "LIBJPEG_TURBO_PREFIX must provide libjpeg" >&2
  exit 2
}
zlib_libdir="$(first_libdir "$ZLIB_PREFIX" libz.so libz.a)" || {
  echo "ZLIB_PREFIX must provide libz" >&2
  exit 2
}
python_ext_suffix="$("$PYTHON_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import importlib.machinery

print(importlib.machinery.EXTENSION_SUFFIXES[0])
PY
)"

rm -rf "$PREFIX"
build_home="$TMPDIR/py-pillow-home"
pip_cache="$TMPDIR/py-pillow-pip-cache"
mkdir -p "$build_home" "$pip_cache"
export HOME="$build_home"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PYBIND11_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export LD_LIBRARY_PATH="$PYTHON_PREFIX/lib:$jpeg_libdir:$zlib_libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:$PYTHON_PREFIX/bin:/usr/bin:/bin"
export PIP_CACHE_DIR="$pip_cache"
export CFLAGS="-I$LIBJPEG_TURBO_PREFIX/include -I$ZLIB_PREFIX/include -I$PYTHON_PREFIX/include/python${PYTHON_ABI} ${CFLAGS:-}"
export LDFLAGS="-L$jpeg_libdir -Wl,-rpath,$jpeg_libdir -L$zlib_libdir -Wl,-rpath,$zlib_libdir -L$PYTHON_PREFIX/lib -Wl,-rpath,$PYTHON_PREFIX/lib ${LDFLAGS:-}"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --config-settings=platform-guessing=disable \
  --config-settings=jpeg=enable \
  --config-settings=zlib=enable \
  --config-settings=webp=disable \
  --config-settings=tiff=disable \
  --config-settings=freetype=disable \
  --config-settings=raqm=disable \
  --config-settings=lcms=disable \
  --config-settings=jpeg2000=disable \
  --config-settings=imagequant=disable \
  --config-settings=xcb=disable \
  --config-settings=avif=disable \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -d "$site_packages/PIL"
test -f "$site_packages/PIL/__init__.py"
test -f "$site_packages/PIL/Image.py"
test -f "$site_packages/PIL/_imaging${python_ext_suffix}"
test -f "$site_packages/pillow-12.2.0.dist-info/INSTALLER"
test -f "$site_packages/pillow-12.2.0.dist-info/METADATA"
test -f "$site_packages/pillow-12.2.0.dist-info/REQUESTED"
test -f "$site_packages/pillow-12.2.0.dist-info/WHEEL"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-pillow native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_pillow_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-pillow native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    py_pybind11_prefix = _read_prefix(repository_ctx, attr.py_pybind11_prefix_file, "py-pybind11")
    libjpeg_turbo_prefix = _read_prefix(repository_ctx, attr.libjpeg_turbo_prefix_file, "libjpeg-turbo")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")
    prefix = str(repository_ctx.path("prefix"))
    tmpdir = repository_ctx.os.environ.get("TMPDIR", "")

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "LIBJPEG_TURBO_PREFIX": libjpeg_turbo_prefix,
            "PYTHON_ABI": python_abi,
            "PYTHON_PREFIX": python_prefix,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_PYBIND11_PREFIX": py_pybind11_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "TMPDIR": tmpdir,
            "VASO_IN_INSULA": "1",
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("py-pillow native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_pillow_native = repository_rule(
    implementation = _py_pillow_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "libjpeg_turbo_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pybind11_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["TMPDIR", "VASO_IN_INSULA"],
    doc = "Build and install py-pillow@12.2.0 with native JPEG/zlib support for torchvision.",
)
