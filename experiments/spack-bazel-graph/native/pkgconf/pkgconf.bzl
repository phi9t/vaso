"""Native (Bazel-owned) build of pkgconf into a Spack-identical prefix.

pkgconf is an autotools build-time tool and library provider. Migrating it is
the next topological step in the libxml2 build DAG after libiconv.

The rule reproduces Spack's package recipe:

  * configure/make/make install with only --prefix from the release tarball;
  * shared + static libpkgconf;
  * Spack's run_after("install") symlinks for pkg-config and pkg-config.1;
  * deletion of libtool .la metadata recorded in archived-files.
"""

_BUILD_TEMPLATE = """\
# GENERATED by pkgconf_native. Native Bazel build of pkgconf, intended to match
# the Spack pkgconf install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/pkgconf",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "pkgconf native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

# The release tarball already ships configure. Regenerate autotools inputs only
# if a future source archive omits configure; the insula intentionally does not
# depend on a host autoreconf.
if [[ ! -x ./configure && -x ./autogen.sh ]]; then
  ./autogen.sh
elif [[ ! -x ./configure && ( -f configure.ac || -f configure.in ) ]]; then
  autoreconf -vif
fi

if [[ ! -x ./configure ]]; then
  echo "pkgconf source archive did not provide ./configure" >&2
  exit 2
fi

./configure --prefix="$PREFIX"

make -j"${MAKE_JOBS:-$(nproc)}" V=1
make install

# Spack adds pkg-config compatibility symlinks after install.
ln -sf pkgconf "$PREFIX/bin/pkg-config"
if [[ -d "$PREFIX/share/man/man1" && -e "$PREFIX/share/man/man1/pkgconf.1" ]]; then
  ln -sf pkgconf.1 "$PREFIX/share/man/man1/pkg-config.1"
fi

# Spack removes libtool archives after installation.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _pkgconf_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("pkgconf native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lpkgconf"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


pkgconf_native = repository_rule(
    implementation = _pkgconf_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build pkgconf from source into a Spack-prefix-identical tree.",
)
