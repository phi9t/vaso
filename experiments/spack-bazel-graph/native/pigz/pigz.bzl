"""Native (Bazel-owned) build of pigz into a Spack-identical prefix."""

_BUILD_TEMPLATE = """\
# GENERATED by pigz_native. Native Bazel build of pigz, prefix-identical to the
# Spack pigz install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# pigz is an executable-only node in this graph. It exposes no public C ABI, but
# @spack_pigz//:lib must remain a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
JOBS="${MAKE_JOBS:-$(nproc)}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "pigz native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -d "${ZLIB_PREFIX:-}/lib" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

cd "$SRC"

# Spack's Pigz.build() is just:
#   make CC=cc 'CFLAGS=-O3 -Wall'
# Thread the native zlib-ng prefix through the same Makefile variables while
# preserving those exact compiler flags.
make -j"$JOBS" \
  CC="${CC:-cc}" \
  "CFLAGS=-O3 -Wall -I${ZLIB_PREFIX}/include" \
  "LDFLAGS=-L${ZLIB_PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib" \
  "LIBS=-lm -lpthread -lz"

mkdir -p "$PREFIX/bin" "$PREFIX/man/man1"
install -m 0755 pigz "$PREFIX/bin/pigz"
install -m 0644 pigz.1 "$PREFIX/man/man1/pigz.1"
"""

def _read_prefix(repository_ctx, label):
    path = repository_ctx.path(label)
    return repository_ctx.read(path).strip()

def _pigz_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file)
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("pigz native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)

pigz_native = repository_rule(
    implementation = _pigz_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["CC", "MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build pigz from source into a Spack-prefix-identical install tree.",
)
