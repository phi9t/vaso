"""Native (Bazel-owned) py-pyparsing prefix.

The hermetic Spack v1.2.2 py-pyparsing@3.3.2 recipe is a PythonPackage that
runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

Spack supplies pip, wheel, and the build backend py-flit-core through already
installed Python prefixes on PYTHONPATH. This rule reproduces that dependency
channel with Bazel-native prefix markers and must run inside the sealed insula.
"""

_BUILD_TEMPLATE = """\
# GENERATED by py_pyparsing_native. Native Bazel build of py-pyparsing,
# intended to match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-pyparsing is a pure Python package prefix. It has no C link surface, but
# @spack_py_pyparsing//:lib must remain a valid provider target after migration
# for unmigrated Python package consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-pyparsing native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python3.14/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python3.14/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi
if [[ -z "${PY_FLIT_CORE_PREFIX:-}" || ! -d "${PY_FLIT_CORE_PREFIX:-}/lib/python3.14/site-packages/flit_core" ]]; then
  echo "PY_FLIT_CORE_PREFIX must name the Bazel-built native py-flit-core prefix" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python3.14/site-packages:$PY_WHEEL_PREFIX/lib/python3.14/site-packages:$PY_FLIT_CORE_PREFIX/lib/python3.14/site-packages:$PYTHON_VENV_PREFIX/lib/python3.14/site-packages"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python3.14/site-packages"
test -d "$site_packages/pyparsing"
test -f "$site_packages/pyparsing/__init__.py"
test -f "$site_packages/pyparsing/actions.py"
test -f "$site_packages/pyparsing/common.py"
test -f "$site_packages/pyparsing/core.py"
test -f "$site_packages/pyparsing/exceptions.py"
test -f "$site_packages/pyparsing/helpers.py"
test -f "$site_packages/pyparsing/results.py"
test -f "$site_packages/pyparsing/testing.py"
test -f "$site_packages/pyparsing/unicode.py"
test -f "$site_packages/pyparsing/util.py"
test -f "$site_packages/pyparsing/warnings.py"
test -f "$site_packages/pyparsing/ai/__init__.py"
test -f "$site_packages/pyparsing/ai/best_practices.md"
test -f "$site_packages/pyparsing/diagram/__init__.py"
test -f "$site_packages/pyparsing/tools/__init__.py"
test -f "$site_packages/pyparsing/tools/cvt_pyparsing_pep8_names.py"
test -f "$site_packages/pyparsing/py.typed"
test -f "$site_packages/pyparsing-3.3.2.dist-info/INSTALLER"
test -f "$site_packages/pyparsing-3.3.2.dist-info/METADATA"
test -f "$site_packages/pyparsing-3.3.2.dist-info/REQUESTED"
test -f "$site_packages/pyparsing-3.3.2.dist-info/WHEEL"
test -f "$site_packages/pyparsing-3.3.2.dist-info/licenses/LICENSE"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-pyparsing native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_pyparsing_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-pyparsing native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    py_flit_core_prefix = _read_prefix(repository_ctx, attr.py_flit_core_prefix_file, "py-flit-core")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "PY_FLIT_CORE_PREFIX": py_flit_core_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-pyparsing native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_pyparsing_native = repository_rule(
    implementation = _py_pyparsing_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_flit_core_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-pyparsing@3.3.2 from its PyPI source archive into a Spack-prefix-identical tree.",
)
