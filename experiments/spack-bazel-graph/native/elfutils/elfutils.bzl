"""Native (Bazel-owned) build of elfutils into a Spack-identical prefix.

The lean PyTorch frontier captures elfutils@0.194 as an AutotoolsPackage with
NLS enabled, executable prefixing enabled, and debuginfod disabled. The native
rule mirrors the hermetic Spack recipe and consumes dependency prefixes only
through Bazel-built `prefix_path.txt` inputs.
"""

_BUILD_TEMPLATE = """\
# GENERATED by elfutils_native. Native Bazel build of elfutils, intended to
# match the Spack elfutils install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/elfutils",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "elfutils native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BZIP2_PREFIX:-}" || ! -f "${BZIP2_PREFIX:-}/include/bzlib.h" || ! -e "${BZIP2_PREFIX:-}/lib/libbz2.so" ]]; then
  echo "BZIP2_PREFIX must name the Bazel-built bzip2 prefix" >&2
  exit 2
fi
if [[ -z "${GETTEXT_PREFIX:-}" || ! -x "${GETTEXT_PREFIX:-}/bin/msgfmt" ]]; then
  echo "GETTEXT_PREFIX must name the Bazel-built gettext prefix" >&2
  exit 2
fi
if [[ -z "${LIBICONV_PREFIX:-}" || ! -f "${LIBICONV_PREFIX:-}/include/iconv.h" || ! -e "${LIBICONV_PREFIX:-}/lib/libiconv.so" ]]; then
  echo "LIBICONV_PREFIX must name the Bazel-built libiconv prefix" >&2
  exit 2
fi
if [[ -z "${M4_PREFIX:-}" || ! -x "${M4_PREFIX:-}/bin/m4" ]]; then
  echo "M4_PREFIX must name the Bazel-built m4 prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${XZ_PREFIX:-}" || ! -f "${XZ_PREFIX:-}/include/lzma.h" || ! -e "${XZ_PREFIX:-}/lib/liblzma.so" ]]; then
  echo "XZ_PREFIX must name the Bazel-built xz prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi
if [[ -z "${ZSTD_PREFIX:-}" || ! -f "${ZSTD_PREFIX:-}/include/zstd.h" || ! -e "${ZSTD_PREFIX:-}/lib/libzstd.so" ]]; then
  echo "ZSTD_PREFIX must name the Bazel-built zstd prefix" >&2
  exit 2
fi

cd "$SRC"

# Spack's patch() removes -Werror from generated Makefile.in files.
python3 - <<'PY'
from pathlib import Path
for path in Path(".").glob("*/Makefile.in"):
    text = path.read_text()
    path.write_text(text.replace("-Werror", ""))
PY

mkdir -p spack-build
cd spack-build

bzip2_libdir="$BZIP2_PREFIX/lib"
libiconv_libdir="$LIBICONV_PREFIX/lib"
xz_libdir="$XZ_PREFIX/lib"
zlib_libdir="$ZLIB_PREFIX/lib"
zstd_libdir="$ZSTD_PREFIX/lib"
dep_rpath="${PREFIX}/lib:${zstd_libdir}:${xz_libdir}:${bzip2_libdir}:${zlib_libdir}:${libiconv_libdir}"

export PATH="${GETTEXT_PREFIX}/bin:${M4_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH}"
export M4="${M4_PREFIX}/bin/m4"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${ZLIB_PREFIX}/lib/pkgconfig:${XZ_PREFIX}/lib/pkgconfig:${ZSTD_PREFIX}/lib/pkgconfig:${LIBICONV_PREFIX}/lib/pkgconfig:${GETTEXT_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
export CPPFLAGS="-I${ZSTD_PREFIX}/include -I${XZ_PREFIX}/include -I${BZIP2_PREFIX}/include -I${ZLIB_PREFIX}/include -I${LIBICONV_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 -march=icelake-client -mtune=icelake-client ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 -march=icelake-client -mtune=icelake-client ${CXXFLAGS:-}"
export LDFLAGS="-L${zstd_libdir} -L${xz_libdir} -L${bzip2_libdir} -L${zlib_libdir} -L${libiconv_libdir} -Wl,-rpath,${dep_rpath} -Wl,--disable-new-dtags ${LDFLAGS:-}"

../configure \\
  --prefix="$PREFIX" \\
  "--with-bzlib=${BZIP2_PREFIX}" \\
  "--with-lzma=${XZ_PREFIX}" \\
  "--with-zlib=${ZLIB_PREFIX}" \\
  "--program-prefix=eu-" \\
  "--with-zstd=${ZSTD_PREFIX}" \\
  "--with-libiconv-prefix=${LIBICONV_PREFIX}" \\
  --without-libintl-prefix \\
  --disable-debuginfod \\
  --disable-libdebuginfod \\
  --disable-debuginfod-ima-verification

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's recipe installs libelf/elf.h at prefix/include/elf.h.
if [[ ! -f "$PREFIX/include/elf.h" && -f "$SRC/libelf/elf.h" ]]; then
  cp "$SRC/libelf/elf.h" "$PREFIX/include/elf.h"
fi

# Match the Spack prefix surface by dropping libtool archive metadata.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("elfutils native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _elfutils_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("elfutils native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    gettext_prefix = _read_prefix(repository_ctx, attr.gettext_prefix_file, "gettext")
    libiconv_prefix = _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv")
    m4_prefix = _read_prefix(repository_ctx, attr.m4_prefix_file, "m4")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    xz_prefix = _read_prefix(repository_ctx, attr.xz_prefix_file, "xz")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")
    zstd_prefix = _read_prefix(repository_ctx, attr.zstd_prefix_file, "zstd")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "BZIP2_PREFIX": bzip2_prefix,
            "GETTEXT_PREFIX": gettext_prefix,
            "LIBICONV_PREFIX": libiconv_prefix,
            "M4_PREFIX": m4_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "VASO_IN_INSULA": "1",
            "XZ_PREFIX": xz_prefix,
            "ZLIB_PREFIX": zlib_prefix,
            "ZSTD_PREFIX": zstd_prefix,
        },
    )
    if res.return_code != 0:
        fail("elfutils native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    dep_libs = [
        "{}/lib".format(zstd_prefix),
        "{}/lib".format(xz_prefix),
        "{}/lib".format(bzip2_prefix),
        "{}/lib".format(zlib_prefix),
        "{}/lib".format(libiconv_prefix),
    ]
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lasm",
        "-ldw",
        "-lelf",
    ]
    for dep_lib in dep_libs:
        linkopts.extend(["-L" + dep_lib, "-Wl,-rpath," + dep_lib])
    linkopts.extend(["-lzstd", "-llzma", "-lbz2", "-lz", "-liconv"])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


elfutils_native = repository_rule(
    implementation = _elfutils_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gettext_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "m4_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zstd_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build elfutils from source into a Spack-prefix-identical tree.",
)
