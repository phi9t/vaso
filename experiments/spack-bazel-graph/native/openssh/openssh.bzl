"""Native (Bazel-owned) build of OpenSSH into a Spack-identical prefix.

The lean PyTorch frontier captures openssh@10.3p1 as an AutotoolsPackage after
numactl. The hermetic Spack recipe patches Makefile.in/configure, configures
GSSAPI support against krb5, then builds with make and runs a serial install.
"""

_BUILD_TEMPLATE = """\
# GENERATED by openssh_native. Native Bazel build of OpenSSH, intended to match
# the Spack openssh install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# OpenSSH is an executable/config prefix in this graph. It exposes no public C
# ABI, but @spack_openssh//:lib must remain a valid provider target after a
# native provider flip.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "openssh native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${KRB5_PREFIX:-}" || ! -f "${KRB5_PREFIX:-}/include/krb5.h" || ! -e "${KRB5_PREFIX:-}/lib/libkrb5.so" ]]; then
  echo "KRB5_PREFIX must name the Bazel-built krb5 prefix" >&2
  exit 2
fi
if [[ -z "${LIBEDIT_PREFIX:-}" || ! -f "${LIBEDIT_PREFIX:-}/include/editline/readline.h" || ! -e "${LIBEDIT_PREFIX:-}/lib/libedit.so" ]]; then
  echo "LIBEDIT_PREFIX must name the Bazel-built libedit prefix" >&2
  exit 2
fi
if [[ -z "${LIBXCRYPT_PREFIX:-}" || ! -f "${LIBXCRYPT_PREFIX:-}/include/crypt.h" || ! -e "${LIBXCRYPT_PREFIX:-}/lib/libcrypt.so" ]]; then
  echo "LIBXCRYPT_PREFIX must name the Bazel-built libxcrypt prefix" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -d "${NCURSES_PREFIX:-}/include" || ! -e "${NCURSES_PREFIX:-}/lib/libtinfo.so" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi
if [[ -z "${OPENSSL_PREFIX:-}" || ! -f "${OPENSSL_PREFIX:-}/include/openssl/ssl.h" ]]; then
  echo "OPENSSL_PREFIX must name the Bazel-built OpenSSL prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

openssl_libdir="$OPENSSL_PREFIX/lib64"
if [[ ! -d "$openssl_libdir" ]]; then
  openssl_libdir="$OPENSSL_PREFIX/lib"
fi
for path in \
  "$KRB5_PREFIX/lib/libgssapi_krb5.so" \
  "$KRB5_PREFIX/lib/libkrb5.so" \
  "$LIBEDIT_PREFIX/lib/libedit.so" \
  "$LIBXCRYPT_PREFIX/lib/libcrypt.so" \
  "$NCURSES_PREFIX/lib/libtinfo.so" \
  "$openssl_libdir/libcrypto.so" \
  "$ZLIB_PREFIX/lib/libz.so"; do
  [[ -e "$path" ]] || { echo "openssh dependency library missing: $path" >&2; exit 2; }
done

cd "$SRC"

# Mirror Spack's package-level patching.
python3 - <<'PY'
from pathlib import Path

makefile = Path("Makefile.in")
text = makefile.read_text()
text = text.replace("$(INSTALL) -m 4711", "$(INSTALL) -m711")
makefile.write_text(text)

configure = Path("configure")
text = configure.read_text()
text = text.replace("if (n != 3 && n != 4)", "if (n < 2)")
configure.write_text(text)
PY

dep_libs=(
  "$KRB5_PREFIX/lib"
  "$LIBEDIT_PREFIX/lib"
  "$LIBXCRYPT_PREFIX/lib"
  "$NCURSES_PREFIX/lib"
  "$openssl_libdir"
  "$ZLIB_PREFIX/lib"
)
dep_includes=(
  "$KRB5_PREFIX/include"
  "$LIBEDIT_PREFIX/include"
  "$LIBXCRYPT_PREFIX/include"
  "$NCURSES_PREFIX/include"
  "$NCURSES_PREFIX/include/ncursesw"
  "$OPENSSL_PREFIX/include"
  "$ZLIB_PREFIX/include"
)

cppflags=()
for include in "${dep_includes[@]}"; do
  cppflags+=("-I$include")
done
ldflags=()
for lib in "${dep_libs[@]}"; do
  ldflags+=("-L$lib" "-Wl,-rpath,$lib")
done
ldflags+=("-Wl,--disable-new-dtags")

export CPPFLAGS="${cppflags[*]} ${CPPFLAGS:-}"
export LDFLAGS="${ldflags[*]} ${LDFLAGS:-}"
export LD_RUN_PATH="$(IFS=:; echo "${dep_libs[*]}")"

./configure \
  --prefix="$PREFIX" \
  --with-privsep-path="$PREFIX/var/empty" \
  --with-kerberos5="$KRB5_PREFIX" \
  --with-ssl-dir="$OPENSSL_PREFIX" \
  --with-zlib="$ZLIB_PREFIX"

make V=1 -j"${MAKE_JOBS:-$(nproc)}"

# Spack's install() is serial because generated config files race.
make install

find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("openssh native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _openssh_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("openssh native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    krb5_prefix = _read_prefix(repository_ctx, attr.krb5_prefix_file, "krb5")
    libedit_prefix = _read_prefix(repository_ctx, attr.libedit_prefix_file, "libedit")
    libxcrypt_prefix = _read_prefix(repository_ctx, attr.libxcrypt_prefix_file, "libxcrypt")
    ncurses_prefix = _read_prefix(repository_ctx, attr.ncurses_prefix_file, "ncurses")
    openssl_prefix = _read_prefix(repository_ctx, attr.openssl_prefix_file, "openssl")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "KRB5_PREFIX": krb5_prefix,
            "LIBEDIT_PREFIX": libedit_prefix,
            "LIBXCRYPT_PREFIX": libxcrypt_prefix,
            "NCURSES_PREFIX": ncurses_prefix,
            "OPENSSL_PREFIX": openssl_prefix,
            "ZLIB_PREFIX": zlib_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("openssh native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


openssh_native = repository_rule(
    implementation = _openssh_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "krb5_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libedit_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libxcrypt_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openssl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build OpenSSH from source into a Spack-prefix-identical executable/config tree.",
)
