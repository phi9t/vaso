"""Native (Bazel-owned) py-kiwisolver prefix.

The hermetic Spack v1.2.2 py-kiwisolver@1.5.0 recipe is a PythonPackage that
runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

This package builds one C++ CPython extension module. Spack supplies cppy,
pip, setuptools, setuptools-scm, wheel, packaging, git, python, and
python-venv through already-installed prefixes. This rule reproduces that
dependency channel with Bazel-native prefix markers and must run inside the
sealed insula.
"""

_BUILD_TEMPLATE = """\
# GENERATED by py_kiwisolver_native. Native Bazel build of py-kiwisolver,
# intended to match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-kiwisolver exposes a Python package and one CPython extension module.
# Keep @spack_py_kiwisolver//:lib valid for migrated-provider dispatch while
# the runtime surface is carried as data from the generated prefix.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-kiwisolver native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${GIT_PREFIX:-}" || ! -x "${GIT_PREFIX:-}/bin/git" ]]; then
  echo "GIT_PREFIX must name the Bazel-built native git prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3.14" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native python prefix" >&2
  exit 2
fi
if [[ ! -d "$PYTHON_PREFIX/include/python3.14" || ! -d "$PYTHON_PREFIX/lib" ]]; then
  echo "PYTHON_PREFIX must provide include/python3.14 and lib" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PY_CPPY_PREFIX:-}" || ! -d "${PY_CPPY_PREFIX:-}/lib/python3.14/site-packages/cppy/include" ]]; then
  echo "PY_CPPY_PREFIX must name the Bazel-built native py-cppy prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python3.14/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python3.14/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_SCM_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_SCM_PREFIX:-}/lib/python3.14/site-packages/setuptools_scm" ]]; then
  echo "PY_SETUPTOOLS_SCM_PREFIX must name the Bazel-built native py-setuptools-scm prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python3.14/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi
if [[ -z "${PY_PACKAGING_PREFIX:-}" || ! -d "${PY_PACKAGING_PREFIX:-}/lib/python3.14/site-packages/packaging" ]]; then
  echo "PY_PACKAGING_PREFIX must name the Bazel-built native py-packaging prefix" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python3.14/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python3.14/site-packages:$PY_PACKAGING_PREFIX/lib/python3.14/site-packages:$PY_SETUPTOOLS_SCM_PREFIX/lib/python3.14/site-packages:$PY_WHEEL_PREFIX/lib/python3.14/site-packages:$PY_CPPY_PREFIX/lib/python3.14/site-packages:$PYTHON_VENV_PREFIX/lib/python3.14/site-packages"
export LD_LIBRARY_PATH="$PYTHON_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$GIT_PREFIX/bin:$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:$PYTHON_PREFIX/bin:/usr/bin:/bin"
export CC=/usr/bin/gcc
cat > spack-target-g++ <<'EOF'
#!/usr/bin/env bash
exec /usr/bin/g++ -march=icelake-client -mtune=icelake-client "$@"
EOF
chmod +x spack-target-g++
export CXX="$PWD/spack-target-g++"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \\
  -vvv \\
  --no-input \\
  --no-cache-dir \\
  --disable-pip-version-check \\
  install \\
  --no-deps \\
  --ignore-installed \\
  --no-build-isolation \\
  --no-warn-script-location \\
  --no-index \\
  --prefix="$PREFIX" \\
  .

site_packages="$PREFIX/lib/python3.14/site-packages"
test -d "$site_packages/kiwisolver"
test -f "$site_packages/kiwisolver/__init__.py"
test -f "$site_packages/kiwisolver/_cext.cpython-314-x86_64-linux-gnu.so"
test -f "$site_packages/kiwisolver/_cext.pyi"
test -f "$site_packages/kiwisolver/exceptions.py"
test -f "$site_packages/kiwisolver/py.typed"
test -f "$site_packages/kiwisolver-1.5.0.dist-info/INSTALLER"
test -f "$site_packages/kiwisolver-1.5.0.dist-info/METADATA"
test -f "$site_packages/kiwisolver-1.5.0.dist-info/REQUESTED"
test -f "$site_packages/kiwisolver-1.5.0.dist-info/WHEEL"
test -f "$site_packages/kiwisolver-1.5.0.dist-info/licenses/LICENSE"
test -f "$site_packages/kiwisolver-1.5.0.dist-info/top_level.txt"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-kiwisolver native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_kiwisolver_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-kiwisolver native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    git_prefix = _read_prefix(repository_ctx, attr.git_prefix_file, "git")
    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    py_cppy_prefix = _read_prefix(repository_ctx, attr.py_cppy_prefix_file, "py-cppy")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_setuptools_scm_prefix = _read_prefix(repository_ctx, attr.py_setuptools_scm_prefix_file, "py-setuptools-scm")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    py_packaging_prefix = _read_prefix(repository_ctx, attr.py_packaging_prefix_file, "py-packaging")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 1200,
        quiet = False,
        environment = {
            "GIT_PREFIX": git_prefix,
            "PYTHON_PREFIX": python_prefix,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_CPPY_PREFIX": py_cppy_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_SETUPTOOLS_SCM_PREFIX": py_setuptools_scm_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "PY_PACKAGING_PREFIX": py_packaging_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-kiwisolver native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_kiwisolver_native = repository_rule(
    implementation = _py_kiwisolver_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "git_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_cppy_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_scm_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_packaging_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-kiwisolver@1.5.0 from its PyPI source archive into a Spack-prefix-identical tree.",
)
