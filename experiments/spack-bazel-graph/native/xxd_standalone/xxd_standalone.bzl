"""Native (Bazel-owned) build of xxd-standalone into a Spack-identical prefix.

Spack's xxd-standalone@8.2.1201 recipe builds Vim's bundled xxd with
`make -C src/xxd` and installs only the resulting `bin/xxd` executable.
"""

_BUILD_TEMPLATE = """\
# GENERATED by xxd_standalone_native. Native Bazel build of xxd-standalone,
# intended to match the Spack xxd-standalone install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# xxd-standalone is an executable/tool-prefix node in the JAX graph. It exposes
# no public C ABI, but @spack_xxd_standalone//:lib must remain a valid provider
# target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
JOBS="${MAKE_JOBS:-$(nproc)}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "xxd-standalone native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

# Mirrors Spack's XxdStandalone.build_targets = ["-C", "src/xxd"].
make -C src/xxd -j"$JOBS"

mkdir -p "$PREFIX/bin"
install -m 0755 src/xxd/xxd "$PREFIX/bin/xxd"
"""


def _xxd_standalone_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("xxd-standalone native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


xxd_standalone_native = repository_rule(
    implementation = _xxd_standalone_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build xxd-standalone from Vim's source archive into a Spack-prefix-identical tree.",
)
