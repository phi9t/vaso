"""Native (Bazel-owned) build of libbsd into a Spack-identical prefix.

libbsd is the first Python-DAG frontier node that consumes another migrated
native prefix (`libmd`). The hermetic Spack v1.2.2 recipe is an
AutotoolsPackage with no package-specific configure args for the current
compiler, so the native rule reproduces configure --prefix, make, and make
install while threading the Bazel-built libmd prefix into configure/link.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libbsd_native. Native Bazel build of libbsd, intended to match
# the Spack libbsd install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libbsd native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${LIBMD_PREFIX:-}" || ! -d "${LIBMD_PREFIX:-}/lib" ]]; then
  echo "LIBMD_PREFIX must name the Bazel-built libmd prefix" >&2
  exit 2
fi

cd "$SRC"

export CPPFLAGS="-I${LIBMD_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${LIBMD_PREFIX}/lib -Wl,-rpath,${LIBMD_PREFIX}/lib ${LDFLAGS:-}"

./configure --prefix="$PREFIX"

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _libbsd_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    libmd_prefix = repository_ctx.read(attr.libmd_prefix_file).strip()
    if not libmd_prefix:
        fail("libbsd native build requires a non-empty libmd prefix path")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "LIBMD_PREFIX": libmd_prefix,
        },
    )
    if res.return_code != 0:
        fail("libbsd native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    libmd_lib = "{}/lib".format(libmd_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lbsd",
        "-lbsd-ctor",
        "-L" + libmd_lib,
        "-Wl,-rpath," + libmd_lib,
        "-lmd",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libbsd_native = repository_rule(
    implementation = _libbsd_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "libmd_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libbsd from source into a Spack-prefix-identical tree.",
)
