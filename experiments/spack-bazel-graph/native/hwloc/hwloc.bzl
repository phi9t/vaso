"""Native (Bazel-owned) build of hwloc into a Spack-identical prefix.

The py-torch frontier captures hwloc@2.13.0 as an AutotoolsPackage with
`+pci`, `+libxml2`, `~cuda`, `~nvml`, `~gl`, `~libudev`, `~opencl`, `~rocm`,
`~level_zero`, and `libs=shared,static`. It consumes native libpciaccess,
libxml2, ncurses, and pkgconf prefixes explicitly so configure cannot discover
those dependencies from the host.
"""

_BUILD_TEMPLATE = """\
# GENERATED by hwloc_native. Native Bazel build of hwloc, intended to match the
# Spack hwloc install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/hwloc",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "hwloc native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${LIBPCIACCESS_PREFIX:-}" || ! -f "${LIBPCIACCESS_PREFIX:-}/include/pciaccess.h" || ! -d "${LIBPCIACCESS_PREFIX:-}/lib" ]]; then
  echo "LIBPCIACCESS_PREFIX must name the Bazel-built libpciaccess prefix" >&2
  exit 2
fi
if [[ -z "${LIBXML2_PREFIX:-}" || ! -f "${LIBXML2_PREFIX:-}/include/libxml2/libxml/parser.h" || ! -d "${LIBXML2_PREFIX:-}/lib" ]]; then
  echo "LIBXML2_PREFIX must name the Bazel-built libxml2 prefix" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -f "${NCURSES_PREFIX:-}/include/term.h" || ! -d "${NCURSES_PREFIX:-}/lib" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi

cd "$SRC"

export PATH="${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${LIBPCIACCESS_PREFIX}/lib/pkgconfig:${LIBXML2_PREFIX}/lib/pkgconfig:${NCURSES_PREFIX}/lib/pkgconfig:${PKGCONF_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${LIBPCIACCESS_PREFIX}/include -I${LIBXML2_PREFIX}/include/libxml2 -I${NCURSES_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${LIBPCIACCESS_PREFIX}/lib -L${LIBXML2_PREFIX}/lib -L${NCURSES_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,-rpath,${LIBPCIACCESS_PREFIX}/lib -Wl,-rpath,${LIBXML2_PREFIX}/lib -Wl,-rpath,${NCURSES_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LIBS="-ltinfo ${LIBS:-}"

./configure \\
  --prefix="$PREFIX" \\
  --disable-cairo \\
  --disable-nvml \\
  --disable-gl \\
  --disable-cuda \\
  --enable-libxml2 \\
  --disable-libudev \\
  --enable-pci \\
  --enable-shared \\
  --enable-static \\
  --disable-levelzero \\
  --disable-opencl \\
  --disable-rsmi

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("hwloc native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _hwloc_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("hwloc native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.download(
        url = attr.patch_urls,
        sha256 = attr.patch_sha256,
        output = "hwloc-f7f1f765.patch",
    )
    patch = repository_ctx.execute(
        ["patch", "-p1", "-i", str(repository_ctx.path("hwloc-f7f1f765.patch"))],
        working_directory = str(repository_ctx.path("src")),
        timeout = 120,
        quiet = False,
    )
    if patch.return_code != 0:
        fail("hwloc patch failed (rc={}):\n{}\n{}".format(
            patch.return_code,
            patch.stdout,
            patch.stderr,
        ))

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    libpciaccess_prefix = _read_prefix(
        repository_ctx,
        attr.libpciaccess_prefix_file,
        "libpciaccess",
    )
    libxml2_prefix = _read_prefix(repository_ctx, attr.libxml2_prefix_file, "libxml2")
    ncurses_prefix = _read_prefix(repository_ctx, attr.ncurses_prefix_file, "ncurses")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "LIBPCIACCESS_PREFIX": libpciaccess_prefix,
            "LIBXML2_PREFIX": libxml2_prefix,
            "NCURSES_PREFIX": ncurses_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
        },
    )
    if res.return_code != 0:
        fail("hwloc native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    dep_libs = [
        "{}/lib".format(libpciaccess_prefix),
        "{}/lib".format(libxml2_prefix),
        "{}/lib".format(ncurses_prefix),
    ]
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lhwloc",
    ]
    for dep_lib in dep_libs:
        linkopts.extend(["-L" + dep_lib, "-Wl,-rpath," + dep_lib])
    linkopts.extend(["-lpciaccess", "-lxml2", "-lm", "-ltinfo"])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


hwloc_native = repository_rule(
    implementation = _hwloc_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "patch_urls": attr.string_list(mandatory = True),
        "patch_sha256": attr.string(mandatory = True),
        "libpciaccess_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libxml2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build hwloc from source into a Spack-prefix-identical install tree.",
)
