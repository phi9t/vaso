"""Native (Bazel-owned) build of GNU libunistring into a Spack-identical prefix.

The py-torch frontier captures libunistring@1.4.2 as an AutotoolsPackage with a
build+link dependency on libiconv. This rule mirrors the Spack configure/make
pipeline while sourcing libiconv only from a Bazel-owned prefix marker.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libunistring_native. Native Bazel build of GNU libunistring,
# intended to match the Spack libunistring install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libunistring native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${LIBICONV_PREFIX:-}" || ! -d "${LIBICONV_PREFIX:-}/lib" || ! -f "${LIBICONV_PREFIX:-}/include/iconv.h" ]]; then
  echo "LIBICONV_PREFIX must name the Bazel-built libiconv prefix" >&2
  exit 2
fi

cd "$SRC"

export CPPFLAGS="-I${LIBICONV_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${LIBICONV_PREFIX}/lib -Wl,-rpath,${LIBICONV_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LIBS="-liconv ${LIBS:-}"

./configure \\
  --prefix="$PREFIX" \\
  --enable-shared \\
  --enable-static \\
  "--with-libiconv-prefix=${LIBICONV_PREFIX}"

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack removes libtool archives from the emitted prefix.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libunistring native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libunistring_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    libiconv_prefix = _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 2400,
        quiet = False,
        environment = {
            "LIBICONV_PREFIX": libiconv_prefix,
        },
    )
    if res.return_code != 0:
        fail("libunistring native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    libiconv_lib = "{}/lib".format(libiconv_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lunistring",
        "-L" + libiconv_lib,
        "-Wl,-rpath," + libiconv_lib,
        "-liconv",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libunistring_native = repository_rule(
    implementation = _libunistring_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU libunistring from source into a Spack-prefix-identical tree.",
)
