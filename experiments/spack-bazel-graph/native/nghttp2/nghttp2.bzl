"""Native (Bazel-owned) build of nghttp2 into a Spack-identical prefix.

The hermetic Spack v1.2.2 nghttp2@1.67.1 recipe is an AutotoolsPackage that
builds only libnghttp2 and disables every optional dependency discovery path.
This rule consumes the native diffutils and pkgconf tool prefixes explicitly so
the Autotools build cannot fall back to host tools.
"""

_BUILD_TEMPLATE = """\
# GENERATED by nghttp2_native. Native Bazel build of nghttp2, intended to match
# the Spack nghttp2 install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/nghttp2",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "nghttp2 native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${DIFFUTILS_PREFIX:-}" || ! -x "${DIFFUTILS_PREFIX:-}/bin/diff" ]]; then
  echo "DIFFUTILS_PREFIX must name the Bazel-built diffutils prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi

cd "$SRC"

export PATH="${DIFFUTILS_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH=
export LDFLAGS="-Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"

./configure \\
  --prefix="$PREFIX" \\
  --enable-lib-only \\
  --with-libxml2=no \\
  --with-jansson=no \\
  --with-zlib=no \\
  --with-libevent-openssl=no \\
  --with-libcares=no \\
  --with-openssl=no \\
  --with-libev=no \\
  --with-cunit=no \\
  --with-jemalloc=no \\
  --with-systemd=no \\
  --with-mruby=no \\
  --with-neverbleed=no \\
  --with-boost=no \\
  --with-wolfssl=no

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _nghttp2_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    diffutils_prefix = repository_ctx.read(attr.diffutils_prefix_file).strip()
    if not diffutils_prefix:
        fail("nghttp2 native build requires a non-empty diffutils prefix path")
    pkgconf_prefix = repository_ctx.read(attr.pkgconf_prefix_file).strip()
    if not pkgconf_prefix:
        fail("nghttp2 native build requires a non-empty pkgconf prefix path")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "DIFFUTILS_PREFIX": diffutils_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
        },
    )
    if res.return_code != 0:
        fail("nghttp2 native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lnghttp2"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


nghttp2_native = repository_rule(
    implementation = _nghttp2_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "diffutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build nghttp2 from source into a Spack-prefix-identical tree.",
)
