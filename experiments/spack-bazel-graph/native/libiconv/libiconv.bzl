"""Native (Bazel-owned) build of GNU libiconv into a Spack-identical prefix.

libiconv is an autotools package that provides `libiconv` and `libcharset`.
It is a dependency of real consumer nodes like libxml2 on this host.

The native build emits `prefix/` matching the Spack hermetic install tree and
exposes `@libiconv_native//:lib` as a cc_library over that prefix.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libiconv_native. Native Bazel build of libiconv, intended to
# match the Spack libiconv install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"      # extracted source dir
PREFIX="$2"   # install prefix (absolute)

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libiconv native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

./configure \\
  --prefix="$PREFIX" \\
  --enable-shared \\
  --enable-static

make -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's libiconv prefix does not ship libtool .la files.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _libiconv_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
    )
    if res.return_code != 0:
        fail("libiconv native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-liconv",
        "-lcharset",
    ]

    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )
    repository_ctx.file("prefix_path.txt", prefix + "\n")


libiconv_native = repository_rule(
    implementation = _libiconv_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU libiconv from source into a Spack-prefix-identical tree.",
)
