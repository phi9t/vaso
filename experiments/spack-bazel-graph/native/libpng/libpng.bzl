"""Native (Bazel-owned) build of libpng into a Spack-identical prefix.

The hermetic Spack v1.2.2 libpng@1.6.58 recipe is a CMakePackage. The concrete
py-torch frontier variant builds shared+static libpng16, leaves PIC disabled,
and consumes zlib-ng through explicit CMake cache variables.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libpng_native. Native Bazel build of libpng, intended to match
# the Spack libpng install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/libpng16",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libpng native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-built CMake prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

CMAKE="$CMAKE_PREFIX/bin/cmake"
ZLIB_LIB="$ZLIB_PREFIX/lib/libz.so"
if [[ ! -e "$ZLIB_LIB" ]]; then
  echo "libpng dependency library missing: $ZLIB_LIB" >&2
  exit 2
fi

BUILD="$(mktemp -d)"
cd "$BUILD"

export PATH="${CMAKE_PREFIX}/bin:${PATH}"
export CMAKE_PREFIX_PATH="${CMAKE_PREFIX};${ZLIB_PREFIX}"
export CMAKE_LIBRARY_PATH="${ZLIB_PREFIX}/lib"
export CMAKE_INCLUDE_PATH="${ZLIB_PREFIX}/include"
export LD_LIBRARY_PATH="${ZLIB_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export CC="${CC:-gcc}"
export CXX="${CXX:-g++}"

"$CMAKE" -G "Unix Makefiles" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  -DCMAKE_INSTALL_RPATH_USE_LINK_PATH:BOOL=ON \
  "-DCMAKE_INSTALL_RPATH:STRING=${PREFIX}/lib;${PREFIX}/lib64;${ZLIB_PREFIX}/lib" \
  "-DCMAKE_PREFIX_PATH:STRING=${CMAKE_PREFIX};${ZLIB_PREFIX}" \
  "-DCMAKE_LIBRARY_PATH:STRING=${ZLIB_PREFIX}/lib" \
  "-DCMAKE_INCLUDE_PATH:STRING=${ZLIB_PREFIX}/include" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_VERBOSE_MAKEFILE:BOOL=ON \
  -DCMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF \
  -DCMAKE_POLICY_DEFAULT_CMP0090:STRING=NEW \
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF \
  -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=ON \
  "-DCMAKE_CXX_FLAGS:STRING=-I${ZLIB_PREFIX}/include" \
  "-DZLIB_ROOT:STRING=${ZLIB_PREFIX}" \
  "-DZLIB_LIBRARY:STRING=${ZLIB_LIB}" \
  -DPNG_SHARED:BOOL=ON \
  -DPNG_STATIC:BOOL=ON \
  -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=OFF \
  "$SRC"
make -j"${MAKE_JOBS:-$(nproc)}"
make install
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libpng native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libpng_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libpng native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 2400,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "VASO_IN_INSULA": "1",
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("libpng native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    zlib_lib = "{}/lib".format(zlib_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lpng16",
        "-L" + zlib_lib,
        "-Wl,-rpath," + zlib_lib,
        "-lz",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libpng_native = repository_rule(
    implementation = _libpng_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libpng from source into a Spack-prefix-identical install tree.",
)
