"""Native (Bazel-owned) py-scipy prefix.

Hermetic Spack v1.2.2 resolves the JAX 0.10.2 dependency closure's SciPy node
as py-scipy@1.17.1 built by PythonPackage/pip with meson-python:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> \
        --config-settings=builddir=build \
        --config-settings=setup-args=-Dfortran_std=legacy \
        --config-settings=setup-args=-Dblas=openblas \
        --config-settings=setup-args=-Dlapack=openblas .

Spack gets BLAS/LAPACK from NumPy's OpenBLAS choice and uses gcc/g++/gfortran
from the rootfs. This rule reproduces that path with explicit Bazel-native
prefix markers and must run inside the sealed CUDA insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_scipy_native. Native Bazel build of py-scipy, intended to
# match the concrete Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-scipy exposes Python modules and CPython extension modules. The runtime
# surface is carried as data from the generated prefix so @spack_py_scipy//:lib
# remains a valid provider target after migration.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-scipy native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
for var in MESON_PREFIX NINJA_PREFIX OPENBLAS_PREFIX PKGCONF_PREFIX PY_BENIGET_PREFIX PY_CYTHON_PREFIX PY_GAST_PREFIX PY_MESON_PYTHON_PREFIX PY_NUMPY_PREFIX PY_PACKAGING_PREFIX PY_PIP_PREFIX PY_PLY_PREFIX PY_PYBIND11_PREFIX PY_PYPROJECT_METADATA_PREFIX PY_PYTHRAN_PREFIX PY_WHEEL_PREFIX PYTHON_PREFIX PYTHON_VENV_PREFIX TMPDIR; do
  if [[ -z "${!var:-}" || ! -d "${!var}" ]]; then
    echo "$var must name a Bazel/hermetic dependency prefix" >&2
    exit 2
  fi
done
if [[ -z "${PYTHON_ABI:-}" || ! -x "$PYTHON_PREFIX/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python prefix" >&2
  exit 2
fi
if [[ ! -x "$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -x "$MESON_PREFIX/bin/meson" ]]; then
  echo "missing Meson binary" >&2
  exit 2
fi
if [[ -x "$NINJA_PREFIX/bin/ninja" ]]; then
  NINJA_BIN="$NINJA_PREFIX/bin/ninja"
elif [[ -x "$NINJA_PREFIX/bin/ninja-build" ]]; then
  NINJA_BIN="$NINJA_PREFIX/bin/ninja-build"
else
  echo "missing Ninja binary" >&2
  exit 2
fi
if [[ -x "$PKGCONF_PREFIX/bin/pkgconf" ]]; then
  PKG_CONFIG_BIN="$PKGCONF_PREFIX/bin/pkgconf"
elif [[ -x "$PKGCONF_PREFIX/bin/pkg-config" ]]; then
  PKG_CONFIG_BIN="$PKGCONF_PREFIX/bin/pkg-config"
else
  echo "missing pkgconf/pkg-config binary" >&2
  exit 2
fi
if [[ ! -x /usr/bin/gfortran ]]; then
  echo "rootfs gfortran is required for py-scipy" >&2
  exit 2
fi

python_include="$PYTHON_PREFIX/include/python${PYTHON_ABI}"
python_libdir="$PYTHON_PREFIX/lib"
if [[ ! -f "$python_include/Python.h" || ! -d "$python_libdir" ]]; then
  echo "PYTHON_PREFIX must provide Python.h and lib for ABI ${PYTHON_ABI}" >&2
  exit 2
fi
ext_suffix="$("$PYTHON_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import sysconfig
print(sysconfig.get_config_var("EXT_SUFFIX") or "")
PY
)"
if [[ -z "$ext_suffix" ]]; then
  echo "native python did not report EXT_SUFFIX" >&2
  exit 2
fi

require_site_package() {
  local prefix="$1"
  local module="$2"
  if [[ ! -d "$prefix/lib/python${PYTHON_ABI}/site-packages/$module" ]]; then
    echo "missing $module for Python ${PYTHON_ABI}" >&2
    exit 2
  fi
}
require_site_package "$MESON_PREFIX" mesonbuild
require_site_package "$PY_BENIGET_PREFIX" beniget
require_site_package "$PY_CYTHON_PREFIX" Cython
require_site_package "$PY_GAST_PREFIX" gast
require_site_package "$PY_MESON_PYTHON_PREFIX" mesonpy
require_site_package "$PY_NUMPY_PREFIX" numpy
require_site_package "$PY_PACKAGING_PREFIX" packaging
require_site_package "$PY_PIP_PREFIX" pip
require_site_package "$PY_PLY_PREFIX" ply
require_site_package "$PY_PYBIND11_PREFIX" pybind11
require_site_package "$PY_PYPROJECT_METADATA_PREFIX" pyproject_metadata
require_site_package "$PY_PYTHRAN_PREFIX" pythran
require_site_package "$PY_WHEEL_PREFIX" wheel

openblas_libdir="$OPENBLAS_PREFIX/lib"
if [[ ! -d "$openblas_libdir" && -d "$OPENBLAS_PREFIX/lib64" ]]; then
  openblas_libdir="$OPENBLAS_PREFIX/lib64"
fi
if [[ ! -d "$openblas_libdir" ]]; then
  echo "OPENBLAS_PREFIX must provide lib or lib64" >&2
  exit 2
fi
if ! compgen -G "$openblas_libdir/libopenblas.so*" >/dev/null; then
  echo "missing OpenBLAS shared library" >&2
  exit 2
fi
if [[ ! -f "$openblas_libdir/pkgconfig/openblas.pc" ]]; then
  echo "missing OpenBLAS pkg-config file" >&2
  exit 2
fi

pybind11_pkgconfig="$PY_PYBIND11_PREFIX/share/pkgconfig"
if [[ ! -d "$pybind11_pkgconfig" ]]; then
  pybind11_pkgconfig="$PY_PYBIND11_PREFIX/lib/pkgconfig"
fi
if [[ ! -d "$pybind11_pkgconfig" ]]; then
  pybind11_pkgconfig="$PY_PYBIND11_PREFIX/lib/python${PYTHON_ABI}/site-packages/pybind11/share/pkgconfig"
fi
pybind11_cmake="$PY_PYBIND11_PREFIX/share/cmake/pybind11"
if [[ ! -d "$pybind11_cmake" ]]; then
  pybind11_cmake="$PY_PYBIND11_PREFIX/lib/python${PYTHON_ABI}/site-packages/pybind11/share/cmake/pybind11"
fi

rm -rf "$PREFIX"
mkdir -p "$TMPDIR" "$PREFIX/.home" "$PREFIX/.pip-cache"
export HOME="$PREFIX/.home"
export PIP_CACHE_DIR="$PREFIX/.pip-cache"
export PYTHONHOME=
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_CYTHON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_MESON_PYTHON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PACKAGING_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PYPROJECT_METADATA_PREFIX/lib/python${PYTHON_ABI}/site-packages:$MESON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_NUMPY_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PYBIND11_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PYTHRAN_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_BENIGET_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_GAST_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PLY_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$MESON_PREFIX/bin:$NINJA_PREFIX/bin:$PKGCONF_PREFIX/bin:$PY_CYTHON_PREFIX/bin:$PY_NUMPY_PREFIX/bin:$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PY_PYTHRAN_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:$PYTHON_PREFIX/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="$openblas_libdir:$python_libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PKG_CONFIG="$PKG_CONFIG_BIN"
if [[ -d "$pybind11_pkgconfig" ]]; then
  export PKG_CONFIG_PATH="$openblas_libdir/pkgconfig:$pybind11_pkgconfig"
  export PKG_CONFIG_LIBDIR="$openblas_libdir/pkgconfig:$pybind11_pkgconfig"
else
  export PKG_CONFIG_PATH="$openblas_libdir/pkgconfig"
  export PKG_CONFIG_LIBDIR="$openblas_libdir/pkgconfig"
fi
if [[ -d "$pybind11_cmake" ]]; then
  export CMAKE_PREFIX_PATH="$PY_PYBIND11_PREFIX${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
fi
export NINJA="$NINJA_BIN"
export NINJAFLAGS="-j${NINJA_JOBS:-$(nproc)} ${NINJAFLAGS:-}"
wrapper_dir="$PWD/.spack-target-wrapper"
rm -rf "$wrapper_dir"
mkdir -p "$wrapper_dir"
spack_target_flags="-march=icelake-client -mtune=icelake-client"
cat >"$wrapper_dir/gcc" <<SH
#!/usr/bin/env bash
exec /usr/bin/gcc $spack_target_flags "\\$@"
SH
cat >"$wrapper_dir/g++" <<SH
#!/usr/bin/env bash
exec /usr/bin/g++ $spack_target_flags "\\$@"
SH
cat >"$wrapper_dir/gfortran" <<SH
#!/usr/bin/env bash
exec /usr/bin/gfortran $spack_target_flags "\\$@"
SH
chmod +x "$wrapper_dir/gcc" "$wrapper_dir/g++" "$wrapper_dir/gfortran"
export CC="$wrapper_dir/gcc"
export CXX="$wrapper_dir/g++"
export FC="$wrapper_dir/gfortran"
export F77="$wrapper_dir/gfortran"
export F90="$wrapper_dir/gfortran"
export CFLAGS="-I$OPENBLAS_PREFIX/include -I$python_include ${CFLAGS:-}"
export CXXFLAGS="-I$OPENBLAS_PREFIX/include -I$python_include ${CXXFLAGS:-}"
export FCFLAGS="${FCFLAGS:-}"
export FFLAGS="${FFLAGS:-}"
export LDFLAGS="-L$openblas_libdir -Wl,-rpath,$openblas_libdir -L$python_libdir -Wl,-rpath,$python_libdir ${LDFLAGS:-}"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  --config-settings=builddir=build \
  --config-settings=setup-args=-Dfortran_std=legacy \
  --config-settings=setup-args=-Dblas=openblas \
  --config-settings=setup-args=-Dlapack=openblas \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -d "$site_packages/scipy"
test -f "$site_packages/scipy/__init__.py"
test -f "$site_packages/scipy/linalg/_fblas$ext_suffix"
test -f "$site_packages/scipy/linalg/_flapack$ext_suffix"
test -f "$site_packages/scipy/special/_ufuncs$ext_suffix"
test -f "$site_packages/scipy/sparse/_sparsetools$ext_suffix"
test -f "$site_packages/scipy/stats/_stats$ext_suffix"
test -f "$site_packages/scipy-1.17.1.dist-info/METADATA"
test -f "$site_packages/scipy-1.17.1.dist-info/WHEEL"
if ! readelf -d "$site_packages/scipy/linalg/_fblas$ext_suffix" | grep -q 'Shared library: \\[libopenblas'; then
  echo "scipy linalg extension is not linked against OpenBLAS" >&2
  exit 1
fi

export PYTHONPATH="$site_packages:$PYTHONPATH"
SMOKE_CWD="$PREFIX/.smoke-cwd"
mkdir -p "$SMOKE_CWD"
cd "$SMOKE_CWD"
out="$("$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import importlib.metadata

import numpy as np
import scipy
from scipy import linalg, special

a = np.array([[1.0, 2.0], [3.0, 4.0]])
print(
    "py-scipy:%s:%s:%.1f:%.6f"
    % (
        importlib.metadata.version("scipy"),
        scipy.__version__,
        float(linalg.det(a)),
        float(special.expit(0.0)),
    )
)
PY
)"
if [[ "$out" != "py-scipy:1.17.1:1.17.1:-2.0:0.500000" ]]; then
  echo "unexpected scipy smoke output: $out" >&2
  exit 1
fi
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-scipy native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_scipy_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-scipy native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    tmpdir = repository_ctx.os.environ.get("TMPDIR")
    if not tmpdir:
        fail("py-scipy native build requires TMPDIR from the insula wrapper")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    prefixes = {
        "MESON_PREFIX": _read_prefix(repository_ctx, attr.meson_prefix_file, "meson"),
        "NINJA_PREFIX": _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja"),
        "OPENBLAS_PREFIX": _read_prefix(repository_ctx, attr.openblas_prefix_file, "openblas"),
        "PKGCONF_PREFIX": _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf"),
        "PY_BENIGET_PREFIX": _read_prefix(repository_ctx, attr.py_beniget_prefix_file, "py-beniget"),
        "PY_CYTHON_PREFIX": _read_prefix(repository_ctx, attr.py_cython_prefix_file, "py-cython"),
        "PY_GAST_PREFIX": _read_prefix(repository_ctx, attr.py_gast_prefix_file, "py-gast"),
        "PY_MESON_PYTHON_PREFIX": _read_prefix(repository_ctx, attr.py_meson_python_prefix_file, "py-meson-python"),
        "PY_NUMPY_PREFIX": _read_prefix(repository_ctx, attr.py_numpy_prefix_file, "py-numpy"),
        "PY_PACKAGING_PREFIX": _read_prefix(repository_ctx, attr.py_packaging_prefix_file, "py-packaging"),
        "PY_PIP_PREFIX": _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip"),
        "PY_PLY_PREFIX": _read_prefix(repository_ctx, attr.py_ply_prefix_file, "py-ply"),
        "PY_PYBIND11_PREFIX": _read_prefix(repository_ctx, attr.py_pybind11_prefix_file, "py-pybind11"),
        "PY_PYPROJECT_METADATA_PREFIX": _read_prefix(repository_ctx, attr.py_pyproject_metadata_prefix_file, "py-pyproject-metadata"),
        "PY_PYTHRAN_PREFIX": _read_prefix(repository_ctx, attr.py_pythran_prefix_file, "py-pythran"),
        "PY_WHEEL_PREFIX": _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel"),
        "PYTHON_PREFIX": python_prefix,
        "PYTHON_VENV_PREFIX": _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv"),
        "TMPDIR": tmpdir,
    }
    prefix = str(repository_ctx.path("prefix"))

    env = dict(prefixes)
    env["PYTHON_ABI"] = python_abi
    env["VASO_IN_INSULA"] = "1"
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 7200,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("py-scipy native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_scipy_native = repository_rule(
    implementation = _py_scipy_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "meson_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openblas_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_beniget_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_cython_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_gast_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_meson_python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_numpy_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_packaging_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_ply_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pybind11_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pyproject_metadata_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pythran_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["NINJA_JOBS", "TMPDIR", "VASO_IN_INSULA"],
    doc = "Build py-scipy@1.17.1 with meson-python and native OpenBLAS into a concrete Spack-compatible Python prefix.",
)
