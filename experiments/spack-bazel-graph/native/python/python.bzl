"""Native (Bazel-owned) build of CPython into a Spack-identical prefix.

The hermetic Spack v1.2.2 python recipe is a generic Package with
configure/build/install phases that drive CPython's generated configure script
and Makefile. The concrete Spack build enables shared libpython and the
readline/ssl/sqlite3/dbm/zlib/bz2/lzma/zstd/pyexpat/ctypes/uuid extension
modules, disables tkinter/tests/ensurepip, and passes every link dependency
through CPPFLAGS/LDFLAGS plus package-specific configure args.

Every dependency prefix is read from a Bazel-owned native prefix marker. The
repository rule must run inside the sealed insula; host-root builds are rejected.
"""

_BUILD_TEMPLATE = """\
# GENERATED by python_native. Native Bazel build of CPython, intended to match
# the Spack python install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include/python{python_abi}"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "python native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

for var in BZIP2_PREFIX EXPAT_PREFIX GDBM_PREFIX GETTEXT_PREFIX LIBFFI_PREFIX NCURSES_PREFIX OPENSSL_PREFIX PKGCONF_PREFIX READLINE_PREFIX SQLITE_PREFIX UTIL_LINUX_UUID_PREFIX XZ_PREFIX ZLIB_PREFIX ZSTD_PREFIX; do
  value="${!var:-}"
  if [[ -z "$value" || ! -d "$value" ]]; then
    echo "$var must name a Bazel-built dependency prefix" >&2
    exit 2
  fi
done
if [[ ! -x "${PKGCONF_PREFIX}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must provide bin/pkgconf" >&2
  exit 2
fi

libdir() {
  if [[ -d "$1/lib64" ]]; then
    printf '%s/lib64' "$1"
  else
    printf '%s/lib' "$1"
  fi
}

include_flags=(
  "-I${BZIP2_PREFIX}/include"
  "-I${EXPAT_PREFIX}/include"
  "-I${GDBM_PREFIX}/include"
  "-I${GETTEXT_PREFIX}/include"
  "-I${LIBFFI_PREFIX}/include"
  "-I${NCURSES_PREFIX}/include"
  "-I${NCURSES_PREFIX}/include/ncursesw"
  "-I${OPENSSL_PREFIX}/include"
  "-I${READLINE_PREFIX}/include"
  "-I${SQLITE_PREFIX}/include"
  "-I${UTIL_LINUX_UUID_PREFIX}/include"
  "-I${XZ_PREFIX}/include"
  "-I${ZLIB_PREFIX}/include"
  "-I${ZSTD_PREFIX}/include"
)
lib_prefixes=(
  "$BZIP2_PREFIX"
  "$EXPAT_PREFIX"
  "$GDBM_PREFIX"
  "$GETTEXT_PREFIX"
  "$LIBFFI_PREFIX"
  "$NCURSES_PREFIX"
  "$OPENSSL_PREFIX"
  "$READLINE_PREFIX"
  "$SQLITE_PREFIX"
  "$UTIL_LINUX_UUID_PREFIX"
  "$XZ_PREFIX"
  "$ZLIB_PREFIX"
  "$ZSTD_PREFIX"
)
ld_flags=()
pkg_paths=()
ld_runtime=()
for dep in "${lib_prefixes[@]}"; do
  dep_lib="$(libdir "$dep")"
  ld_flags+=("-L${dep_lib}" "-Wl,-rpath,${dep_lib}")
  ld_runtime+=("${dep_lib}")
  if [[ -d "${dep_lib}/pkgconfig" ]]; then
    pkg_paths+=("${dep_lib}/pkgconfig")
  fi
done
ld_flags+=("-Wl,-rpath,${PREFIX}/lib" "-Wl,--disable-new-dtags")

cd "$SRC"

python3 - <<'PY'
from pathlib import Path
path = Path("Makefile.pre.in")
text = path.read_text()
text = text.replace("setup.py build", "setup.py --no-user-cfg build")
text = text.replace("setup.py install", "setup.py --no-user-cfg install")
path.write_text(text)
PY

export PATH="${PKGCONF_PREFIX}/bin:${GETTEXT_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="$(IFS=:; echo "${pkg_paths[*]}")${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
export CPPFLAGS="$(printf '%s ' "${include_flags[@]}")${CPPFLAGS:-}"
export LDFLAGS="$(printf '%s ' "${ld_flags[@]}")${LDFLAGS:-}"
export CFLAGS="-fPIC ${CFLAGS:-}"
export LD_LIBRARY_PATH="$(IFS=:; echo "${ld_runtime[*]}")${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export PYTHONPATH=
export PYTHONHOME=

./configure \\
  --prefix="$PREFIX" \\
  --without-pydebug \\
  --enable-shared \\
  --without-static-libpython \\
  --disable-test-modules \\
  --without-ensurepip \\
  "--with-openssl=${OPENSSL_PREFIX}" \\
  --with-dbmliborder=gdbm \\
  --with-system-expat \\
  py_cv_module__tkinter=n/a

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install "COMPILEALL_OPTS=-j${MAKE_JOBS:-$(nproc)}"

ln -sfn python3 "${PREFIX}/bin/python"
ln -sfn python3-config "${PREFIX}/bin/python-config"

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("python native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _python_abi(version):
    parts = version.split(".")
    if len(parts) != 3 or not all([part.isdigit() for part in parts]):
        fail("python native build requires an exact X.Y.Z version, got {!r}".format(version))
    return "{}.{}".format(parts[0], parts[1])


def _python_native_impl(repository_ctx):
    attr = repository_ctx.attr
    python_abi = _python_abi(attr.version)
    if attr.strip_prefix != "Python-" + attr.version:
        fail("python native strip_prefix {!r} does not match version {!r}".format(
            attr.strip_prefix,
            attr.version,
        ))

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    expat_prefix = _read_prefix(repository_ctx, attr.expat_prefix_file, "expat")
    gdbm_prefix = _read_prefix(repository_ctx, attr.gdbm_prefix_file, "gdbm")
    gettext_prefix = _read_prefix(repository_ctx, attr.gettext_prefix_file, "gettext")
    libffi_prefix = _read_prefix(repository_ctx, attr.libffi_prefix_file, "libffi")
    ncurses_prefix = _read_prefix(repository_ctx, attr.ncurses_prefix_file, "ncurses")
    openssl_prefix = _read_prefix(repository_ctx, attr.openssl_prefix_file, "openssl")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    readline_prefix = _read_prefix(repository_ctx, attr.readline_prefix_file, "readline")
    sqlite_prefix = _read_prefix(repository_ctx, attr.sqlite_prefix_file, "sqlite")
    util_linux_uuid_prefix = _read_prefix(repository_ctx, attr.util_linux_uuid_prefix_file, "util-linux-uuid")
    xz_prefix = _read_prefix(repository_ctx, attr.xz_prefix_file, "xz")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib")
    zstd_prefix = _read_prefix(repository_ctx, attr.zstd_prefix_file, "zstd")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 7200,
        quiet = False,
        environment = {
            "BZIP2_PREFIX": bzip2_prefix,
            "EXPAT_PREFIX": expat_prefix,
            "GDBM_PREFIX": gdbm_prefix,
            "GETTEXT_PREFIX": gettext_prefix,
            "LIBFFI_PREFIX": libffi_prefix,
            "NCURSES_PREFIX": ncurses_prefix,
            "OPENSSL_PREFIX": openssl_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "READLINE_PREFIX": readline_prefix,
            "SQLITE_PREFIX": sqlite_prefix,
            "UTIL_LINUX_UUID_PREFIX": util_linux_uuid_prefix,
            "XZ_PREFIX": xz_prefix,
            "ZLIB_PREFIX": zlib_prefix,
            "ZSTD_PREFIX": zstd_prefix,
        },
    )
    if res.return_code != 0:
        fail("python native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lpython" + python_abi,
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts), python_abi = python_abi),
    )


python_native = repository_rule(
    implementation = _python_native_impl,
    attrs = {
        "version": attr.string(
            mandatory = True,
            doc = "Exact CPython X.Y.Z; the ABI (X.Y) is derived from it.",
        ),
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "expat_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gdbm_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gettext_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libffi_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openssl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "readline_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "sqlite_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "util_linux_uuid_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zstd_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build CPython from source into a Spack-prefix-identical tree.",
)
