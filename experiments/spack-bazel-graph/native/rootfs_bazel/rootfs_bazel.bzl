"""Boundary for the estate Bazel binary used by nested source builds."""

_BUILD_TEMPLATE = """\
# GENERATED by rootfs_bazel_native. Boundary for the estate Bazel binary.
# Do not edit by hand.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files([
    "prefix_path.txt",
    "sdk_boundary.json",
])
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
PREFIX="$1"
REQUIRED_VERSION="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "rootfs Bazel boundary must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${VASO_ROOTFS_BUNDLE_MANIFEST:-}" || ! -f "$VASO_ROOTFS_BUNDLE_MANIFEST" ]]; then
  echo "VASO_ROOTFS_BUNDLE_MANIFEST must point at the insula rootfs-bundle.json" >&2
  exit 2
fi
if [[ -z "${VASO_BAZEL:-}" || ! -x "$VASO_BAZEL" ]]; then
  echo "VASO_BAZEL must name the estate Bazel binary for nested source builds" >&2
  exit 2
fi

actual="$("$VASO_BAZEL" --version | awk '{print $2; exit}')"
if [[ "$actual" != "$REQUIRED_VERSION" ]]; then
  echo "estate Bazel version mismatch: required $REQUIRED_VERSION, got ${actual:-unknown} from $VASO_BAZEL" >&2
  exit 2
fi

rm -rf "$PREFIX"
mkdir -p "$PREFIX/bin"
ln -s "$VASO_BAZEL" "$PREFIX/bin/bazel"
ln -s "$VASO_BAZEL" "$PREFIX/bin/bazel-real"

python3 - "$PREFIX/sdk_boundary.json" "$VASO_ROOTFS_BUNDLE_MANIFEST" "$VASO_BAZEL" "$REQUIRED_VERSION" <<'PY'
import json
import sys

out, manifest_path, bazel, required = sys.argv[1:5]
manifest = json.load(open(manifest_path, encoding="utf-8"))
data = {
    "schema_version": 1,
    "mechanism": "bazel-tool-boundary",
    "package": "bazel",
    "required_version": required,
    "bazel": bazel,
    "rootfs_bundle": manifest,
}
with open(out, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2, sort_keys=True)
    handle.write("\\n")
PY
"""


def _rootfs_bazel_native_impl(repository_ctx):
    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("rootfs Bazel boundary must run inside the hermetic insula (VASO_IN_INSULA=1)")

    required_version = repository_ctx.attr.required_version
    bazel = repository_ctx.os.environ.get(
        "VASO_BAZEL",
        "/opt/vaso/bazel-{}/bin/bazel-real".format(required_version),
    )
    manifest = repository_ctx.os.environ.get(
        "VASO_ROOTFS_BUNDLE_MANIFEST",
        "/run/vaso/rootfs-bundle.json",
    )

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", prefix, required_version],
        timeout = 120,
        quiet = False,
        environment = {
            "VASO_BAZEL": bazel,
            "VASO_IN_INSULA": "1",
            "VASO_ROOTFS_BUNDLE_MANIFEST": manifest,
        },
    )
    if res.return_code != 0:
        fail("rootfs Bazel boundary validation failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.symlink("prefix/sdk_boundary.json", "sdk_boundary.json")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


rootfs_bazel_native = repository_rule(
    implementation = _rootfs_bazel_native_impl,
    attrs = {
        "required_version": attr.string(mandatory = True),
    },
    environ = [
        "VASO_BAZEL",
        "VASO_IN_INSULA",
        "VASO_ROOTFS_BUNDLE_MANIFEST",
    ],
    doc = "Expose the estate Bazel binary as the pinned nested-build prefix for jaxlib.",
)
