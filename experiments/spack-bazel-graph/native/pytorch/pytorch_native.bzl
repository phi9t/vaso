"""Native (Bazel-owned) PyTorch build — GATED skeleton.

Mirrors `native/zlib_ng/zlib_ng.bzl`'s shape (a repository rule that emits a
Spack-prefix-identical install tree) but for PyTorch, the first non-trivial
migration and the forcing function to seal the CUDA/Ubuntu>=24.04 rootfs bundle
(see docs/native-migration.md).

CRITICAL: this rule NEVER runs the full multi-hour CUDA torch build on its own.
It always PLANS the build (resolving input Spack prefixes, computing the
`python -m pip wheel` env from upstream PyTorch v2.14.0 plus the
vendor-libtorch compatibility interface, running preflight via
native/pytorch/plan.py) and only proceeds to the wheel build when the trusted
request carries the token `build-native-pytorch` (VASO_NATIVE_PYTORCH_TOKEN).
Absent the token it stops cleanly after writing build_plan.json and aliases
:lib back to the Spack provider so the graph still resolves.

Wire it (once ready) via native_overrides.json:
    "pytorch": "@pytorch_native//:lib"
and register @pytorch_native in MODULE.bazel with the input prefixes. Until the
CUDA rootfs is sealed and the token is issued, keep it out of the default lock.
"""

_PLAN_BUILD = """\
# GENERATED by pytorch_native (DRY-RUN / unauthorized). The native torch build
# did not run: no token, or preflight not satisfied. build_plan.json records the
# resolved interface. :lib aliases back to the Spack provider so the DAG still
# resolves and unmigrated consumers are unaffected.
package(default_visibility = ["//visibility:public"])

exports_files(["build_plan.json"])

alias(
    name = "lib",
    actual = "{spack_fallback}",
)
"""

_NATIVE_BUILD = """\
# GENERATED by pytorch_native (AUTHORIZED). Native torch wheel built and
# pip-installed into a vendor-libtorch-identical prefix.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

filegroup(
    name = "wheel",
    srcs = glob(["prefix/artifacts/wheels/torch-*.whl"], allow_empty = False),
)

cc_library(
    name = "lib",
    hdrs = glob(["prefix/lib/site-packages/torch/include/**"], allow_empty = True),
    includes = ["prefix/lib/site-packages/torch/include"],
    linkopts = {linkopts},
)
"""

_REQUIRED_TOKEN = "build-native-pytorch"

def _pytorch_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("pytorch native planning/build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    # Compose --prefix KEY=PATH args for the planner from the declared inputs.
    plan_args = [
        "python3",
        str(repository_ctx.path(attr._plan)),
        "--cuda-arch", attr.cuda_arch,
        "--build-version", attr.build_version,
        "--out", "build_plan.json",
    ]
    for key in (
        "cuda",
        "cudnn",
        "nccl",
        "python",
        "cmake",
        "ninja",
        "openblas",
        "protobuf",
        "cusparselt",
        "openmpi",
        "cudss",
        "nvshmem",
        "numactl",
        "cpuinfo",
        "fp16",
        "fxdiv",
        "psimd",
        "pthreadpool",
    ):
        val = getattr(attr, key)
        if val:
            plan_args += ["--prefix", "{}={}".format(key, val)]
    if attr.rootfs_cuda_bundle:
        plan_args.append("--rootfs-cuda-bundle")

    token = repository_ctx.os.environ.get("VASO_NATIVE_PYTORCH_TOKEN", "")
    authorized = token == _REQUIRED_TOKEN and attr.source != ""

    # Always plan + preflight first (dry-run). This validates the interface.
    plan_res = repository_ctx.execute(plan_args, quiet = False)
    if plan_res.return_code != 0 and not authorized:
        # Dry-run preflight failure is informative, not fatal, while
        # unauthorized: we still emit the fallback alias so the graph resolves.
        pass

    if not authorized:
        repository_ctx.file(
            "BUILD.bazel",
            _PLAN_BUILD.format(spack_fallback = attr.spack_fallback),
        )
        return

    # AUTHORIZED PATH (token present + source pinned). Re-run the planner with
    # --execute to hard-gate on the token, then drive python -m pip wheel
    # and pip-install into a vendor-libtorch-identical prefix. This branch only
    # runs when a trusted operator has issued the token; it is intentionally the
    # long, expensive path.
    fail(
        "pytorch_native authorized path is a skeleton: wire the python -m " +
        "pip wheel + pip install steps here once the CUDA rootfs is " +
        "sealed and 'build-native-pytorch' is issued. See " +
        "docs/native-migration.md.",
    )

pytorch_native = repository_rule(
    implementation = _pytorch_native_impl,
    attrs = {
        "source": attr.string(doc = "PyTorch source tree (git checkout)"),
        "cuda_arch": attr.string(default = "10.0"),
        "build_version": attr.string(default = "2.14.0"),
        "cuda": attr.string(doc = "Spack cuda prefix"),
        "cudnn": attr.string(doc = "Spack cudnn prefix"),
        "nccl": attr.string(doc = "Spack nccl prefix"),
        "python": attr.string(doc = "Spack python prefix"),
        "cmake": attr.string(doc = "Spack cmake prefix"),
        "ninja": attr.string(doc = "Spack ninja prefix"),
        "openblas": attr.string(doc = "Spack openblas prefix"),
        "protobuf": attr.string(doc = "Spack protobuf prefix for PyTorch ~custom-protobuf builds"),
        "cusparselt": attr.string(doc = "Spack cuSPARSELt prefix"),
        "openmpi": attr.string(doc = "Spack OpenMPI prefix"),
        "cudss": attr.string(doc = "Spack cuDSS prefix"),
        "nvshmem": attr.string(doc = "Spack NVSHMEM prefix"),
        "numactl": attr.string(doc = "Spack numactl prefix for USE_NUMA"),
        "cpuinfo": attr.string(doc = "Native cpuinfo prefix for PyTorch helper providers"),
        "fp16": attr.string(doc = "Native FP16 prefix for PyTorch helper providers"),
        "fxdiv": attr.string(doc = "Native FXdiv prefix for PyTorch helper providers"),
        "psimd": attr.string(doc = "Native psimd prefix for PyTorch helper providers"),
        "pthreadpool": attr.string(doc = "Native pthreadpool prefix for PyTorch helper providers"),
        "rootfs_cuda_bundle": attr.bool(default = False),
        "spack_fallback": attr.string(
            default = "@spack_vendor_libtorch//:lib",
            doc = "Spack provider :lib to alias when unauthorized/dry-run",
        ),
        "_plan": attr.label(
            default = "//native/pytorch:plan.py",
            allow_single_file = True,
        ),
    },
    environ = ["VASO_NATIVE_PYTORCH_TOKEN", "VASO_IN_INSULA"],
    doc = "GATED native PyTorch build: dry-run plan by default; full build " +
          "only with the 'build-native-pytorch' token.",
)
