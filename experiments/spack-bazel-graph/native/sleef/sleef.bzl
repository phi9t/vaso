"""Native (Bazel-owned) build of SLEEF into a Spack-identical prefix.

The hermetic Spack v1.2.2 sleef@3.8 recipe is a CMakePackage. The concrete
frontier build uses the Ninja generator, builds static PIC libsleef.a and
libsleefgnuabi.a, disables tests, and installs pkg-config plus CMake package
metadata.
"""

_BUILD_TEMPLATE = """\
# GENERATED by sleef_native. Native Bazel build of SLEEF, intended to match the
# Spack SLEEF install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: cmake
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "SLEEF native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-built CMake prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja-build" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built Ninja prefix" >&2
  exit 2
fi

CMAKE="$CMAKE_PREFIX/bin/cmake"
NINJA="$NINJA_PREFIX/bin/ninja-build"
: "${TMPDIR:?TMPDIR must be set}"
BUILD="$(mktemp -d -p "$TMPDIR")"
cd "$BUILD"

export PATH="${CMAKE_PREFIX}/bin:${NINJA_PREFIX}/bin:${PATH}"
export CMAKE_PREFIX_PATH="${CMAKE_PREFIX};${NINJA_PREFIX}"
export CC="${CC:-gcc}"

"$CMAKE" -G Ninja \
  -DCMAKE_MAKE_PROGRAM:FILEPATH="$NINJA" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  -DCMAKE_INSTALL_RPATH_USE_LINK_PATH:BOOL=ON \
  "-DCMAKE_INSTALL_RPATH:STRING=${PREFIX}/lib;${PREFIX}/lib64" \
  "-DCMAKE_PREFIX_PATH:STRING=${CMAKE_PREFIX};${NINJA_PREFIX}" \
  -DCMAKE_C_COMPILER:FILEPATH=/usr/bin/gcc \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF \
  -DCMAKE_POLICY_DEFAULT_CMP0090:STRING=NEW \
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF \
  -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=ON \
  -DSLEEF_BUILD_TESTS:BOOL=OFF \
  -DSLEEF_BUILD_DFT:BOOL=OFF \
  -DSLEEF_BUILD_LIBM:BOOL=ON \
  -DSLEEF_BUILD_GNUABI_LIBS:BOOL=ON \
  -DSLEEF_ENABLE_CXX:BOOL=OFF \
  -DSLEEF_ENABLE_CUDA:BOOL=OFF \
  -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON \
  "$SRC"
"$NINJA" -v
"$NINJA" install

for path in \
  include/sleef.h \
  lib/libsleef.a \
  lib/libsleefgnuabi.a \
  lib/pkgconfig/sleef.pc \
  lib/cmake/sleef/sleefConfig.cmake \
  lib/cmake/sleef/sleefConfigVersion.cmake \
  lib/cmake/sleef/sleefTargets.cmake \
  lib/cmake/sleef/sleefTargets-release.cmake
do
  test -f "$PREFIX/$path"
done
if compgen -G "$PREFIX/lib/*.so*" >/dev/null; then
  echo "SLEEF reference prefix is static-only; native build produced shared libraries" >&2
  exit 2
fi
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("SLEEF native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _sleef_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("SLEEF native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")
    ninja_prefix = _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja")

    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "NINJA_PREFIX": ninja_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("SLEEF native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lsleef",
        "-lsleefgnuabi",
        "-lm",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


sleef_native = repository_rule(
    implementation = _sleef_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build SLEEF from source into a Spack-prefix-identical static-library tree.",
)
