"""Native (Bazel-owned) build of xz into a Spack-prefix-identical install tree.

This continues the migration hillclimb past leaf packages: libxml2 links against
both xz (liblzma) and zlib-ng, so flipping xz is a prerequisite to migrating a
real consumer node without changing DAG topology.

`xz_native` is a `repository_rule` that:

  1. fetches a pinned xz source archive (content-addressed by sha256);
  2. builds using the autotools pipeline (configure && make && make install)
     into an in-repo `prefix/` directory;
  3. post-processes the prefix to match what Spack emits (notably: Spack’s xz
     install tree does not include libtool `.la` files, so we delete them);
  4. exposes `@xz_native//:lib` as a `cc_library` over the prefix.

The ABI-parity gate compares the candidate prefix against the Spack reference
prefix using tools/abi_parity.py.
"""

_BUILD_TEMPLATE = """\
# GENERATED by xz_native. Native Bazel build of xz, prefix-identical to the Spack
# xz install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"      # extracted source dir
PREFIX="$2"   # install prefix (absolute)

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "xz native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

./configure \\
  --prefix="$PREFIX" \\
  --enable-shared \\
  --enable-static

make -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack does not ship libtool .la files for xz (liblzma). Match the emitted
# prefix contract by removing them.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _xz_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("xz native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-llzma"]

    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )
    repository_ctx.file("prefix_path.txt", prefix + "\n")


xz_native = repository_rule(
    implementation = _xz_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build xz from source into a Spack-prefix-identical install tree.",
)
