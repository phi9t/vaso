"""Native (Bazel-owned) build of utf8proc from source into a Spack-identical prefix.

Second migration node and the first *cmake*-build-system proof. Mirrors
native/zlib_ng/zlib_ng.bzl but reproduces Spack's `CMakeBuilder` instead of its
`AutotoolsBuilder` (see docs/recipes/utf8proc.md).

`utf8proc_native` is a `repository_rule` that:

  1. fetches the pinned utf8proc source (same 2.10.0 tag + sha256 the Spack
     utf8proc package pins);
  2. drives the SAME build Spack drives — `cmake -G "Unix Makefiles"
     -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF` then `make &&
     make install` — into an in-repo `prefix/` install tree;
  3. exposes `@utf8proc_native//:lib`, a `cc_library` over that native prefix.

Because the cmake args match the Spack recipe's concretized variant set
(`shared=False` -> `-DBUILD_SHARED_LIBS=OFF`, `build_type=Release`,
`generator=make`), the emitted `include/utf8proc.h`, `lib/libutf8proc.a`, and
`lib/pkgconfig/libutf8proc.pc` are byte/ABI-identical (verified by
tools/abi_parity.py). The build needs a modern cmake; the sealed CUDA insula
ships one, and CMAKE can be overridden via env for host runs.
"""

_BUILD_TEMPLATE = """\
# GENERATED by utf8proc_native. Native Bazel build of utf8proc, prefix-identical
# to the Spack utf8proc install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

# The build script mirrors the Spack CMakeBuilder for the
# shared=False,build_type=Release,generator=make variant set. CMAKE defaults to
# `cmake` on PATH but honors an override so a hermetic caller can point at the
# Spack/insula cmake.
_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"      # extracted source dir
PREFIX="$2"   # install prefix (absolute)
CMAKE="${CMAKE:-cmake}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "utf8proc native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

BUILD="$(mktemp -d)"
cd "$BUILD"
# Same phases Spack's CMakeBuilder drives: configure (cmake), build, install.
"$CMAKE" -G "Unix Makefiles" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DBUILD_SHARED_LIBS:BOOL=OFF \
  "$SRC"
make -j"${MAKE_JOBS:-$(nproc)}"
make install
"""

def _utf8proc_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    env = {}
    if attr.cmake_bin:
        env["CMAKE"] = attr.cmake_bin
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("utf8proc native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lutf8proc"]

    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )

utf8proc_native = repository_rule(
    implementation = _utf8proc_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "cmake_bin": attr.string(doc = "cmake binary; empty uses PATH `cmake`"),
    },
    environ = ["CMAKE", "MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build utf8proc from source into a Spack-prefix-identical install tree.",
)
