"""Native (Bazel-owned) build of GNU m4 into a Spack-identical prefix.

The py-torch frontier captures m4@1.4.21 as an AutotoolsPackage. The concrete
Spack build uses an out-of-tree spack-build directory, enables C++ support, and
links against libsigsegv.
"""

_BUILD_TEMPLATE = """\
# GENERATED by m4_native. Native Bazel build of GNU m4, intended to match the
# Spack m4 install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# m4 is an executable/tool-prefix node in this graph. It exposes no public C
# ABI, but @spack_m4//:lib must remain a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "m4 native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${DIFFUTILS_PREFIX:-}" || ! -x "${DIFFUTILS_PREFIX:-}/bin/diff" || ! -x "${DIFFUTILS_PREFIX:-}/bin/cmp" ]]; then
  echo "DIFFUTILS_PREFIX must name the Bazel-built diffutils prefix" >&2
  exit 2
fi
if [[ -z "${LIBSIGSEGV_PREFIX:-}" || ! -d "${LIBSIGSEGV_PREFIX:-}/lib" || ! -f "${LIBSIGSEGV_PREFIX:-}/include/sigsegv.h" ]]; then
  echo "LIBSIGSEGV_PREFIX must name the Bazel-built libsigsegv prefix" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

export PATH="${DIFFUTILS_PREFIX}/bin:${PATH}"
export CPPFLAGS="-I${LIBSIGSEGV_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${LIBSIGSEGV_PREFIX}/lib -Wl,-rpath,${LIBSIGSEGV_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LIBS="-lsigsegv ${LIBS:-}"

../configure \\
  --prefix="$PREFIX" \\
  --enable-c++ \\
  "--with-libsigsegv-prefix=${LIBSIGSEGV_PREFIX}"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack removes libtool archives from the emitted prefix.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("m4 native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _m4_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("m4 native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    diffutils_prefix = _read_prefix(repository_ctx, attr.diffutils_prefix_file, "diffutils")
    libsigsegv_prefix = _read_prefix(repository_ctx, attr.libsigsegv_prefix_file, "libsigsegv")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "DIFFUTILS_PREFIX": diffutils_prefix,
            "LIBSIGSEGV_PREFIX": libsigsegv_prefix,
        },
    )
    if res.return_code != 0:
        fail("m4 native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


m4_native = repository_rule(
    implementation = _m4_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "diffutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libsigsegv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU m4 from source into a Spack-prefix-identical tree.",
)
