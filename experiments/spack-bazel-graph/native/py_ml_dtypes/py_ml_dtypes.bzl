"""Native (Bazel-owned) py-ml-dtypes prefix.

The hermetic Spack v1.2.2 py-ml-dtypes@0.5.1 recipe is a PythonPackage that
builds a CPython C++ extension with setuptools against NumPy:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

Spack sources the package from the git tag with submodules. The PyPI sdist has
the same Python sources but omits Eigen's generated AVX512 TrsmUnrolls.inc, so
this rule overlays that single file from the exact Eigen submodule commit
recorded by Spack. Spack supplies pip, setuptools, wheel, NumPy, and the Python
prefix. This rule reproduces that dependency channel with Bazel-native prefix
markers and must run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_ml_dtypes_native. Native Bazel build of py-ml-dtypes,
# intended to match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-ml-dtypes exposes Python modules plus one CPython extension module. The
# runtime surface is carried as data from the generated prefix so
# @spack_py_ml_dtypes//:lib remains a valid provider target after migration.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-ml-dtypes native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
for var in OPENBLAS_PREFIX PY_NUMPY_PREFIX PY_PIP_PREFIX PY_SETUPTOOLS_PREFIX PY_WHEEL_PREFIX PYTHON_PREFIX PYTHON_VENV_PREFIX; do
  if [[ -z "${!var:-}" || ! -d "${!var}" ]]; then
    echo "$var must name a Bazel/hermetic dependency prefix" >&2
    exit 2
  fi
done
if [[ -z "${PYTHON_ABI:-}" || ! -x "$PYTHON_PREFIX/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python prefix" >&2
  exit 2
fi
if [[ ! -x "$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "missing py-pip for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "missing py-setuptools for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "missing py-wheel for Python ${PYTHON_ABI}" >&2
  exit 2
fi
if [[ ! -d "$PY_NUMPY_PREFIX/lib/python${PYTHON_ABI}/site-packages/numpy" ]]; then
  echo "missing py-numpy for Python ${PYTHON_ABI}" >&2
  exit 2
fi

openblas_libdir="$OPENBLAS_PREFIX/lib"
if [[ ! -d "$openblas_libdir" && -d "$OPENBLAS_PREFIX/lib64" ]]; then
  openblas_libdir="$OPENBLAS_PREFIX/lib64"
fi
if [[ ! -d "$openblas_libdir" ]]; then
  echo "OPENBLAS_PREFIX must provide lib or lib64" >&2
  exit 2
fi

python_include="$PYTHON_PREFIX/include/python${PYTHON_ABI}"
python_libdir="$PYTHON_PREFIX/lib"
if [[ ! -f "$python_include/Python.h" || ! -d "$python_libdir" ]]; then
  echo "PYTHON_PREFIX must provide Python.h and lib for ABI ${PYTHON_ABI}" >&2
  exit 2
fi
ext_suffix="$("$PYTHON_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import sysconfig
print(sysconfig.get_config_var("EXT_SUFFIX") or "")
PY
)"
if [[ -z "$ext_suffix" ]]; then
  echo "native python did not report EXT_SUFFIX" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONNOUSERSITE=1
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_NUMPY_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:$PYTHON_PREFIX/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="$openblas_libdir:$python_libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
wrapper_dir="$PWD/.spack-target-wrapper"
rm -rf "$wrapper_dir"
mkdir -p "$wrapper_dir"
spack_target_flags="-march=icelake-client -mtune=icelake-client"
cat >"$wrapper_dir/gcc" <<SH
#!/usr/bin/env bash
exec /usr/bin/gcc $spack_target_flags "\\$@"
SH
cat >"$wrapper_dir/g++" <<SH
#!/usr/bin/env bash
exec /usr/bin/g++ $spack_target_flags "\\$@"
SH
chmod +x "$wrapper_dir/gcc" "$wrapper_dir/g++"
export CC="$wrapper_dir/gcc"
export CXX="$wrapper_dir/g++"
export CFLAGS="-I$python_include ${CFLAGS:-}"
export CXXFLAGS="-I$python_include ${CXXFLAGS:-}"
export LDFLAGS="-L$python_libdir -Wl,-rpath,$python_libdir ${LDFLAGS:-}"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -f "$site_packages/ml_dtypes/__init__.py"
test -f "$site_packages/ml_dtypes/_finfo.py"
test -f "$site_packages/ml_dtypes/_iinfo.py"
test -f "$site_packages/ml_dtypes/_ml_dtypes_ext$ext_suffix"
test -f "$site_packages/ml_dtypes/py.typed"
test -f "$site_packages/ml_dtypes-0.5.1.dist-info/METADATA"
test -f "$site_packages/ml_dtypes-0.5.1.dist-info/WHEEL"

export PYTHONPATH="$site_packages:$PYTHONPATH"
SMOKE_CWD="$PREFIX/.smoke-cwd"
mkdir -p "$SMOKE_CWD"
cd "$SMOKE_CWD"
out="$("$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" - <<'PY'
import importlib.metadata
import ml_dtypes
import numpy as np

arr = np.array([1, 2, 3], dtype=ml_dtypes.bfloat16)
print(
    "py-ml-dtypes:%s:%s:%s"
    % (
        importlib.metadata.version("ml-dtypes"),
        ml_dtypes.__version__,
        str(arr.dtype),
    )
)
PY
)"
if [[ "$out" != "py-ml-dtypes:0.5.1:0.5.1:bfloat16" ]]; then
  echo "unexpected ml-dtypes smoke output: $out" >&2
  exit 1
fi
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-ml-dtypes native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_ml_dtypes_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-ml-dtypes native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.download(
        url = attr.eigen_trsm_unrolls_urls,
        sha256 = attr.eigen_trsm_unrolls_sha256,
        output = "src/third_party/eigen/Eigen/src/Core/arch/AVX512/TrsmUnrolls.inc",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    prefixes = {
        "OPENBLAS_PREFIX": _read_prefix(repository_ctx, attr.openblas_prefix_file, "openblas"),
        "PY_NUMPY_PREFIX": _read_prefix(repository_ctx, attr.py_numpy_prefix_file, "py-numpy"),
        "PY_PIP_PREFIX": _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip"),
        "PY_SETUPTOOLS_PREFIX": _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools"),
        "PY_WHEEL_PREFIX": _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel"),
        "PYTHON_PREFIX": python_prefix,
        "PYTHON_VENV_PREFIX": _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv"),
    }
    prefix = str(repository_ctx.path("prefix"))

    env = dict(prefixes)
    env["PYTHON_ABI"] = python_abi
    env["VASO_IN_INSULA"] = "1"
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 1800,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("py-ml-dtypes native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_ml_dtypes_native = repository_rule(
    implementation = _py_ml_dtypes_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "eigen_trsm_unrolls_urls": attr.string_list(mandatory = True),
        "eigen_trsm_unrolls_sha256": attr.string(mandatory = True),
        "openblas_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_numpy_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-ml-dtypes@0.5.1 from its PyPI source archive plus Spack's pinned Eigen submodule file into a Spack-compatible Python prefix.",
)
