"""Native (Bazel-owned) build of GNU libtool into a Spack-identical prefix.

The lean PyTorch frontier captures libtool@2.5.4 as an AutotoolsPackage. It
installs GNU libtool/libtoolize plus libltdl and consumes file, findutils, and
m4 as build/run tool prefixes.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libtool_native. Native Bazel build of GNU libtool, intended to
# match the Spack libtool install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = False),
    includes = [
        "prefix/include",
        "prefix/include/libltdl",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libtool native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${FILE_PREFIX:-}" || ! -x "${FILE_PREFIX:-}/bin/file" ]]; then
  echo "FILE_PREFIX must name the Bazel-built file prefix" >&2
  exit 2
fi
if [[ -z "${FINDUTILS_PREFIX:-}" || ! -x "${FINDUTILS_PREFIX:-}/bin/find" || ! -x "${FINDUTILS_PREFIX:-}/bin/xargs" ]]; then
  echo "FINDUTILS_PREFIX must name the Bazel-built findutils prefix" >&2
  exit 2
fi
if [[ -z "${M4_PREFIX:-}" || ! -x "${M4_PREFIX:-}/bin/m4" ]]; then
  echo "M4_PREFIX must name the Bazel-built m4 prefix" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

export PATH="${FILE_PREFIX}/bin:${FINDUTILS_PREFIX}/bin:${M4_PREFIX}/bin:${PATH}"
export M4="${M4_PREFIX}/bin/m4"

../configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Match Spack's post-install prefix surface.
find "$PREFIX" -type f -name '*.la' -delete || true
ln -sf libtool "$PREFIX/bin/glibtool"
ln -sf libtoolize "$PREFIX/bin/glibtoolize"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libtool native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libtool_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libtool native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    file_prefix = _read_prefix(repository_ctx, attr.file_prefix_file, "file")
    findutils_prefix = _read_prefix(repository_ctx, attr.findutils_prefix_file, "findutils")
    m4_prefix = _read_prefix(repository_ctx, attr.m4_prefix_file, "m4")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "FILE_PREFIX": file_prefix,
            "FINDUTILS_PREFIX": findutils_prefix,
            "M4_PREFIX": m4_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("libtool native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lltdl",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libtool_native = repository_rule(
    implementation = _libtool_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "file_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "findutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "m4_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU libtool from source into a Spack-prefix-identical tree.",
)
