"""Native (Bazel-owned) build of CMake into a Spack-identical prefix.

The hermetic Spack v1.2.2 cmake@3.31.11 recipe is a Generic Package, but its
concrete Linux build mechanism is CMake's own bootstrap script followed by
make/install. It uses bundled third-party libraries except for Spack-provided
curl, always depends on zlib, and builds the ncurses ccmake UI.
"""

_BUILD_TEMPLATE = """\
# GENERATED by cmake_native. Native Bazel build of CMake, intended to match the
# Spack cmake install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# CMake is a build-tool prefix in this graph. It exposes no public C ABI, but
# @spack_cmake//:lib must remain a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "cmake native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CURL_PREFIX:-}" || ! -x "${CURL_PREFIX:-}/bin/curl" || ! -f "${CURL_PREFIX:-}/include/curl/curl.h" ]]; then
  echo "CURL_PREFIX must name the Bazel-built curl prefix" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -f "${NCURSES_PREFIX:-}/include/ncurses.h" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

curl_libdir="$CURL_PREFIX/lib"
ncurses_libdir="$NCURSES_PREFIX/lib"
zlib_libdir="$ZLIB_PREFIX/lib"
for path in "$curl_libdir/libcurl.so" "$ncurses_libdir/libncurses.so" \
            "$ncurses_libdir/libcurses.so" "$zlib_libdir/libz.so"; do
  [[ -e "$path" ]] || { echo "cmake dependency library missing: $path" >&2; exit 2; }
done

cd "$SRC"

export PATH="${CURL_PREFIX}/bin:${NCURSES_PREFIX}/bin:${PATH}"
export PKG_CONFIG_PATH="${CURL_PREFIX}/lib/pkgconfig:${NCURSES_PREFIX}/lib/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig"
export CMAKE_PREFIX_PATH="${CURL_PREFIX};${NCURSES_PREFIX};${ZLIB_PREFIX}"
export CMAKE_LIBRARY_PATH="${curl_libdir};${ncurses_libdir};${zlib_libdir}"
export CMAKE_INCLUDE_PATH="${CURL_PREFIX}/include;${NCURSES_PREFIX}/include;${ZLIB_PREFIX}/include"
export LD_LIBRARY_PATH="${curl_libdir}:${ncurses_libdir}:${zlib_libdir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export LD_RUN_PATH="${curl_libdir}:${zlib_libdir}:${ncurses_libdir}"

./bootstrap \
  --prefix="$PREFIX" \
  --parallel="${MAKE_JOBS:-$(nproc)}" \
  --no-system-libs \
  --system-curl \
  --no-qt-gui \
  -- \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMake_TEST_INSTALL=OFF \
  -DBUILD_CursesDialog=ON \
  -DBUILD_QtDialog=OFF \
  -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
  "-DCMAKE_INSTALL_RPATH=${PREFIX}/lib;${PREFIX}/lib64;${curl_libdir};${zlib_libdir};${ncurses_libdir}" \
  "-DCMAKE_PREFIX_PATH=${CURL_PREFIX};${NCURSES_PREFIX};${ZLIB_PREFIX}"

make -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("cmake native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _cmake_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("cmake native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    curl_prefix = _read_prefix(repository_ctx, attr.curl_prefix_file, "curl")
    ncurses_prefix = _read_prefix(repository_ctx, attr.ncurses_prefix_file, "ncurses")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 5400,
        quiet = False,
        environment = {
            "CURL_PREFIX": curl_prefix,
            "NCURSES_PREFIX": ncurses_prefix,
            "ZLIB_PREFIX": zlib_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("cmake native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


cmake_native = repository_rule(
    implementation = _cmake_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "curl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build CMake from source into a Spack-prefix-identical tool prefix.",
)
