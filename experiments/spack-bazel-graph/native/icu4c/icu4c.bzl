"""Native (Bazel-owned) build of icu4c into a Spack-identical prefix.

The hermetic Spack v1.2.2 icu4c@76.1 recipe is an AutotoolsPackage with:

  * build directory: `source`
  * variant: cxxstd=17
  * build env: LC_ALL=en_US.UTF-8
  * configure arg: PYTHON=<python-prefix>/bin/python3.14

The native rule validates the same build-tool prefixes that Spack pulls into
the node, then runs the release tarball's generated configure script from
`source/` so the emitted include/lib/bin/pkgconfig tree can be ABI-gated
against the Spack reference prefix.
"""

_BUILD_TEMPLATE = """\
# GENERATED by icu4c_native. Native Bazel build of icu4c, intended to match
# the Spack icu4c install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = False),
    includes = [
        "prefix/include",
        "prefix/include/unicode",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "icu4c native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${AUTOCONF_PREFIX:-}" || ! -x "${AUTOCONF_PREFIX:-}/bin/autoreconf" ]]; then
  echo "AUTOCONF_PREFIX must name the Bazel-built autoconf prefix" >&2
  exit 2
fi
if [[ -z "${AUTOMAKE_PREFIX:-}" || ! -x "${AUTOMAKE_PREFIX:-}/bin/automake" || ! -x "${AUTOMAKE_PREFIX:-}/bin/aclocal" ]]; then
  echo "AUTOMAKE_PREFIX must name the Bazel-built automake prefix" >&2
  exit 2
fi
if [[ -z "${LIBTOOL_PREFIX:-}" || ! -x "${LIBTOOL_PREFIX:-}/bin/libtoolize" ]]; then
  echo "LIBTOOL_PREFIX must name the Bazel-built libtool prefix" >&2
  exit 2
fi
if [[ -z "${M4_PREFIX:-}" || ! -x "${M4_PREFIX:-}/bin/m4" ]]; then
  echo "M4_PREFIX must name the Bazel-built m4 prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built python prefix" >&2
  exit 2
fi

cd "$SRC/source"

export LC_ALL=en_US.UTF-8
export PATH="${AUTOCONF_PREFIX}/bin:${AUTOMAKE_PREFIX}/bin:${LIBTOOL_PREFIX}/bin:${M4_PREFIX}/bin:${PYTHON_PREFIX}/bin:${PATH}"
export M4="${M4_PREFIX}/bin/m4"
export PYTHON="${PYTHON_PREFIX}/bin/python3"
export CC=gcc
export CXX=g++
unset CFLAGS
export CXXFLAGS="-std=c++17"

./configure --prefix="$PREFIX" "PYTHON=${PYTHON}"

spack_target_flags="-march=icelake-client -mtune=icelake-client"
spack_cflags="-O2 -std=c11 -Wall -pedantic -Wshadow -Wpointer-arith -Wmissing-prototypes -Wwrite-strings"
spack_runtime_ldflags="-Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags"
make V=1 -j"${MAKE_JOBS:-$(nproc)}" \
  CFLAGS="${spack_cflags} ${spack_target_flags}" \
  CXXFLAGS+=" ${spack_target_flags}" \
  LDFLAGS+=" ${spack_runtime_ldflags}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true

# Spack's compiler wrapper injects target/RPATH flags at execution time without
# recording them in ICU's installed pkgdata metadata. Scrub the resolved files
# and keep Spack's top-level relative symlink shape intact.
for pkgdata in "$PREFIX/lib/icu/current/pkgdata.inc" "$PREFIX/lib/icu/76.1/pkgdata.inc"; do
  [[ -f "$pkgdata" ]] || continue
  sed -i \
    -e 's/ -march=icelake-client -mtune=icelake-client//g' \
    -e "s# -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags##g" \
    "$pkgdata"
done
rm -f "$PREFIX/lib/icu/pkgdata.inc"
ln -s current/pkgdata.inc "$PREFIX/lib/icu/pkgdata.inc"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("icu4c native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _icu4c_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("icu4c native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    autoconf_prefix = _read_prefix(repository_ctx, attr.autoconf_prefix_file, "autoconf")
    automake_prefix = _read_prefix(repository_ctx, attr.automake_prefix_file, "automake")
    libtool_prefix = _read_prefix(repository_ctx, attr.libtool_prefix_file, "libtool")
    m4_prefix = _read_prefix(repository_ctx, attr.m4_prefix_file, "m4")
    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "AUTOCONF_PREFIX": autoconf_prefix,
            "AUTOMAKE_PREFIX": automake_prefix,
            "LIBTOOL_PREFIX": libtool_prefix,
            "M4_PREFIX": m4_prefix,
            "PYTHON_PREFIX": python_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("icu4c native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-licuio",
        "-licutest",
        "-licutu",
        "-licui18n",
        "-licuuc",
        "-licudata",
        "-lpthread",
        "-lm",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


icu4c_native = repository_rule(
    implementation = _icu4c_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "autoconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "automake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libtool_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "m4_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build icu4c from source into a Spack-prefix-identical install tree.",
)
