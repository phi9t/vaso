"""Rootfs boundary for llvm-project 35901313 installed at /usr/lib/llvm-23."""

_BUILD_TEMPLATE = """\
# GENERATED by rootfs_llvm_23_native. Boundary for rootfs LLVM 23.
# Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files([
    "prefix_path.txt",
    "sdk_boundary.json",
])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
PREFIX="$1"

# rootfs-toolchain-boundary
if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "rootfs LLVM boundary must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${VASO_ROOTFS_BUNDLE_MANIFEST:-}" || ! -f "$VASO_ROOTFS_BUNDLE_MANIFEST" ]]; then
  echo "VASO_ROOTFS_BUNDLE_MANIFEST must point at the insula rootfs-bundle.json" >&2
  exit 2
fi
if [[ -z "${ROOTFS_LLVM_HOME:-}" || ! -x "${ROOTFS_LLVM_HOME:-}/bin/clang" ]]; then
  echo "ROOTFS_LLVM_HOME must name the rootfs LLVM prefix with bin/clang" >&2
  exit 2
fi

mapfile -t expected < <(python3 - "$VASO_ROOTFS_BUNDLE_MANIFEST" <<'PY'
import json
import sys

manifest = sys.argv[1]
data = json.load(open(manifest, encoding="utf-8"))
component = data.get("verified_versions", {}).get("components", {}).get("llvm", {})
commit = component.get("commit")
prefix = component.get("prefix")
version = component.get("expected")
if commit != "35901313800ea6e6cbeb9226e51c7c4b29bfc40e":
    raise SystemExit(f"rootfs manifest LLVM commit mismatch: {commit!r}")
if prefix != "/usr/lib/llvm-23":
    raise SystemExit(f"rootfs manifest LLVM prefix mismatch: {prefix!r}")
if version != "23.0.0git":
    raise SystemExit(f"rootfs manifest LLVM version mismatch: {version!r}")
print(commit)
print(prefix)
print(version)
PY
)
if [[ "${#expected[@]}" -ne 3 ]]; then
  echo "failed to read LLVM expected values from $VASO_ROOTFS_BUNDLE_MANIFEST" >&2
  exit 2
fi
if [[ "${expected[1]}" != "$ROOTFS_LLVM_HOME" ]]; then
  echo "ROOTFS_LLVM_HOME mismatch: expected ${expected[1]}, got $ROOTFS_LLVM_HOME" >&2
  exit 2
fi

for rel in \
  bin/clang \
  bin/clang++ \
  bin/ld.lld \
  bin/llvm-config \
  bin/FileCheck \
  include/llvm/Config/llvm-config.h \
  lib/cmake/llvm/LLVMConfig.cmake \
  lib/cmake/mlir/MLIRConfig.cmake; do
  if [[ ! -e "$ROOTFS_LLVM_HOME/$rel" ]]; then
    echo "rootfs LLVM prefix lacks $rel" >&2
    exit 2
  fi
done

actual="$("$ROOTFS_LLVM_HOME/bin/clang" --version)"
if [[ "$actual" != *"23.0.0git"* || "$actual" != *"35901313800ea6e6cbeb9226e51c7c4b29bfc40e"* ]]; then
  echo "rootfs LLVM clang version mismatch:" >&2
  printf '%s\n' "$actual" >&2
  exit 2
fi

rm -rf "$PREFIX"
mkdir -p "$PREFIX"
ln -s "$ROOTFS_LLVM_HOME/bin" "$PREFIX/bin"
ln -s "$ROOTFS_LLVM_HOME/include" "$PREFIX/include"
ln -s "$ROOTFS_LLVM_HOME/lib" "$PREFIX/lib"
if [[ -e "$ROOTFS_LLVM_HOME/.vaso-llvm-build.json" ]]; then
  ln -s "$ROOTFS_LLVM_HOME/.vaso-llvm-build.json" "$PREFIX/.vaso-llvm-build.json"
fi

python3 - "$PREFIX/sdk_boundary.json" "$VASO_ROOTFS_BUNDLE_MANIFEST" "$ROOTFS_LLVM_HOME" <<'PY'
import json
import sys

out, manifest_path, prefix = sys.argv[1:4]
manifest = json.load(open(manifest_path, encoding="utf-8"))
component = manifest["verified_versions"]["components"]["llvm"]
data = {
    "schema_version": 1,
    "mechanism": "sdk-boundary",
    "package": "llvm",
    "commit": component["commit"],
    "version": component["expected"],
    "prefix": prefix,
    "rootfs_bundle": manifest,
}
with open(out, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2, sort_keys=True)
    handle.write("\\n")
PY
"""


def _rootfs_llvm_23_native_impl(repository_ctx):
    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("rootfs LLVM boundary must run inside the hermetic insula (VASO_IN_INSULA=1)")

    manifest = repository_ctx.os.environ.get(
        "VASO_ROOTFS_BUNDLE_MANIFEST",
        "/run/vaso/rootfs-bundle.json",
    )
    prefix = repository_ctx.os.environ.get("ROOTFS_LLVM_HOME", "/usr/lib/llvm-23")
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("prefix"))],
        timeout = 120,
        quiet = False,
        environment = {
            "ROOTFS_LLVM_HOME": prefix,
            "VASO_IN_INSULA": "1",
            "VASO_ROOTFS_BUNDLE_MANIFEST": manifest,
        },
    )
    if res.return_code != 0:
        fail("rootfs LLVM boundary validation failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", str(repository_ctx.path("prefix")) + "\n")
    repository_ctx.symlink("prefix/sdk_boundary.json", "sdk_boundary.json")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


rootfs_llvm_23_native = repository_rule(
    implementation = _rootfs_llvm_23_native_impl,
    environ = [
        "ROOTFS_LLVM_HOME",
        "VASO_IN_INSULA",
        "VASO_ROOTFS_BUNDLE_MANIFEST",
    ],
    doc = "Expose rootfs llvm-project 35901313 at /usr/lib/llvm-23 as a native prefix boundary.",
)
