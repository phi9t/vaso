"""Native (Bazel-owned) build of gdbm into a Spack-identical prefix.

The hermetic Spack v1.2.2 gdbm@1.26 recipe is an AutotoolsPackage with:

  * depends_on("readline")
  * configure args: --enable-libgdbm-compat CPPFLAGS=-D_GNU_SOURCE

This rule fetches the same GNU release archive, consumes the Bazel-selected
native readline/ncurses prefixes, and emits a prefix/ABI-compatible install
tree for the generated @spack_gdbm provider alias.
"""

_BUILD_TEMPLATE = """\
# GENERATED by gdbm_native. Native Bazel build of gdbm, intended to match the
# Spack gdbm install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "gdbm native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${READLINE_PREFIX:-}" || ! -d "${READLINE_PREFIX:-}/lib" ]]; then
  echo "READLINE_PREFIX must name the Bazel-built readline prefix" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -d "${NCURSES_PREFIX:-}/lib" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi

cd "$SRC"

dep_cppflags="-I${READLINE_PREFIX}/include -I${READLINE_PREFIX}/include/readline -I${NCURSES_PREFIX}/include -I${NCURSES_PREFIX}/include/ncursesw"
export LDFLAGS="-L${READLINE_PREFIX}/lib -L${NCURSES_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,-rpath,${READLINE_PREFIX}/lib -Wl,-rpath,${NCURSES_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export PKG_CONFIG=/bin/false
export PKG_CONFIG_PATH="${READLINE_PREFIX}/lib/pkgconfig:${NCURSES_PREFIX}/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"

./configure \\
  --prefix="$PREFIX" \\
  --enable-libgdbm-compat \\
  "CPPFLAGS=-D_GNU_SOURCE ${dep_cppflags}"

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _gdbm_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    readline_prefix = repository_ctx.read(attr.readline_prefix_file).strip()
    if not readline_prefix:
        fail("gdbm native build requires a non-empty readline prefix path")
    ncurses_prefix = repository_ctx.read(attr.ncurses_prefix_file).strip()
    if not ncurses_prefix:
        fail("gdbm native build requires a non-empty ncurses prefix path")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "READLINE_PREFIX": readline_prefix,
            "NCURSES_PREFIX": ncurses_prefix,
        },
    )
    if res.return_code != 0:
        fail("gdbm native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    readline_lib = "{}/lib".format(readline_prefix)
    ncurses_lib = "{}/lib".format(ncurses_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lgdbm",
        "-lgdbm_compat",
        "-L" + readline_lib,
        "-Wl,-rpath," + readline_lib,
        "-lreadline",
        "-lhistory",
        "-L" + ncurses_lib,
        "-Wl,-rpath," + ncurses_lib,
        "-lncursesw",
        "-ltinfow",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


gdbm_native = repository_rule(
    implementation = _gdbm_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "readline_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build gdbm from source into a Spack-prefix-identical tree.",
)
