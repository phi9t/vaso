"""Native (Bazel-owned) build of fontconfig into a Spack-identical prefix.

The py-torch lean-font frontier captures fontconfig@2.15.0 as an
AutotoolsPackage. Its concrete Spack recipe enables libxml2 support, disables
docs, points the default font directory at the lean native font-util prefix,
and runs the upstream install-time cache/config generation inside the insula.
"""

_BUILD_TEMPLATE = """\
# GENERATED by fontconfig_native. Native Bazel build of fontconfig, intended to
# match the Spack fontconfig install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/fontconfig",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "fontconfig native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${FONT_UTIL_PREFIX:-}" || ! -f "${FONT_UTIL_PREFIX:-}/lib/pkgconfig/fontutil.pc" || ! -d "${FONT_UTIL_PREFIX:-}/share/fonts" ]]; then
  echo "FONT_UTIL_PREFIX must name the Bazel-built lean font-util prefix" >&2
  exit 2
fi
if [[ -z "${FREETYPE_PREFIX:-}" || ! -f "${FREETYPE_PREFIX:-}/lib/pkgconfig/freetype2.pc" || ! -e "${FREETYPE_PREFIX:-}/lib/libfreetype.so" ]]; then
  echo "FREETYPE_PREFIX must name the Bazel-built freetype prefix" >&2
  exit 2
fi
if [[ -z "${GPERF_PREFIX:-}" || ! -x "${GPERF_PREFIX:-}/bin/gperf" ]]; then
  echo "GPERF_PREFIX must name the Bazel-built gperf prefix" >&2
  exit 2
fi
if [[ -z "${LIBXML2_PREFIX:-}" || ! -f "${LIBXML2_PREFIX:-}/lib/pkgconfig/libxml-2.0.pc" || ! -e "${LIBXML2_PREFIX:-}/lib/libxml2.so" ]]; then
  echo "LIBXML2_PREFIX must name the Bazel-built libxml2 prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built python prefix" >&2
  exit 2
fi
if [[ -z "${UTIL_LINUX_UUID_PREFIX:-}" || ! -f "${UTIL_LINUX_UUID_PREFIX:-}/lib/pkgconfig/uuid.pc" || ! -e "${UTIL_LINUX_UUID_PREFIX:-}/lib/libuuid.so" ]]; then
  echo "UTIL_LINUX_UUID_PREFIX must name the Bazel-built util-linux-uuid prefix" >&2
  exit 2
fi

for var in BZIP2_PREFIX LIBICONV_PREFIX LIBPNG_PREFIX XZ_PREFIX ZLIB_PREFIX; do
  val="${!var:-}"
  if [[ -z "$val" || ! -d "$val" ]]; then
    echo "$var must name a Bazel-built transitive dependency prefix" >&2
    exit 2
  fi
done

cd "$SRC"

# Spack removes this generated header before configure so gperf regenerates it
# for the current toolchain.
rm -f src/fcobjshash.h

export PATH="${GPERF_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PYTHON_PREFIX}/bin:${PATH:-}"
export PYTHON="${PYTHON_PREFIX}/bin/python3"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${FONT_UTIL_PREFIX}/lib/pkgconfig:${FREETYPE_PREFIX}/lib/pkgconfig:${LIBXML2_PREFIX}/lib/pkgconfig:${UTIL_LINUX_UUID_PREFIX}/lib/pkgconfig:${BZIP2_PREFIX}/lib/pkgconfig:${LIBICONV_PREFIX}/lib/pkgconfig:${LIBPNG_PREFIX}/lib/pkgconfig:${XZ_PREFIX}/lib/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig:${PKGCONF_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${FONT_UTIL_PREFIX}/include -I${FREETYPE_PREFIX}/include -I${FREETYPE_PREFIX}/include/freetype2 -I${LIBXML2_PREFIX}/include/libxml2 -I${UTIL_LINUX_UUID_PREFIX}/include -I${BZIP2_PREFIX}/include -I${LIBICONV_PREFIX}/include -I${LIBPNG_PREFIX}/include/libpng16 -I${XZ_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${FONT_UTIL_PREFIX}/lib -Wl,-rpath,${FONT_UTIL_PREFIX}/lib -L${FREETYPE_PREFIX}/lib -Wl,-rpath,${FREETYPE_PREFIX}/lib -L${LIBXML2_PREFIX}/lib -Wl,-rpath,${LIBXML2_PREFIX}/lib -L${UTIL_LINUX_UUID_PREFIX}/lib -Wl,-rpath,${UTIL_LINUX_UUID_PREFIX}/lib -L${BZIP2_PREFIX}/lib -Wl,-rpath,${BZIP2_PREFIX}/lib -L${LIBICONV_PREFIX}/lib -Wl,-rpath,${LIBICONV_PREFIX}/lib -L${LIBPNG_PREFIX}/lib -Wl,-rpath,${LIBPNG_PREFIX}/lib -L${XZ_PREFIX}/lib -Wl,-rpath,${XZ_PREFIX}/lib -L${ZLIB_PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"

./configure \
  --prefix="$PREFIX" \
  --enable-libxml2 \
  --disable-docs \
  --with-default-fonts="${FONT_UTIL_PREFIX}/share/fonts"

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

"${PYTHON}" - "$PREFIX/etc/fonts/fonts.conf" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
data = path.read_text()
data = data.replace(
    '<dir prefix="xdg">fonts</dir>',
    '<dir prefix="xdg">fonts</dir><dir>/usr/share/fonts</dir>',
)
path.write_text(data)
PY

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("fontconfig native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _fontconfig_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("fontconfig native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    font_util_prefix = _read_prefix(repository_ctx, attr.font_util_prefix_file, "font-util")
    freetype_prefix = _read_prefix(repository_ctx, attr.freetype_prefix_file, "freetype")
    gperf_prefix = _read_prefix(repository_ctx, attr.gperf_prefix_file, "gperf")
    libiconv_prefix = _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv")
    libpng_prefix = _read_prefix(repository_ctx, attr.libpng_prefix_file, "libpng")
    libxml2_prefix = _read_prefix(repository_ctx, attr.libxml2_prefix_file, "libxml2")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    util_linux_uuid_prefix = _read_prefix(repository_ctx, attr.util_linux_uuid_prefix_file, "util-linux-uuid")
    xz_prefix = _read_prefix(repository_ctx, attr.xz_prefix_file, "xz")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "BZIP2_PREFIX": bzip2_prefix,
            "FONT_UTIL_PREFIX": font_util_prefix,
            "FREETYPE_PREFIX": freetype_prefix,
            "GPERF_PREFIX": gperf_prefix,
            "LIBICONV_PREFIX": libiconv_prefix,
            "LIBPNG_PREFIX": libpng_prefix,
            "LIBXML2_PREFIX": libxml2_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "PYTHON_PREFIX": python_prefix,
            "UTIL_LINUX_UUID_PREFIX": util_linux_uuid_prefix,
            "VASO_IN_INSULA": "1",
            "XZ_PREFIX": xz_prefix,
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("fontconfig native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-l:libfontconfig.so.1",
        "-L" + "{}/lib".format(freetype_prefix),
        "-Wl,-rpath," + "{}/lib".format(freetype_prefix),
        "-l:libfreetype.so.6",
        "-L" + "{}/lib".format(libxml2_prefix),
        "-Wl,-rpath," + "{}/lib".format(libxml2_prefix),
        "-l:libxml2.so.2",
        "-L" + "{}/lib".format(util_linux_uuid_prefix),
        "-Wl,-rpath," + "{}/lib".format(util_linux_uuid_prefix),
        "-l:libuuid.so.1",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


fontconfig_native = repository_rule(
    implementation = _fontconfig_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "font_util_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "freetype_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gperf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpng_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libxml2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "util_linux_uuid_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build fontconfig from source into a Spack-prefix-identical install tree.",
)
