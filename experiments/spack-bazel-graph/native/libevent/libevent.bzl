"""Native (Bazel-owned) build of libevent into a Spack-identical prefix.

The hermetic Spack v1.2.2 libevent@2.1.12 recipe is an AutotoolsPackage. The
concrete py-torch frontier variant enables OpenSSL, installs shared+static
libevent libraries, and exposes the event, event_core, event_extra,
event_openssl, and event_pthreads link surface.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libevent_native. Native Bazel build of libevent, intended to
# match the Spack libevent install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/event2",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libevent native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${OPENSSL_PREFIX:-}" || ! -f "${OPENSSL_PREFIX:-}/include/openssl/ssl.h" ]]; then
  echo "OPENSSL_PREFIX must name the Bazel-built OpenSSL prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

openssl_libdir="$OPENSSL_PREFIX/lib64"
if [[ ! -d "$openssl_libdir" ]]; then
  openssl_libdir="$OPENSSL_PREFIX/lib"
fi
zlib_libdir="$ZLIB_PREFIX/lib"
for path in "$openssl_libdir/libssl.so" "$openssl_libdir/libcrypto.so" "$zlib_libdir/libz.so"; do
  [[ -e "$path" ]] || { echo "libevent dependency library missing: $path" >&2; exit 2; }
done

cd "$SRC"

export PATH="${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${openssl_libdir}/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${OPENSSL_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${openssl_libdir} -Wl,-rpath,${openssl_libdir} -L${zlib_libdir} -Wl,-rpath,${zlib_libdir} -Wl,--disable-new-dtags ${LDFLAGS:-}"
export CC="${CC:-gcc}"

./configure \\
  --prefix="$PREFIX" \\
  --enable-openssl

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true

# Match the exact pkg-config whitespace emitted by the hermetic Spack
# Autotools recipe. The ABI parity gate normalizes prefixes but still checks
# metadata bytes after normalization.
pc="$PREFIX/lib/pkgconfig/libevent_openssl.pc"
tmp="${pc}.tmp"
while IFS= read -r line; do
  case "$line" in
    Libs.private:*) printf 'Libs.private:  -L%s -lssl -lcrypto    \n' "$openssl_libdir" ;;
    Cflags:*) printf 'Cflags: -I${includedir} -I%s/include \n' "$OPENSSL_PREFIX" ;;
    *) printf '%s\n' "$line" ;;
  esac
done < "$pc" > "$tmp"
mv "$tmp" "$pc"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libevent native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libevent_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libevent native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    openssl_prefix = _read_prefix(repository_ctx, attr.openssl_prefix_file, "openssl")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 2400,
        quiet = False,
        environment = {
            "OPENSSL_PREFIX": openssl_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "ZLIB_PREFIX": zlib_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("libevent native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)

    dep_libs = []
    for dep_prefix in (openssl_prefix, zlib_prefix):
        dep_lib = "{}/lib64".format(dep_prefix)
        if not repository_ctx.path(dep_lib).exists:
            dep_lib = "{}/lib".format(dep_prefix)
        dep_libs.append(dep_lib)

    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-levent",
        "-levent_core",
        "-levent_extra",
        "-levent_openssl",
        "-levent_pthreads",
    ]
    for dep_lib in dep_libs:
        linkopts.extend([
            "-L" + dep_lib,
            "-Wl,-rpath," + dep_lib,
        ])
    linkopts.extend(["-lssl", "-lcrypto", "-lz", "-pthread"])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libevent_native = repository_rule(
    implementation = _libevent_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "openssl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libevent from source into a Spack-prefix-identical install tree.",
)
