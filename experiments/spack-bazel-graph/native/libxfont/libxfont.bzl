"""Native (Bazel-owned) build of libXfont into a Spack-identical prefix.

The py-torch frontier captures libxfont@1.5.4 as an AutotoolsPackage. It
consumes X.Org protocol/header prefixes, freetype, libfontenc, pkgconf,
util-macros, zlib, and freetype's private pkg-config deps explicitly so
configure/pkg-config/linker discovery stays inside the Bazel-owned insula
graph.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libxfont_native. Native Bazel build of libXfont, intended to
# match the Spack libxfont install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/X11/fonts",
    ],
    linkopts = {linkopts},
    deps = [
        "@fontsproto_native//:lib",
        "@freetype_native//:lib",
        "@libfontenc_native//:lib",
        "@xproto_native//:lib",
        "@xtrans_native//:lib",
        "@zlib_ng_native//:lib",
    ],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libxfont native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BZIP2_PREFIX:-}" || ! -f "${BZIP2_PREFIX:-}/lib/pkgconfig/bzip2.pc" || ! -e "${BZIP2_PREFIX:-}/lib/libbz2.so" ]]; then
  echo "BZIP2_PREFIX must name the Bazel-built bzip2 prefix used by freetype pkg-config metadata" >&2
  exit 2
fi
if [[ -z "${FONTSPROTO_PREFIX:-}" || ! -f "${FONTSPROTO_PREFIX:-}/lib/pkgconfig/fontsproto.pc" ]]; then
  echo "FONTSPROTO_PREFIX must name the Bazel-built fontsproto prefix" >&2
  exit 2
fi
if [[ -z "${FREETYPE_PREFIX:-}" || ! -f "${FREETYPE_PREFIX:-}/lib/pkgconfig/freetype2.pc" || ! -e "${FREETYPE_PREFIX:-}/lib/libfreetype.so" ]]; then
  echo "FREETYPE_PREFIX must name the Bazel-built freetype prefix" >&2
  exit 2
fi
if [[ -z "${LIBFONTENC_PREFIX:-}" || ! -f "${LIBFONTENC_PREFIX:-}/lib/pkgconfig/fontenc.pc" || ! -e "${LIBFONTENC_PREFIX:-}/lib/libfontenc.so" ]]; then
  echo "LIBFONTENC_PREFIX must name the Bazel-built libfontenc prefix" >&2
  exit 2
fi
if [[ -z "${LIBPNG_PREFIX:-}" || ! -f "${LIBPNG_PREFIX:-}/lib/pkgconfig/libpng.pc" || ! -e "${LIBPNG_PREFIX:-}/lib/libpng16.so" ]]; then
  echo "LIBPNG_PREFIX must name the Bazel-built libpng prefix used by freetype pkg-config metadata" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${UTIL_MACROS_PREFIX:-}" || ! -f "${UTIL_MACROS_PREFIX:-}/share/aclocal/xorg-macros.m4" ]]; then
  echo "UTIL_MACROS_PREFIX must name the Bazel-built util-macros prefix" >&2
  exit 2
fi
if [[ -z "${XPROTO_PREFIX:-}" || ! -f "${XPROTO_PREFIX:-}/lib/pkgconfig/xproto.pc" ]]; then
  echo "XPROTO_PREFIX must name the Bazel-built xproto prefix" >&2
  exit 2
fi
if [[ -z "${XTRANS_PREFIX:-}" || ! -f "${XTRANS_PREFIX:-}/share/pkgconfig/xtrans.pc" ]]; then
  echo "XTRANS_PREFIX must name the Bazel-built xtrans prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

cd "$SRC"

export PATH="${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${BZIP2_PREFIX}/lib/pkgconfig:${FONTSPROTO_PREFIX}/lib/pkgconfig:${FREETYPE_PREFIX}/lib/pkgconfig:${LIBFONTENC_PREFIX}/lib/pkgconfig:${LIBPNG_PREFIX}/lib/pkgconfig:${PKGCONF_PREFIX}/lib/pkgconfig:${XPROTO_PREFIX}/lib/pkgconfig:${XTRANS_PREFIX}/share/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig:${UTIL_MACROS_PREFIX}/share/pkgconfig"
export ACLOCAL_PATH="${UTIL_MACROS_PREFIX}/share/aclocal:${PKGCONF_PREFIX}/share/aclocal${ACLOCAL_PATH:+:${ACLOCAL_PATH}}"
export CPPFLAGS="-I${BZIP2_PREFIX}/include -I${FONTSPROTO_PREFIX}/include -I${FREETYPE_PREFIX}/include -I${FREETYPE_PREFIX}/include/freetype2 -I${LIBFONTENC_PREFIX}/include -I${LIBPNG_PREFIX}/include/libpng16 -I${XPROTO_PREFIX}/include -I${XTRANS_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${BZIP2_PREFIX}/lib -Wl,-rpath,${BZIP2_PREFIX}/lib -L${FREETYPE_PREFIX}/lib -Wl,-rpath,${FREETYPE_PREFIX}/lib -L${LIBFONTENC_PREFIX}/lib -Wl,-rpath,${LIBFONTENC_PREFIX}/lib -L${LIBPNG_PREFIX}/lib -Wl,-rpath,${LIBPNG_PREFIX}/lib -L${ZLIB_PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LIBS="-lz -lm ${LIBS:-}"

./configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libxfont native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libxfont_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libxfont native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    fontsproto_prefix = _read_prefix(repository_ctx, attr.fontsproto_prefix_file, "fontsproto")
    freetype_prefix = _read_prefix(repository_ctx, attr.freetype_prefix_file, "freetype")
    libfontenc_prefix = _read_prefix(repository_ctx, attr.libfontenc_prefix_file, "libfontenc")
    libpng_prefix = _read_prefix(repository_ctx, attr.libpng_prefix_file, "libpng")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    util_macros_prefix = _read_prefix(repository_ctx, attr.util_macros_prefix_file, "util-macros")
    xproto_prefix = _read_prefix(repository_ctx, attr.xproto_prefix_file, "xproto")
    xtrans_prefix = _read_prefix(repository_ctx, attr.xtrans_prefix_file, "xtrans")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "BZIP2_PREFIX": bzip2_prefix,
            "FONTSPROTO_PREFIX": fontsproto_prefix,
            "FREETYPE_PREFIX": freetype_prefix,
            "LIBFONTENC_PREFIX": libfontenc_prefix,
            "LIBPNG_PREFIX": libpng_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "UTIL_MACROS_PREFIX": util_macros_prefix,
            "VASO_IN_INSULA": "1",
            "XPROTO_PREFIX": xproto_prefix,
            "XTRANS_PREFIX": xtrans_prefix,
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("libxfont native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    dep_libs = [
        "{}/lib".format(freetype_prefix),
        "{}/lib".format(libfontenc_prefix),
        "{}/lib".format(libpng_prefix),
        "{}/lib".format(bzip2_prefix),
        "{}/lib".format(zlib_prefix),
    ]
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lXfont",
    ]
    for dep_lib in dep_libs:
        linkopts.extend(["-L" + dep_lib, "-Wl,-rpath," + dep_lib])
    linkopts.extend(["-lfreetype", "-lz", "-lm", "-lfontenc", "-lpng16", "-lbz2"])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libxfont_native = repository_rule(
    implementation = _libxfont_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "fontsproto_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "freetype_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libfontenc_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpng_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "util_macros_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xproto_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xtrans_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libXfont from source into a Spack-prefix-identical install tree.",
)
