"""Native (Bazel-owned) build of zstd from source into a Spack-identical prefix.

Third migration node and the first *makefile*-build-system proof. Mirrors the
zlib_ng / utf8proc native rules but reproduces Spack's `MakefileBuilder` (an
`edit` -> `build` -> `install` pipeline that drives the project's own Makefile
directly, with no configure/cmake step). See docs/recipes/zstd.md.

`zstd_native` reproduces the exact `make` targets Spack's zstd package runs for
the concretized variant set (libs=shared,static; programs=True;
compression=none): the library install via `make -C lib ... install-pc
install-includes install-shared install-static` and the programs via
`make -C programs ... HAVE_ZLIB=0 HAVE_LZMA=0 HAVE_LZ4=0 install`. The emitted
`include/`, `lib/libzstd.so.1.5.7`+SONAME, static `libzstd.a`, `pkgconfig`, and
`bin/zstd*` are byte/ABI-identical (verified by tools/abi_parity.py — this one
exercises the soname+symbol axis, unlike static-only utf8proc).
"""

_BUILD_TEMPLATE = """\
# GENERATED by zstd_native. Native Bazel build of zstd, prefix-identical to the
# Spack zstd install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

# Reproduces Spack MakefileBuilder.install() for libs=shared,static +programs,
# compression=none. There is no configure/cmake step (the `build` phase is a
# no-op for this package; install targets build what they need).
_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"      # extracted source dir
PREFIX="$2"   # install prefix (absolute)
JOBS="${MAKE_JOBS:-$(nproc)}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "zstd native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

# Library: pkgconfig + headers + shared + static, matching the Spack targets.
make -C "$SRC/lib" -j"$JOBS" VERBOSE=1 PREFIX="$PREFIX" \
  install-pc install-includes install-shared install-static
# Programs, with the same compression backends disabled Spack disables.
make -C "$SRC/programs" -j"$JOBS" VERBOSE=1 PREFIX="$PREFIX" \
  HAVE_ZLIB=0 HAVE_LZMA=0 HAVE_LZ4=0 install
"""

def _zstd_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("zstd native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lzstd"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )

zstd_native = repository_rule(
    implementation = _zstd_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build zstd from source into a Spack-prefix-identical install tree.",
)
