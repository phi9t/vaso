"""Native (Bazel-owned) build of protobuf into a Spack-identical prefix.

The native PyTorch frontier uses the protobuf family from upstream PyTorch's
release source. PyTorch v2.14.0 pins third_party/protobuf at tag v3.21.12. The
native provider builds shared libraries, disables tests, enables PIC, and
consumes zlib-ng as the zlib provider.
"""

_BUILD_TEMPLATE = """\
# GENERATED by protobuf_native. Native Bazel build of protobuf, intended to
# match the Spack protobuf install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/google",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
CMAKE_SOURCE="$SRC/${CMAKE_SOURCE_SUBDIR:-.}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "protobuf native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-built CMake prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

CMAKE="$CMAKE_PREFIX/bin/cmake"
BUILD="$(mktemp -d)"
cd "$BUILD"

zlib_libdir="$ZLIB_PREFIX/lib"
spack_target_flags="-march=icelake-client -mtune=icelake-client"
export PATH="${CMAKE_PREFIX}/bin:${PATH}"
export CMAKE_PREFIX_PATH="${ZLIB_PREFIX};${CMAKE_PREFIX}"
export CMAKE_LIBRARY_PATH="${zlib_libdir}"
export CMAKE_INCLUDE_PATH="${ZLIB_PREFIX}/include"
export LD_LIBRARY_PATH="${zlib_libdir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

"$CMAKE" -G "Unix Makefiles" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  -DCMAKE_INSTALL_RPATH_USE_LINK_PATH:BOOL=ON \
  "-DCMAKE_INSTALL_RPATH:STRING=${PREFIX}/lib;${PREFIX}/lib64;${zlib_libdir}" \
  "-DCMAKE_PREFIX_PATH:STRING=${ZLIB_PREFIX};${CMAKE_PREFIX}" \
  -DCMAKE_C_COMPILER:FILEPATH=/usr/bin/gcc \
  -DCMAKE_CXX_COMPILER:FILEPATH=/usr/bin/g++ \
  "-DCMAKE_C_FLAGS:STRING=${spack_target_flags}" \
  "-DCMAKE_CXX_FLAGS:STRING=${spack_target_flags}" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_VERBOSE_MAKEFILE:BOOL=ON \
  -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON \
  -DBUILD_SHARED_LIBS:BOOL=ON \
  -Dprotobuf_BUILD_TESTS:BOOL=OFF \
  -DZLIB_ROOT:PATH="$ZLIB_PREFIX" \
  "$CMAKE_SOURCE"
make -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("protobuf native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _protobuf_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("protobuf native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    if attr.patch_urls:
        patch_path = repository_ctx.path("protobuf.patch")
        repository_ctx.download(
            url = attr.patch_urls,
            sha256 = attr.patch_sha256,
            output = patch_path,
        )
        patch = repository_ctx.execute(
            ["patch", "-d", "src", "-p1", "-i", str(patch_path)],
            timeout = 120,
            quiet = False,
        )
        if patch.return_code != 0:
            fail("protobuf patch failed (rc={}):\n{}\n{}".format(
                patch.return_code,
                patch.stdout,
                patch.stderr,
            ))
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "ZLIB_PREFIX": zlib_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("protobuf native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    zlib_lib = zlib_prefix + "/lib"

    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lprotobuf",
        "-lprotobuf-lite",
        "-lprotoc",
        "-L" + zlib_lib,
        "-Wl,-rpath," + zlib_lib,
        "-lz",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


protobuf_native = repository_rule(
    implementation = _protobuf_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "patch_urls": attr.string_list(default = []),
        "patch_sha256": attr.string(default = ""),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build protobuf from source into a Spack-prefix-identical install tree.",
)
