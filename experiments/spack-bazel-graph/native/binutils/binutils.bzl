"""Native (Bazel-owned) build of GNU binutils into a Spack-identical prefix.

The lean PyTorch frontier captures binutils@2.46.1 as an AutotoolsPackage with
shared/static libraries, plugins enabled, gas/ld/gprofng disabled, NLS disabled,
and zlib debug-section compression. The native rule consumes only Bazel-built
dependency prefixes and refuses host-root execution.
"""

_BUILD_TEMPLATE = """\
# GENERATED by binutils_native. Native Bazel build of GNU binutils, intended to
# match the Spack binutils install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "binutils native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${DIFFUTILS_PREFIX:-}" || ! -x "${DIFFUTILS_PREFIX:-}/bin/diff" || ! -x "${DIFFUTILS_PREFIX:-}/bin/cmp" ]]; then
  echo "DIFFUTILS_PREFIX must name the Bazel-built diffutils prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi
if [[ -z "${ZSTD_PREFIX:-}" || ! -f "${ZSTD_PREFIX:-}/include/zstd.h" || ! -e "${ZSTD_PREFIX:-}/lib/libzstd.so" ]]; then
  echo "ZSTD_PREFIX must name the Bazel-built zstd prefix" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

zlib_libdir="$ZLIB_PREFIX/lib"
zstd_libdir="$ZSTD_PREFIX/lib"
dep_rpath="${PREFIX}/lib:${zstd_libdir}:${zlib_libdir}"

export PATH="${DIFFUTILS_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${ZLIB_PREFIX}/lib/pkgconfig:${ZSTD_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${ZLIB_PREFIX}/include -I${ZSTD_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 -march=icelake-client -mtune=icelake-client ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 -march=icelake-client -mtune=icelake-client ${CXXFLAGS:-}"
export LDFLAGS="-L${zlib_libdir} -L${zstd_libdir} -Wl,-rpath,${dep_rpath} -Wl,--disable-new-dtags ${LDFLAGS:-}"

../configure \\
  --prefix="$PREFIX" \\
  --disable-dependency-tracking \\
  --disable-werror \\
  --enable-64-bit-bfd \\
  --enable-deterministic-archives \\
  --enable-multilib \\
  --enable-pic \\
  --enable-targets=x86_64-linux-gnu \\
  --with-sysroot=/ \\
  --with-system-zlib \\
  --disable-gas \\
  --disable-gprofng \\
  --disable-install-libiberty \\
  --disable-interwork \\
  --disable-ld \\
  --enable-shared \\
  --enable-static \\
  --disable-lto \\
  --disable-nls \\
  --enable-plugins \\
  --without-debuginfod \\
  --disable-pgo-build \\
  --enable-compressed-debug-sections=all \\
  --enable-default-compressed-debug-sections-algorithm=zlib

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Match the Spack prefix surface: no libtool archives, manpages, or locale
# payload for this concretization.
find "$PREFIX" -type f -name '*.la' -delete || true
rm -rf "$PREFIX/share/man" "$PREFIX/share/locale"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("binutils native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _binutils_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("binutils native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    diffutils_prefix = _read_prefix(repository_ctx, attr.diffutils_prefix_file, "diffutils")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")
    zstd_prefix = _read_prefix(repository_ctx, attr.zstd_prefix_file, "zstd")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "DIFFUTILS_PREFIX": diffutils_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "VASO_IN_INSULA": "1",
            "ZLIB_PREFIX": zlib_prefix,
            "ZSTD_PREFIX": zstd_prefix,
        },
    )
    if res.return_code != 0:
        fail("binutils native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lbfd",
        "-lopcodes",
        "-lctf",
        "-lctf-nobfd",
        "-lsframe",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


binutils_native = repository_rule(
    implementation = _binutils_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "diffutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zstd_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU binutils from source into a Spack-prefix-identical tree.",
)
