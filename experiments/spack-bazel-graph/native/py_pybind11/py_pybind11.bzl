"""Native (Bazel-owned) py-pybind11 prefix."""

load("//native/common:python_abi.bzl", "python_abi_from_interpreter_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_pybind11_native. Native Bazel build of py-pybind11.
# Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-pybind11 native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-built native CMake prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja-build" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built native Ninja prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PY_PACKAGING_PREFIX:-}" || ! -d "${PY_PACKAGING_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/packaging" ]]; then
  echo "PY_PACKAGING_PREFIX must name the Bazel-built native py-packaging prefix" >&2
  exit 2
fi
if [[ -z "${PY_PATHSPEC_PREFIX:-}" || ! -d "${PY_PATHSPEC_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pathspec" ]]; then
  echo "PY_PATHSPEC_PREFIX must name the Bazel-built native py-pathspec prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SCIKIT_BUILD_CORE_PREFIX:-}" || ! -d "${PY_SCIKIT_BUILD_CORE_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/scikit_build_core" ]]; then
  echo "PY_SCIKIT_BUILD_CORE_PREFIX must name the Bazel-built native py-scikit-build-core prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export CMAKE_EXECUTABLE="$CMAKE_PREFIX/bin/cmake"
export PYTHONPATH="$PY_PACKAGING_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PATHSPEC_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SCIKIT_BUILD_CORE_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$CMAKE_PREFIX/bin:$NINJA_PREFIX/bin:$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:/usr/bin:/bin"

: "${TMPDIR:?TMPDIR must be set}"
BUILD="$(mktemp -d -p "$TMPDIR")"
"$CMAKE_PREFIX/bin/cmake" -G Ninja \
  -DCMAKE_MAKE_PROGRAM:FILEPATH="$NINJA_PREFIX/bin/ninja-build" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  "-DCMAKE_PREFIX_PATH:STRING=${CMAKE_PREFIX};${NINJA_PREFIX};${PYTHON_VENV_PREFIX}" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF \
  -DCMAKE_POLICY_DEFAULT_CMP0090:STRING=NEW \
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF \
  -DPYBIND11_TEST:BOOL=OFF \
  -DPYBIND11_INSTALL:BOOL=ON \
  -Dprefix_for_pc_file:STRING="$PREFIX" \
  -DPython_EXECUTABLE:FILEPATH="$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" \
  -DPython3_EXECUTABLE:FILEPATH="$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" \
  -S "$SRC" \
  -B "$BUILD"
"$NINJA_PREFIX/bin/ninja-build" -C "$BUILD" -v install

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --config-settings=cmake.define.CMAKE_MAKE_PROGRAM="$NINJA_PREFIX/bin/ninja-build" \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -d "$site_packages/pybind11"
test -f "$site_packages/pybind11/__init__.py"
test -f "$PREFIX/include/pybind11/pybind11.h"
if [[ ! -f "$PREFIX/share/cmake/pybind11/pybind11Config.cmake" && ! -f "$site_packages/pybind11/share/cmake/pybind11/pybind11Config.cmake" ]]; then
  echo "py-pybind11 native build did not install pybind11Config.cmake" >&2
  exit 2
fi
test -f "$site_packages/pybind11-3.0.2.dist-info/METADATA"
test -f "$site_packages/pybind11-3.0.2.dist-info/WHEEL"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-pybind11 native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_pybind11_native_impl(repository_ctx):
    attr = repository_ctx.attr
    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-pybind11 native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")
    ninja_prefix = _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja")
    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    python_abi = python_abi_from_interpreter_prefix(repository_ctx, python_venv_prefix, "python-venv")
    py_packaging_prefix = _read_prefix(repository_ctx, attr.py_packaging_prefix_file, "py-packaging")
    py_pathspec_prefix = _read_prefix(repository_ctx, attr.py_pathspec_prefix_file, "py-pathspec")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_scikit_build_core_prefix = _read_prefix(repository_ctx, attr.py_scikit_build_core_prefix_file, "py-scikit-build-core")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "NINJA_PREFIX": ninja_prefix,
            "PYTHON_ABI": python_abi,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PACKAGING_PREFIX": py_packaging_prefix,
            "PY_PATHSPEC_PREFIX": py_pathspec_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_SCIKIT_BUILD_CORE_PREFIX": py_scikit_build_core_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-pybind11 native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_pybind11_native = repository_rule(
    implementation = _py_pybind11_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_packaging_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pathspec_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_scikit_build_core_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-pybind11@3.0.2 from source into a Spack-compatible prefix.",
)
