"""Native (Bazel-owned) build of libfontenc into a Spack-identical prefix.

The py-torch frontier captures libfontenc@1.1.8 as an AutotoolsPackage. It
links against zlib and consumes xproto, pkgconf, and util-macros as build-time
prefixes.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libfontenc_native. Native Bazel build of libfontenc, intended to
# match the Spack libfontenc install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/X11/fonts",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libfontenc native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${UTIL_MACROS_PREFIX:-}" || ! -f "${UTIL_MACROS_PREFIX:-}/share/aclocal/xorg-macros.m4" ]]; then
  echo "UTIL_MACROS_PREFIX must name the Bazel-built util-macros prefix" >&2
  exit 2
fi
if [[ -z "${XPROTO_PREFIX:-}" || ! -f "${XPROTO_PREFIX:-}/lib/pkgconfig/xproto.pc" ]]; then
  echo "XPROTO_PREFIX must name the Bazel-built xproto prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -d "${ZLIB_PREFIX:-}/lib" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

cd "$SRC"

export PATH="${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${PKGCONF_PREFIX}/lib/pkgconfig:${XPROTO_PREFIX}/lib/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig:${UTIL_MACROS_PREFIX}/share/pkgconfig"
export ACLOCAL_PATH="${UTIL_MACROS_PREFIX}/share/aclocal${ACLOCAL_PATH:+:${ACLOCAL_PATH}}"
export CPPFLAGS="-I${XPROTO_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${ZLIB_PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LIBS="-lz ${LIBS:-}"

./configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libfontenc native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libfontenc_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libfontenc native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    util_macros_prefix = _read_prefix(repository_ctx, attr.util_macros_prefix_file, "util-macros")
    xproto_prefix = _read_prefix(repository_ctx, attr.xproto_prefix_file, "xproto")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "PKGCONF_PREFIX": pkgconf_prefix,
            "UTIL_MACROS_PREFIX": util_macros_prefix,
            "XPROTO_PREFIX": xproto_prefix,
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("libfontenc native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    zlib_lib = "{}/lib".format(zlib_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lfontenc",
        "-L" + zlib_lib,
        "-Wl,-rpath," + zlib_lib,
        "-lz",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libfontenc_native = repository_rule(
    implementation = _libfontenc_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "util_macros_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xproto_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libfontenc from source into a Spack-prefix-identical tree.",
)
