"""Native (Bazel-owned) build of re2c into a Spack-identical prefix.

The focused py-torch frontier captures re2c@4.4 as an AutotoolsPackage. The
concrete Spack build uses an out-of-tree spack-build directory, Python as a
build dependency, and configures with libraries plus generated wrappers.
"""

_BUILD_TEMPLATE = """\
# GENERATED by re2c_native. Native Bazel build of re2c, intended to match the
# Spack re2c install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "re2c native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built Python prefix" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

spack_target_flags="-march=icelake-client -mtune=icelake-client"
export PATH="${PYTHON_PREFIX}/bin:${PATH}"
export CFLAGS="${spack_target_flags} ${CFLAGS:-}"
export CXXFLAGS="${spack_target_flags} ${CXXFLAGS:-}"

../configure \\
  --prefix="$PREFIX" \\
  --disable-benchmarks \\
  --disable-debug \\
  --disable-dependency-tracking \\
  --disable-docs \\
  --disable-lexers \\
  --enable-libs \\
  --enable-golang
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack removes libtool archives from emitted prefixes.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("re2c native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _re2c_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("re2c native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "PYTHON_PREFIX": python_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("re2c native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lre2c"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


re2c_native = repository_rule(
    implementation = _re2c_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build re2c from source into a Spack-prefix-identical tree.",
)
