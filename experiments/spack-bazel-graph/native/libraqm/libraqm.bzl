"""Native (Bazel-owned) build of libraqm into a Spack-identical prefix.

The hermetic Spack v1.2.2 libraqm@0.10.5 recipe is a MesonPackage. The
concrete frontier variant uses Meson's default FriBidi bidi backend and links
against FreeType, HarfBuzz, and FriBidi through pkg-config.
"""

load("//native/common:python_abi.bzl", "python_abi_from_site_packages_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by libraqm_native. Native Bazel build of libraqm, intended to
# match the Spack libraqm install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = False),
    includes = [
        "prefix/include",
    ],
    linkopts = {linkopts},
    deps = [
        "@bzip2_native//:lib",
        "@freetype_native//:lib",
        "@fribidi_native//:lib",
        "@glib_native//:lib",
        "@harfbuzz_native//:lib",
        "@libpng_native//:lib",
        "@pcre2_native//:lib",
        "@zlib_ng_native//:lib",
    ],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: meson
SRC="$1"
PREFIX="$2"
BUILD_DIR="$PWD/build"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libraqm native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${FREETYPE_PREFIX:-}" || ! -f "${FREETYPE_PREFIX:-}/include/freetype2/ft2build.h" || ! -e "${FREETYPE_PREFIX:-}/lib/libfreetype.so" ]]; then
  echo "FREETYPE_PREFIX must name the Bazel-built freetype prefix" >&2
  exit 2
fi
if [[ -z "${BZIP2_PREFIX:-}" || ! -f "${BZIP2_PREFIX:-}/lib/pkgconfig/bzip2.pc" || ! -e "${BZIP2_PREFIX:-}/lib/libbz2.so" ]]; then
  echo "BZIP2_PREFIX must name the Bazel-built bzip2 prefix required by freetype2.pc" >&2
  exit 2
fi
if [[ -z "${FRIBIDI_PREFIX:-}" || ! -f "${FRIBIDI_PREFIX:-}/include/fribidi/fribidi.h" || ! -e "${FRIBIDI_PREFIX:-}/lib/libfribidi.so" ]]; then
  echo "FRIBIDI_PREFIX must name the Bazel-built fribidi prefix" >&2
  exit 2
fi
if [[ -z "${HARFBUZZ_PREFIX:-}" || ! -f "${HARFBUZZ_PREFIX:-}/include/harfbuzz/hb.h" || ! -e "${HARFBUZZ_PREFIX:-}/lib/libharfbuzz.so" ]]; then
  echo "HARFBUZZ_PREFIX must name the Bazel-built harfbuzz prefix" >&2
  exit 2
fi
if [[ -z "${GLIB_PREFIX:-}" || ! -f "${GLIB_PREFIX:-}/lib/pkgconfig/glib-2.0.pc" || ! -e "${GLIB_PREFIX:-}/lib/libglib-2.0.so" ]]; then
  echo "GLIB_PREFIX must name the Bazel-built glib prefix required by harfbuzz.pc" >&2
  exit 2
fi
if [[ -z "${LIBPNG_PREFIX:-}" || ! -f "${LIBPNG_PREFIX:-}/lib/pkgconfig/libpng.pc" || ! -e "${LIBPNG_PREFIX:-}/lib/libpng16.so" ]]; then
  echo "LIBPNG_PREFIX must name the Bazel-built libpng prefix required by freetype2.pc" >&2
  exit 2
fi
if [[ -z "${MESON_PREFIX:-}" || ! -x "${MESON_PREFIX:-}/bin/meson" ]]; then
  echo "MESON_PREFIX must name the Bazel-built Meson prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -d "${MESON_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/mesonbuild" ]]; then
  echo "PYTHON_ABI must match the Bazel-built Meson prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built Ninja prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${PCRE2_PREFIX:-}" || ! -f "${PCRE2_PREFIX:-}/lib/pkgconfig/libpcre2-8.pc" || ! -e "${PCRE2_PREFIX:-}/lib/libpcre2-8.so" ]]; then
  echo "PCRE2_PREFIX must name the Bazel-built pcre2 prefix required by glib-2.0.pc" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/lib/pkgconfig/zlib.pc" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix required by libpng.pc" >&2
  exit 2
fi

rm -rf "$BUILD_DIR" "$PREFIX"
mkdir -p "$BUILD_DIR"

dep_libs=(
  "$BZIP2_PREFIX/lib"
  "$FREETYPE_PREFIX/lib"
  "$FRIBIDI_PREFIX/lib"
  "$GLIB_PREFIX/lib"
  "$HARFBUZZ_PREFIX/lib"
  "$LIBPNG_PREFIX/lib"
  "$PCRE2_PREFIX/lib"
  "$ZLIB_PREFIX/lib"
)
dep_pkgconfigs=(
  "$BZIP2_PREFIX/lib/pkgconfig"
  "$FREETYPE_PREFIX/lib/pkgconfig"
  "$FRIBIDI_PREFIX/lib/pkgconfig"
  "$GLIB_PREFIX/lib/pkgconfig"
  "$HARFBUZZ_PREFIX/lib/pkgconfig"
  "$LIBPNG_PREFIX/lib/pkgconfig"
  "$PCRE2_PREFIX/lib/pkgconfig"
  "$ZLIB_PREFIX/lib/pkgconfig"
)

spack_target_flags="-march=icelake-client -mtune=icelake-client"
export PATH="${MESON_PREFIX}/bin:${NINJA_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH}"
export PYTHONHOME=
export PYTHONPATH="${MESON_PREFIX}/lib/python${PYTHON_ABI}/site-packages${PYTHONPATH:+:${PYTHONPATH}}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="$(IFS=:; echo "${dep_pkgconfigs[*]}")"
export CPPFLAGS="-I${BZIP2_PREFIX}/include -I${FREETYPE_PREFIX}/include/freetype2 -I${FRIBIDI_PREFIX}/include/fribidi -I${GLIB_PREFIX}/include/glib-2.0 -I${GLIB_PREFIX}/lib/glib-2.0/include -I${HARFBUZZ_PREFIX}/include/harfbuzz -I${LIBPNG_PREFIX}/include/libpng16 -I${PCRE2_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CXXFLAGS:-}"
export LDFLAGS="$(printf ' -L%s' "${dep_libs[@]}")$(printf ' -Wl,-rpath-link,%s' "${dep_libs[@]}") -Wl,-rpath,$(IFS=:; echo "${dep_libs[*]}") -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LD_LIBRARY_PATH="$(IFS=:; echo "${dep_libs[*]}")${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

"$MESON_PREFIX/bin/meson" setup "$BUILD_DIR" "$SRC" \
  -Dprefix="$PREFIX" \
  -Dlibdir="$PREFIX/lib" \
  -Dbuildtype=release \
  -Dstrip=false \
  -Ddefault_library=shared \
  -Dwrap_mode=nodownload

"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" -v
"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true

test -f "$PREFIX/include/raqm.h"
test -f "$PREFIX/include/raqm-version.h"
test -f "$PREFIX/lib/libraqm.so"
test -f "$PREFIX/lib/libraqm.so.0"
test -f "$PREFIX/lib/libraqm.so.0.10.5"
test -f "$PREFIX/lib/pkgconfig/raqm.pc"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libraqm native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libraqm_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libraqm native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    prefixes = {
        "BZIP2_PREFIX": _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2"),
        "FREETYPE_PREFIX": _read_prefix(repository_ctx, attr.freetype_prefix_file, "freetype"),
        "FRIBIDI_PREFIX": _read_prefix(repository_ctx, attr.fribidi_prefix_file, "fribidi"),
        "GLIB_PREFIX": _read_prefix(repository_ctx, attr.glib_prefix_file, "glib"),
        "HARFBUZZ_PREFIX": _read_prefix(repository_ctx, attr.harfbuzz_prefix_file, "harfbuzz"),
        "LIBPNG_PREFIX": _read_prefix(repository_ctx, attr.libpng_prefix_file, "libpng"),
        "MESON_PREFIX": _read_prefix(repository_ctx, attr.meson_prefix_file, "meson"),
        "NINJA_PREFIX": _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja"),
        "PCRE2_PREFIX": _read_prefix(repository_ctx, attr.pcre2_prefix_file, "pcre2"),
        "PKGCONF_PREFIX": _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf"),
        "ZLIB_PREFIX": _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng"),
    }

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    env = dict(prefixes)
    env["PYTHON_ABI"] = python_abi_from_site_packages_prefix(repository_ctx, prefixes["MESON_PREFIX"], "meson")
    env["VASO_IN_INSULA"] = "1"
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("libraqm native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lraqm",
    ]
    for prefix_path in (
        prefixes["BZIP2_PREFIX"],
        prefixes["FREETYPE_PREFIX"],
        prefixes["FRIBIDI_PREFIX"],
        prefixes["GLIB_PREFIX"],
        prefixes["HARFBUZZ_PREFIX"],
        prefixes["LIBPNG_PREFIX"],
        prefixes["PCRE2_PREFIX"],
        prefixes["ZLIB_PREFIX"],
    ):
        lib = "{}/lib".format(prefix_path)
        linkopts.extend([
            "-L" + lib,
            "-Wl,-rpath," + lib,
            "-Wl,-rpath-link," + lib,
        ])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(
            linkopts = repr(linkopts),
        ),
    )


libraqm_native = repository_rule(
    implementation = _libraqm_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "freetype_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "fribidi_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "glib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "harfbuzz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpng_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "meson_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pcre2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libraqm@0.10.5 from source into a Spack-prefix-identical tree.",
)
