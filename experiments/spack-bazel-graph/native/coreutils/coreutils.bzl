"""Native (Bazel-owned) build of GNU coreutils into a Spack-identical prefix.

The hermetic Spack v1.2.2 coreutils@9.10 recipe is an AutotoolsPackage with:

  * variant gprefix=false
  * depends_on("openssl@3:", type="link")
  * configure args: --disable-nls

This rule preserves the Spack DAG edge by consuming the already-migrated native
OpenSSL prefix through a mandatory Bazel prefix marker file.
"""

_BUILD_TEMPLATE = """\
# GENERATED by coreutils_native. Native Bazel build of GNU coreutils, intended
# to match the Spack coreutils install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# coreutils is an executable/tool-prefix node in this graph. It exposes no
# public C ABI, but @spack_coreutils//:lib must remain a valid provider target
# after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "coreutils native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${OPENSSL_PREFIX:-}" || ! -d "${OPENSSL_PREFIX:-}/include/openssl" ]]; then
  echo "OPENSSL_PREFIX must name the Bazel-built OpenSSL prefix" >&2
  exit 2
fi
openssl_libdir="$OPENSSL_PREFIX/lib64"
if [[ ! -d "$openssl_libdir" ]]; then
  openssl_libdir="$OPENSSL_PREFIX/lib"
fi
if [[ ! -d "$openssl_libdir" || ! -f "$openssl_libdir/libcrypto.so" ]]; then
  echo "OPENSSL_PREFIX does not contain libcrypto.so under lib/ or lib64/: $OPENSSL_PREFIX" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

export CPPFLAGS="-I${OPENSSL_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${openssl_libdir} -Wl,-rpath,${openssl_libdir} -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LIBS="-lcrypto ${LIBS:-}"

../configure \\
  --prefix="$PREFIX" \\
  --disable-nls \\
  --with-openssl=yes

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("coreutils native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _coreutils_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    openssl_prefix = _read_prefix(repository_ctx, attr.openssl_prefix_file, "openssl")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "OPENSSL_PREFIX": openssl_prefix,
        },
    )
    if res.return_code != 0:
        fail("coreutils native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


coreutils_native = repository_rule(
    implementation = _coreutils_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "openssl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU coreutils from source into a Spack-prefix-identical tree.",
)
