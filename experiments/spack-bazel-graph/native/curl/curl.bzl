"""Native (Bazel-owned) build of curl into a Spack-identical prefix.

The hermetic Spack v1.2.2 curl@8.20.0 recipe is an AutotoolsPackage for this
Linux graph. The concrete PyTorch-frontier spec enables OpenSSL TLS and
nghttp2, builds shared+static libcurl, disables the other optional discovery
paths, and links zlib through the zlib-api provider.
"""

_BUILD_TEMPLATE = """\
# GENERATED by curl_native. Native Bazel build of curl, intended to match the
# Spack curl install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/curl",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "curl native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${NGHTTP2_PREFIX:-}" || ! -f "${NGHTTP2_PREFIX:-}/include/nghttp2/nghttp2.h" ]]; then
  echo "NGHTTP2_PREFIX must name the Bazel-built nghttp2 prefix" >&2
  exit 2
fi
if [[ -z "${OPENSSL_PREFIX:-}" || ! -d "${OPENSSL_PREFIX:-}/include/openssl" ]]; then
  echo "OPENSSL_PREFIX must name the Bazel-built OpenSSL prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

openssl_libdir="$OPENSSL_PREFIX/lib64"
if [[ ! -d "$openssl_libdir" ]]; then
  openssl_libdir="$OPENSSL_PREFIX/lib"
fi
nghttp2_libdir="$NGHTTP2_PREFIX/lib"
zlib_libdir="$ZLIB_PREFIX/lib"
for path in "$openssl_libdir/libssl.so" "$openssl_libdir/libcrypto.so" \
            "$nghttp2_libdir/libnghttp2.so" "$zlib_libdir/libz.so"; do
  [[ -e "$path" ]] || { echo "curl dependency library missing: $path" >&2; exit 2; }
done

cd "$SRC"

export PATH="${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${NGHTTP2_PREFIX}/lib/pkgconfig:${openssl_libdir}/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig"
export CC="${CC:-gcc}"

enable_symbol_hiding=no ./configure \
  --prefix="$PREFIX" \
  --with-zlib="$ZLIB_PREFIX" \
  --without-brotli \
  --without-libgsasl \
  --without-libpsl \
  --without-zstd \
  --disable-docs \
  --disable-manual \
  --enable-shared \
  --enable-static \
  --without-ca-bundle \
  --without-ca-path \
  --with-ca-fallback \
  --without-gssapi \
  --without-gnutls \
  --without-mbedtls \
  --with-openssl="$OPENSSL_PREFIX" \
  --without-secure-transport \
  --without-sspi \
  --without-libidn2 \
  --without-librtmp \
  --with-nghttp2="$NGHTTP2_PREFIX" \
  --without-libssh2 \
  --without-libssh \
  --disable-ldap

export LD_RUN_PATH="${PREFIX}/lib:${zlib_libdir}:${openssl_libdir}:${nghttp2_libdir}"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("curl native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _curl_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("curl native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    nghttp2_prefix = _read_prefix(repository_ctx, attr.nghttp2_prefix_file, "nghttp2")
    openssl_prefix = _read_prefix(repository_ctx, attr.openssl_prefix_file, "openssl")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 2400,
        quiet = False,
        environment = {
            "NGHTTP2_PREFIX": nghttp2_prefix,
            "OPENSSL_PREFIX": openssl_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "ZLIB_PREFIX": zlib_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("curl native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)

    dep_libs = []
    for dep_prefix in (nghttp2_prefix, openssl_prefix, zlib_prefix):
        dep_lib = "{}/lib64".format(dep_prefix)
        if not repository_ctx.path(dep_lib).exists:
            dep_lib = "{}/lib".format(dep_prefix)
        dep_libs.append(dep_lib)

    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lcurl",
    ]
    for dep_lib in dep_libs:
        linkopts.extend([
            "-L" + dep_lib,
            "-Wl,-rpath," + dep_lib,
        ])
    linkopts.extend(["-lnghttp2", "-lssl", "-lcrypto", "-lz"])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


curl_native = repository_rule(
    implementation = _curl_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "nghttp2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openssl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build curl from source into a Spack-prefix-identical tree.",
)
