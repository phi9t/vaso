"""Native (Bazel-owned) build of libedit into a Spack-identical prefix.

The py-torch frontier captures libedit@3.1-20251016 as an AutotoolsPackage.
The hermetic Spack v1.2.2 recipe disables curses/termcap/ncurses tgetent
probes so configure resolves tgetent from ncurses' termlib (`-ltinfo`).
"""

_BUILD_TEMPLATE = """\
# GENERATED by libedit_native. Native Bazel build of libedit, intended to match
# the Spack libedit install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/editline",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libedit native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -d "${NCURSES_PREFIX:-}/lib" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi

cd "$SRC"

export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${NCURSES_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${NCURSES_PREFIX}/include -I${NCURSES_PREFIX}/include/ncursesw ${CPPFLAGS:-}"
export LDFLAGS="-L${NCURSES_PREFIX}/lib -Wl,-rpath,${NCURSES_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"

./configure \\
  --prefix="$PREFIX" \\
  ac_cv_lib_curses_tgetent=no \\
  ac_cv_lib_termcap_tgetent=no \\
  ac_cv_lib_ncurses_tgetent=no
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _libedit_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libedit native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    ncurses_prefix = repository_ctx.read(attr.ncurses_prefix_file).strip()
    if not ncurses_prefix:
        fail("libedit native build requires a non-empty ncurses prefix path")
    pkgconf_prefix = repository_ctx.read(attr.pkgconf_prefix_file).strip()
    if not pkgconf_prefix:
        fail("libedit native build requires a non-empty pkgconf prefix path")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "NCURSES_PREFIX": ncurses_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
        },
    )
    if res.return_code != 0:
        fail("libedit native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    ncurses_lib = "{}/lib".format(ncurses_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-ledit",
        "-L" + ncurses_lib,
        "-Wl,-rpath," + ncurses_lib,
        "-ltinfo",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libedit_native = repository_rule(
    implementation = _libedit_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libedit from source into a Spack-prefix-identical tree.",
)
