"""Native (Bazel-owned) build of zlib-ng from source into a Spack-identical prefix.

This is the Task-3 leaf proof: a package whose *provider* is flipped from Spack
to a native Bazel build while staying prefix-identical and ABI-identical to the
Spack install tree, so unmigrated consumers `depends_on` it unchanged.

`zlib_ng_native` is a `repository_rule` that:

  1. fetches the pinned zlib-ng source archive (content-addressed by sha256 —
     the same 2.3.3 tag + sha the Spack `zlib-ng` package pins);
  2. drives the SAME build Spack drives — autotools `configure --zlib-compat`
     then `make && make install` — into an in-repo `prefix/` install tree;
  3. exposes `@zlib_ng_native//:lib`, a `cc_library` over that native prefix,
     with the identical `-lz` / include / rpath wiring the Spack provider emits.

Because the configure flags (`--zlib-compat`) match the Spack recipe's
`+compat` variant, the emitted `include/`, `lib/libz.so.N`+soname, and
`lib/pkgconfig/zlib.pc` are byte/ABI-identical (verified by tools/abi_parity.py).
The build runs entirely inside the sealed CUDA insula (make/gcc hermetic there).
"""

_BUILD_TEMPLATE = """\
# GENERATED by zlib_ng_native. Native Bazel build of zlib-ng, prefix-identical
# to the Spack zlib-ng install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The native install tree, identical in layout to the Spack hermetic prefix.
filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

# The build script is captured verbatim; it mirrors the Spack AutotoolsBuilder
# configure_args() for the +compat,+opt,+shared,+new_strategies variant set.
_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"      # extracted source dir
PREFIX="$2"   # install prefix (absolute)

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "zlib-ng native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"
# Same phase Spack drives: autotools configure with --zlib-compat, then make.
./configure --prefix="$PREFIX" --zlib-compat
make -j"${MAKE_JOBS:-$(nproc)}"
make install
"""

def _zlib_ng_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("zlib-ng native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lz"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )

zlib_ng_native = repository_rule(
    implementation = _zlib_ng_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build zlib-ng from source into a Spack-prefix-identical install tree.",
)
