"""Native (Bazel-owned) build of font-util into a Spack-identical prefix.

The py-torch frontier captures font-util@1.4.1 as an X.Org AutotoolsPackage.
The main package installs bdftruncate, ucs2any, fontutil.pc, and fontutil.m4;
Spack then runs an install hook over the selected X.Org font resources with
`autoreconf -ifv`, `./configure --prefix`, and `make install`.

This rule mirrors that two-phase recipe inside the insula. All native
dependency discovery is routed through explicit prefix files: Autoconf and
Automake for the resource autoreconf phase; bdftopcf, mkfontdir, and
mkfontscale for generated font indexes; pkgconf and util-macros for Autotools
macro/pkg-config discovery.
"""

_FONT_RESOURCES = [
    # Lean Spack-concretized form: `font-util@1.4.1 fonts:=encodings`.
    ("encodings", "1.0.4", "55861d9cf456bd717a3d30a3193402c02174ed3c0dcee828798165fe307ee324"),
]

_BUILD_TEMPLATE = """\
# GENERATED by font_util_native. Native Bazel build of font-util, intended to
# match the Spack font-util install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# font-util is a data/tool Autotools prefix. Its downstream consumers use
# fontutil.pc, fontutil.m4, and the installed font tree rather than a C ABI.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
RESOURCES="$3"
RESOURCE_NAMES_FILE="$4"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "font-util native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${AUTOCONF_PREFIX:-}" || ! -x "${AUTOCONF_PREFIX:-}/bin/autoconf" || ! -x "${AUTOCONF_PREFIX:-}/bin/autoreconf" ]]; then
  echo "AUTOCONF_PREFIX must name the Bazel-built autoconf prefix" >&2
  exit 2
fi
if [[ -z "${AUTOMAKE_PREFIX:-}" || ! -x "${AUTOMAKE_PREFIX:-}/bin/aclocal" || ! -x "${AUTOMAKE_PREFIX:-}/bin/automake" ]]; then
  echo "AUTOMAKE_PREFIX must name the Bazel-built automake prefix" >&2
  exit 2
fi
if [[ -z "${BDFTOPCF_PREFIX:-}" || ! -x "${BDFTOPCF_PREFIX:-}/bin/bdftopcf" ]]; then
  echo "BDFTOPCF_PREFIX must name the Bazel-built bdftopcf prefix" >&2
  exit 2
fi
if [[ -z "${MKFONTDIR_PREFIX:-}" || ! -x "${MKFONTDIR_PREFIX:-}/bin/mkfontdir" ]]; then
  echo "MKFONTDIR_PREFIX must name the Bazel-built mkfontdir prefix" >&2
  exit 2
fi
if [[ -z "${MKFONTSCALE_PREFIX:-}" || ! -x "${MKFONTSCALE_PREFIX:-}/bin/mkfontscale" ]]; then
  echo "MKFONTSCALE_PREFIX must name the Bazel-built mkfontscale prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${UTIL_MACROS_PREFIX:-}" || ! -f "${UTIL_MACROS_PREFIX:-}/share/aclocal/xorg-macros.m4" ]]; then
  echo "UTIL_MACROS_PREFIX must name the Bazel-built util-macros prefix" >&2
  exit 2
fi

export PATH="${AUTOCONF_PREFIX}/bin:${AUTOMAKE_PREFIX}/bin:${BDFTOPCF_PREFIX}/bin:${MKFONTDIR_PREFIX}/bin:${MKFONTSCALE_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH:-}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${PREFIX}/lib/pkgconfig:${PKGCONF_PREFIX}/lib/pkgconfig:${UTIL_MACROS_PREFIX}/share/pkgconfig"
export ACLOCAL_PATH="${UTIL_MACROS_PREFIX}/share/aclocal:${PREFIX}/share/aclocal:${PKGCONF_PREFIX}/share/aclocal${ACLOCAL_PATH:+:${ACLOCAL_PATH}}"

cd "$SRC"
./configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

while IFS= read -r font; do
  [[ -n "$font" ]] || continue
  fontroot="$RESOURCES/$font"
  if [[ ! -d "$fontroot" ]]; then
    echo "missing extracted font resource: $fontroot" >&2
    exit 2
  fi
  (
    cd "$fontroot"
    autoreconf -ifv --include="${UTIL_MACROS_PREFIX}/share/aclocal" --include="${PREFIX}/share/aclocal"
    ./configure --prefix="$PREFIX"
    make V=1 -j"${MAKE_JOBS:-$(nproc)}"
    make install
  )
done < "$RESOURCE_NAMES_FILE"

# Spack removes libtool archives from emitted prefixes.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("font-util native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _font_util_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("font-util native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    for name, version, sha256 in _FONT_RESOURCES:
        repository_ctx.download_and_extract(
            url = ["https://www.x.org/archive/individual/font/{}-{}.tar.gz".format(name, version)],
            sha256 = sha256,
            stripPrefix = "{}-{}".format(name, version),
            output = "resources/{}".format(name),
        )

    repository_ctx.file("font_resources.txt", "\n".join([r[0] for r in _FONT_RESOURCES]) + "\n")
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    autoconf_prefix = _read_prefix(repository_ctx, attr.autoconf_prefix_file, "autoconf")
    automake_prefix = _read_prefix(repository_ctx, attr.automake_prefix_file, "automake")
    bdftopcf_prefix = _read_prefix(repository_ctx, attr.bdftopcf_prefix_file, "bdftopcf")
    mkfontdir_prefix = _read_prefix(repository_ctx, attr.mkfontdir_prefix_file, "mkfontdir")
    mkfontscale_prefix = _read_prefix(repository_ctx, attr.mkfontscale_prefix_file, "mkfontscale")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    util_macros_prefix = _read_prefix(repository_ctx, attr.util_macros_prefix_file, "util-macros")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    resources = str(repository_ctx.path("resources"))
    resource_names = str(repository_ctx.path("font_resources.txt"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix, resources, resource_names],
        timeout = 7200,
        quiet = False,
        environment = {
            "AUTOCONF_PREFIX": autoconf_prefix,
            "AUTOMAKE_PREFIX": automake_prefix,
            "BDFTOPCF_PREFIX": bdftopcf_prefix,
            "MKFONTDIR_PREFIX": mkfontdir_prefix,
            "MKFONTSCALE_PREFIX": mkfontscale_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "UTIL_MACROS_PREFIX": util_macros_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("font-util native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


font_util_native = repository_rule(
    implementation = _font_util_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "autoconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "automake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "bdftopcf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "mkfontdir_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "mkfontscale_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "util_macros_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build font-util and selected X.Org font resources into a Spack-prefix-identical tree.",
)
