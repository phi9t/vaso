"""Native py-llvmlite build-action skeleton.

The hermetic Spack v1.2.2 py-llvmlite@0.47.0 recipe is a PythonPackage that
requires LLVM 20 and builds llvmlite's native C++ bridge through CMake during
pip install. This repository rule records the prefix/build contract and refuses
the full native build unless VASO_NATIVE_PY_LLVMLITE_TOKEN is explicitly set.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_PLAN_BUILD = """\
# GENERATED by py_llvmlite_native (DRY-RUN / unauthorized). The native
# py-llvmlite build did not run. build_plan.json records the resolved interface
# and build.sh is emitted for review.
package(default_visibility = ["//visibility:public"])

exports_files(["build_plan.json", "build.sh"])
"""

_NATIVE_BUILD = """\
# GENERATED by py_llvmlite_native (AUTHORIZED). Native py-llvmlite was built
# into a Spack-compatible Python prefix.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: python-pip-install
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-llvmlite native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BINUTILS_PREFIX:-}" || ! -x "${BINUTILS_PREFIX:-}/bin/ld" ]]; then
  echo "BINUTILS_PREFIX must name the Bazel-provided binutils prefix" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-provided CMake prefix" >&2
  exit 2
fi
if [[ -z "${LLVM_PREFIX:-}" || ! -x "${LLVM_PREFIX:-}/bin/llvm-config" || ! -f "${LLVM_PREFIX:-}/lib/cmake/llvm/LLVMConfig.cmake" ]]; then
  echo "LLVM_PREFIX must name the LLVM 20 prefix selected by the Spack DAG" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-provided Python prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the Bazel-provided Python prefix" >&2
  exit 2
fi
if [[ "$PYTHON_ABI" != "3.13" ]]; then
  echo "py-llvmlite@0.47.0 is pinned to the Python 3.13 PyTorch line; got $PYTHON_ABI" >&2
  exit 2
fi
if [[ ! -d "${PYTHON_PREFIX:-}/include/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_PREFIX must provide include/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-provided python-venv prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_VENV_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-provided py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-provided py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-provided py-wheel prefix" >&2
  exit 2
fi

llvm_version="$("$LLVM_PREFIX/bin/llvm-config" --version)"
case "$llvm_version" in
  20.*) ;;
  *) echo "py-llvmlite@0.47.0 requires LLVM 20, got $llvm_version" >&2; exit 2 ;;
esac

rm -rf "$PREFIX"
export PATH="${CMAKE_PREFIX}/bin:${LLVM_PREFIX}/bin:${BINUTILS_PREFIX}/bin:${PYTHON_PREFIX}/bin:${PYTHON_VENV_PREFIX}/bin:/usr/bin:/bin"
export PYTHONHOME=
export PYTHONPATH="${PY_PIP_PREFIX}/lib/python${PYTHON_ABI}/site-packages:${PY_SETUPTOOLS_PREFIX}/lib/python${PYTHON_ABI}/site-packages:${PY_WHEEL_PREFIX}/lib/python${PYTHON_ABI}/site-packages:${PYTHON_VENV_PREFIX}/lib/python${PYTHON_ABI}/site-packages"
export LD_LIBRARY_PATH="${PYTHON_PREFIX}/lib:${LLVM_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export LLVM_CONFIG="${LLVM_PREFIX}/bin/llvm-config"
export LLVM_DIR="${LLVM_PREFIX}/lib/cmake/llvm"
export CMAKE="${CMAKE_PREFIX}/bin/cmake"
export CMAKE_PREFIX_PATH="${LLVM_PREFIX}"
export CMAKE_ARGS="-DLLVM_DIR:PATH=${LLVM_DIR} -DCMAKE_PREFIX_PATH:STRING=${LLVM_PREFIX} -DCMAKE_FIND_PACKAGE_PREFER_CONFIG:BOOL=ON -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY:BOOL=OFF -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF -DCMAKE_FIND_USE_SYSTEM_PATH:BOOL=OFF -DCMAKE_C_COMPILER:FILEPATH=/usr/bin/gcc -DCMAKE_CXX_COMPILER:FILEPATH=/usr/bin/g++ -DLLVMLITE_PACKAGE_FORMAT:STRING=wheel -DLLVMLITE_LTO:BOOL=ON -DLLVMLITE_SHARED:BOOL=OFF ${CMAKE_ARGS:-}"
export CXX_FLTO_FLAGS="-flto -fPIC"
export LD_FLTO_FLAGS="-Wl,--exclude-libs=ALL"
export CFLAGS="-I${PYTHON_PREFIX}/include/python${PYTHON_ABI} ${CFLAGS:-}"
export CXXFLAGS="-fPIC -I${PYTHON_PREFIX}/include/python${PYTHON_ABI} ${CXXFLAGS:-}"
export LDFLAGS="-L${PYTHON_PREFIX}/lib -L${LLVM_PREFIX}/lib -Wl,-rpath,${PYTHON_PREFIX}/lib -Wl,-rpath,${LLVM_PREFIX}/lib ${LDFLAGS:-}"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -m pip \\
  -vvv \\
  --no-input \\
  --no-cache-dir \\
  --disable-pip-version-check \\
  install \\
  --no-deps \\
  --ignore-installed \\
  --no-build-isolation \\
  --no-warn-script-location \\
  --no-index \\
  --prefix="$PREFIX" \\
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
python_ext_suffix="$("$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX") or "")')"
if [[ -z "$python_ext_suffix" ]]; then
  echo "native python did not report EXT_SUFFIX" >&2
  exit 2
fi
test -d "$site_packages/llvmlite"
test -f "$site_packages/llvmlite/__init__.py"
test -f "$site_packages/llvmlite/binding/libllvmlite.so"
test -f "$site_packages/llvmlite/binding/_stub${python_ext_suffix}"
test -f "$site_packages/llvmlite-0.47.0.dist-info/METADATA"
"""

_REQUIRED_TOKEN = "build-native-py-llvmlite"


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-llvmlite native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_llvmlite_native_impl(repository_ctx):
    attr = repository_ctx.attr
    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-llvmlite native planning/build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    prefix_inputs = {
        "binutils": _read_prefix(repository_ctx, attr.binutils_prefix_file, "binutils"),
        "cmake": _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake"),
        "llvm": _read_prefix(repository_ctx, attr.llvm_prefix_file, "llvm"),
        "python": _read_prefix(repository_ctx, attr.python_prefix_file, "python"),
        "python_venv": _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv"),
        "py_pip": _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip"),
        "py_setuptools": _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools"),
        "py_wheel": _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel"),
    }
    python_abi = python_abi_from_prefix(repository_ctx, prefix_inputs["python"], "python")
    env = {
        "BINUTILS_PREFIX": prefix_inputs["binutils"],
        "CMAKE_PREFIX": prefix_inputs["cmake"],
        "LLVM_PREFIX": prefix_inputs["llvm"],
        "PYTHON_ABI": python_abi,
        "PYTHON_PREFIX": prefix_inputs["python"],
        "PYTHON_VENV_PREFIX": prefix_inputs["python_venv"],
        "PY_PIP_PREFIX": prefix_inputs["py_pip"],
        "PY_SETUPTOOLS_PREFIX": prefix_inputs["py_setuptools"],
        "PY_WHEEL_PREFIX": prefix_inputs["py_wheel"],
        "VASO_IN_INSULA": "1",
    }
    plan_args = [
        prefix_inputs["python"] + "/bin/python" + python_abi,
        str(repository_ctx.path(attr._plan)),
        "--out",
        "build_plan.json",
    ]
    for key, value in sorted(prefix_inputs.items()):
        plan_args.extend(["--prefix", "{}={}".format(key, value)])

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)
    plan_res = repository_ctx.execute(plan_args, quiet = False, environment = env)
    token = repository_ctx.os.environ.get("VASO_NATIVE_PY_LLVMLITE_TOKEN", "")
    authorized = token == _REQUIRED_TOKEN
    if not authorized:
        repository_ctx.file("BUILD.bazel", _PLAN_BUILD)
        return
    if plan_res.return_code != 0:
        fail("py-llvmlite native preflight failed:\n{}\n{}".format(plan_res.stdout, plan_res.stderr))

    fail(
        "py_llvmlite_native full build is gated and intentionally not " +
        "implemented in this checkpoint. Build LLVM first, review prefix/ABI " +
        "gates, then issue VASO_NATIVE_PY_LLVMLITE_TOKEN=build-native-py-llvmlite.",
    )

    repository_ctx.file("BUILD.bazel", _NATIVE_BUILD)


py_llvmlite_native = repository_rule(
    implementation = _py_llvmlite_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "binutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "llvm_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "_plan": attr.label(default = "//native/py_llvmlite:plan.py", allow_single_file = True),
    },
    environ = ["VASO_NATIVE_PY_LLVMLITE_TOKEN", "VASO_IN_INSULA"],
    doc = "Plan and eventually build py-llvmlite@0.47.0 into a Spack-compatible Python prefix.",
)
