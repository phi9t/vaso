"""Native (Bazel-owned) build of mkfontscale into a Spack-identical prefix.

The py-torch frontier captures mkfontscale@1.2.3 as an X.Org
AutotoolsPackage. It installs an executable plus the mkfontdir shell wrapper;
all dependency discovery is threaded through explicit Bazel-native prefix
files so configure/pkg-config/linker lookup stays inside the insula graph.
"""

_BUILD_TEMPLATE = """\
# GENERATED by mkfontscale_native. Native Bazel build of mkfontscale,
# intended to match the Spack mkfontscale install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# mkfontscale is an executable/tool-prefix node in this graph. It exposes no
# public C ABI, but @spack_mkfontscale//:lib must stay a valid provider target
# after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "mkfontscale native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BZIP2_PREFIX:-}" || ! -f "${BZIP2_PREFIX:-}/lib/pkgconfig/bzip2.pc" || ! -e "${BZIP2_PREFIX:-}/lib/libbz2.so" ]]; then
  echo "BZIP2_PREFIX must name the Bazel-built bzip2 prefix used by freetype pkg-config metadata" >&2
  exit 2
fi
if [[ -z "${FREETYPE_PREFIX:-}" || ! -f "${FREETYPE_PREFIX:-}/lib/pkgconfig/freetype2.pc" || ! -e "${FREETYPE_PREFIX:-}/lib/libfreetype.so" ]]; then
  echo "FREETYPE_PREFIX must name the Bazel-built freetype prefix" >&2
  exit 2
fi
if [[ -z "${LIBFONTENC_PREFIX:-}" || ! -f "${LIBFONTENC_PREFIX:-}/lib/pkgconfig/fontenc.pc" || ! -e "${LIBFONTENC_PREFIX:-}/lib/libfontenc.so" ]]; then
  echo "LIBFONTENC_PREFIX must name the Bazel-built libfontenc prefix" >&2
  exit 2
fi
if [[ -z "${LIBPNG_PREFIX:-}" || ! -f "${LIBPNG_PREFIX:-}/lib/pkgconfig/libpng.pc" || ! -e "${LIBPNG_PREFIX:-}/lib/libpng16.so" ]]; then
  echo "LIBPNG_PREFIX must name the Bazel-built libpng prefix used by freetype pkg-config metadata" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${UTIL_MACROS_PREFIX:-}" || ! -f "${UTIL_MACROS_PREFIX:-}/share/aclocal/xorg-macros.m4" ]]; then
  echo "UTIL_MACROS_PREFIX must name the Bazel-built util-macros prefix" >&2
  exit 2
fi
if [[ -z "${XPROTO_PREFIX:-}" || ! -f "${XPROTO_PREFIX:-}/lib/pkgconfig/xproto.pc" ]]; then
  echo "XPROTO_PREFIX must name the Bazel-built xproto prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

cd "$SRC"

export PATH="${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${LIBFONTENC_PREFIX}/lib/pkgconfig:${FREETYPE_PREFIX}/lib/pkgconfig:${XPROTO_PREFIX}/lib/pkgconfig:${BZIP2_PREFIX}/lib/pkgconfig:${LIBPNG_PREFIX}/lib/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig:${PKGCONF_PREFIX}/lib/pkgconfig:${UTIL_MACROS_PREFIX}/share/pkgconfig"
export ACLOCAL_PATH="${UTIL_MACROS_PREFIX}/share/aclocal:${PKGCONF_PREFIX}/share/aclocal${ACLOCAL_PATH:+:${ACLOCAL_PATH}}"
export CPPFLAGS="-I${LIBFONTENC_PREFIX}/include -I${FREETYPE_PREFIX}/include -I${FREETYPE_PREFIX}/include/freetype2 -I${XPROTO_PREFIX}/include -I${BZIP2_PREFIX}/include -I${LIBPNG_PREFIX}/include/libpng16 -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${LIBFONTENC_PREFIX}/lib -Wl,-rpath,${LIBFONTENC_PREFIX}/lib -L${FREETYPE_PREFIX}/lib -Wl,-rpath,${FREETYPE_PREFIX}/lib -L${BZIP2_PREFIX}/lib -Wl,-rpath,${BZIP2_PREFIX}/lib -L${LIBPNG_PREFIX}/lib -Wl,-rpath,${LIBPNG_PREFIX}/lib -L${ZLIB_PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LIBS="-lz ${LIBS:-}"

./configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("mkfontscale native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _mkfontscale_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("mkfontscale native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    freetype_prefix = _read_prefix(repository_ctx, attr.freetype_prefix_file, "freetype")
    libfontenc_prefix = _read_prefix(repository_ctx, attr.libfontenc_prefix_file, "libfontenc")
    libpng_prefix = _read_prefix(repository_ctx, attr.libpng_prefix_file, "libpng")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    util_macros_prefix = _read_prefix(repository_ctx, attr.util_macros_prefix_file, "util-macros")
    xproto_prefix = _read_prefix(repository_ctx, attr.xproto_prefix_file, "xproto")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "BZIP2_PREFIX": bzip2_prefix,
            "FREETYPE_PREFIX": freetype_prefix,
            "LIBFONTENC_PREFIX": libfontenc_prefix,
            "LIBPNG_PREFIX": libpng_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "UTIL_MACROS_PREFIX": util_macros_prefix,
            "VASO_IN_INSULA": "1",
            "XPROTO_PREFIX": xproto_prefix,
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("mkfontscale native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


mkfontscale_native = repository_rule(
    implementation = _mkfontscale_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "freetype_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libfontenc_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpng_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "util_macros_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xproto_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build mkfontscale from source into a Spack-prefix-identical executable tree.",
)
