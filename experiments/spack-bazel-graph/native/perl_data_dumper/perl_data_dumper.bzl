"""Native (Bazel-owned) build of CPAN Data-Dumper into a Spack prefix.

The py-torch lean frontier captures perl-data-dumper@2.173 as a Spack
PerlPackage. It uses ExtUtils::MakeMaker (`perl Makefile.PL && make install`)
and depends on the already-migrated native Perl prefix for the interpreter,
core headers, and MakeMaker configuration.
"""

_BUILD_TEMPLATE = """\
# GENERATED by perl_data_dumper_native. Native Bazel build of
# perl-data-dumper, intended to match the Spack install tree. Do not edit by
# hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# perl-data-dumper is a Perl module prefix. Its public surface is loaded by
# Perl through PERL5LIB; @spack_perl_data_dumper//:lib must remain a valid
# provider target after migration, but it exposes no C headers or link flags.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "perl-data-dumper native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PERL_PREFIX:-}" || ! -x "${PERL_PREFIX:-}/bin/perl" ]]; then
  echo "PERL_PREFIX must name the Bazel-built native Perl prefix" >&2
  exit 2
fi

export PATH="${PERL_PREFIX}/bin:${PATH:-}"
export LD_LIBRARY_PATH="${PERL_PREFIX}/lib:${PERL_PREFIX}/lib/5.42.0/x86_64-linux-thread-multi/CORE${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

cd "$SRC"
"$PERL_PREFIX/bin/perl" Makefile.PL INSTALL_BASE="$PREFIX"
make -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true

test -f "$PREFIX/lib/perl5/x86_64-linux-thread-multi/Data/Dumper.pm"
test -f "$PREFIX/lib/perl5/x86_64-linux-thread-multi/auto/Data/Dumper/Dumper.so"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("perl-data-dumper native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _perl_data_dumper_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("perl-data-dumper native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    perl_prefix = _read_prefix(repository_ctx, attr.perl_prefix_file, "perl")

    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "PERL_PREFIX": perl_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("perl-data-dumper native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


perl_data_dumper_native = repository_rule(
    implementation = _perl_data_dumper_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build CPAN Data-Dumper into a Spack-prefix-identical Perl module tree.",
)
