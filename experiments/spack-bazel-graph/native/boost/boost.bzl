"""Native (Bazel-owned) build of Boost into a Spack-identical prefix.

This encodes the concrete py-torch frontier Boost node captured from hermetic
Spack v1.2.2: boost@1.90.0 with +atomic +chrono +exception +shared +system
+thread +multithreaded, cxxstd=11, visibility=hidden, no ICU/Python/MPI, and
system layout. Boost is a Spack `generic` package, but the real mechanism is
Boost.Build (`bootstrap.sh` plus `b2`), so every build axis is pinned here.
"""

_BUILD_TEMPLATE = """\
# GENERATED by boost_native. Native Bazel build of Boost, intended to match the
# captured hermetic Spack boost install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
PATCH="$3"
JOBS="${MAKE_JOBS:-$(nproc)}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "boost native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"
patch -p1 < "$PATCH"

cat > user-config.jam <<EOF
using gcc : : ${CXX:-g++} ;
EOF

export BOOST_BUILD_PATH="$SRC"
export CXX="${CXX:-g++}"

./bootstrap.sh \\
  --prefix="$PREFIX" \\
  --with-toolset=gcc \\
  --with-libraries=atomic,chrono,exception,system,thread \\
  --without-icu

# Spack strips the bootstrap-generated project-config toolchain stanza so the
# explicit user-config.jam is the only compiler discovery channel.
python3 - <<'PY'
from pathlib import Path
path = Path("project-config.jam")
if path.exists():
    lines = [
        line for line in path.read_text().splitlines()
        if not line.lstrip().startswith("using gcc")
    ]
    path.write_text("\\n".join(lines) + "\\n")
PY

./b2 --clean \\
  -j "$JOBS" \\
  --user-config="$SRC/user-config.jam" \\
  variant=release \\
  --disable-icu \\
  link=static,shared \\
  --layout=system \\
  toolset=gcc \\
  cxxstd=11 \\
  visibility=hidden

./b2 install \\
  threading=multi \\
  -j "$JOBS" \\
  --user-config="$SRC/user-config.jam" \\
  variant=release \\
  --disable-icu \\
  link=static,shared \\
  --layout=system \\
  toolset=gcc \\
  cxxstd=11 \\
  visibility=hidden

# Spack adds -mt symlinks when +multithreaded and ~taggedlayout.
if [[ -d "$PREFIX/lib" ]]; then
  (
    cd "$PREFIX/lib"
    for lib in libboost_*.*; do
      [[ -f "$lib" ]] || continue
      base="${lib%%.*}"
      rest="${lib#*.}"
      ln -sfn "$lib" "${base}-mt.${rest}"
    done
  )
fi
"""


def _boost_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("boost native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    patch = str(repository_ctx.path(attr.bootstrap_compiler_patch))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix, patch],
        timeout = 7200,
        quiet = False,
    )
    if res.return_code != 0:
        fail("boost native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lboost_atomic",
        "-lboost_chrono",
        "-lboost_container",
        "-lboost_date_time",
        "-lboost_exception",
        "-lboost_thread",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


boost_native = repository_rule(
    implementation = _boost_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bootstrap_compiler_patch": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["CXX", "MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build Boost from source into a Spack-prefix-identical tree.",
)
