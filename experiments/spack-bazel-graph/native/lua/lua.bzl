"""Native (Bazel-owned) build of Lua into a Spack-identical prefix.

The py-torch frontier captures lua@5.3.6 as a MakefilePackage with the
`+shared fetcher=curl` variants. The hermetic Spack v1.2.2 recipe builds the
upstream Lua Makefile target `linux`, installs the static archive and
executables, creates a versioned shared liblua from liblua.a, adds Lua
pkg-config metadata, and then installs the bundled LuaRocks resource.

This rule consumes all non-toolchain Spack edges through explicit Bazel-native
prefix files: readline/ncurses for Lua's build and C ABI, plus curl/unzip for
LuaRocks' runtime tool contract.
"""

_BUILD_TEMPLATE = """\
# GENERATED by lua_native. Native Bazel build of Lua, intended to match the
# Spack lua install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
    deps = [
        "@ncurses_native//:lib",
        "@readline_native//:lib",
    ],
)
"""

_LUA_PC_TEMPLATE = """\
prefix={prefix}
libdir={prefix}/lib
includedir={prefix}/include
bindir={prefix}/bin
INSTALL_LMOD={prefix}/share/lua/5.3
INSTALL_CMOD={prefix}/lib/lua/5.3
INTERPRETER=${{bindir}}/lua
COMPILER=${{bindir}}/luac
Name: Lua
Description: A powerful, fast, lightweight, embeddable scripting language
Version: 5.3.6
Libs: -L${{libdir}} -llua -lm
Cflags: -I${{includedir}}
"""

_BUILD_SH = """\
#!/usr/bin/env bash
# spack-build-system: makefile
set -euo pipefail
SRC="$1"
LUAROCKS_SRC="$2"
PREFIX="$3"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "lua native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

for var in CURL_PREFIX NCURSES_PREFIX READLINE_PREFIX UNZIP_PREFIX; do
  value="${!var:-}"
  if [[ -z "$value" || ! -d "$value" ]]; then
    echo "$var must name a Bazel-built native prefix" >&2
    exit 2
  fi
done
if [[ ! -x "$CURL_PREFIX/bin/curl" ]]; then
  echo "CURL_PREFIX must contain bin/curl" >&2
  exit 2
fi
if [[ ! -x "$UNZIP_PREFIX/bin/unzip" ]]; then
  echo "UNZIP_PREFIX must contain bin/unzip" >&2
  exit 2
fi
if [[ ! -f "$NCURSES_PREFIX/lib/libncurses.so" || ! -f "$NCURSES_PREFIX/lib/libtinfo.so" ]]; then
  echo "NCURSES_PREFIX must contain libncurses.so and libtinfo.so" >&2
  exit 2
fi
if [[ ! -f "$READLINE_PREFIX/lib/libreadline.so" ]]; then
  echo "READLINE_PREFIX must contain libreadline.so" >&2
  exit 2
fi

export PATH="$CURL_PREFIX/bin:$UNZIP_PREFIX/bin:$PATH"

lua_rpath="${PREFIX}/lib:${NCURSES_PREFIX}/lib:${READLINE_PREFIX}/lib"
make -C "$SRC" -j"${MAKE_JOBS:-$(nproc)}" \
  "MYCFLAGS=-I${READLINE_PREFIX}/include -I${NCURSES_PREFIX}/include -I${NCURSES_PREFIX}/include/ncursesw" \
  "MYLDFLAGS=-L${READLINE_PREFIX}/lib -L${NCURSES_PREFIX}/lib -Wl,-rpath,${lua_rpath} -Wl,--disable-new-dtags" \
  "MYLIBS=-lncurses -ltinfo -lncursesw -ltinfow" \
  "CC=${CC:-gcc} -std=gnu99 -fPIC" \
  linux

make -C "$SRC" "INSTALL_TOP=${PREFIX}" install

gcc -shared \
  -Wl,-soname,liblua.so.5.3 \
  -Wl,-rpath,"${lua_rpath}" \
  -Wl,--disable-new-dtags \
  -Wl,--whole-archive "${PREFIX}/lib/liblua.a" -Wl,--no-whole-archive \
  -lm -ldl \
  -o "${PREFIX}/lib/liblua.so.5.3.6"
(
  cd "$PREFIX/lib"
  ln -sfn liblua.so.5.3.6 liblua.so
  ln -sfn liblua.so.5.3.6 liblua.so.5.3
  ln -sfn liblua.so.5.3.6 liblua5.3.so
  ln -sfn liblua.so.5.3.6 liblua53.so
  ln -sfn liblua.so.5.3.6 liblua-5.3.so
  ln -sfn liblua.so.5.3.6 liblua-53.so
)

mkdir -p "$PREFIX/lib/pkgconfig"
cat > "$PREFIX/lib/pkgconfig/lua5.3.pc" <<'EOF'
@@LUA_PC_TEMPLATE@@
EOF
ln -sfn "${PREFIX}/lib/pkgconfig/lua5.3.pc" "$PREFIX/lib/pkgconfig/lua.pc"

cd "$LUAROCKS_SRC"
./configure --prefix="$PREFIX" --with-lua="$PREFIX"
make build
make install

find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("lua native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _lua_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("lua native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.download_and_extract(
        url = attr.luarocks_urls,
        sha256 = attr.luarocks_sha256,
        stripPrefix = attr.luarocks_strip_prefix,
        output = "luarocks",
    )

    curl_prefix = _read_prefix(repository_ctx, attr.curl_prefix_file, "curl")
    ncurses_prefix = _read_prefix(repository_ctx, attr.ncurses_prefix_file, "ncurses")
    readline_prefix = _read_prefix(repository_ctx, attr.readline_prefix_file, "readline")
    unzip_prefix = _read_prefix(repository_ctx, attr.unzip_prefix_file, "unzip")

    prefix = str(repository_ctx.path("prefix"))
    build_sh = _BUILD_SH.replace(
        "@@LUA_PC_TEMPLATE@@",
        _LUA_PC_TEMPLATE.format(prefix = prefix).rstrip("\n"),
    )
    repository_ctx.file("build.sh", build_sh, executable = True)

    res = repository_ctx.execute(
        [
            "./build.sh",
            str(repository_ctx.path("src")),
            str(repository_ctx.path("luarocks")),
            prefix,
        ],
        timeout = 1800,
        quiet = False,
        environment = {
            "CURL_PREFIX": curl_prefix,
            "NCURSES_PREFIX": ncurses_prefix,
            "READLINE_PREFIX": readline_prefix,
            "UNZIP_PREFIX": unzip_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("lua native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-llua",
        "-lm",
        "-ldl",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


lua_native = repository_rule(
    implementation = _lua_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "luarocks_urls": attr.string_list(mandatory = True),
        "luarocks_sha256": attr.string(mandatory = True),
        "luarocks_strip_prefix": attr.string(mandatory = True),
        "curl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "readline_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "unzip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build Lua and its LuaRocks resource into a Spack-prefix-identical tree.",
)
