"""Native (Bazel-owned) build of GNU tar into a Spack-identical prefix.

The hermetic Spack v1.2.2 tar@1.35 recipe is an AutotoolsPackage with:

  * variant zip=pigz
  * depends_on("iconv")
  * run dependencies on pigz, zstd+programs, xz, and bzip2
  * configure args:
      --disable-nls
      --with-xz=<xz prefix>/bin/xz
      --with-lzma=<xz prefix>/bin/lzma
      --with-bzip2=<bzip2 prefix>/bin/bzip2
      --with-zstd=<zstd prefix>/bin/zstd
      --with-gzip=<pigz prefix>/bin/pigz
      --with-libiconv-prefix=<libiconv prefix>
  * flag_handler appends -liconv for tar@1.35 ^libiconv

This rule preserves the absolute compressor-tool contract while sourcing every
prefix from Bazel-owned native prefix marker files.
"""

_BUILD_TEMPLATE = """\
# GENERATED by tar_native. Native Bazel build of GNU tar, prefix-identical to
# the Spack tar install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# GNU tar is an executable-only node in this graph. It exposes no public C ABI,
# but @spack_tar//:lib must remain a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "tar native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BZIP2_PREFIX:-}" || ! -x "${BZIP2_PREFIX:-}/bin/bzip2" ]]; then
  echo "BZIP2_PREFIX must name the Bazel-built bzip2 prefix" >&2
  exit 2
fi
if [[ -z "${LIBICONV_PREFIX:-}" || ! -d "${LIBICONV_PREFIX:-}/lib" ]]; then
  echo "LIBICONV_PREFIX must name the Bazel-built libiconv prefix" >&2
  exit 2
fi
if [[ -z "${PIGZ_PREFIX:-}" || ! -x "${PIGZ_PREFIX:-}/bin/pigz" ]]; then
  echo "PIGZ_PREFIX must name the Bazel-built pigz prefix" >&2
  exit 2
fi
if [[ -z "${XZ_PREFIX:-}" || ! -x "${XZ_PREFIX:-}/bin/xz" || ! -x "${XZ_PREFIX:-}/bin/lzma" ]]; then
  echo "XZ_PREFIX must name the Bazel-built xz prefix" >&2
  exit 2
fi
if [[ -z "${ZSTD_PREFIX:-}" || ! -x "${ZSTD_PREFIX:-}/bin/zstd" ]]; then
  echo "ZSTD_PREFIX must name the Bazel-built zstd prefix" >&2
  exit 2
fi

cd "$SRC"

export CPPFLAGS="-I${LIBICONV_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${LIBICONV_PREFIX}/lib -Wl,-rpath,${LIBICONV_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LIBS="-liconv ${LIBS:-}"

./configure \\
  --prefix="$PREFIX" \\
  --disable-nls \\
  "--with-xz=${XZ_PREFIX}/bin/xz" \\
  "--with-lzma=${XZ_PREFIX}/bin/lzma" \\
  "--with-bzip2=${BZIP2_PREFIX}/bin/bzip2" \\
  "--with-zstd=${ZSTD_PREFIX}/bin/zstd" \\
  "--with-gzip=${PIGZ_PREFIX}/bin/pigz" \\
  "--with-libiconv-prefix=${LIBICONV_PREFIX}"

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("tar native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _tar_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    libiconv_prefix = _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv")
    pigz_prefix = _read_prefix(repository_ctx, attr.pigz_prefix_file, "pigz")
    xz_prefix = _read_prefix(repository_ctx, attr.xz_prefix_file, "xz")
    zstd_prefix = _read_prefix(repository_ctx, attr.zstd_prefix_file, "zstd")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "BZIP2_PREFIX": bzip2_prefix,
            "LIBICONV_PREFIX": libiconv_prefix,
            "PIGZ_PREFIX": pigz_prefix,
            "XZ_PREFIX": xz_prefix,
            "ZSTD_PREFIX": zstd_prefix,
        },
    )
    if res.return_code != 0:
        fail("tar native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


tar_native = repository_rule(
    implementation = _tar_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pigz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zstd_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU tar from source into a Spack-prefix-identical tree.",
)
