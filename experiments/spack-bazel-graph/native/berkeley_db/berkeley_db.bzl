"""Native (Bazel-owned) build of Berkeley DB into a Spack-identical prefix.

Berkeley DB is the next Python-DAG C library frontier after the toolchain and
ca-certificates-mozilla nodes. Spack builds it with AutotoolsPackage but uses
nonstandard source/build directories:

  * configure_directory = "dist"
  * build_directory = "build_unix"

The native rule applies the same local patch effects and configure args that
the installed Spack recipe used for berkeley-db@18.1.40.
"""

_BUILD_TEMPLATE = """\
# GENERATED by berkeley_db_native. Native Bazel build of Berkeley DB, intended
# to match the Spack berkeley-db install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "berkeley-db native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

# Spack's ~docs patch limits DOCLIST to index.html, and its package patch()
# removes missing 18.1.40 doc targets from dist/Makefile.in.
python3 - <<'PY'
from pathlib import Path
p = Path("dist/Makefile.in")
s = p.read_text()
start = s.find("DOCLIST=api_reference")
if start != -1:
    end = s.find("\\n\\ninstall_docs:", start)
    if end != -1:
        s = s[:start] + "DOCLIST=index.html" + s[end:]
s = s.replace("bdb-sql", "")
s = s.replace("gsg_db_server", "")
p.write_text(s)

# Spack tls.patch includes stdlib.h in the TLS configure probe.
for rel in ("dist/aclocal/tls.m4", "dist/configure"):
    p = Path(rel)
    if not p.exists():
        continue
    s = p.read_text()
    needle = "template <typename T>class TLSClass {"
    if "#include <stdlib.h>\\n              template <typename T>class TLSClass {" not in s:
        s = s.replace(needle, "#include <stdlib.h>\\n              " + needle)
    p.write_text(s)
PY

mkdir -p build_unix
cd build_unix

../dist/configure \\
  --prefix="$PREFIX" \\
  --disable-static \\
  --enable-dbm \\
  --enable-compat185 \\
  --with-repmgr-ssl=no \\
  --enable-cxx \\
  --enable-stl

make -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _berkeley_db_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
    )
    if res.return_code != 0:
        fail("berkeley-db native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-ldb",
        "-ldb_cxx",
        "-ldb_stl",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


berkeley_db_native = repository_rule(
    implementation = _berkeley_db_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build Berkeley DB from source into a Spack-prefix-identical tree.",
)
