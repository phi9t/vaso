"""Native (Bazel-owned) build of OpenSSL into a Spack-identical prefix.

OpenSSL is a Spack GenericPackage in this graph. Its recipe uses OpenSSL's own
`./config` script, not Autotools, then `make` and `make install_sw`. This rule
mirrors that flow inside the CUDA insula and consumes already-migrated native
prefixes for Perl, zlib-ng, and the Mozilla CA bundle.
"""

_BUILD_TEMPLATE = """\
# GENERATED by openssl_native. Native Bazel build of OpenSSL, intended to match
# the Spack openssl install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "openssl native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
for var in PERL_PREFIX ZLIB_PREFIX CA_CERTIFICATES_MOZILLA_PREFIX; do
  val="${!var:-}"
  if [[ -z "$val" || ! -d "$val" ]]; then
    echo "$var must name a Bazel-built native dependency prefix" >&2
    exit 2
  fi
done
if [[ ! -x "$PERL_PREFIX/bin/perl" ]]; then
  echo "PERL_PREFIX does not contain bin/perl: $PERL_PREFIX" >&2
  exit 2
fi
if [[ ! -d "$ZLIB_PREFIX/lib" ]]; then
  echo "ZLIB_PREFIX does not contain lib/: $ZLIB_PREFIX" >&2
  exit 2
fi
if [[ ! -f "$CA_CERTIFICATES_MOZILLA_PREFIX/share/cacert.pem" ]]; then
  echo "CA cert prefix does not contain share/cacert.pem: $CA_CERTIFICATES_MOZILLA_PREFIX" >&2
  exit 2
fi

cd "$SRC"

# Spack's OpenSSL recipe clears these variables because OpenSSL's Makefile and
# config scripts treat them as overrides.
unset APPS BUILD RELEASE MACHINE SYSTEM
export KERNEL_BITS=64
export PERL="$PERL_PREFIX/bin/perl"
export PATH="$PERL_PREFIX/bin:${PATH:-}"

./config \\
  --prefix="$PREFIX" \\
  --openssldir="$PREFIX/etc/openssl" \\
  -I"$ZLIB_PREFIX/include" \\
  -L"$ZLIB_PREFIX/lib" \\
  zlib \\
  shared

# Same Linux-relevant post-configure cleanup Spack applies.
python3 - <<'PY'
from pathlib import Path
p = Path("Makefile")
s = p.read_text()
s = s.replace("-arch x86_64", "")
p.write_text(s)
PY

make -j"${MAKE_JOBS:-$(nproc)}"
make -j1 install_sw

mkdir -p "$PREFIX/etc/openssl"
cp "$CA_CERTIFICATES_MOZILLA_PREFIX/share/cacert.pem" "$PREFIX/etc/openssl/cert.pem"

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, what):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("openssl native build requires a non-empty {} prefix path".format(what))
    return value


def _openssl_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    perl_prefix = _read_prefix(repository_ctx, attr.perl_prefix_file, "perl")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")
    ca_prefix = _read_prefix(
        repository_ctx,
        attr.ca_certificates_mozilla_prefix_file,
        "ca-certificates-mozilla",
    )

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 7200,
        quiet = False,
        environment = {
            "PERL_PREFIX": perl_prefix,
            "ZLIB_PREFIX": zlib_prefix,
            "CA_CERTIFICATES_MOZILLA_PREFIX": ca_prefix,
        },
    )
    if res.return_code != 0:
        fail("openssl native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_rel = "prefix/lib64" if repository_ctx.path("prefix/lib64").exists else "prefix/lib"
    lib_abs = "{}/{}".format(repository_ctx.path("."), lib_rel)
    zlib_abs = "{}/lib".format(zlib_prefix)
    linkopts = [
        "-L" + lib_abs,
        "-Wl,-rpath," + lib_abs,
        "-lssl",
        "-lcrypto",
        "-L" + zlib_abs,
        "-Wl,-rpath," + zlib_abs,
        "-lz",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


openssl_native = repository_rule(
    implementation = _openssl_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ca_certificates_mozilla_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build OpenSSL from source into a Spack-prefix-identical runtime tree.",
)
