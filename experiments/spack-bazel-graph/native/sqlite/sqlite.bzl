"""Native (Bazel-owned) build of sqlite into a Spack-identical prefix.

The hermetic Spack v1.2.2 sqlite@3.53.1 recipe is an AutotoolsPackage with:

  * variants: +column_metadata +fts +rtree
  * depends_on("readline") and depends_on("zlib-api")
  * configure args: --enable-fts4 --enable-fts5 --enable-rtree
  * CPPFLAGS=-DSQLITE_ENABLE_COLUMN_METADATA=1

The observed hermetic Spack build detects zlib and emits
`Line-editing support for the sqlite3 shell: none`; this rule preserves that
result by validating the readline DAG input without injecting it into configure.
"""

_BUILD_TEMPLATE = """\
# GENERATED by sqlite_native. Native Bazel build of sqlite, intended to match
# the Spack sqlite install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "sqlite native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${READLINE_PREFIX:-}" || ! -d "${READLINE_PREFIX:-}/lib" ]]; then
  echo "READLINE_PREFIX must name the Bazel-built readline prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -d "${ZLIB_PREFIX:-}/lib" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

cd "$SRC"

# Reproduce the hermetic Spack sqlite build:
#   ./configure --prefix=... --enable-fts4 --enable-fts5 --enable-rtree \
#     CPPFLAGS=-DSQLITE_ENABLE_COLUMN_METADATA=1
# The Spack DAG includes readline, but the observed configure result is
# line-editing support: none, so do not add READLINE_PREFIX to configure flags.
dep_cppflags="-I${ZLIB_PREFIX}/include"
export LDFLAGS="-L${ZLIB_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export PKG_CONFIG=/bin/false
export PKG_CONFIG_PATH="${ZLIB_PREFIX}/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"

./configure \\
  --prefix="$PREFIX" \\
  --enable-fts4 \\
  --enable-fts5 \\
  --enable-rtree \\
  "CPPFLAGS=-DSQLITE_ENABLE_COLUMN_METADATA=1 ${dep_cppflags}"

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("sqlite native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _sqlite_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    readline_prefix = _read_prefix(repository_ctx, attr.readline_prefix_file, "readline")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "READLINE_PREFIX": readline_prefix,
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("sqlite native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    zlib_lib = "{}/lib".format(zlib_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lsqlite3",
        "-L" + zlib_lib,
        "-Wl,-rpath," + zlib_lib,
        "-lz",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


sqlite_native = repository_rule(
    implementation = _sqlite_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "readline_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build sqlite from source into a Spack-prefix-identical tree.",
)
