"""Native (Bazel-owned) build of libxml2 into a Spack-prefix-identical tree.

This is the first real consumer migration target in the hillclimb: `libxml2`
links against `xz` (liblzma), `zlib-ng`, and `libiconv`, and it has binaries
(`xmllint`, ...) besides the shared library.

The repository rule reproduces Spack’s autotools pipeline for libxml2 and emits
an install tree under `prefix/`. The ABI parity gate (tools/abi_parity.py)
compares the candidate prefix against the Spack reference prefix.

Note: matching Spack’s full configure-flag surface is a per-package deep dive.
We start with the minimal flags needed for a shared library install and then
iterate until the parity gate is green.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libxml2_native. Native Bazel build of libxml2, intended to match
# the Spack libxml2 install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = {includes},
    linkopts = {linkopts},
)

exports_files(["prefix_path.txt"])
"""

_MISSING_ENV_BUILD_TEMPLATE = """\
# GENERATED by libxml2_native. This native provider was declared but not
# configured with hermetic dependency prefixes, so it must not be used as a
# migrated provider.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = [],
)

cc_library(
    name = "lib",
    linkopts = ["-Wl,--no-undefined", "-l__libxml2_native_missing_env__"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"      # extracted source dir
PREFIX="$2"   # install prefix (absolute)

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libxml2 native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
for var in LIBICONV_PREFIX PKGCONF_PREFIX XZ_PREFIX ZLIB_NG_PREFIX; do
  val="${!var:-}"
  if [[ -z "$val" || ! -d "$val" ]]; then
    echo "$var must name a Bazel-built native dependency prefix" >&2
    exit 2
  fi
done
if [[ ! -x "$PKGCONF_PREFIX/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must provide bin/pkgconf" >&2
  exit 2
fi
if [[ ! -d "$LIBICONV_PREFIX/lib" || ! -d "$ZLIB_NG_PREFIX/lib" ]]; then
  echo "libxml2 native deps must expose lib/ directories" >&2
  exit 2
fi

cd "$SRC"

# Ensure configure and the final link step can find the Bazel-native dependency
# prefixes selected from the hermetic Spack DAG.
export CPPFLAGS="-I${LIBICONV_PREFIX}/include -I${XZ_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-fPIC -DPIC ${CFLAGS:-}"
export LDFLAGS="-L${LIBICONV_PREFIX}/lib -Wl,-rpath,${LIBICONV_PREFIX}/lib -L${XZ_PREFIX}/lib -Wl,-rpath,${XZ_PREFIX}/lib ${LDFLAGS:-}"
export LIBS="-liconv ${LIBS:-}"

export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${ZLIB_NG_PREFIX}/lib/pkgconfig:${ZLIB_NG_PREFIX}/lib64/pkgconfig:${XZ_PREFIX}/lib/pkgconfig:${XZ_PREFIX}/lib64/pkgconfig:${PKG_CONFIG_PATH:-}"

./configure \\
  --prefix="$PREFIX" \\
  --with-lzma="$XZ_PREFIX" \\
  --with-iconv="$LIBICONV_PREFIX" \\
  --with-zlib="$ZLIB_NG_PREFIX" \\
  --without-python \\
  --without-http \\
  --enable-shared \\
  --disable-static \\
  --without-pic

make -j"${MAKE_JOBS:-$(nproc)}"
make install

# Match the emitted prefix: Spack generally does not ship .la files.
find "$PREFIX" -type f -name '*.la' -delete || true
find "$PREFIX" -type f -name '*.a' -delete || true
"""

def _read_prefix(repository_ctx, label):
    path = repository_ctx.path(label)
    return repository_ctx.read(path).strip()

def _libxml2_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libxml2 native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    env = {
        "LIBICONV_PREFIX": _read_prefix(repository_ctx, attr.libiconv_prefix_file),
        "PKGCONF_PREFIX": _read_prefix(repository_ctx, attr.pkgconf_prefix_file),
        "XZ_PREFIX": _read_prefix(repository_ctx, attr.xz_prefix_file),
        "ZLIB_NG_PREFIX": _read_prefix(repository_ctx, attr.zlib_prefix_file),
    }

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("libxml2 native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lxml2",
    ]
    includes = ["prefix/include", "prefix/include/libxml2"]

    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts), includes = repr(includes)),
    )
    repository_ctx.file("prefix_path.txt", prefix + "\n")


libxml2_native = repository_rule(
    implementation = _libxml2_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libxml2 from source into a Spack-prefix-identical install tree.",
)
