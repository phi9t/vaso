"""Native (Bazel-owned) build of GNU findutils into a Spack-identical prefix.

The py-torch frontier captures findutils@4.10.0 as an AutotoolsPackage with
NLS enabled and the hermetic Spack `nonnull.patch` applied. It installs only
tooling, documentation, locale data, and var/; no public C ABI is exposed.
"""

_BUILD_TEMPLATE = """\
# GENERATED by findutils_native. Native Bazel build of GNU findutils, intended
# to match the Spack findutils install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# findutils is an executable/tool-prefix node in this graph. It exposes no
# public C ABI, but @spack_findutils//:lib must remain a valid provider target
# after a provider flip.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "findutils native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${GETTEXT_PREFIX:-}" || ! -x "${GETTEXT_PREFIX:-}/bin/msgfmt" ]]; then
  echo "GETTEXT_PREFIX must name the Bazel-built gettext prefix" >&2
  exit 2
fi

cd "$SRC"

# Mirror Spack's nonnull.patch for findutils@4.8.0: with GCC as well as macOS
# compilers, force the gnulib dynarray skeleton away from __nonnull detection.
python3 - <<'PY'
from pathlib import Path

path = Path("gl/lib/malloc/dynarray-skeleton.c")
needle = "#include <malloc/dynarray.h>\\n"
replacement = needle + "#undef __nonnull\\n#define __nonnull(x)\\n"
text = path.read_text()
if "#undef __nonnull" not in text:
    path.write_text(text.replace(needle, replacement, 1))
PY

mkdir -p spack-build
cd spack-build

export PATH="${GETTEXT_PREFIX}/bin:${PATH}"
export MSGFMT="${GETTEXT_PREFIX}/bin/msgfmt"

../configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("findutils native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _findutils_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("findutils native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    gettext_prefix = _read_prefix(repository_ctx, attr.gettext_prefix_file, "gettext")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "GETTEXT_PREFIX": gettext_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("findutils native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


findutils_native = repository_rule(
    implementation = _findutils_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "gettext_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU findutils from source into a Spack-prefix-identical tree.",
)
