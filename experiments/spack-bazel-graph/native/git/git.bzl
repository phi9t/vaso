"""Native (Bazel-owned) build of Git into a Spack-identical prefix.

The lean PyTorch frontier captures git@2.53.0 as an AutotoolsPackage after
OpenSSH. Spack patches the top-level Makefile to preserve EXTLIBS, writes a
small config.mak for glibc's arc4random support, configures explicit library
prefixes, builds with make, installs manpages, completions, and git-subtree.
"""

_BUILD_TEMPLATE = """\
# GENERATED by git_native. Native Bazel build of Git, intended to match the
# Spack git install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# Git is an executable/script/data prefix in this graph. It exposes no public C
# ABI, but @spack_git//:lib must remain a valid provider target after a native
# provider flip.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "git native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

for var in AUTOCONF_PREFIX AUTOMAKE_PREFIX CURL_PREFIX DIFFUTILS_PREFIX EXPAT_PREFIX GETTEXT_PREFIX LIBICONV_PREFIX LIBIDN2_PREFIX LIBTOOL_PREFIX M4_PREFIX OPENSSH_PREFIX OPENSSL_PREFIX PCRE2_PREFIX PERL_PREFIX ZLIB_PREFIX; do
  if [[ -z "${!var:-}" ]]; then
    echo "$var must name a Bazel-built dependency prefix" >&2
    exit 2
  fi
done

require_file() {
  local var="$1"
  local rel="$2"
  local value="${!var:-}"
  if [[ -z "$value" || ! -f "$value/$rel" ]]; then
    echo "$var must name a Bazel-built prefix containing $rel" >&2
    exit 2
  fi
}

require_exe() {
  local var="$1"
  local rel="$2"
  local value="${!var:-}"
  if [[ -z "$value" || ! -x "$value/$rel" ]]; then
    echo "$var must name a Bazel-built prefix containing executable $rel" >&2
    exit 2
  fi
}

require_exe AUTOCONF_PREFIX bin/autoconf
require_exe AUTOMAKE_PREFIX bin/automake
require_exe CURL_PREFIX bin/curl-config
require_exe DIFFUTILS_PREFIX bin/cmp
require_file EXPAT_PREFIX include/expat.h
require_exe GETTEXT_PREFIX bin/msgfmt
require_file LIBICONV_PREFIX include/iconv.h
require_file LIBIDN2_PREFIX include/idn2.h
require_exe LIBTOOL_PREFIX bin/libtool
require_exe M4_PREFIX bin/m4
require_exe OPENSSH_PREFIX bin/ssh
require_file OPENSSL_PREFIX include/openssl/ssl.h
require_file PCRE2_PREFIX include/pcre2.h
require_exe PERL_PREFIX bin/perl
require_file ZLIB_PREFIX include/zlib.h

libdir_for() {
  local prefix="$1"
  if [[ -d "$prefix/lib64" ]]; then
    echo "$prefix/lib64"
  else
    echo "$prefix/lib"
  fi
}

curl_libdir="$(libdir_for "$CURL_PREFIX")"
expat_libdir="$(libdir_for "$EXPAT_PREFIX")"
gettext_libdir="$(libdir_for "$GETTEXT_PREFIX")"
libiconv_libdir="$(libdir_for "$LIBICONV_PREFIX")"
libidn2_libdir="$(libdir_for "$LIBIDN2_PREFIX")"
openssl_libdir="$(libdir_for "$OPENSSL_PREFIX")"
pcre2_libdir="$(libdir_for "$PCRE2_PREFIX")"
perl_libdir="$(libdir_for "$PERL_PREFIX")"
zlib_libdir="$(libdir_for "$ZLIB_PREFIX")"

for path in \
  "$curl_libdir/libcurl.so" \
  "$expat_libdir/libexpat.so" \
  "$libiconv_libdir/libiconv.so" \
  "$libidn2_libdir/libidn2.so" \
  "$openssl_libdir/libssl.so" \
  "$openssl_libdir/libcrypto.so" \
  "$pcre2_libdir/libpcre2-8.so" \
  "$zlib_libdir/libz.so"; do
  [[ -e "$path" ]] || { echo "git dependency library missing: $path" >&2; exit 2; }
done

cd "$SRC"

# Mirror Spack's package-level patch and platform config.
python3 - <<'PY'
from pathlib import Path

makefile = Path("Makefile")
text = makefile.read_text()
text = text.replace("EXTLIBS =", "#EXTLIBS =")
makefile.write_text(text)
Path("config.mak").write_text("CSPRNG_METHOD=arc4random\\n")
PY

dep_bins=(
  "$AUTOCONF_PREFIX/bin"
  "$AUTOMAKE_PREFIX/bin"
  "$CURL_PREFIX/bin"
  "$DIFFUTILS_PREFIX/bin"
  "$GETTEXT_PREFIX/bin"
  "$LIBTOOL_PREFIX/bin"
  "$M4_PREFIX/bin"
  "$OPENSSH_PREFIX/bin"
  "$PERL_PREFIX/bin"
)
dep_libs=(
  "$curl_libdir"
  "$expat_libdir"
  "$gettext_libdir"
  "$libiconv_libdir"
  "$libidn2_libdir"
  "$openssl_libdir"
  "$pcre2_libdir"
  "$perl_libdir"
  "$zlib_libdir"
)
dep_includes=(
  "$CURL_PREFIX/include"
  "$EXPAT_PREFIX/include"
  "$GETTEXT_PREFIX/include"
  "$LIBICONV_PREFIX/include"
  "$LIBIDN2_PREFIX/include"
  "$OPENSSL_PREFIX/include"
  "$PCRE2_PREFIX/include"
  "$ZLIB_PREFIX/include"
)

export PATH="$(IFS=:; echo "${dep_bins[*]}"):$PATH"
export CPPFLAGS="$(printf ' -I%s' "${dep_includes[@]}") ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 -march=icelake-client -mtune=icelake-client ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 -march=icelake-client -mtune=icelake-client ${CXXFLAGS:-}"
export LDFLAGS="$(printf ' -L%s' "${dep_libs[@]}") -Wl,-rpath,$(IFS=:; echo "${dep_libs[*]}") -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LD_RUN_PATH="$(IFS=:; echo "${dep_libs[*]}")"
export PERL_PATH="$PERL_PREFIX/bin/perl"
export PYTHON_PATH="/usr/bin/python3"

./configure \
  --prefix="$PREFIX" \
  --with-curl="$CURL_PREFIX" \
  --with-expat="$EXPAT_PREFIX" \
  --with-openssl="$OPENSSL_PREFIX" \
  --with-libpcre2="$PCRE2_PREFIX" \
  --with-zlib="$ZLIB_PREFIX" \
  --with-iconv="$LIBICONV_PREFIX" \
  --with-perl="$PERL_PREFIX/bin/perl" \
  --without-tcltk

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

mkdir -p "$PREFIX/share/bash-completion/completions"
cp contrib/completion/git-completion.bash "$PREFIX/share/bash-completion/completions/git"

mkdir -p "$PREFIX/share/zsh/site-functions"
python3 - "$PREFIX" <<'PY'
import sys
from pathlib import Path

prefix = Path(sys.argv[1])
src = Path("contrib/completion/git-completion.zsh")
data = src.read_text()
data = data.replace("$bash_completion/git", str(prefix / "share/bash-completion/completions/git"))
(prefix / "share/zsh/site-functions/_git").write_text(data)
PY

if [[ -d git-manpages ]]; then
  mkdir -p "$PREFIX/share/man"
  cp -R git-manpages/man1 "$PREFIX/share/man/"
  cp -R git-manpages/man5 "$PREFIX/share/man/"
  cp -R git-manpages/man7 "$PREFIX/share/man/"
fi

make -C contrib/subtree V=1 prefix="$PREFIX/bin"
make -C contrib/subtree V=1 prefix="$PREFIX/bin" install
cp contrib/subtree/git-subtree "$PREFIX/bin/git-subtree"

find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("git native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _git_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("git native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.download_and_extract(
        url = attr.manpage_urls,
        sha256 = attr.manpage_sha256,
        output = "src/git-manpages",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    autoconf_prefix = _read_prefix(repository_ctx, attr.autoconf_prefix_file, "autoconf")
    automake_prefix = _read_prefix(repository_ctx, attr.automake_prefix_file, "automake")
    curl_prefix = _read_prefix(repository_ctx, attr.curl_prefix_file, "curl")
    diffutils_prefix = _read_prefix(repository_ctx, attr.diffutils_prefix_file, "diffutils")
    expat_prefix = _read_prefix(repository_ctx, attr.expat_prefix_file, "expat")
    gettext_prefix = _read_prefix(repository_ctx, attr.gettext_prefix_file, "gettext")
    libiconv_prefix = _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv")
    libidn2_prefix = _read_prefix(repository_ctx, attr.libidn2_prefix_file, "libidn2")
    libtool_prefix = _read_prefix(repository_ctx, attr.libtool_prefix_file, "libtool")
    m4_prefix = _read_prefix(repository_ctx, attr.m4_prefix_file, "m4")
    openssh_prefix = _read_prefix(repository_ctx, attr.openssh_prefix_file, "openssh")
    openssl_prefix = _read_prefix(repository_ctx, attr.openssl_prefix_file, "openssl")
    pcre2_prefix = _read_prefix(repository_ctx, attr.pcre2_prefix_file, "pcre2")
    perl_prefix = _read_prefix(repository_ctx, attr.perl_prefix_file, "perl")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = {
            "AUTOCONF_PREFIX": autoconf_prefix,
            "AUTOMAKE_PREFIX": automake_prefix,
            "CURL_PREFIX": curl_prefix,
            "DIFFUTILS_PREFIX": diffutils_prefix,
            "EXPAT_PREFIX": expat_prefix,
            "GETTEXT_PREFIX": gettext_prefix,
            "LIBICONV_PREFIX": libiconv_prefix,
            "LIBIDN2_PREFIX": libidn2_prefix,
            "LIBTOOL_PREFIX": libtool_prefix,
            "M4_PREFIX": m4_prefix,
            "OPENSSH_PREFIX": openssh_prefix,
            "OPENSSL_PREFIX": openssl_prefix,
            "PCRE2_PREFIX": pcre2_prefix,
            "PERL_PREFIX": perl_prefix,
            "VASO_IN_INSULA": "1",
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("git native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


git_native = repository_rule(
    implementation = _git_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "manpage_urls": attr.string_list(mandatory = True),
        "manpage_sha256": attr.string(mandatory = True),
        "autoconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "automake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "curl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "diffutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "expat_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gettext_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libidn2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libtool_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "m4_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openssh_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openssl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pcre2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build Git from source into a Spack-prefix-identical executable/data tree.",
)
