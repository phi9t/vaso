"""Native (Bazel-owned) build of expat into a Spack-identical prefix.

expat is the Python-DAG frontier immediately after libbsd. The hermetic Spack
v1.2.2 recipe defaults to Autotools and passes --without-docbook,
--enable-static, and --with-libbsd. Upstream expat 2.8.1 accepts the first two
and warns that --with-libbsd is unrecognized on this platform, but the native
rule keeps the argument to match Spack's concrete recipe path.
"""

_BUILD_TEMPLATE = """\
# GENERATED by expat_native. Native Bazel build of expat, intended to match the
# Spack expat install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "expat native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${LIBBSD_PREFIX:-}" || ! -d "${LIBBSD_PREFIX:-}/lib" ]]; then
  echo "LIBBSD_PREFIX must name the Bazel-built libbsd prefix" >&2
  exit 2
fi

cd "$SRC"

export CPPFLAGS="-I${LIBBSD_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${LIBBSD_PREFIX}/lib -Wl,-rpath,${LIBBSD_PREFIX}/lib ${LDFLAGS:-}"

./configure --prefix="$PREFIX" --without-docbook --enable-static --with-libbsd

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _expat_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    libbsd_prefix = repository_ctx.read(attr.libbsd_prefix_file).strip()
    if not libbsd_prefix:
        fail("expat native build requires a non-empty libbsd prefix path")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "LIBBSD_PREFIX": libbsd_prefix,
        },
    )
    if res.return_code != 0:
        fail("expat native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    libbsd_lib = "{}/lib".format(libbsd_prefix)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lexpat",
        "-L" + libbsd_lib,
        "-Wl,-rpath," + libbsd_lib,
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


expat_native = repository_rule(
    implementation = _expat_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "libbsd_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build expat from source into a Spack-prefix-identical tree.",
)
