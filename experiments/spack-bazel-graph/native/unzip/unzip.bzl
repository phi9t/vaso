"""Native (Bazel-owned) build of UnZip into a Spack-identical prefix.

The hermetic Spack v1.2.2 unzip@6.0 recipe is a MakefilePackage that applies
the bundled Spack patches plus Fedora security patches, then runs:

  make -f unix/Makefile LOC="<flags>" generic
  make -f unix/Makefile LOC="<flags>" prefix=<prefix> install

It is an executable-only prefix in this graph: unzip, funzip, unzipsfx,
zipgrep, zipinfo, and their manpages.
"""

_BUILD_TEMPLATE = """\
# GENERATED by unzip_native. Native Bazel build of UnZip, intended to match the
# Spack unzip install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# unzip is an executable/tool-prefix node in this graph. It exposes no public C
# ABI, but @spack_unzip//:lib must remain a valid provider target after a flip.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
JOBS="${MAKE_JOBS:-$(nproc)}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "unzip native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

make -j"$JOBS" -f unix/Makefile \
  "LOC=-Wno-error=implicit-function-declaration -Wno-error=implicit-int -DLARGE_FILE_SUPPORT" \
  generic
make -j"$JOBS" -f unix/Makefile \
  "LOC=-Wno-error=implicit-function-declaration -Wno-error=implicit-int -DLARGE_FILE_SUPPORT" \
  "prefix=${PREFIX}" \
  install
"""


def _apply_patch(repository_ctx, patch_file, strip):
    res = repository_ctx.execute(
        ["patch", "-p{}".format(strip), "-i", str(repository_ctx.path(patch_file))],
        working_directory = str(repository_ctx.path("src")),
        timeout = 120,
        quiet = False,
    )
    if res.return_code != 0:
        fail("unzip patch {} failed (rc={}):\n{}\n{}".format(
            patch_file,
            res.return_code,
            res.stdout,
            res.stderr,
        ))


def _patch_name(index):
    if index < 10:
        return "patches/0{}.patch".format(index)
    return "patches/{}.patch".format(index)


def _unzip_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("unzip native build must run inside the hermetic insula (VASO_IN_INSULA=1)")
    if len(attr.patch_urls) != len(attr.patch_sha256s):
        fail("unzip patch_urls and patch_sha256s must have the same length")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.download(
        url = attr.configure_cflags_patch_urls,
        sha256 = attr.configure_cflags_patch_sha256,
        output = "configure-cflags.patch",
    )
    repository_ctx.download(
        url = attr.strip_patch_urls,
        sha256 = attr.strip_patch_sha256,
        output = "strip.patch",
    )
    for index, url in enumerate(attr.patch_urls):
        repository_ctx.download(
            url = url,
            sha256 = attr.patch_sha256s[index],
            output = _patch_name(index),
        )

    _apply_patch(repository_ctx, "configure-cflags.patch", 0)
    _apply_patch(repository_ctx, "strip.patch", 1)
    for index, _ in enumerate(attr.patch_urls):
        _apply_patch(repository_ctx, _patch_name(index), 1)

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("unzip native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


unzip_native = repository_rule(
    implementation = _unzip_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "configure_cflags_patch_urls": attr.string_list(mandatory = True),
        "configure_cflags_patch_sha256": attr.string(mandatory = True),
        "strip_patch_urls": attr.string_list(mandatory = True),
        "strip_patch_sha256": attr.string(mandatory = True),
        "patch_urls": attr.string_list(mandatory = True),
        "patch_sha256s": attr.string_list(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build UnZip from source into a Spack-prefix-identical install tree.",
)
