"""Native (Bazel-owned) build of freetype into a Spack-identical prefix.

The hermetic Spack v1.2.2 freetype@2.14.2 recipe supports CMake and
Autotools, but defaults to Autotools because the CMake build does not install
freetype-config. The py-torch frontier variant builds shared+static FreeType
with bzip2 and libpng enabled, brotli/harfbuzz/zlib disabled, and PIC enabled.
"""

_BUILD_TEMPLATE = """\
# GENERATED by freetype_native. Native Bazel build of freetype, intended to
# match the Spack freetype install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/freetype2",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "freetype native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BZIP2_PREFIX:-}" || ! -f "${BZIP2_PREFIX:-}/include/bzlib.h" || ! -e "${BZIP2_PREFIX:-}/lib/libbz2.so" ]]; then
  echo "BZIP2_PREFIX must name the Bazel-built bzip2 prefix" >&2
  exit 2
fi
if [[ -z "${LIBPNG_PREFIX:-}" || ! -f "${LIBPNG_PREFIX:-}/include/libpng16/png.h" || ! -e "${LIBPNG_PREFIX:-}/lib/libpng16.so" ]]; then
  echo "LIBPNG_PREFIX must name the Bazel-built libpng prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix used by libpng pkg-config metadata" >&2
  exit 2
fi

cd "$SRC"

export PATH="${PKGCONF_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${BZIP2_PREFIX}/lib/pkgconfig:${LIBPNG_PREFIX}/lib/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig:${PKGCONF_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${BZIP2_PREFIX}/include -I${LIBPNG_PREFIX}/include/libpng16 -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${BZIP2_PREFIX}/lib -Wl,-rpath,${BZIP2_PREFIX}/lib -L${LIBPNG_PREFIX}/lib -Wl,-rpath,${LIBPNG_PREFIX}/lib -L${ZLIB_PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export CC="${CC:-gcc}"

./configure \
  --prefix="$PREFIX" \
  --with-brotli=no \
  --with-bzip2=yes \
  --with-harfbuzz=no \
  --with-png=yes \
  --with-zlib=no \
  --enable-freetype-config \
  --enable-shared \
  --with-pic

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("freetype native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _freetype_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("freetype native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    libpng_prefix = _read_prefix(repository_ctx, attr.libpng_prefix_file, "libpng")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 2400,
        quiet = False,
        environment = {
            "BZIP2_PREFIX": bzip2_prefix,
            "LIBPNG_PREFIX": libpng_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "VASO_IN_INSULA": "1",
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("freetype native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lfreetype",
        "-L" + "{}/lib".format(bzip2_prefix),
        "-Wl,-rpath," + "{}/lib".format(bzip2_prefix),
        "-lbz2",
        "-L" + "{}/lib".format(libpng_prefix),
        "-Wl,-rpath," + "{}/lib".format(libpng_prefix),
        "-lpng16",
        "-L" + "{}/lib".format(zlib_prefix),
        "-Wl,-rpath," + "{}/lib".format(zlib_prefix),
        "-lz",
        "-lm",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


freetype_native = repository_rule(
    implementation = _freetype_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpng_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build freetype from source into a Spack-prefix-identical install tree.",
)
