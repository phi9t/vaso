"""Native (Bazel-owned) py-meson-python prefix.

The hermetic Spack v1.2.2 py-meson-python@0.19.0 recipe is a PythonPackage
that uses the in-tree mesonpy PEP 517 backend, runs Meson/Ninja during metadata
preparation, then installs with:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

Spack supplies Meson, Ninja, packaging, pyproject-metadata, pip, wheel, Python,
and python-venv as concrete prefixes. This rule reproduces that dependency
channel with Bazel-native prefix markers and must run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_interpreter_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_meson_python_native. Native Bazel build of py-meson-python,
# intended to match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-meson-python is a pure Python package prefix. It has no C link surface,
# but @spack_py_meson_python//:lib must remain a valid provider target after
# migration for unmigrated PythonPackage consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-meson-python native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${MESON_PREFIX:-}" || ! -x "${MESON_PREFIX:-}/bin/meson" ]]; then
  echo "MESON_PREFIX must name the Bazel-built native meson prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ( ! -x "${NINJA_PREFIX:-}/bin/ninja" && ! -x "${NINJA_PREFIX:-}/bin/ninja-build" ) ]]; then
  echo "NINJA_PREFIX must name the Bazel-built native ninja prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native python prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python-venv prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_PREFIX must provide bin/python${PYTHON_ABI}" >&2
  exit 2
fi
if [[ -z "${PY_PACKAGING_PREFIX:-}" || ! -d "${PY_PACKAGING_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/packaging" ]]; then
  echo "PY_PACKAGING_PREFIX must name the Bazel-built native py-packaging prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_PYPROJECT_METADATA_PREFIX:-}" || ! -d "${PY_PYPROJECT_METADATA_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pyproject_metadata" ]]; then
  echo "PY_PYPROJECT_METADATA_PREFIX must name the Bazel-built native py-pyproject-metadata prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi
if [[ ! -d "${MESON_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/mesonbuild" ]]; then
  echo "MESON_PREFIX must provide mesonbuild for Python ${PYTHON_ABI}" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PACKAGING_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PYPROJECT_METADATA_PREFIX/lib/python${PYTHON_ABI}/site-packages:$MESON_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$MESON_PREFIX/bin:$NINJA_PREFIX/bin:$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:$PYTHON_PREFIX/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="$PYTHON_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python${PYTHON_ABI}" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -d "$site_packages/mesonpy"
test -f "$site_packages/mesonpy/__init__.py"
test -f "$site_packages/mesonpy/_compat.py"
test -f "$site_packages/mesonpy/_editable.py"
test -f "$site_packages/mesonpy/_rpath.py"
test -f "$site_packages/mesonpy/_tags.py"
test -f "$site_packages/mesonpy/_util.py"
test -f "$site_packages/mesonpy/_wheelfile.py"
test -f "$site_packages/meson_python-0.19.0.dist-info/INSTALLER"
test -f "$site_packages/meson_python-0.19.0.dist-info/METADATA"
test -f "$site_packages/meson_python-0.19.0.dist-info/REQUESTED"
test -f "$site_packages/meson_python-0.19.0.dist-info/WHEEL"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-meson-python native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_meson_python_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-meson-python native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    meson_prefix = _read_prefix(repository_ctx, attr.meson_prefix_file, "meson")
    ninja_prefix = _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja")
    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    python_abi = python_abi_from_interpreter_prefix(repository_ctx, python_venv_prefix, "python-venv")
    py_packaging_prefix = _read_prefix(repository_ctx, attr.py_packaging_prefix_file, "py-packaging")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_pyproject_metadata_prefix = _read_prefix(repository_ctx, attr.py_pyproject_metadata_prefix_file, "py-pyproject-metadata")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "MESON_PREFIX": meson_prefix,
            "NINJA_PREFIX": ninja_prefix,
            "PYTHON_ABI": python_abi,
            "PYTHON_PREFIX": python_prefix,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PACKAGING_PREFIX": py_packaging_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_PYPROJECT_METADATA_PREFIX": py_pyproject_metadata_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-meson-python native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_meson_python_native = repository_rule(
    implementation = _py_meson_python_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "meson_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_packaging_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pyproject_metadata_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-meson-python@0.19.0 from its PyPI source archive into a Spack-prefix-identical tree.",
)
