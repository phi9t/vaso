"""Native (Bazel-owned) py-wheel prefix.

The hermetic Spack v1.2.2 py-wheel@0.45.1 recipe installs the upstream wheel
with:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> <wheel>

Spack supplies pip by placing the py-pip prefix on PYTHONPATH. This rule
reproduces that dependency channel with Bazel-native prefix markers and must
run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_interpreter_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_wheel_native. Native Bazel build of py-wheel, intended to
# match the Spack wheel-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-wheel is a Python package prefix. It has no C link surface, but
# @spack_py_wheel//:lib must remain a valid provider target after migration for
# unmigrated Python package consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
WHEEL="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-wheel native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"

"$PYTHON_VENV_PREFIX/bin/python3" -m pip \\
  -vvv \\
  --no-input \\
  --no-cache-dir \\
  --disable-pip-version-check \\
  install \\
  --no-deps \\
  --ignore-installed \\
  --no-build-isolation \\
  --no-warn-script-location \\
  --no-index \\
  --prefix="$PREFIX" \\
  "$WHEEL"

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -x "$PREFIX/bin/wheel"
test -d "$site_packages/wheel"
test -f "$site_packages/wheel/__init__.py"
test -f "$site_packages/wheel/__main__.py"
test -f "$site_packages/wheel-0.45.1.dist-info/METADATA"
test -f "$site_packages/wheel-0.45.1.dist-info/WHEEL"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-wheel native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_wheel_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-wheel native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    wheel = repository_ctx.path("wheel-0.45.1-py3-none-any.whl")
    repository_ctx.download(
        url = attr.urls,
        sha256 = attr.sha256,
        output = wheel,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    python_abi = python_abi_from_interpreter_prefix(repository_ctx, python_venv_prefix, "python-venv")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(wheel), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "PYTHON_ABI": python_abi,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-wheel native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_wheel_native = repository_rule(
    implementation = _py_wheel_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Install py-wheel@0.45.1 from its upstream wheel into a Spack-prefix-identical tree.",
)
