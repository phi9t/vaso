"""Native (Bazel-owned) build of ncurses into a Spack-identical prefix.

The hermetic Spack v1.2.2 recipe builds ncurses@6.6 twice, once non-wide and
once wide, then installs both into one prefix. This rule follows that recipe
inside the sealed insula and applies the same rxvt-unicode terminfo patch.
"""

_BUILD_TEMPLATE = """\
# GENERATED by ncurses_native. Native Bazel build of ncurses, intended to match
# the Spack ncurses install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/ncurses",
        "prefix/include/ncursesw",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
PATCH="$3"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "ncurses native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

unset TERMINFO
export CFLAGS="-O2 -fPIC ${CFLAGS:-}"
export CXXFLAGS="-O2 -fPIC ${CXXFLAGS:-}"

cd "$SRC"
patch -p1 < "$PATCH"

common_opts=(
  --disable-stripping
  --with-shared
  --with-cxx-shared
  --enable-overwrite
  --without-ada
  --enable-pc-files
  --disable-overwrite
  "--with-pkg-config-libdir=$SRC/lib/pkgconfig"
  --with-termlib
  --enable-termcap
  --enable-getcap
  --enable-tcap-names
  --with-versioned-syms
)

mkdir -p "$SRC/lib/pkgconfig"

mkdir -p build_ncurses
(
  cd build_ncurses
  ../configure --prefix="$PREFIX" "${common_opts[@]}" \
    --disable-widec --without-manpages --without-tests
  make V=1 -j"${MAKE_JOBS:-$(nproc)}"
  make install
)

mkdir -p build_ncursesw
(
  cd build_ncursesw
  ../configure --prefix="$PREFIX" "${common_opts[@]}" \
    --enable-widec --without-manpages --without-tests
  make V=1 -j"${MAKE_JOBS:-$(nproc)}"
  make install
)

for header in "$PREFIX"/include/ncursesw/*.h; do
  [[ -e "$header" ]] || continue
  ln -sfn "ncursesw/$(basename "$header")" "$PREFIX/include/$(basename "$header")"
done

mkdir -p "$PREFIX/lib/pkgconfig"
cp -a "$SRC/lib/pkgconfig"/. "$PREFIX/lib/pkgconfig"/

if [[ ! -e "$PREFIX/lib/libcurses.so" && -e "$PREFIX/lib/libncurses.so" ]]; then
  ln -sfn "$PREFIX/lib/libncurses.so" "$PREFIX/lib/libcurses.so"
fi

find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _ncurses_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    patch = str(repository_ctx.path(attr.rxvt_patch))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix, patch],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("ncurses native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    link_libs = [
        "curses",
        "form",
        "form_g",
        "formw",
        "formw_g",
        "menu",
        "menu_g",
        "menuw",
        "menuw_g",
        "ncurses",
        "ncurses++",
        "ncurses++_g",
        "ncurses++w",
        "ncurses++w_g",
        "ncurses_g",
        "ncursesw",
        "ncursesw_g",
        "panel",
        "panel_g",
        "panelw",
        "panelw_g",
        "tinfo",
        "tinfo_g",
        "tinfow",
        "tinfow_g",
    ]
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib]
    for lib in link_libs:
        linkopts.append("-l" + lib)

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


ncurses_native = repository_rule(
    implementation = _ncurses_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "rxvt_patch": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build ncurses from source into a Spack-prefix-identical tree.",
)
