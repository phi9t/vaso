"""Native (Bazel-owned) py-urllib3 prefix.

The hermetic Spack v1.2.2 py-urllib3@2.6.3 recipe is a PythonPackage that
runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

Spack supplies pip, wheel, hatchling, hatch-vcs, setuptools-scm, and
hatchling's Python runtime dependencies through already installed prefixes. This
rule reproduces that dependency channel with Bazel-native prefix markers and
must run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_interpreter_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_urllib3_native. Native Bazel build of py-urllib3,
# intended to match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-urllib3 is a pure Python package prefix. It has no C link surface, but
# @spack_py_urllib3//:lib must remain a valid provider target after migration
# for unmigrated Python package consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-urllib3 native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PY_HATCH_VCS_PREFIX:-}" || ! -d "${PY_HATCH_VCS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/hatch_vcs" ]]; then
  echo "PY_HATCH_VCS_PREFIX must name the Bazel-built native py-hatch-vcs prefix" >&2
  exit 2
fi
if [[ -z "${PY_HATCHLING_PREFIX:-}" || ! -d "${PY_HATCHLING_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/hatchling" ]]; then
  echo "PY_HATCHLING_PREFIX must name the Bazel-built native py-hatchling prefix" >&2
  exit 2
fi
if [[ -z "${PY_PACKAGING_PREFIX:-}" || ! -d "${PY_PACKAGING_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/packaging" ]]; then
  echo "PY_PACKAGING_PREFIX must name the Bazel-built native py-packaging prefix" >&2
  exit 2
fi
if [[ -z "${PY_PATHSPEC_PREFIX:-}" || ! -d "${PY_PATHSPEC_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pathspec" ]]; then
  echo "PY_PATHSPEC_PREFIX must name the Bazel-built native py-pathspec prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_PLUGGY_PREFIX:-}" || ! -d "${PY_PLUGGY_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pluggy" ]]; then
  echo "PY_PLUGGY_PREFIX must name the Bazel-built native py-pluggy prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_SCM_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_SCM_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools_scm" ]]; then
  echo "PY_SETUPTOOLS_SCM_PREFIX must name the Bazel-built native py-setuptools-scm prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_TROVE_CLASSIFIERS_PREFIX:-}" || ! -d "${PY_TROVE_CLASSIFIERS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/trove_classifiers" ]]; then
  echo "PY_TROVE_CLASSIFIERS_PREFIX must name the Bazel-built native py-trove-classifiers prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export HATCH_METADATA_CLASSIFIERS_NO_VERIFY=1
export PYTHONPATH="$PY_HATCH_VCS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_HATCHLING_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PACKAGING_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PATHSPEC_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PLUGGY_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_SCM_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_TROVE_CLASSIFIERS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:/usr/bin:/bin"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -f "$site_packages/urllib3/__init__.py"
test -f "$site_packages/urllib3/_version.py"
test -f "$site_packages/urllib3/connectionpool.py"
test -f "$site_packages/urllib3/exceptions.py"
test -f "$site_packages/urllib3/poolmanager.py"
test -f "$site_packages/urllib3/response.py"
test -f "$site_packages/urllib3/util/retry.py"
test -f "$site_packages/urllib3/util/url.py"
test -f "$site_packages/urllib3/py.typed"
test -f "$site_packages/urllib3-2.6.3.dist-info/INSTALLER"
test -f "$site_packages/urllib3-2.6.3.dist-info/METADATA"
test -f "$site_packages/urllib3-2.6.3.dist-info/REQUESTED"
test -f "$site_packages/urllib3-2.6.3.dist-info/WHEEL"
test -f "$site_packages/urllib3-2.6.3.dist-info/licenses/LICENSE.txt"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-urllib3 native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_urllib3_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-urllib3 native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    python_abi = python_abi_from_interpreter_prefix(repository_ctx, python_venv_prefix, "python-venv")
    py_hatch_vcs_prefix = _read_prefix(repository_ctx, attr.py_hatch_vcs_prefix_file, "py-hatch-vcs")
    py_hatchling_prefix = _read_prefix(repository_ctx, attr.py_hatchling_prefix_file, "py-hatchling")
    py_packaging_prefix = _read_prefix(repository_ctx, attr.py_packaging_prefix_file, "py-packaging")
    py_pathspec_prefix = _read_prefix(repository_ctx, attr.py_pathspec_prefix_file, "py-pathspec")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_pluggy_prefix = _read_prefix(repository_ctx, attr.py_pluggy_prefix_file, "py-pluggy")
    py_setuptools_scm_prefix = _read_prefix(repository_ctx, attr.py_setuptools_scm_prefix_file, "py-setuptools-scm")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_trove_classifiers_prefix = _read_prefix(repository_ctx, attr.py_trove_classifiers_prefix_file, "py-trove-classifiers")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PYTHON_ABI": python_abi,
            "PY_HATCH_VCS_PREFIX": py_hatch_vcs_prefix,
            "PY_HATCHLING_PREFIX": py_hatchling_prefix,
            "PY_PACKAGING_PREFIX": py_packaging_prefix,
            "PY_PATHSPEC_PREFIX": py_pathspec_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_PLUGGY_PREFIX": py_pluggy_prefix,
            "PY_SETUPTOOLS_SCM_PREFIX": py_setuptools_scm_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_TROVE_CLASSIFIERS_PREFIX": py_trove_classifiers_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-urllib3 native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_urllib3_native = repository_rule(
    implementation = _py_urllib3_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_hatch_vcs_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_hatchling_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_packaging_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pathspec_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pluggy_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_scm_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_trove_classifiers_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-urllib3@2.6.3 from its PyPI source archive into a Spack-prefix-identical tree.",
)
