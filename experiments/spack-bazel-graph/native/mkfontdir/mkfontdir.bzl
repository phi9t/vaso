"""Native (Bazel-owned) build of mkfontdir into a Spack-identical prefix.

The py-torch frontier captures mkfontdir@1.0.7 as an X.Org
AutotoolsPackage. It installs only the mkfontdir shell wrapper and manpage,
but the wrapper delegates to mkfontscale at runtime. The build rule consumes
mkfontscale, pkgconf, and util-macros through explicit Bazel-native prefix
files so Autotools discovery stays inside the insula graph.
"""

_BUILD_TEMPLATE = """\
# GENERATED by mkfontdir_native. Native Bazel build of mkfontdir, intended to
# match the Spack mkfontdir install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# mkfontdir is an executable/tool-prefix node in this graph. It exposes no
# public C ABI, but @spack_mkfontdir//:lib must stay a valid provider target
# after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "mkfontdir native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${MKFONTSCALE_PREFIX:-}" || ! -x "${MKFONTSCALE_PREFIX:-}/bin/mkfontscale" ]]; then
  echo "MKFONTSCALE_PREFIX must name the Bazel-built mkfontscale prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${UTIL_MACROS_PREFIX:-}" || ! -f "${UTIL_MACROS_PREFIX:-}/share/aclocal/xorg-macros.m4" ]]; then
  echo "UTIL_MACROS_PREFIX must name the Bazel-built util-macros prefix" >&2
  exit 2
fi

cd "$SRC"

export PATH="${PKGCONF_PREFIX}/bin:${MKFONTSCALE_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${PKGCONF_PREFIX}/lib/pkgconfig:${UTIL_MACROS_PREFIX}/share/pkgconfig"
export ACLOCAL_PATH="${UTIL_MACROS_PREFIX}/share/aclocal:${PKGCONF_PREFIX}/share/aclocal${ACLOCAL_PATH:+:${ACLOCAL_PATH}}"

./configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("mkfontdir native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _mkfontdir_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("mkfontdir native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    mkfontscale_prefix = _read_prefix(repository_ctx, attr.mkfontscale_prefix_file, "mkfontscale")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    util_macros_prefix = _read_prefix(repository_ctx, attr.util_macros_prefix_file, "util-macros")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "MKFONTSCALE_PREFIX": mkfontscale_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "UTIL_MACROS_PREFIX": util_macros_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("mkfontdir native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


mkfontdir_native = repository_rule(
    implementation = _mkfontdir_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "mkfontscale_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "util_macros_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build mkfontdir from source into a Spack-prefix-identical executable tree.",
)
