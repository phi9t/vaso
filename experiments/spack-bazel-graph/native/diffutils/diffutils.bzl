"""Native (Bazel-owned) build of GNU diffutils into a Spack-identical prefix."""

_BUILD_TEMPLATE = """\
# GENERATED by diffutils_native. Native Bazel build of GNU diffutils, intended
# to match the Spack diffutils install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# diffutils is a tool-prefix node in this graph. It exposes no public C ABI, but
# @spack_diffutils//:lib must remain a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "diffutils native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

../configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# The hermetic Spack prefix for diffutils@3.12 contains bin/{cmp,diff,diff3,sdiff}
# and share/info/diffutils.info, but no manpage or locale payload.
rm -rf "$PREFIX/share/man" "$PREFIX/share/locale"
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _diffutils_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("diffutils native build failed (rc={}):\n{}\n{}".format(
            res.return_code, res.stdout, res.stderr))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


diffutils_native = repository_rule(
    implementation = _diffutils_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build GNU diffutils from source into a Spack-prefix-identical tree.",
)
