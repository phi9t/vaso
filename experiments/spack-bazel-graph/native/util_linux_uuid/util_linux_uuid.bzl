"""Native (Bazel-owned) build of util-linux-uuid into a Spack-identical prefix.

The hermetic Spack v1.2.2 util-linux-uuid@2.41 recipe is an AutotoolsPackage
that builds only libuuid from the larger util-linux release archive:

  * --disable-use-tty-group
  * --disable-makeinstall-chown
  * --without-systemd
  * --disable-all-programs
  * --without-python
  * --enable-libuuid
  * --disable-bash-completion

This repository rule fetches the same release archive and emits the libuuid
prefix used by generated @spack_util_linux_uuid consumers.
"""

_BUILD_TEMPLATE = """\
# GENERATED by util_linux_uuid_native. Native Bazel build of util-linux-uuid,
# intended to match the Spack util-linux-uuid install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/uuid",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "util-linux-uuid native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

export LDFLAGS="-Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"

./configure \\
  --prefix="$PREFIX" \\
  --disable-use-tty-group \\
  --disable-makeinstall-chown \\
  --without-systemd \\
  --disable-all-programs \\
  --without-python \\
  --enable-libuuid \\
  --disable-bash-completion

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _util_linux_uuid_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("util-linux-uuid native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-luuid",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


util_linux_uuid_native = repository_rule(
    implementation = _util_linux_uuid_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build util-linux-uuid from source into a Spack-prefix-identical tree.",
)
