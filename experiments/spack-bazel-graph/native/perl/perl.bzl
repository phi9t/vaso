"""Native (Bazel-owned) build of Perl into a Spack-identical prefix.

Perl is a Spack GenericPackage in this graph: Spack runs Perl's own
`Configure`, then `make`, `make install`, and finally installs the cpanminus
resource with the newly installed Perl. This repository rule mirrors that flow
inside the CUDA insula and consumes the already-migrated native dependency
prefixes through explicit `prefix_path.txt` files.
"""

_BUILD_TEMPLATE = """\
# GENERATED by perl_native. Native Bazel build of Perl, intended to match the
# Spack perl install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/lib/**/CORE/*.h"], allow_empty = True),
    includes = {includes},
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
CPANM_SRC="$2"
PREFIX="$3"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "perl native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
for var in BERKELEY_DB_PREFIX BZIP2_PREFIX GDBM_PREFIX ZLIB_PREFIX; do
  val="${!var:-}"
  if [[ -z "$val" || ! -d "$val/lib" ]]; then
    echo "$var must name a Bazel-built native dependency prefix" >&2
    exit 2
  fi
done

cd "$SRC"

# Same Linux-relevant patch Spack applies before Configure.
chmod 0644 lib/perlbug.t
python3 - <<'PY'
from pathlib import Path
p = Path("lib/perlbug.t")
s = p.read_text()
s = s.replace("!/$B/", "! (/(?:$B|PATH)/)")
p.write_text(s)
PY

rm -rf cpanm
mkdir -p cpanm
cp -a "$CPANM_SRC" cpanm/cpanm

dep_includes=(
  "$GDBM_PREFIX/include"
  "$BZIP2_PREFIX/include"
  "$ZLIB_PREFIX/include"
  "$BERKELEY_DB_PREFIX/include"
)
dep_libs=(
  "$GDBM_PREFIX/lib"
  "$BZIP2_PREFIX/lib"
  "$ZLIB_PREFIX/lib"
  "$BERKELEY_DB_PREFIX/lib"
)
core_dir="$PREFIX/lib/5.42.0/x86_64-linux-thread-multi/CORE"

join_by() {
  local IFS="$1"
  shift
  echo "$*"
}

include_flags=()
for d in "${dep_includes[@]}"; do include_flags+=("-I$d"); done
lib_flags=()
rpath_flags=("-Wl,-rpath,$core_dir" "-Wl,-rpath,$PREFIX/lib" "-Wl,-rpath,$PREFIX/lib64")
for d in "${dep_libs[@]}"; do
  lib_flags+=("-L$d")
  rpath_flags+=("-Wl,-rpath,$d")
done
rpath_flags+=("-Wl,--disable-new-dtags")

export BUILD_BZIP2=0
export BUILD_ZLIB=0
export BZIP2_INCLUDE="$BZIP2_PREFIX/include"
export BZIP2_LIB="$BZIP2_PREFIX/lib"
export ZLIB_INCLUDE="$ZLIB_PREFIX/include"
export ZLIB_LIB="$ZLIB_PREFIX/lib"
export PKG_CONFIG_PATH="$BZIP2_PREFIX/lib/pkgconfig:$ZLIB_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export CPATH="$(join_by : "${dep_includes[@]}")${CPATH:+:$CPATH}"
export LIBRARY_PATH="$(join_by : "${dep_libs[@]}")${LIBRARY_PATH:+:$LIBRARY_PATH}"
export LD_LIBRARY_PATH="$(join_by : "${dep_libs[@]}")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export SPACK_STORE_INCLUDE_DIRS="$(join_by : "${dep_includes[@]}")"
export SPACK_STORE_LINK_DIRS="$(join_by : "${dep_libs[@]}")"
export SPACK_STORE_RPATH_DIRS="$PREFIX/lib:$PREFIX/lib64:$(join_by : "${dep_libs[@]}")"
export SPACK_DISABLE_NEW_DTAGS="--disable-new-dtags"
export CFLAGS="${CFLAGS:-} ${include_flags[*]}"
export CPPFLAGS="${CPPFLAGS:-} ${include_flags[*]}"
export LDFLAGS="${LDFLAGS:-} ${lib_flags[*]} ${rpath_flags[*]}"

# Perl Configure invokes make internally during setup; Spack clears MAKEFLAGS
# for this phase and then runs the package build normally.
MAKEFLAGS= ./Configure \\
  -des \\
  -Dprefix="$PREFIX" \\
  -Dlocincpth="$GDBM_PREFIX/include" \\
  -Dloclibpth="$GDBM_PREFIX/lib" \\
  "-Accflags=-DAPPLLIB_EXP=\\\\\\\"$PREFIX/lib/perl5\\\\\\\"" \\
  -Duseshrplib \\
  -Dusethreads \\
  -Dnoextensions=DB_File

# Perl Configure writes -A ccflags through a generated shell fragment, which
# strips the quote characters required by APPLLIB_EXP before make invokes the
# compiler. Rewrite only that generated token so the make shell passes
# -DAPPLLIB_EXP="/.../lib/perl5" to GCC.
python3 - "$PREFIX" <<'PY'
from pathlib import Path
import re
import sys

prefix = sys.argv[1]
config_replacement = f'-DAPPLLIB_EXP="{prefix}/lib/perl5"'
cflags_replacement = f'-DAPPLLIB_EXP=\\\\\\"{prefix}/lib/perl5\\\\\\"'
pattern = re.compile(r'-DAPPLLIB_EXP=(?:"[^"]*"|\\\\"[^"]*\\\\"|\\?"?[^\\s\\\'"]+\\?"?)')
total = 0
for rel in ("config.sh", "cflags", "Makefile", "makefile"):
    path = Path(rel)
    if not path.exists():
        continue
    data = path.read_text()
    replacement = cflags_replacement if rel == "cflags" else config_replacement
    new, count = pattern.subn(replacement, data)
    if count:
        path.write_text(new)
        total += count
if total == 0:
    raise SystemExit("APPLLIB_EXP token not found in generated Perl build files")
PY

make -j"${MAKE_JOBS:-$(nproc)}"
make install

(
  cd cpanm/cpanm
  "$PREFIX/bin/perl" Makefile.PL
  make -j"${MAKE_JOBS:-$(nproc)}"
  make install
)

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, what):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("perl native build requires a non-empty {} prefix path".format(what))
    return value


def _perl_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.download_and_extract(
        url = attr.cpanm_urls,
        sha256 = attr.cpanm_sha256,
        stripPrefix = attr.cpanm_strip_prefix,
        output = "cpanm_src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    berkeley_db_prefix = _read_prefix(repository_ctx, attr.berkeley_db_prefix_file, "berkeley-db")
    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    gdbm_prefix = _read_prefix(repository_ctx, attr.gdbm_prefix_file, "gdbm")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    cpanm_src = str(repository_ctx.path("cpanm_src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, cpanm_src, prefix],
        timeout = 7200,
        quiet = False,
        environment = {
            "BERKELEY_DB_PREFIX": berkeley_db_prefix,
            "BZIP2_PREFIX": bzip2_prefix,
            "GDBM_PREFIX": gdbm_prefix,
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("perl native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    core_rel = None
    for path in repository_ctx.path("prefix/lib").readdir():
        if not path.basename.startswith("5.42.0"):
            continue
        for arch in path.readdir():
            candidate = arch.get_child("CORE").get_child("libperl.so")
            if candidate.exists:
                core_rel = "prefix/lib/{}/{}/CORE".format(path.basename, arch.basename)
                break
        if core_rel:
            break
    if not core_rel:
        fail("perl native build did not emit CORE/libperl.so under prefix/lib/5.42.0")

    repo_root = str(repository_ctx.path("."))
    core_abs = "{}/{}".format(repo_root, core_rel)
    dep_libs = [
        "{}/lib".format(gdbm_prefix),
        "{}/lib".format(bzip2_prefix),
        "{}/lib".format(zlib_prefix),
        "{}/lib".format(berkeley_db_prefix),
    ]
    linkopts = [
        "-L" + core_abs,
        "-Wl,-rpath," + core_abs,
        "-lperl",
    ]
    for libdir in dep_libs:
        linkopts.extend(["-L" + libdir, "-Wl,-rpath," + libdir])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(
            includes = repr([core_rel]),
            linkopts = repr(linkopts),
        ),
    )


perl_native = repository_rule(
    implementation = _perl_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "cpanm_urls": attr.string_list(mandatory = True),
        "cpanm_sha256": attr.string(mandatory = True),
        "cpanm_strip_prefix": attr.string(mandatory = True),
        "berkeley_db_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gdbm_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build Perl from source into a Spack-prefix-identical runtime tree.",
)
