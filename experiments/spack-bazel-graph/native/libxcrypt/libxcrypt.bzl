"""Native (Bazel-owned) build of libxcrypt into a Spack-identical prefix.

The py-torch frontier captures libxcrypt@4.5.2 as an AutotoolsPackage with
~obsolete_api and a build-only Perl dependency. Spack configures it with
--disable-werror, --disable-obsolete-api, and a Python-passlib cache override to
avoid a Python test dependency cycle.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libxcrypt_native. Native Bazel build of libxcrypt, intended to
# match the Spack libxcrypt install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libxcrypt native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PERL_PREFIX:-}" || ! -x "${PERL_PREFIX:-}/bin/perl" ]]; then
  echo "PERL_PREFIX must name the Bazel-built perl prefix" >&2
  exit 2
fi

cd "$SRC"

export PATH="${PERL_PREFIX}/bin:${PATH:-}"
export PERL="${PERL_PREFIX}/bin/perl"

./configure \\
  --prefix="$PREFIX" \\
  ac_cv_path_python3_passlib="not found" \\
  --disable-werror \\
  --disable-obsolete-api

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack removes libtool archives from emitted prefixes.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libxcrypt native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libxcrypt_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libxcrypt native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    perl_prefix = _read_prefix(repository_ctx, attr.perl_prefix_file, "perl")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "PERL_PREFIX": perl_prefix,
        },
    )
    if res.return_code != 0:
        fail("libxcrypt native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lcrypt"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libxcrypt_native = repository_rule(
    implementation = _libxcrypt_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libxcrypt from source into a Spack-prefix-identical install tree.",
)
