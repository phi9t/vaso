"""Native (Bazel-owned) build of flex into a Spack-identical prefix.

The py-torch frontier captures flex@2.6.3 as an AutotoolsPackage with `~nls`
and `+lex`. It consumes bison, diffutils, findutils, and m4 as build tools.
"""

_BUILD_TEMPLATE = """\
# GENERATED by flex_native. Native Bazel build of flex, intended to match the
# Spack flex install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**/*.h"], allow_empty = False),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "flex native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BISON_PREFIX:-}" || ! -x "${BISON_PREFIX:-}/bin/bison" ]]; then
  echo "BISON_PREFIX must name the Bazel-built bison prefix" >&2
  exit 2
fi
if [[ -z "${DIFFUTILS_PREFIX:-}" || ! -x "${DIFFUTILS_PREFIX:-}/bin/diff" || ! -x "${DIFFUTILS_PREFIX:-}/bin/cmp" ]]; then
  echo "DIFFUTILS_PREFIX must name the Bazel-built diffutils prefix" >&2
  exit 2
fi
if [[ -z "${FINDUTILS_PREFIX:-}" || ! -x "${FINDUTILS_PREFIX:-}/bin/find" || ! -x "${FINDUTILS_PREFIX:-}/bin/xargs" ]]; then
  echo "FINDUTILS_PREFIX must name the Bazel-built findutils prefix" >&2
  exit 2
fi
if [[ -z "${M4_PREFIX:-}" || ! -x "${M4_PREFIX:-}/bin/m4" ]]; then
  echo "M4_PREFIX must name the Bazel-built m4 prefix" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

export PATH="${BISON_PREFIX}/bin:${DIFFUTILS_PREFIX}/bin:${FINDUTILS_PREFIX}/bin:${M4_PREFIX}/bin:${PATH}"
export BISON="${BISON_PREFIX}/bin/bison"
export M4="${M4_PREFIX}/bin/m4"

../configure --prefix="$PREFIX" --disable-nls
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack removes libtool archives from emitted prefixes.
find "$PREFIX" -type f -name '*.la' -delete || true

# Spack's default +lex variant provides POSIX-lex compatibility names.
ln -sf flex "$PREFIX/bin/flex++"
ln -sf flex "$PREFIX/bin/lex"
if [[ -e "$PREFIX/lib/libfl.a" ]]; then
  ln -sf libfl.a "$PREFIX/lib/libl.a"
fi
if [[ -e "$PREFIX/lib/libfl.so" ]]; then
  ln -sf libfl.so "$PREFIX/lib/libl.so"
fi
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("flex native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _flex_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("flex native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bison_prefix = _read_prefix(repository_ctx, attr.bison_prefix_file, "bison")
    diffutils_prefix = _read_prefix(repository_ctx, attr.diffutils_prefix_file, "diffutils")
    findutils_prefix = _read_prefix(repository_ctx, attr.findutils_prefix_file, "findutils")
    m4_prefix = _read_prefix(repository_ctx, attr.m4_prefix_file, "m4")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "BISON_PREFIX": bison_prefix,
            "DIFFUTILS_PREFIX": diffutils_prefix,
            "FINDUTILS_PREFIX": findutils_prefix,
            "M4_PREFIX": m4_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("flex native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-lfl"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


flex_native = repository_rule(
    implementation = _flex_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bison_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "diffutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "findutils_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "m4_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build flex from source into a Spack-prefix-identical tree.",
)
