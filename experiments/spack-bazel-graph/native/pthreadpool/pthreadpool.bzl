"""Native (Bazel-owned) build of pthreadpool into a Spack-identical prefix.

The hermetic Spack v1.2.2 pthreadpool@2023-08-29 recipe is a CMakePackage.
The concrete py-torch frontier build uses the Ninja generator, builds a static
PIC libpthreadpool.a, vendors FXdiv as a source subdirectory, disables tests and
benchmarks, and installs include/pthreadpool.h plus include/fxdiv.h.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by pthreadpool_native. Native Bazel build of pthreadpool, intended
# to match the Spack pthreadpool install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: cmake
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "pthreadpool native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-built CMake prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja-build" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built Ninja prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native python prefix" >&2
  exit 2
fi

CMAKE="$CMAKE_PREFIX/bin/cmake"
NINJA="$NINJA_PREFIX/bin/ninja-build"
PYTHON="$PYTHON_PREFIX/bin/python${PYTHON_ABI}"
BUILD="$(mktemp -d)"
cd "$BUILD"

mkdir -p "$SRC/deps/googletest" "$SRC/deps/googlebenchmark"

export PATH="${CMAKE_PREFIX}/bin:${NINJA_PREFIX}/bin:${PYTHON_PREFIX}/bin:${PATH}"
export CMAKE_PREFIX_PATH="${CMAKE_PREFIX};${NINJA_PREFIX};${PYTHON_PREFIX}"
export CC="${CC:-gcc}"
export CXX="${CXX:-g++}"

"$CMAKE" -G Ninja \
  -DCMAKE_MAKE_PROGRAM:FILEPATH="$NINJA" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  -DCMAKE_INSTALL_RPATH_USE_LINK_PATH:BOOL=ON \
  "-DCMAKE_INSTALL_RPATH:STRING=${PREFIX}/lib;${PREFIX}/lib64" \
  "-DCMAKE_PREFIX_PATH:STRING=${CMAKE_PREFIX};${NINJA_PREFIX};${PYTHON_PREFIX}" \
  -DPYTHON_EXECUTABLE:PATH="$PYTHON" \
  -DPython_EXECUTABLE:PATH="$PYTHON" \
  -DPython3_EXECUTABLE:PATH="$PYTHON" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF \
  -DCMAKE_POLICY_DEFAULT_CMP0090:STRING=NEW \
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF \
  -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=ON \
  "-DFXDIV_SOURCE_DIR:STRING=${SRC}/deps/fxdiv" \
  "-DGOOGLETEST_SOURCE_DIR:STRING=${SRC}/deps/googletest" \
  "-DGOOGLEBENCHMARK_SOURCE_DIR:STRING=${SRC}/deps/googlebenchmark" \
  -DPTHREADPOOL_BUILD_TESTS:BOOL=OFF \
  -DPTHREADPOOL_BUILD_BENCHMARKS:BOOL=OFF \
  -DPTHREADPOOL_LIBRARY_TYPE:STRING=static \
  -DPTHREADPOOL_ALLOW_DEPRECATED_API:BOOL=ON \
  -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON \
  "$SRC"
"$NINJA" -v
"$NINJA" install
test -f "$PREFIX/include/pthreadpool.h"
test -f "$PREFIX/include/fxdiv.h"
test -f "$PREFIX/lib/libpthreadpool.a"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("pthreadpool native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _pthreadpool_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("pthreadpool native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.download_and_extract(
        url = attr.fxdiv_urls,
        sha256 = attr.fxdiv_sha256,
        stripPrefix = attr.fxdiv_strip_prefix,
        output = "src/deps/fxdiv",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")
    ninja_prefix = _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja")
    python_prefix = _read_prefix(repository_ctx, attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "NINJA_PREFIX": ninja_prefix,
            "PYTHON_PREFIX": python_prefix,
            "PYTHON_ABI": python_abi,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("pthreadpool native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lpthreadpool",
        "-pthread",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


pthreadpool_native = repository_rule(
    implementation = _pthreadpool_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "fxdiv_urls": attr.string_list(mandatory = True),
        "fxdiv_sha256": attr.string(mandatory = True),
        "fxdiv_strip_prefix": attr.string(mandatory = True),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build pthreadpool from source into a Spack-prefix-identical static-library tree.",
)
