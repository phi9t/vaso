"""Native (Bazel-owned) build of OpenMPI into a Spack-identical prefix.

The PyTorch frontier captures openmpi@5.0.10 as an AutotoolsPackage after
native PMIx, PRRTE, hwloc, libevent, numactl, and OpenSSH. The rule replays the
hermetic Spack configure contract and passes every dependency through a Bazel
prefix file so the build cannot discover host Spack state.
"""

_BUILD_TEMPLATE = """\
# GENERATED by openmpi_native. Native Bazel build of OpenMPI, intended to match
# the Spack OpenMPI install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/openmpi",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "openmpi native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${AUTOCONF_PREFIX:-}" || ! -x "${AUTOCONF_PREFIX:-}/bin/autoconf" ]]; then
  echo "AUTOCONF_PREFIX must name the Bazel-built autoconf prefix" >&2
  exit 2
fi
if [[ -z "${AUTOMAKE_PREFIX:-}" || ! -x "${AUTOMAKE_PREFIX:-}/bin/automake" ]]; then
  echo "AUTOMAKE_PREFIX must name the Bazel-built automake prefix" >&2
  exit 2
fi
if [[ -z "${HWLOC_PREFIX:-}" || ! -f "${HWLOC_PREFIX:-}/include/hwloc.h" || ! -e "${HWLOC_PREFIX:-}/lib/libhwloc.so" ]]; then
  echo "HWLOC_PREFIX must name the Bazel-built hwloc prefix" >&2
  exit 2
fi
if [[ -z "${LIBEVENT_PREFIX:-}" || ! -f "${LIBEVENT_PREFIX:-}/include/event2/event.h" || ! -e "${LIBEVENT_PREFIX:-}/lib/libevent_core.so" ]]; then
  echo "LIBEVENT_PREFIX must name the Bazel-built libevent prefix" >&2
  exit 2
fi
if [[ -z "${LIBTOOL_PREFIX:-}" || ! -x "${LIBTOOL_PREFIX:-}/bin/libtoolize" ]]; then
  echo "LIBTOOL_PREFIX must name the Bazel-built libtool prefix" >&2
  exit 2
fi
if [[ -z "${NUMACTL_PREFIX:-}" || ! -f "${NUMACTL_PREFIX:-}/include/numa.h" || ! -e "${NUMACTL_PREFIX:-}/lib/libnuma.so" ]]; then
  echo "NUMACTL_PREFIX must name the Bazel-built numactl prefix" >&2
  exit 2
fi
if [[ -z "${OPENSSH_PREFIX:-}" || ! -x "${OPENSSH_PREFIX:-}/bin/ssh" ]]; then
  echo "OPENSSH_PREFIX must name the Bazel-built OpenSSH prefix" >&2
  exit 2
fi
if [[ -z "${PERL_PREFIX:-}" || ! -x "${PERL_PREFIX:-}/bin/perl" ]]; then
  echo "PERL_PREFIX must name the Bazel-built perl prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${PMIX_PREFIX:-}" || ! -f "${PMIX_PREFIX:-}/include/pmix.h" || ! -e "${PMIX_PREFIX:-}/lib/libpmix.so" ]]; then
  echo "PMIX_PREFIX must name the Bazel-built PMIx prefix" >&2
  exit 2
fi
if [[ -z "${PRRTE_PREFIX:-}" || ! -f "${PRRTE_PREFIX:-}/include/prte.h" || ! -e "${PRRTE_PREFIX:-}/lib/libprrte.so" ]]; then
  echo "PRRTE_PREFIX must name the Bazel-built PRRTE prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi
if [[ ! -x /usr/bin/gfortran ]]; then
  echo "openmpi native build requires the hermetic rootfs Fortran compiler at /usr/bin/gfortran" >&2
  exit 2
fi

cd "$SRC"

export PATH="${AUTOCONF_PREFIX}/bin:${AUTOMAKE_PREFIX}/bin:${LIBTOOL_PREFIX}/bin:${OPENSSH_PREFIX}/bin:${PERL_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH}"
export PERL="${PERL_PREFIX}/bin/perl"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export ACLOCAL_PATH="${LIBTOOL_PREFIX}/share/aclocal:${AUTOMAKE_PREFIX}/share/aclocal:${PKGCONF_PREFIX}/share/aclocal${ACLOCAL_PATH:+:${ACLOCAL_PATH}}"
export PKG_CONFIG_PATH="${NUMACTL_PREFIX}/lib/pkgconfig:${PKGCONF_PREFIX}/lib/pkgconfig:${PMIX_PREFIX}/lib/pkgconfig:${HWLOC_PREFIX}/lib/pkgconfig:${LIBEVENT_PREFIX}/lib/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${LIBEVENT_PREFIX}/include -I${HWLOC_PREFIX}/include -I${PMIX_PREFIX}/include -I${PMIX_PREFIX}/include/pmix -I${PRRTE_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -DNDEBUG -DYY_BUF_SIZE=1048576 -finline-functions ${CFLAGS:-}"
export CXXFLAGS="-O3 -DNDEBUG -finline-functions ${CXXFLAGS:-}"
export FC="${FC:-/usr/bin/gfortran}"
export LDFLAGS="-L${LIBEVENT_PREFIX}/lib -Wl,-rpath,${LIBEVENT_PREFIX}/lib -L${HWLOC_PREFIX}/lib -Wl,-rpath,${HWLOC_PREFIX}/lib -L${PMIX_PREFIX}/lib -Wl,-rpath,${PMIX_PREFIX}/lib -L${PRRTE_PREFIX}/lib -Wl,-rpath,${PRRTE_PREFIX}/lib -L${ZLIB_PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib -L${NUMACTL_PREFIX}/lib -Wl,-rpath,${NUMACTL_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LD_LIBRARY_PATH="${LIBEVENT_PREFIX}/lib:${HWLOC_PREFIX}/lib:${PMIX_PREFIX}/lib:${PRRTE_PREFIX}/lib:${ZLIB_PREFIX}/lib:${NUMACTL_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export CC="${CC:-/usr/bin/gcc}"
export CXX="${CXX:-/usr/bin/g++}"

./configure \\
  --prefix="$PREFIX" \\
  --enable-shared \\
  --disable-silent-rules \\
  --disable-sphinx \\
  --disable-dependency-tracking \\
  --enable-builtin-atomics \\
  --disable-static \\
  --enable-mpi1-compatibility \\
  --without-psm \\
  --without-psm2 \\
  --without-verbs \\
  --without-mxm \\
  --without-ucx \\
  --without-ofi \\
  --without-fca \\
  --without-hcoll \\
  --without-ucc \\
  --without-xpmem \\
  --without-cma \\
  --without-knem \\
  --without-xpmem \\
  --without-alps \\
  --without-lsf \\
  --without-tm \\
  --without-slurm \\
  --without-sge \\
  --without-loadleveler \\
  --disable-memchecker \\
  --with-libevent="$LIBEVENT_PREFIX" \\
  --with-pmix="$PMIX_PREFIX" \\
  --with-prrte="$PRRTE_PREFIX" \\
  --with-zlib="$ZLIB_PREFIX" \\
  --with-hwloc="$HWLOC_PREFIX" \\
  --disable-java \\
  --disable-mpi-java \\
  --disable-io-romio \\
  --with-gpfs=no \\
  --without-cuda \\
  --without-rocm \\
  --enable-wrapper-rpath \\
  --disable-wrapper-runpath \\
  --enable-mpi-fortran \\
  --disable-debug

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Match Spack's public prefix surface.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("openmpi native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _download_patch(repository_ctx, index, url, sha256):
    out = "patches/openmpi-5.0.10-{}.patch".format(index)
    repository_ctx.download(url = url, sha256 = sha256, output = out)
    return out


def _openmpi_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("openmpi native build must run inside the hermetic insula (VASO_IN_INSULA=1)")
    if len(attr.patch_urls) != len(attr.patch_sha256s):
        fail("openmpi patch_urls and patch_sha256s must have the same length")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    for index, url in enumerate(attr.patch_urls):
        patch_file = _download_patch(repository_ctx, index + 1, url, attr.patch_sha256s[index])
        patch = repository_ctx.execute(
            ["patch", "-p1", "-i", str(repository_ctx.path(patch_file))],
            working_directory = str(repository_ctx.path("src")),
            timeout = 120,
            quiet = False,
        )
        if patch.return_code != 0:
            fail("openmpi patch {} failed (rc={}):\n{}\n{}".format(
                patch_file,
                patch.return_code,
                patch.stdout,
                patch.stderr,
            ))

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    autoconf_prefix = _read_prefix(repository_ctx, attr.autoconf_prefix_file, "autoconf")
    automake_prefix = _read_prefix(repository_ctx, attr.automake_prefix_file, "automake")
    hwloc_prefix = _read_prefix(repository_ctx, attr.hwloc_prefix_file, "hwloc")
    libevent_prefix = _read_prefix(repository_ctx, attr.libevent_prefix_file, "libevent")
    libtool_prefix = _read_prefix(repository_ctx, attr.libtool_prefix_file, "libtool")
    numactl_prefix = _read_prefix(repository_ctx, attr.numactl_prefix_file, "numactl")
    openssh_prefix = _read_prefix(repository_ctx, attr.openssh_prefix_file, "openssh")
    perl_prefix = _read_prefix(repository_ctx, attr.perl_prefix_file, "perl")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    pmix_prefix = _read_prefix(repository_ctx, attr.pmix_prefix_file, "pmix")
    prrte_prefix = _read_prefix(repository_ctx, attr.prrte_prefix_file, "prrte")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 7200,
        quiet = False,
        environment = {
            "AUTOCONF_PREFIX": autoconf_prefix,
            "AUTOMAKE_PREFIX": automake_prefix,
            "HWLOC_PREFIX": hwloc_prefix,
            "LIBEVENT_PREFIX": libevent_prefix,
            "LIBTOOL_PREFIX": libtool_prefix,
            "NUMACTL_PREFIX": numactl_prefix,
            "OPENSSH_PREFIX": openssh_prefix,
            "PERL_PREFIX": perl_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "PMIX_PREFIX": pmix_prefix,
            "PRRTE_PREFIX": prrte_prefix,
            "VASO_IN_INSULA": "1",
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("openmpi native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    dep_libs = [
        "{}/lib".format(pmix_prefix),
        "{}/lib".format(prrte_prefix),
        "{}/lib".format(hwloc_prefix),
        "{}/lib".format(libevent_prefix),
        "{}/lib".format(numactl_prefix),
        "{}/lib".format(zlib_prefix),
    ]
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lmpi",
        "-lmpi_mpifh",
        "-lmpi_usempi_ignore_tkr",
        "-lmpi_usempif08",
        "-lopen-pal",
    ]
    for dep_lib in dep_libs:
        linkopts.extend(["-L" + dep_lib, "-Wl,-rpath," + dep_lib])
    linkopts.extend([
        "-lpmix",
        "-lprrte",
        "-lhwloc",
        "-levent_core",
        "-levent_pthreads",
        "-lnuma",
        "-lz",
        "-ldl",
        "-pthread",
        "-lgfortran",
        "-lquadmath",
    ])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


openmpi_native = repository_rule(
    implementation = _openmpi_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "patch_urls": attr.string_list(mandatory = True),
        "patch_sha256s": attr.string_list(mandatory = True),
        "autoconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "automake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "hwloc_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libevent_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libtool_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "numactl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openssh_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pmix_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "prrte_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build OpenMPI from source into a Spack-prefix-identical install tree.",
)
