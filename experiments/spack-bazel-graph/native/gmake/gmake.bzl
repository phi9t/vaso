"""Native (Bazel-owned) build of GNU Make into a Spack-identical prefix.

The current torch, Triton, and JAX frontier captures all select gmake@4.4.1 as
a generic build-tool node with +guile disabled. Spack's recipe uses GNU Make's
configure/build.sh flow and installs only bin/make plus a bin/gmake symlink.
"""

_BUILD_TEMPLATE = """\
# GENERATED by gmake_native. Native Bazel build of GNU Make, intended to match
# the Spack gmake install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# gmake is an executable/tool-prefix node in this graph. It exposes no public C
# ABI, but @spack_gmake//:lib must remain a valid provider target after a flip.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "gmake native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

../configure \
  --prefix="$PREFIX" \
  --without-guile \
  --disable-nls \
  --disable-dependency-tracking

# Match Spack's Gmake.install(): do not embed the compiler-wrapper CXX path in
# the generated binary defaults.
python3 - <<'PY'
from pathlib import Path
import re
p = Path("src/config.h")
s = p.read_text()
s = re.sub(r"^#define MAKE_CXX .*$", "#undef MAKE_CXX", s, flags=re.M)
p.write_text(s)
PY

../build.sh
mkdir -p "$PREFIX/bin"
install -m 0755 make "$PREFIX/bin/make"
ln -s make "$PREFIX/bin/gmake"
"""


def _gmake_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("gmake native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("gmake native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


gmake_native = repository_rule(
    implementation = _gmake_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU Make from source into a Spack-prefix-identical tree.",
)
