"""Native (Bazel-owned) build of GNU gettext into a Spack-identical prefix.

The hermetic Spack v1.2.2 gettext@1.0 recipe is an AutotoolsPackage with:

  * variants: +bzip2 +curses +git +libxml2 -libunistring +pic +shared +tar +xz
  * dependencies: bzip2, iconv, libxml2, ncurses, tar (run), xz
  * patch(): libtextstyle/configure uses external libxml2 by rewriting
      gl_cv_libxml_force_included=yes -> gl_cv_libxml_force_included=no
  * flag_handler(): appends -lxml2 when +libxml2
  * configure args matching the concrete hermetic Spack build.

Every dependency prefix is read from a Bazel-owned native prefix marker. The
repository rule must run inside the sealed insula; host-root builds are rejected.
"""

_BUILD_TEMPLATE = """\
# GENERATED by gettext_native. Native Bazel build of GNU gettext, intended to
# match the Spack gettext install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/textstyle",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "gettext native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BZIP2_PREFIX:-}" || ! -x "${BZIP2_PREFIX:-}/bin/bzip2" ]]; then
  echo "BZIP2_PREFIX must name the Bazel-built bzip2 prefix" >&2
  exit 2
fi
if [[ -z "${LIBICONV_PREFIX:-}" || ! -d "${LIBICONV_PREFIX:-}/lib" ]]; then
  echo "LIBICONV_PREFIX must name the Bazel-built libiconv prefix" >&2
  exit 2
fi
if [[ -z "${LIBXML2_PREFIX:-}" || ! -d "${LIBXML2_PREFIX:-}/lib" ]]; then
  echo "LIBXML2_PREFIX must name the Bazel-built libxml2 prefix" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -d "${NCURSES_PREFIX:-}/lib" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi
if [[ -z "${TAR_PREFIX:-}" || ! -x "${TAR_PREFIX:-}/bin/tar" ]]; then
  echo "TAR_PREFIX must name the Bazel-built GNU tar prefix" >&2
  exit 2
fi
if [[ -z "${XZ_PREFIX:-}" || ! -x "${XZ_PREFIX:-}/bin/xz" ]]; then
  echo "XZ_PREFIX must name the Bazel-built xz prefix" >&2
  exit 2
fi

cd "$SRC"

python3 - <<'PY'
from pathlib import Path
path = Path("libtextstyle/configure")
text = path.read_text()
old = "gl_cv_libxml_force_included=yes"
new = "gl_cv_libxml_force_included=no"
if old not in text and new not in text:
    raise SystemExit("libtextstyle/configure did not contain the expected libxml2 probe")
path.write_text(text.replace(old, new))
PY

export PATH="${TAR_PREFIX}/bin:${BZIP2_PREFIX}/bin:${XZ_PREFIX}/bin:${PATH}"
export TAR="${TAR_PREFIX}/bin/tar"
export CPPFLAGS="-I${LIBICONV_PREFIX}/include -I${LIBXML2_PREFIX}/include/libxml2 -I${NCURSES_PREFIX}/include -I${NCURSES_PREFIX}/include/ncursesw ${CPPFLAGS:-}"
export LDFLAGS="-L${LIBICONV_PREFIX}/lib -L${LIBXML2_PREFIX}/lib -L${NCURSES_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,-rpath,${LIBICONV_PREFIX}/lib -Wl,-rpath,${LIBXML2_PREFIX}/lib -Wl,-rpath,${NCURSES_PREFIX}/lib -Wl,--disable-new-dtags -lxml2 ${LDFLAGS:-}"
export PKG_CONFIG=/bin/false
export PKG_CONFIG_PATH="${LIBXML2_PREFIX}/lib/pkgconfig:${NCURSES_PREFIX}/lib/pkgconfig:${LIBICONV_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH:-}"

./configure \\
  --prefix="$PREFIX" \\
  --disable-java \\
  --disable-csharp \\
  --with-included-glib \\
  --with-included-gettext \\
  --with-included-libcroco \\
  --without-emacs \\
  "--with-lispdir=${PREFIX}/share/emacs/site-lisp/gettext" \\
  --without-cvs \\
  --disable-d \\
  --enable-shared \\
  "--with-libiconv-prefix=${LIBICONV_PREFIX}" \\
  "--with-ncurses-prefix=${NCURSES_PREFIX}" \\
  "--with-libxml2-prefix=${LIBXML2_PREFIX}" \\
  --with-included-libunistring \\
  --with-pic

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("gettext native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _gettext_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    bzip2_prefix = _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2")
    libiconv_prefix = _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv")
    libxml2_prefix = _read_prefix(repository_ctx, attr.libxml2_prefix_file, "libxml2")
    ncurses_prefix = _read_prefix(repository_ctx, attr.ncurses_prefix_file, "ncurses")
    tar_prefix = _read_prefix(repository_ctx, attr.tar_prefix_file, "tar")
    xz_prefix = _read_prefix(repository_ctx, attr.xz_prefix_file, "xz")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 5400,
        quiet = False,
        environment = {
            "BZIP2_PREFIX": bzip2_prefix,
            "LIBICONV_PREFIX": libiconv_prefix,
            "LIBXML2_PREFIX": libxml2_prefix,
            "NCURSES_PREFIX": ncurses_prefix,
            "TAR_PREFIX": tar_prefix,
            "XZ_PREFIX": xz_prefix,
        },
    )
    if res.return_code != 0:
        fail("gettext native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lasprintf",
        "-lgettextpo",
        "-ltextstyle",
        "-lgettextsrc-1.0",
        "-lgettextlib-1.0",
        "-L{}/lib".format(libiconv_prefix),
        "-Wl,-rpath,{}/lib".format(libiconv_prefix),
        "-liconv",
        "-L{}/lib".format(libxml2_prefix),
        "-Wl,-rpath,{}/lib".format(libxml2_prefix),
        "-lxml2",
        "-L{}/lib".format(ncurses_prefix),
        "-Wl,-rpath,{}/lib".format(ncurses_prefix),
        "-lncursesw",
        "-ltinfow",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


gettext_native = repository_rule(
    implementation = _gettext_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libxml2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "tar_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU gettext from source into a Spack-prefix-identical tree.",
)
