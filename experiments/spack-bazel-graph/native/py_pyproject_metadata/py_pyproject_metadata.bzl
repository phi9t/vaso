"""Native (Bazel-owned) py-pyproject-metadata prefix.

The hermetic Spack v1.2.2 py-pyproject-metadata@0.11.0 recipe is a
PythonPackage that runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

Spack supplies pip, wheel, py-flit-core, and the runtime dependency
py-packaging through installed Python prefixes on PYTHONPATH. This rule
reproduces that dependency channel with Bazel-native prefix markers and must
run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_interpreter_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_pyproject_metadata_native. Native Bazel build of
# py-pyproject-metadata, intended to match the Spack source-installed prefix.
# Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-pyproject-metadata is a pure Python package prefix. It has no C link
# surface, but @spack_py_pyproject_metadata//:lib must remain a valid provider
# target after migration for unmigrated Python package consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-pyproject-metadata native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi
if [[ -z "${PY_FLIT_CORE_PREFIX:-}" || ! -d "${PY_FLIT_CORE_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/flit_core" ]]; then
  echo "PY_FLIT_CORE_PREFIX must name the Bazel-built native py-flit-core prefix" >&2
  exit 2
fi
if [[ -z "${PY_PACKAGING_PREFIX:-}" || ! -d "${PY_PACKAGING_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/packaging" ]]; then
  echo "PY_PACKAGING_PREFIX must name the Bazel-built native py-packaging prefix" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_FLIT_CORE_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PACKAGING_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -d "$site_packages/pyproject_metadata"
test -f "$site_packages/pyproject_metadata/__init__.py"
test -f "$site_packages/pyproject_metadata/_dispatch.py"
test -f "$site_packages/pyproject_metadata/constants.py"
test -f "$site_packages/pyproject_metadata/errors.py"
test -f "$site_packages/pyproject_metadata/project_table.py"
test -f "$site_packages/pyproject_metadata/pyproject.py"
test -f "$site_packages/pyproject_metadata/py.typed"
test -f "$site_packages/pyproject_metadata-0.11.0.dist-info/INSTALLER"
test -f "$site_packages/pyproject_metadata-0.11.0.dist-info/METADATA"
test -f "$site_packages/pyproject_metadata-0.11.0.dist-info/REQUESTED"
test -f "$site_packages/pyproject_metadata-0.11.0.dist-info/WHEEL"
test -f "$site_packages/pyproject_metadata-0.11.0.dist-info/licenses/LICENSE"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-pyproject-metadata native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_pyproject_metadata_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-pyproject-metadata native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    python_abi = python_abi_from_interpreter_prefix(repository_ctx, python_venv_prefix, "python-venv")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    py_flit_core_prefix = _read_prefix(repository_ctx, attr.py_flit_core_prefix_file, "py-flit-core")
    py_packaging_prefix = _read_prefix(repository_ctx, attr.py_packaging_prefix_file, "py-packaging")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "PYTHON_ABI": python_abi,
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "PY_FLIT_CORE_PREFIX": py_flit_core_prefix,
            "PY_PACKAGING_PREFIX": py_packaging_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-pyproject-metadata native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_pyproject_metadata_native = repository_rule(
    implementation = _py_pyproject_metadata_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_flit_core_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_packaging_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-pyproject-metadata@0.11.0 from its PyPI source archive into a Spack-prefix-identical tree.",
)
