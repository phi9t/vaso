"""Native (Bazel-owned) build of GNU Autoconf into a Spack-identical prefix.

The py-torch frontier captures autoconf@2.72 as an AutotoolsPackage. It is a
build/run tool prefix: generated scripts bake concrete Perl and GNU m4 paths, so
the native rule consumes Bazel-built m4 and perl prefixes explicitly.
"""

_BUILD_TEMPLATE = """\
# GENERATED by autoconf_native. Native Bazel build of GNU Autoconf, intended to
# match the Spack autoconf install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# Autoconf is an executable/data build-tool prefix. It exposes no public C ABI,
# but @spack_autoconf//:lib must remain a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "autoconf native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${M4_PREFIX:-}" || ! -x "${M4_PREFIX:-}/bin/m4" ]]; then
  echo "M4_PREFIX must name the Bazel-built m4 prefix" >&2
  exit 2
fi
if [[ -z "${PERL_PREFIX:-}" || ! -x "${PERL_PREFIX:-}/bin/perl" ]]; then
  echo "PERL_PREFIX must name the Bazel-built perl prefix" >&2
  exit 2
fi

# Match Spack's Autoconf.patch(): use an env perl shebang while autom4te is
# called from the build tree, preserving mtime so generated manpages are not
# rebuilt, then restore the concrete Perl path after install.
python3 - <<'PY'
from pathlib import Path
import os
p = Path("SRC_PLACEHOLDER/bin/autom4te.in")
st = p.stat()
s = p.read_text()
s = s.replace("#! @PERL@", "#! /usr/bin/env perl")
p.write_text(s)
os.utime(p, (st.st_atime, st.st_mtime))
PY

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

export PATH="${M4_PREFIX}/bin:${PERL_PREFIX}/bin:${PATH:-}"
export M4="${M4_PREFIX}/bin/m4"
export PERL="${PERL_PREFIX}/bin/perl"

../configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

python3 - "$PREFIX/bin/autom4te" "$PERL_PREFIX/bin/perl" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
perl = sys.argv[2]
s = p.read_text()
s = s.replace("#! /usr/bin/env perl", f"#! {perl}", 1)
p.write_text(s)
PY

# Spack removes libtool archives from emitted prefixes.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("autoconf native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _autoconf_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("autoconf native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    build_sh = _BUILD_SH.replace("SRC_PLACEHOLDER", str(repository_ctx.path("src")))
    repository_ctx.file("build.sh", build_sh, executable = True)

    m4_prefix = _read_prefix(repository_ctx, attr.m4_prefix_file, "m4")
    perl_prefix = _read_prefix(repository_ctx, attr.perl_prefix_file, "perl")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "M4_PREFIX": m4_prefix,
            "PERL_PREFIX": perl_prefix,
        },
    )
    if res.return_code != 0:
        fail("autoconf native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


autoconf_native = repository_rule(
    implementation = _autoconf_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "m4_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU Autoconf from source into a Spack-prefix-identical tree.",
)
