"""Native (Bazel-owned) build of SWIG into a Spack-identical prefix.

The lean PyTorch frontier captures swig@4.4.1 as an AutotoolsPackage. The
concrete hermetic Spack build runs the release tarball's configure script from
`spack-build`, links the SWIG executable against PCRE2, builds ccache-swig with
zlib, and installs the SWIG runtime data under share/swig/4.4.1.
"""

_BUILD_TEMPLATE = """\
# GENERATED by swig_native. Native Bazel build of SWIG, intended to match the
# Spack swig install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# SWIG is a tool-prefix node in this graph. It exposes no public C ABI, but
# @spack_swig//:lib must stay a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "swig native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PCRE2_PREFIX:-}" || ! -x "${PCRE2_PREFIX:-}/bin/pcre2-config" || ! -e "${PCRE2_PREFIX:-}/lib/libpcre2-8.so" ]]; then
  echo "PCRE2_PREFIX must name the Bazel-built pcre2 prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

pcre2_libdir="$PCRE2_PREFIX/lib"
zlib_libdir="$ZLIB_PREFIX/lib"
spack_target_flags="-march=icelake-client -mtune=icelake-client"
dep_rpath="${pcre2_libdir}:${zlib_libdir}"

export PATH="${PKGCONF_PREFIX}/bin:${PCRE2_PREFIX}/bin:${PATH}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${PCRE2_PREFIX}/lib/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${PCRE2_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="${spack_target_flags} ${CFLAGS:-}"
export CXXFLAGS="${spack_target_flags} ${CXXFLAGS:-}"
export LDFLAGS="-L${pcre2_libdir} -L${zlib_libdir} -Wl,-rpath,${dep_rpath} -Wl,--disable-new-dtags ${LDFLAGS:-}"

../configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Versioned executable symlink from Spack's run_after("install") hook.
(
  cd "$PREFIX/bin"
  ln -sfn swig swig4.0
)

# Spack removes libtool archives from emitted prefixes.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("swig native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _swig_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("swig native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    pcre2_prefix = _read_prefix(repository_ctx, attr.pcre2_prefix_file, "pcre2")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "PCRE2_PREFIX": pcre2_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "VASO_IN_INSULA": "1",
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("swig native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


swig_native = repository_rule(
    implementation = _swig_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "pcre2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build SWIG from source into a Spack-prefix-identical tool tree.",
)
