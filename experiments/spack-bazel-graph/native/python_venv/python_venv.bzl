"""Native (Bazel-owned) Python virtual-environment prefix.

The hermetic Spack v1.2.2 python-venv@1.0 recipe is a code-free generic
Package whose install phase is exactly:

    python -m venv --without-pip <prefix>

This rule reproduces that install tree by invoking the Bazel-built native
CPython interpreter from an explicit prefix marker. It never searches PATH for
Python and must run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by python_venv_native. Native Bazel build of python-venv,
# intended to match the Spack virtual-environment prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# python-venv is a prefix-only Python environment. It has no headers or C link
# flags, but @spack_python_venv//:lib must remain a valid provider target after
# migration for unmigrated Python package consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
PREFIX="$1"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "python-venv native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built native Python prefix with bin/python3" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -d "${PYTHON_PREFIX:-}/include/python${PYTHON_ABI}" || ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native Python prefix include directory" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH=
"$PYTHON_PREFIX/bin/python${PYTHON_ABI}" -m venv --without-pip "$PREFIX"

test -f "$PREFIX/pyvenv.cfg"
test -x "$PREFIX/bin/python${PYTHON_ABI}"
test -d "$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -L "$PREFIX/lib64"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("python-venv native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _python_venv_native_impl(repository_ctx):
    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("python-venv native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)
    python_prefix = _read_prefix(repository_ctx, repository_ctx.attr.python_prefix_file, "python")
    python_abi = python_abi_from_prefix(repository_ctx, python_prefix, "python")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", prefix],
        timeout = 600,
        quiet = False,
        environment = {
            "PYTHON_ABI": python_abi,
            "PYTHON_PREFIX": python_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("python-venv native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


python_venv_native = repository_rule(
    implementation = _python_venv_native_impl,
    attrs = {
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Create python-venv@1.0 with Bazel-built CPython's venv module.",
)
