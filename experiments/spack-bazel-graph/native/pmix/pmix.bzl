"""Native (Bazel-owned) build of PMIx into a Spack-identical prefix.

The PyTorch frontier captures pmix@6.1.0 as an AutotoolsPackage with
`~munge`, `~python`, shared and static libraries, and explicit zlib, libevent,
and hwloc dependency prefixes. The rule runs only inside the hermetic insula and
passes every dependency through a Bazel prefix file.
"""

_BUILD_TEMPLATE = """\
# GENERATED by pmix_native. Native Bazel build of PMIx, intended to match the
# Spack PMIx install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/pmix",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "pmix native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${HWLOC_PREFIX:-}" || ! -f "${HWLOC_PREFIX:-}/include/hwloc.h" || ! -e "${HWLOC_PREFIX:-}/lib/libhwloc.so" ]]; then
  echo "HWLOC_PREFIX must name the Bazel-built hwloc prefix" >&2
  exit 2
fi
if [[ -z "${LIBICONV_PREFIX:-}" || ! -f "${LIBICONV_PREFIX:-}/include/iconv.h" || ! -e "${LIBICONV_PREFIX:-}/lib/libiconv.so" ]]; then
  echo "LIBICONV_PREFIX must name the Bazel-built libiconv prefix" >&2
  exit 2
fi
if [[ -z "${LIBEVENT_PREFIX:-}" || ! -f "${LIBEVENT_PREFIX:-}/include/event2/event.h" || ! -e "${LIBEVENT_PREFIX:-}/lib/libevent_core.so" ]]; then
  echo "LIBEVENT_PREFIX must name the Bazel-built libevent prefix" >&2
  exit 2
fi
if [[ -z "${LIBPCIACCESS_PREFIX:-}" || ! -f "${LIBPCIACCESS_PREFIX:-}/include/pciaccess.h" || ! -f "${LIBPCIACCESS_PREFIX:-}/lib/pkgconfig/pciaccess.pc" ]]; then
  echo "LIBPCIACCESS_PREFIX must name the Bazel-built libpciaccess prefix" >&2
  exit 2
fi
if [[ -z "${LIBTOOL_PREFIX:-}" || ! -x "${LIBTOOL_PREFIX:-}/bin/libtoolize" ]]; then
  echo "LIBTOOL_PREFIX must name the Bazel-built libtool prefix" >&2
  exit 2
fi
if [[ -z "${LIBXML2_PREFIX:-}" || ! -f "${LIBXML2_PREFIX:-}/include/libxml2/libxml/parser.h" || ! -f "${LIBXML2_PREFIX:-}/lib/pkgconfig/libxml-2.0.pc" ]]; then
  echo "LIBXML2_PREFIX must name the Bazel-built libxml2 prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${XZ_PREFIX:-}" || ! -f "${XZ_PREFIX:-}/include/lzma.h" || ! -f "${XZ_PREFIX:-}/lib/pkgconfig/liblzma.pc" ]]; then
  echo "XZ_PREFIX must name the Bazel-built xz prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

cd "$SRC"

export PATH="${LIBTOOL_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH}"
export ACLOCAL_PATH="${LIBTOOL_PREFIX}/share/aclocal:${PKGCONF_PREFIX}/share/aclocal${ACLOCAL_PATH:+:${ACLOCAL_PATH}}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="${HWLOC_PREFIX}/lib/pkgconfig:${LIBEVENT_PREFIX}/lib/pkgconfig:${ZLIB_PREFIX}/lib/pkgconfig:${LIBPCIACCESS_PREFIX}/lib/pkgconfig:${LIBXML2_PREFIX}/lib/pkgconfig:${XZ_PREFIX}/lib/pkgconfig:${PKGCONF_PREFIX}/lib/pkgconfig"
export CPPFLAGS="-I${HWLOC_PREFIX}/include -I${LIBEVENT_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 -march=icelake-client -mtune=icelake-client ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 -march=icelake-client -mtune=icelake-client ${CXXFLAGS:-}"
export LDFLAGS="-L${HWLOC_PREFIX}/lib -Wl,-rpath,${HWLOC_PREFIX}/lib -L${LIBEVENT_PREFIX}/lib -Wl,-rpath,${LIBEVENT_PREFIX}/lib -L${ZLIB_PREFIX}/lib -Wl,-rpath,${ZLIB_PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export CC="${CC:-gcc}"

./configure \\
  --prefix="$PREFIX" \\
  --enable-shared \\
  --enable-static \\
  --with-zlib="$ZLIB_PREFIX" \\
  --with-libevent="$LIBEVENT_PREFIX" \\
  --with-hwloc="$HWLOC_PREFIX" \\
  --disable-python-bindings \\
  --without-munge

make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true

# PMIx's Autoconf probes only copy hwloc's transitive static closure into
# pmix.pc when every private pkg-config module resolves during configure. Match
# Spack's emitted public metadata from the explicit Bazel-native prefixes so
# static consumers see the same closure without discovering host state.
pc="$PREFIX/lib/pkgconfig/pmix.pc"
tmp="${pc}.tmp"
while IFS= read -r line; do
  case "$line" in
    Libs.private:*)
      printf 'Libs.private: -L%s/lib -L%s/lib -L%s/lib -L%s/lib -L%s/lib -L%s/lib -L%s/lib -L%s/lib ' \
        "$ZLIB_PREFIX" "$LIBEVENT_PREFIX" "$HWLOC_PREFIX" "$ZLIB_PREFIX" "$HWLOC_PREFIX" \
        "$LIBPCIACCESS_PREFIX" "$LIBXML2_PREFIX" "$LIBICONV_PREFIX"
      printf -- '-Wl,-rpath -Wl,%s/lib -Wl,-rpath -Wl,%s/lib -Wl,-rpath -Wl,%s/lib -Wl,-rpath -Wl,%s/lib -Wl,-rpath -Wl,%s/lib -Wl,-rpath -Wl,%s/lib -Wl,-rpath -Wl,%s/lib -Wl,-rpath -Wl,%s/lib ' \
        "$ZLIB_PREFIX" "$LIBEVENT_PREFIX" "$HWLOC_PREFIX" "$ZLIB_PREFIX" "$HWLOC_PREFIX" \
        "$LIBPCIACCESS_PREFIX" "$LIBXML2_PREFIX" "$LIBICONV_PREFIX"
      printf -- '-ldl -lz -levent_core -levent_pthreads -lhwloc -lpthread -lxml2 -liconv -lm -lpciaccess\n'
      ;;
    Cflags:*)
      printf 'Cflags: -I${includedir} -I${includedir}/pmix -I%s/include -I%s/include -I%s/include/libxml2 -I%s/include\n' \
        "$LIBEVENT_PREFIX" "$HWLOC_PREFIX" "$LIBXML2_PREFIX" "$LIBPCIACCESS_PREFIX"
      ;;
    Requires.private:*)
      printf 'Requires.private: %s/lib/pkgconfig/hwloc.pc %s/lib/pkgconfig/zlib.pc\n' "$HWLOC_PREFIX" "$ZLIB_PREFIX"
      ;;
    *) printf '%s\n' "$line" ;;
  esac
done < "$pc" > "$tmp"
mv "$tmp" "$pc"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("pmix native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _pmix_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("pmix native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    hwloc_prefix = _read_prefix(repository_ctx, attr.hwloc_prefix_file, "hwloc")
    libiconv_prefix = _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv")
    libevent_prefix = _read_prefix(repository_ctx, attr.libevent_prefix_file, "libevent")
    libpciaccess_prefix = _read_prefix(repository_ctx, attr.libpciaccess_prefix_file, "libpciaccess")
    libtool_prefix = _read_prefix(repository_ctx, attr.libtool_prefix_file, "libtool")
    libxml2_prefix = _read_prefix(repository_ctx, attr.libxml2_prefix_file, "libxml2")
    pkgconf_prefix = _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf")
    xz_prefix = _read_prefix(repository_ctx, attr.xz_prefix_file, "xz")
    zlib_prefix = _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 2400,
        quiet = False,
        environment = {
            "HWLOC_PREFIX": hwloc_prefix,
            "LIBICONV_PREFIX": libiconv_prefix,
            "LIBEVENT_PREFIX": libevent_prefix,
            "LIBPCIACCESS_PREFIX": libpciaccess_prefix,
            "LIBTOOL_PREFIX": libtool_prefix,
            "LIBXML2_PREFIX": libxml2_prefix,
            "PKGCONF_PREFIX": pkgconf_prefix,
            "VASO_IN_INSULA": "1",
            "XZ_PREFIX": xz_prefix,
            "ZLIB_PREFIX": zlib_prefix,
        },
    )
    if res.return_code != 0:
        fail("pmix native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    dep_libs = [
        "{}/lib".format(hwloc_prefix),
        "{}/lib".format(libevent_prefix),
        "{}/lib".format(zlib_prefix),
    ]
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lpmix",
    ]
    for dep_lib in dep_libs:
        linkopts.extend(["-L" + dep_lib, "-Wl,-rpath," + dep_lib])
    linkopts.extend([
        "-lhwloc",
        "-levent",
        "-levent_core",
        "-levent_extra",
        "-levent_pthreads",
        "-lz",
        "-ldl",
        "-pthread",
    ])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


pmix_native = repository_rule(
    implementation = _pmix_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "hwloc_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libevent_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpciaccess_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libtool_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libxml2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "xz_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build PMIx from source into a Spack-prefix-identical install tree.",
)
