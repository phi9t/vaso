"""Native (Bazel-owned) build of OpenBLAS into a Spack-identical prefix.

The py-torch frontier captures openblas@0.3.33 with build_system=makefile,
~fortran, +dynamic_dispatch, threads=none, +locking, +shared, and ~static. Spack
still installs libopenblas-r0.3.33.a alongside the shared library, so the ABI
gate checks both shared SONAME/symbols and static archive member/symbol parity.
"""

_BUILD_TEMPLATE = """\
# GENERATED by openblas_native. Native Bazel build of OpenBLAS, intended to
# match the Spack openblas install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"
JOBS="${MAKE_JOBS:-$(nproc)}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "openblas native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

make_flags=(
  CC="${CC:-gcc}"
  MAKE_NB_JOBS=0
  ARCH=x86_64
  TARGET=SKYLAKEX
  DYNAMIC_ARCH=1
  NOFORTRAN=1
  USE_LOCKING=1
  USE_OPENMP=0
  USE_THREAD=0
  RANLIB=ranlib
)

make -s -j"$JOBS" "${make_flags[@]}"
make -j"$JOBS" "${make_flags[@]}" PREFIX="$PREFIX" install
"""


def _openblas_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("openblas native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.download(
        url = attr.patch_urls,
        sha256 = attr.patch_sha256,
        output = "openblas-pr5796.diff",
    )
    patch = repository_ctx.execute(
        ["patch", "-p1", "-i", str(repository_ctx.path("openblas-pr5796.diff"))],
        working_directory = str(repository_ctx.path("src")),
        timeout = 120,
        quiet = False,
    )
    if patch.return_code != 0:
        fail("openblas patch failed (rc={}):\n{}\n{}".format(
            patch.return_code,
            patch.stdout,
            patch.stderr,
        ))

    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
    )
    if res.return_code != 0:
        fail("openblas native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = ["-L" + abs_lib, "-Wl,-rpath," + abs_lib, "-lopenblas", "-lm"]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


openblas_native = repository_rule(
    implementation = _openblas_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "patch_urls": attr.string_list(mandatory = True),
        "patch_sha256": attr.string(mandatory = True),
    },
    environ = ["CC", "MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build OpenBLAS from source into a Spack-prefix-identical install tree.",
)
