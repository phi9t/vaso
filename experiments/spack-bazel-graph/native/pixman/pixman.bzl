"""Native (Bazel-owned) build of Pixman into a Spack-identical prefix.

The hermetic Spack v1.2.2 pixman@0.46.4 recipe is a MesonPackage. The concrete
frontier variant builds shared libpixman-1 with libpng enabled, GTK disabled,
static-PIC enabled for any static outputs, and Spack's Meson libpng discovery
patch applied before configuration.
"""

load("//native/common:python_abi.bzl", "python_abi_from_site_packages_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by pixman_native. Native Bazel build of Pixman, intended to match
# the Spack pixman install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = False),
    includes = [
        "prefix/include",
        "prefix/include/pixman-1",
    ],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: meson
SRC="$1"
PREFIX="$2"
PATCH_FILE="$3"
BUILD_DIR="$PWD/build"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "pixman native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BISON_PREFIX:-}" || ! -x "${BISON_PREFIX:-}/bin/bison" ]]; then
  echo "BISON_PREFIX must name the Bazel-built bison prefix" >&2
  exit 2
fi
if [[ -z "${FLEX_PREFIX:-}" || ! -x "${FLEX_PREFIX:-}/bin/flex" ]]; then
  echo "FLEX_PREFIX must name the Bazel-built flex prefix" >&2
  exit 2
fi
if [[ -z "${LIBPNG_PREFIX:-}" || ! -f "${LIBPNG_PREFIX:-}/include/png.h" ]]; then
  echo "LIBPNG_PREFIX must name the Bazel-built libpng prefix" >&2
  exit 2
fi
if [[ -z "${MESON_PREFIX:-}" || ! -x "${MESON_PREFIX:-}/bin/meson" ]]; then
  echo "MESON_PREFIX must name the Bazel-built Meson prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -d "${MESON_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/mesonbuild" ]]; then
  echo "PYTHON_ABI must match the Bazel-built Meson prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built Ninja prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/include/zlib.h" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix for libpng pkg-config closure" >&2
  exit 2
fi

rm -rf "$BUILD_DIR" "$PREFIX"
patch -d "$SRC" -p1 -i "$PATCH_FILE"
mkdir -p "$BUILD_DIR"

dep_libs=(
  "$LIBPNG_PREFIX/lib"
  "$ZLIB_PREFIX/lib"
)
dep_pkgconfigs=(
  "$LIBPNG_PREFIX/lib/pkgconfig"
  "$ZLIB_PREFIX/lib/pkgconfig"
)

spack_target_flags="-march=icelake-client -mtune=icelake-client"
export PATH="${BISON_PREFIX}/bin:${FLEX_PREFIX}/bin:${MESON_PREFIX}/bin:${NINJA_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${PATH}"
export PYTHONHOME=
export PYTHONPATH="${MESON_PREFIX}/lib/python${PYTHON_ABI}/site-packages${PYTHONPATH:+:${PYTHONPATH}}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="$(IFS=:; echo "${dep_pkgconfigs[*]}")"
export CPPFLAGS="-I${LIBPNG_PREFIX}/include -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CXXFLAGS:-}"
export LDFLAGS="$(printf ' -L%s' "${dep_libs[@]}") -Wl,-rpath,$(IFS=:; echo "${dep_libs[*]}") -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LD_LIBRARY_PATH="$(IFS=:; echo "${dep_libs[*]}")${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

"$MESON_PREFIX/bin/meson" setup "$BUILD_DIR" "$SRC" \
  -Dprefix="$PREFIX" \
  -Dlibdir="$PREFIX/lib" \
  -Dbuildtype=release \
  -Dstrip=false \
  -Ddefault_library=shared \
  -Dwrap_mode=nodownload \
  -Dlibpng=enabled \
  -Dgtk=disabled \
  -Db_staticpic=true

"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" -v
"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" install

# Spack's emitted prefix has no libtool archives.
find "$PREFIX" -type f -name '*.la' -delete || true

test -f "$PREFIX/include/pixman-1/pixman.h"
test -f "$PREFIX/include/pixman-1/pixman-version.h"
test -f "$PREFIX/lib/libpixman-1.so"
test -f "$PREFIX/lib/pkgconfig/pixman-1.pc"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("pixman native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _pixman_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("pixman native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    prefixes = {
        "BISON_PREFIX": _read_prefix(repository_ctx, attr.bison_prefix_file, "bison"),
        "FLEX_PREFIX": _read_prefix(repository_ctx, attr.flex_prefix_file, "flex"),
        "LIBPNG_PREFIX": _read_prefix(repository_ctx, attr.libpng_prefix_file, "libpng"),
        "MESON_PREFIX": _read_prefix(repository_ctx, attr.meson_prefix_file, "meson"),
        "NINJA_PREFIX": _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja"),
        "PKGCONF_PREFIX": _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf"),
        "ZLIB_PREFIX": _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng"),
    }

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    patch_file = str(repository_ctx.path(attr.libpng_patch))
    env = dict(prefixes)
    env["PYTHON_ABI"] = python_abi_from_site_packages_prefix(repository_ctx, prefixes["MESON_PREFIX"], "meson")
    env["VASO_IN_INSULA"] = "1"
    res = repository_ctx.execute(
        ["./build.sh", src, prefix, patch_file],
        timeout = 1800,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("pixman native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lpixman-1",
    ]
    for dep in (
        prefixes["LIBPNG_PREFIX"],
        prefixes["ZLIB_PREFIX"],
    ):
        linkopts.extend([
            "-L{}/lib".format(dep),
            "-Wl,-rpath,{}/lib".format(dep),
        ])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


pixman_native = repository_rule(
    implementation = _pixman_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bison_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "flex_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpng_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpng_patch": attr.label(mandatory = True, allow_single_file = True),
        "meson_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build pixman@0.46.4 from source into a Spack-prefix-identical tree.",
)
