"""Native (Bazel-owned) build of less into a Spack-identical prefix.

less is an executable-only Autotools node in the Python-root graph. The
hermetic Spack v1.2.2 recipe has no package-specific configure arguments and
depends on ncurses; configure selects -ltinfow on this platform.
"""

_BUILD_TEMPLATE = """\
# GENERATED by less_native. Native Bazel build of less, intended to match the
# Spack less install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# less is a tool-prefix node in this graph. It exposes no public C ABI, but
# @spack_less//:lib must remain a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "less native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${NCURSES_PREFIX:-}" || ! -d "${NCURSES_PREFIX:-}/lib" ]]; then
  echo "NCURSES_PREFIX must name the Bazel-built ncurses prefix" >&2
  exit 2
fi

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

export CPPFLAGS="-I${NCURSES_PREFIX}/include ${CPPFLAGS:-}"
export LDFLAGS="-L${NCURSES_PREFIX}/lib -Wl,-rpath,${NCURSES_PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export PKG_CONFIG=/bin/false
export PKG_CONFIG_PATH="${NCURSES_PREFIX}/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"

../configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _less_native_impl(repository_ctx):
    attr = repository_ctx.attr

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    ncurses_prefix = repository_ctx.read(attr.ncurses_prefix_file).strip()
    if not ncurses_prefix:
        fail("less native build requires a non-empty ncurses prefix path")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "NCURSES_PREFIX": ncurses_prefix,
        },
    )
    if res.return_code != 0:
        fail("less native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


less_native = repository_rule(
    implementation = _less_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "ncurses_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build less from source into a Spack-prefix-identical tree.",
)
