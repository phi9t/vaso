"""Native data-prefix provider for ca-certificates-mozilla.

Spack's package is a generic one-file install: download
`cacert-<version>.pem` from curl.se and install it as `share/cacert.pem`.
This rule reproduces that prefix shape and exposes `:prefix` plus an empty
`:lib` target for the stable `@spack_<pkg>//:lib` alias contract.
"""

_BUILD_TEMPLATE = """\
# GENERATED by ca_certificates_mozilla_native. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    data = [":prefix"],
)
"""


def _ca_certificates_mozilla_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("ca-certificates-mozilla native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.file("prefix/share/.keep", "")
    repository_ctx.delete("prefix/share/.keep")
    repository_ctx.download(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "prefix/share/cacert.pem",
    )
    repository_ctx.file("prefix_path.txt", str(repository_ctx.path("prefix")) + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


ca_certificates_mozilla_native = repository_rule(
    implementation = _ca_certificates_mozilla_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Install Mozilla CA certificates as share/cacert.pem.",
)
