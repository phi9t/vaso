"""Native (Bazel-owned) build of Eigen into a Spack-identical prefix.

The hermetic Spack v1.2.2 eigen@5.0.1 recipe is a CMakePackage. The concrete
frontier spec is header-only for consumers: tests, BLAS, LAPACK, ROCm, and IPO
are disabled, and the install tree contains include/eigen3 plus pkg-config and
CMake package metadata.
"""

_BUILD_TEMPLATE = """\
# GENERATED by eigen_native. Native Bazel build of Eigen, intended to match the
# Spack eigen install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = [
        "prefix/include",
        "prefix/include/eigen3",
    ],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "eigen native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-built CMake prefix" >&2
  exit 2
fi

CMAKE="$CMAKE_PREFIX/bin/cmake"
BUILD="$(mktemp -d)"
cd "$BUILD"

export PATH="${CMAKE_PREFIX}/bin:${PATH}"
export CMAKE_PREFIX_PATH="${CMAKE_PREFIX}"

"$CMAKE" -G "Unix Makefiles" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  -DCMAKE_INSTALL_RPATH_USE_LINK_PATH:BOOL=ON \
  "-DCMAKE_INSTALL_RPATH:STRING=${PREFIX}/lib;${PREFIX}/lib64" \
  -DCMAKE_PREFIX_PATH:STRING="$CMAKE_PREFIX" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_VERBOSE_MAKEFILE:BOOL=ON \
  -DCMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF \
  -DCMAKE_POLICY_DEFAULT_CMP0090:STRING=NEW \
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF \
  -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=ON \
  -DEIGEN_BUILD_TESTING:BOOL=OFF \
  -DEIGEN_LEAVE_TEST_IN_ALL_TARGET:BOOL=OFF \
  -DEIGEN_BUILD_BLAS:BOOL=OFF \
  -DEIGEN_BUILD_LAPACK:BOOL=OFF \
  "$SRC"
make -j"${MAKE_JOBS:-$(nproc)}"
make install
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("eigen native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _eigen_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("eigen native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("eigen native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


eigen_native = repository_rule(
    implementation = _eigen_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build Eigen from source into a Spack-prefix-identical header/CMake package prefix.",
)
