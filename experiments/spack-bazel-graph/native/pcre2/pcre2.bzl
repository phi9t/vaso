"""Native (Bazel-owned) build of PCRE2 into a Spack-identical prefix.

The py-torch frontier captures pcre2@10.44 as an AutotoolsPackage with
+multibyte, ~jit, and +pic. The concrete Spack build enables the 16-bit and
32-bit libraries in addition to the default 8-bit and POSIX libraries.
"""

_BUILD_TEMPLATE = """\
# GENERATED by pcre2_native. Native Bazel build of PCRE2, intended to match the
# Spack pcre2 install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "pcre2 native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi

cd "$SRC"

export CFLAGS="${CFLAGS:-} -O2 -fvisibility=hidden"
./configure \\
  --prefix="$PREFIX" \\
  --enable-pcre2-16 \\
  --enable-pcre2-32 \\
  --disable-jit \\
  --disable-pcre2grep-libz \\
  --disable-pcre2grep-libbz2 \\
  --disable-pcre2test-libreadline \\
  --disable-pcre2test-libedit
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack removes libtool archives from the emitted prefix.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _pcre2_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("pcre2 native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
    )
    if res.return_code != 0:
        fail("pcre2 native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lpcre2-posix",
        "-lpcre2-8",
        "-lpcre2-16",
        "-lpcre2-32",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


pcre2_native = repository_rule(
    implementation = _pcre2_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    environ = ["CFLAGS", "MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build PCRE2 from source into a Spack-prefix-identical install tree.",
)
