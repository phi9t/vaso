"""Native (Bazel-owned) build of HarfBuzz into a Spack-identical prefix.

The hermetic Spack v1.2.2 harfbuzz@11.5.1 recipe is a MesonPackage. The
concrete frontier variant enables FreeType, GLib/GObject, ICU, and Cairo,
disables Graphite2, CoreText, docs, and introspection, and emits the same
shared-library/tools/pkg-config install tree into a native prefix.
"""

load("//native/common:python_abi.bzl", "python_abi_from_site_packages_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by harfbuzz_native. Native Bazel build of HarfBuzz, intended to
# match the Spack harfbuzz install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = False),
    includes = [
        "prefix/include",
        "prefix/include/harfbuzz",
    ],
    linkopts = {linkopts},
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: meson
SRC="$1"
PREFIX="$2"
BUILD_DIR="$PWD/build"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "harfbuzz native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${BZIP2_PREFIX:-}" || ! -f "${BZIP2_PREFIX:-}/lib/pkgconfig/bzip2.pc" || ! -e "${BZIP2_PREFIX:-}/lib/libbz2.so" ]]; then
  echo "BZIP2_PREFIX must name the Bazel-built bzip2 prefix" >&2
  exit 2
fi
if [[ -z "${CAIRO_PREFIX:-}" || ! -f "${CAIRO_PREFIX:-}/lib/pkgconfig/cairo.pc" || ! -e "${CAIRO_PREFIX:-}/lib/libcairo.so" ]]; then
  echo "CAIRO_PREFIX must name the Bazel-built cairo prefix" >&2
  exit 2
fi
if [[ -z "${FONTCONFIG_PREFIX:-}" || ! -f "${FONTCONFIG_PREFIX:-}/lib/pkgconfig/fontconfig.pc" || ! -e "${FONTCONFIG_PREFIX:-}/lib/libfontconfig.so" ]]; then
  echo "FONTCONFIG_PREFIX must name the Bazel-built fontconfig prefix" >&2
  exit 2
fi
if [[ -z "${FREETYPE_PREFIX:-}" || ! -f "${FREETYPE_PREFIX:-}/lib/pkgconfig/freetype2.pc" || ! -e "${FREETYPE_PREFIX:-}/lib/libfreetype.so" ]]; then
  echo "FREETYPE_PREFIX must name the Bazel-built freetype prefix" >&2
  exit 2
fi
if [[ -z "${GLIB_PREFIX:-}" || ! -f "${GLIB_PREFIX:-}/lib/pkgconfig/glib-2.0.pc" || ! -f "${GLIB_PREFIX:-}/lib/pkgconfig/gobject-2.0.pc" || ! -e "${GLIB_PREFIX:-}/lib/libglib-2.0.so" || ! -e "${GLIB_PREFIX:-}/lib/libgobject-2.0.so" ]]; then
  echo "GLIB_PREFIX must name the Bazel-built glib prefix with GObject support" >&2
  exit 2
fi
if [[ -z "${GOBJECT_INTROSPECTION_PREFIX:-}" || ! -x "${GOBJECT_INTROSPECTION_PREFIX:-}/bin/g-ir-scanner" ]]; then
  echo "GOBJECT_INTROSPECTION_PREFIX must name the Bazel-built gobject-introspection prefix" >&2
  exit 2
fi
if [[ -z "${ICU4C_PREFIX:-}" || ! -f "${ICU4C_PREFIX:-}/lib/pkgconfig/icu-uc.pc" || ! -e "${ICU4C_PREFIX:-}/lib/libicuuc.so" ]]; then
  echo "ICU4C_PREFIX must name the Bazel-built icu4c prefix" >&2
  exit 2
fi
if [[ -z "${LIBFFI_PREFIX:-}" || ! -f "${LIBFFI_PREFIX:-}/lib/pkgconfig/libffi.pc" || ! -e "${LIBFFI_PREFIX:-}/lib/libffi.so" ]]; then
  echo "LIBFFI_PREFIX must name the Bazel-built libffi prefix" >&2
  exit 2
fi
if [[ -z "${LIBICONV_PREFIX:-}" || ! -d "${LIBICONV_PREFIX:-}/lib" ]]; then
  echo "LIBICONV_PREFIX must name the Bazel-built libiconv prefix" >&2
  exit 2
fi
if [[ -z "${LIBPNG_PREFIX:-}" || ! -f "${LIBPNG_PREFIX:-}/lib/pkgconfig/libpng.pc" || ! -e "${LIBPNG_PREFIX:-}/lib/libpng.so" ]]; then
  echo "LIBPNG_PREFIX must name the Bazel-built libpng prefix" >&2
  exit 2
fi
if [[ -z "${LIBXML2_PREFIX:-}" || ! -f "${LIBXML2_PREFIX:-}/lib/pkgconfig/libxml-2.0.pc" || ! -e "${LIBXML2_PREFIX:-}/lib/libxml2.so" ]]; then
  echo "LIBXML2_PREFIX must name the Bazel-built libxml2 prefix" >&2
  exit 2
fi
if [[ -z "${LZO_PREFIX:-}" || ! -f "${LZO_PREFIX:-}/lib/pkgconfig/lzo2.pc" || ! -e "${LZO_PREFIX:-}/lib/liblzo2.so" ]]; then
  echo "LZO_PREFIX must name the Bazel-built lzo prefix" >&2
  exit 2
fi
if [[ -z "${MESON_PREFIX:-}" || ! -x "${MESON_PREFIX:-}/bin/meson" ]]; then
  echo "MESON_PREFIX must name the Bazel-built Meson prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -d "${MESON_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/mesonbuild" ]]; then
  echo "PYTHON_ABI must match the Bazel-built Meson prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built Ninja prefix" >&2
  exit 2
fi
if [[ -z "${PCRE2_PREFIX:-}" || ! -f "${PCRE2_PREFIX:-}/lib/pkgconfig/libpcre2-8.pc" || ! -e "${PCRE2_PREFIX:-}/lib/libpcre2-8.so" ]]; then
  echo "PCRE2_PREFIX must name the Bazel-built pcre2 prefix" >&2
  exit 2
fi
if [[ -z "${PIXMAN_PREFIX:-}" || ! -f "${PIXMAN_PREFIX:-}/lib/pkgconfig/pixman-1.pc" || ! -e "${PIXMAN_PREFIX:-}/lib/libpixman-1.so" ]]; then
  echo "PIXMAN_PREFIX must name the Bazel-built pixman prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/lib/pkgconfig/zlib.pc" || ! -e "${ZLIB_PREFIX:-}/lib/libz.so" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi

rm -rf "$BUILD_DIR" "$PREFIX"
mkdir -p "$BUILD_DIR"

dep_libs=(
  "$BZIP2_PREFIX/lib"
  "$CAIRO_PREFIX/lib"
  "$FONTCONFIG_PREFIX/lib"
  "$FREETYPE_PREFIX/lib"
  "$GLIB_PREFIX/lib"
  "$GOBJECT_INTROSPECTION_PREFIX/lib"
  "$ICU4C_PREFIX/lib"
  "$LIBFFI_PREFIX/lib"
  "$LIBICONV_PREFIX/lib"
  "$LIBPNG_PREFIX/lib"
  "$LIBXML2_PREFIX/lib"
  "$LZO_PREFIX/lib"
  "$PCRE2_PREFIX/lib"
  "$PIXMAN_PREFIX/lib"
  "$ZLIB_PREFIX/lib"
)
dep_pkgconfigs=(
  "$BZIP2_PREFIX/lib/pkgconfig"
  "$CAIRO_PREFIX/lib/pkgconfig"
  "$FONTCONFIG_PREFIX/lib/pkgconfig"
  "$FREETYPE_PREFIX/lib/pkgconfig"
  "$GLIB_PREFIX/lib/pkgconfig"
  "$GOBJECT_INTROSPECTION_PREFIX/lib/pkgconfig"
  "$ICU4C_PREFIX/lib/pkgconfig"
  "$LIBFFI_PREFIX/lib/pkgconfig"
  "$LIBICONV_PREFIX/lib/pkgconfig"
  "$LIBPNG_PREFIX/lib/pkgconfig"
  "$LIBXML2_PREFIX/lib/pkgconfig"
  "$LZO_PREFIX/lib/pkgconfig"
  "$PCRE2_PREFIX/lib/pkgconfig"
  "$PIXMAN_PREFIX/lib/pkgconfig"
  "$ZLIB_PREFIX/lib/pkgconfig"
)

spack_target_flags="-march=icelake-client -mtune=icelake-client"
export PATH="${MESON_PREFIX}/bin:${NINJA_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${GOBJECT_INTROSPECTION_PREFIX}/bin:${PATH}"
export PYTHONHOME=
export PYTHONPATH="${MESON_PREFIX}/lib/python${PYTHON_ABI}/site-packages${PYTHONPATH:+:${PYTHONPATH}}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="$(IFS=:; echo "${dep_pkgconfigs[*]}")"
export GI_TYPELIB_PATH="${GOBJECT_INTROSPECTION_PREFIX}/lib/girepository-1.0:${GLIB_PREFIX}/lib/girepository-1.0${GI_TYPELIB_PATH:+:${GI_TYPELIB_PATH}}"
export XDG_DATA_DIRS="${GOBJECT_INTROSPECTION_PREFIX}/share:${GLIB_PREFIX}/share${XDG_DATA_DIRS:+:${XDG_DATA_DIRS}}"
export CPPFLAGS="-I${BZIP2_PREFIX}/include -I${CAIRO_PREFIX}/include -I${CAIRO_PREFIX}/include/cairo -I${FONTCONFIG_PREFIX}/include -I${FREETYPE_PREFIX}/include -I${FREETYPE_PREFIX}/include/freetype2 -I${GLIB_PREFIX}/include -I${GLIB_PREFIX}/include/glib-2.0 -I${GLIB_PREFIX}/lib/glib-2.0/include -I${GOBJECT_INTROSPECTION_PREFIX}/include -I${ICU4C_PREFIX}/include -I${LIBFFI_PREFIX}/include -I${LIBICONV_PREFIX}/include -I${LIBPNG_PREFIX}/include -I${LIBPNG_PREFIX}/include/libpng16 -I${LIBXML2_PREFIX}/include/libxml2 -I${LZO_PREFIX}/include -I${PCRE2_PREFIX}/include -I${PIXMAN_PREFIX}/include/pixman-1 -I${ZLIB_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CXXFLAGS:-}"
export LDFLAGS="$(printf ' -L%s' "${dep_libs[@]}")$(printf ' -Wl,-rpath-link,%s' "${dep_libs[@]}") -Wl,-rpath,$(IFS=:; echo "${dep_libs[*]}") -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LD_LIBRARY_PATH="$(IFS=:; echo "${dep_libs[*]}")${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

"$MESON_PREFIX/bin/meson" setup "$BUILD_DIR" "$SRC" \
  -Dprefix="$PREFIX" \
  -Dlibdir="$PREFIX/lib" \
  -Dbuildtype=release \
  -Dstrip=false \
  -Ddefault_library=shared \
  -Dwrap_mode=nodownload \
  -Ddocs=disabled \
  -Dfreetype=enabled \
  -Dgraphite2=disabled \
  -Dcoretext=disabled \
  -Dintrospection=disabled

"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" -v
"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" install

find "$PREFIX" -type f -name '*.la' -delete || true

test -x "$PREFIX/bin/hb-info"
test -x "$PREFIX/bin/hb-shape"
test -x "$PREFIX/bin/hb-subset"
test -x "$PREFIX/bin/hb-view"
test -f "$PREFIX/include/harfbuzz/hb.h"
test -f "$PREFIX/include/harfbuzz/hb-cairo.h"
test -f "$PREFIX/include/harfbuzz/hb-ft.h"
test -f "$PREFIX/include/harfbuzz/hb-glib.h"
test -f "$PREFIX/include/harfbuzz/hb-gobject.h"
test -f "$PREFIX/include/harfbuzz/hb-icu.h"
test -f "$PREFIX/lib/libharfbuzz.so"
test -f "$PREFIX/lib/libharfbuzz-subset.so"
test -f "$PREFIX/lib/libharfbuzz-icu.so"
test -f "$PREFIX/lib/libharfbuzz-cairo.so"
test -f "$PREFIX/lib/libharfbuzz-gobject.so"
test -f "$PREFIX/lib/pkgconfig/harfbuzz.pc"
test -f "$PREFIX/lib/pkgconfig/harfbuzz-subset.pc"
test -f "$PREFIX/lib/pkgconfig/harfbuzz-icu.pc"
test -f "$PREFIX/lib/pkgconfig/harfbuzz-cairo.pc"
test -f "$PREFIX/lib/pkgconfig/harfbuzz-gobject.pc"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("harfbuzz native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _harfbuzz_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("harfbuzz native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    prefixes = {
        "BZIP2_PREFIX": _read_prefix(repository_ctx, attr.bzip2_prefix_file, "bzip2"),
        "CAIRO_PREFIX": _read_prefix(repository_ctx, attr.cairo_prefix_file, "cairo"),
        "FONTCONFIG_PREFIX": _read_prefix(repository_ctx, attr.fontconfig_prefix_file, "fontconfig"),
        "FREETYPE_PREFIX": _read_prefix(repository_ctx, attr.freetype_prefix_file, "freetype"),
        "GLIB_PREFIX": _read_prefix(repository_ctx, attr.glib_prefix_file, "glib"),
        "GOBJECT_INTROSPECTION_PREFIX": _read_prefix(repository_ctx, attr.gobject_introspection_prefix_file, "gobject-introspection"),
        "ICU4C_PREFIX": _read_prefix(repository_ctx, attr.icu4c_prefix_file, "icu4c"),
        "LIBFFI_PREFIX": _read_prefix(repository_ctx, attr.libffi_prefix_file, "libffi"),
        "LIBICONV_PREFIX": _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv"),
        "LIBPNG_PREFIX": _read_prefix(repository_ctx, attr.libpng_prefix_file, "libpng"),
        "LIBXML2_PREFIX": _read_prefix(repository_ctx, attr.libxml2_prefix_file, "libxml2"),
        "LZO_PREFIX": _read_prefix(repository_ctx, attr.lzo_prefix_file, "lzo"),
        "MESON_PREFIX": _read_prefix(repository_ctx, attr.meson_prefix_file, "meson"),
        "NINJA_PREFIX": _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja"),
        "PCRE2_PREFIX": _read_prefix(repository_ctx, attr.pcre2_prefix_file, "pcre2"),
        "PIXMAN_PREFIX": _read_prefix(repository_ctx, attr.pixman_prefix_file, "pixman"),
        "PKGCONF_PREFIX": _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf"),
        "ZLIB_PREFIX": _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng"),
    }

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    env = dict(prefixes)
    env["PYTHON_ABI"] = python_abi_from_site_packages_prefix(repository_ctx, prefixes["MESON_PREFIX"], "meson")
    env["VASO_IN_INSULA"] = "1"
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 3600,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("harfbuzz native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lharfbuzz",
        "-lharfbuzz-subset",
        "-lharfbuzz-icu",
        "-lharfbuzz-cairo",
        "-lharfbuzz-gobject",
    ]
    for dep in (
        prefixes["BZIP2_PREFIX"],
        prefixes["CAIRO_PREFIX"],
        prefixes["FONTCONFIG_PREFIX"],
        prefixes["FREETYPE_PREFIX"],
        prefixes["GLIB_PREFIX"],
        prefixes["GOBJECT_INTROSPECTION_PREFIX"],
        prefixes["ICU4C_PREFIX"],
        prefixes["LIBFFI_PREFIX"],
        prefixes["LIBICONV_PREFIX"],
        prefixes["LIBPNG_PREFIX"],
        prefixes["LIBXML2_PREFIX"],
        prefixes["LZO_PREFIX"],
        prefixes["PCRE2_PREFIX"],
        prefixes["PIXMAN_PREFIX"],
        prefixes["ZLIB_PREFIX"],
    ):
        linkopts.extend([
            "-L{}/lib".format(dep),
            "-Wl,-rpath-link,{}/lib".format(dep),
            "-Wl,-rpath,{}/lib".format(dep),
        ])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


harfbuzz_native = repository_rule(
    implementation = _harfbuzz_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "bzip2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "cairo_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "fontconfig_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "freetype_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "glib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "gobject_introspection_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "icu4c_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libffi_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libpng_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libxml2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "lzo_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "meson_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pcre2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pixman_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build HarfBuzz from source into a Spack-prefix-identical install tree.",
)
