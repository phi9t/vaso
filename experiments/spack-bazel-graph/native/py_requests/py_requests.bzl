"""Native (Bazel-owned) py-requests prefix.

The hermetic Spack v1.2.2 py-requests@2.33.1 recipe is a PythonPackage that
runs:

    <python-venv-prefix>/bin/python3 -m pip -vvv ... \
        --no-index --prefix=<prefix> .

Spack supplies pip, setuptools, wheel, and requests' HTTP dependency quartet
through already installed prefixes. This rule reproduces that dependency channel
with Bazel-native prefix markers and must run inside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_interpreter_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by py_requests_native. Native Bazel build of py-requests,
# intended to match the Spack source-installed prefix. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# py-requests is a pure Python package prefix. It has no C link surface, but
# @spack_py_requests//:lib must remain a valid provider target after migration
# for unmigrated Python package consumers.
cc_library(
    name = "lib",
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "py-requests native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_VENV_PREFIX:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_VENV_PREFIX must name the Bazel-built native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" || ! -x "${PYTHON_VENV_PREFIX:-}/bin/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native python-venv prefix" >&2
  exit 2
fi
if [[ -z "${PY_CERTIFI_PREFIX:-}" || ! -d "${PY_CERTIFI_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/certifi" ]]; then
  echo "PY_CERTIFI_PREFIX must name the Bazel-built native py-certifi prefix" >&2
  exit 2
fi
if [[ -z "${PY_CHARSET_NORMALIZER_PREFIX:-}" || ! -d "${PY_CHARSET_NORMALIZER_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/charset_normalizer" ]]; then
  echo "PY_CHARSET_NORMALIZER_PREFIX must name the Bazel-built native py-charset-normalizer prefix" >&2
  exit 2
fi
if [[ -z "${PY_IDNA_PREFIX:-}" || ! -d "${PY_IDNA_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/idna" ]]; then
  echo "PY_IDNA_PREFIX must name the Bazel-built native py-idna prefix" >&2
  exit 2
fi
if [[ -z "${PY_PIP_PREFIX:-}" || ! -d "${PY_PIP_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/pip" ]]; then
  echo "PY_PIP_PREFIX must name the Bazel-built native py-pip prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built native py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PY_URLLIB3_PREFIX:-}" || ! -d "${PY_URLLIB3_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/urllib3" ]]; then
  echo "PY_URLLIB3_PREFIX must name the Bazel-built native py-urllib3 prefix" >&2
  exit 2
fi
if [[ -z "${PY_WHEEL_PREFIX:-}" || ! -d "${PY_WHEEL_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/wheel" ]]; then
  echo "PY_WHEEL_PREFIX must name the Bazel-built native py-wheel prefix" >&2
  exit 2
fi

rm -rf "$PREFIX"
export PYTHONHOME=
export PYTHONPATH="$PY_CERTIFI_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_CHARSET_NORMALIZER_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_IDNA_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_PIP_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_SETUPTOOLS_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_URLLIB3_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PY_WHEEL_PREFIX/lib/python${PYTHON_ABI}/site-packages:$PYTHON_VENV_PREFIX/lib/python${PYTHON_ABI}/site-packages"
export PATH="$PY_PIP_PREFIX/bin:$PY_WHEEL_PREFIX/bin:$PYTHON_VENV_PREFIX/bin:/usr/bin:/bin"

cd "$SRC"
"$PYTHON_VENV_PREFIX/bin/python3" -m pip \
  -vvv \
  --no-input \
  --no-cache-dir \
  --disable-pip-version-check \
  install \
  --no-deps \
  --ignore-installed \
  --no-build-isolation \
  --no-warn-script-location \
  --no-index \
  --prefix="$PREFIX" \
  .

site_packages="$PREFIX/lib/python${PYTHON_ABI}/site-packages"
test -f "$site_packages/requests/__init__.py"
test -f "$site_packages/requests/__version__.py"
test -f "$site_packages/requests/api.py"
test -f "$site_packages/requests/models.py"
test -f "$site_packages/requests/sessions.py"
test -f "$site_packages/requests/status_codes.py"
test -f "$site_packages/requests/utils.py"
test -f "$site_packages/requests-2.33.1.dist-info/INSTALLER"
test -f "$site_packages/requests-2.33.1.dist-info/METADATA"
test -f "$site_packages/requests-2.33.1.dist-info/REQUESTED"
test -f "$site_packages/requests-2.33.1.dist-info/WHEEL"
test -f "$site_packages/requests-2.33.1.dist-info/licenses/LICENSE"
test -f "$site_packages/requests-2.33.1.dist-info/licenses/NOTICE"
test -f "$site_packages/requests-2.33.1.dist-info/top_level.txt"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("py-requests native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _py_requests_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("py-requests native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        output = "src",
        stripPrefix = attr.strip_prefix,
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    python_venv_prefix = _read_prefix(repository_ctx, attr.python_venv_prefix_file, "python-venv")
    python_abi = python_abi_from_interpreter_prefix(repository_ctx, python_venv_prefix, "python-venv")
    py_certifi_prefix = _read_prefix(repository_ctx, attr.py_certifi_prefix_file, "py-certifi")
    py_charset_normalizer_prefix = _read_prefix(repository_ctx, attr.py_charset_normalizer_prefix_file, "py-charset-normalizer")
    py_idna_prefix = _read_prefix(repository_ctx, attr.py_idna_prefix_file, "py-idna")
    py_pip_prefix = _read_prefix(repository_ctx, attr.py_pip_prefix_file, "py-pip")
    py_setuptools_prefix = _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools")
    py_urllib3_prefix = _read_prefix(repository_ctx, attr.py_urllib3_prefix_file, "py-urllib3")
    py_wheel_prefix = _read_prefix(repository_ctx, attr.py_wheel_prefix_file, "py-wheel")
    prefix = str(repository_ctx.path("prefix"))

    res = repository_ctx.execute(
        ["./build.sh", str(repository_ctx.path("src")), prefix],
        timeout = 900,
        quiet = False,
        environment = {
            "PYTHON_VENV_PREFIX": python_venv_prefix,
            "PYTHON_ABI": python_abi,
            "PY_CERTIFI_PREFIX": py_certifi_prefix,
            "PY_CHARSET_NORMALIZER_PREFIX": py_charset_normalizer_prefix,
            "PY_IDNA_PREFIX": py_idna_prefix,
            "PY_PIP_PREFIX": py_pip_prefix,
            "PY_SETUPTOOLS_PREFIX": py_setuptools_prefix,
            "PY_URLLIB3_PREFIX": py_urllib3_prefix,
            "PY_WHEEL_PREFIX": py_wheel_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("py-requests native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


py_requests_native = repository_rule(
    implementation = _py_requests_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "python_venv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_certifi_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_charset_normalizer_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_idna_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_pip_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_urllib3_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_wheel_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build and install py-requests@2.33.1 from its PyPI source archive into a Spack-prefix-identical tree.",
)
