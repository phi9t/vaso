"""Native (Bazel-owned) build of libjpeg-turbo into a Spack-identical prefix.

The hermetic Spack v1.2.2 libjpeg-turbo@3.1.3 recipe is a CMakePackage. The
concrete py-torch frontier spec builds shared+static libraries, disables jpeg8
ABI mode, enables PIC, and consumes NASM as an explicit build-tool dependency.
"""

_BUILD_TEMPLATE = """\
# GENERATED by libjpeg_turbo_native. Native Bazel build of libjpeg-turbo,
# intended to match the Spack libjpeg-turbo install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include"],
    linkopts = {linkopts},
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "libjpeg-turbo native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${CMAKE_PREFIX:-}" || ! -x "${CMAKE_PREFIX:-}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must name the Bazel-built CMake prefix" >&2
  exit 2
fi
if [[ -z "${NASM_PREFIX:-}" || ! -x "${NASM_PREFIX:-}/bin/nasm" ]]; then
  echo "NASM_PREFIX must name the Bazel-built NASM prefix" >&2
  exit 2
fi

CMAKE="$CMAKE_PREFIX/bin/cmake"
NASM="$NASM_PREFIX/bin/nasm"
BUILD="$(mktemp -d)"
cd "$BUILD"

export PATH="${CMAKE_PREFIX}/bin:${NASM_PREFIX}/bin:${PATH}"
export CMAKE_PREFIX_PATH="${CMAKE_PREFIX};${NASM_PREFIX}"
export CMAKE_PROGRAM_PATH="${CMAKE_PREFIX}/bin;${NASM_PREFIX}/bin"
export CC="${CC:-gcc}"
export CXX="${CXX:-g++}"

"$CMAKE" -G "Unix Makefiles" \
  -DCMAKE_INSTALL_PREFIX:STRING="$PREFIX" \
  -DCMAKE_INSTALL_RPATH_USE_LINK_PATH:BOOL=ON \
  "-DCMAKE_INSTALL_RPATH:STRING=${PREFIX}/lib;${PREFIX}/lib64" \
  "-DCMAKE_PREFIX_PATH:STRING=${CMAKE_PREFIX};${NASM_PREFIX}" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_VERBOSE_MAKEFILE:BOOL=ON \
  -DCMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF \
  -DCMAKE_POLICY_DEFAULT_CMP0090:STRING=NEW \
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF \
  -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=ON \
  -DCMAKE_ASM_NASM_COMPILER:FILEPATH="$NASM" \
  -DENABLE_SHARED:BOOL=ON \
  -DENABLE_STATIC:BOOL=ON \
  -DWITH_JPEG8:BOOL=OFF \
  -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON \
  "$SRC"
make -j"${MAKE_JOBS:-$(nproc)}"
make install
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("libjpeg-turbo native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _libjpeg_turbo_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("libjpeg-turbo native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")
    nasm_prefix = _read_prefix(repository_ctx, attr.nasm_prefix_file, "nasm")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 2400,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "NASM_PREFIX": nasm_prefix,
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("libjpeg-turbo native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = "prefix/lib"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = "prefix/lib64"
    abs_lib = "{}/{}".format(repository_ctx.path("."), lib_dir)
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-ljpeg",
        "-lturbojpeg",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


libjpeg_turbo_native = repository_rule(
    implementation = _libjpeg_turbo_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "nasm_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build libjpeg-turbo from source into a Spack-prefix-identical tree.",
)
