"""Native (Bazel-owned) build of PyTorch's MAGMA provider.

PyTorch v2.14.0 builds its Linux CUDA MAGMA package from MAGMA 2.6.1 plus the
patch set under `.ci/magma/package_files`. Hermetic Spack v1.2.2 rejects
`magma@2.6.1 ^cuda@12.9.1`, so this is a PyTorch-official source provider
rather than a Spack ABI-parity capture. The prefix contract is the package
surface PyTorch consumes: include/ plus lib/libmagma.a.
"""

_PATCH_NAMES = [
    "CMake.patch",
    "cmakelists.patch",
    "thread_queue.patch",
    "cuda13.patch",
    "getrf_shfl.patch",
    "getrf_nbparam.patch",
]

_BUILD_TEMPLATE = """\
# GENERATED by magma_native. Native Bazel build of PyTorch's MAGMA provider.
# Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files([
    "prefix_path.txt",
    "source_build.json",
])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = False),
    includes = ["prefix/include"],
    data = [":prefix"],
    linkopts = {linkopts},
    deps = [
        "@cuda_native//:lib",
        "@openblas_native//:lib",
    ],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: cmake
SRC="$1"
PATCH_DIR="$2"
PREFIX="$3"
EXPECTED_VERSION="$4"
DESIRED_CUDA="$5"
CUDA_ARCH_LIST="$6"
JOBS="${MAKE_JOBS:-$(nproc)}"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "MAGMA native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
for var in CMAKE_PREFIX NINJA_PREFIX CUDA_PREFIX OPENBLAS_PREFIX; do
  val="${!var:-}"
  if [[ -z "$val" || ! -d "$val" ]]; then
    echo "$var must name a Bazel-native dependency prefix" >&2
    exit 2
  fi
done
if [[ ! -x "${CMAKE_PREFIX}/bin/cmake" ]]; then
  echo "CMAKE_PREFIX must provide bin/cmake" >&2
  exit 2
fi
if [[ ! -x "${NINJA_PREFIX}/bin/ninja-build" ]]; then
  echo "NINJA_PREFIX must provide bin/ninja-build" >&2
  exit 2
fi
if [[ ! -x "${CUDA_PREFIX}/bin/nvcc" ]]; then
  echo "CUDA_PREFIX must provide bin/nvcc" >&2
  exit 2
fi
if [[ ! -f "${OPENBLAS_PREFIX}/include/openblas_config.h" ]]; then
  echo "OPENBLAS_PREFIX must provide include/openblas_config.h" >&2
  exit 2
fi
if [[ -z "$CUDA_ARCH_LIST" ]]; then
  echo "CUDA_ARCH_LIST must be non-empty" >&2
  exit 2
fi

cuda_libdir="${CUDA_PREFIX}/lib64"
if [[ ! -d "$cuda_libdir" ]]; then
  cuda_libdir="${CUDA_PREFIX}/lib"
fi
openblas_libdir="${OPENBLAS_PREFIX}/lib64"
if [[ ! -d "$openblas_libdir" ]]; then
  openblas_libdir="${OPENBLAS_PREFIX}/lib"
fi
openblas_lib="${openblas_libdir}/libopenblas.so"
if [[ ! -e "$openblas_lib" ]]; then
  openblas_lib="${openblas_libdir}/libopenblas.a"
fi
if [[ ! -e "$openblas_lib" ]]; then
  echo "OPENBLAS_PREFIX must provide libopenblas.so or libopenblas.a" >&2
  exit 2
fi

nvcc_release="$("${CUDA_PREFIX}/bin/nvcc" --version | sed -n 's/.*release \\([^,]*\\),.*/\\1/p' | tail -1)"
if [[ "$nvcc_release" != "$DESIRED_CUDA" ]]; then
  echo "CUDA Version is not $DESIRED_CUDA. CUDA Version found: ${nvcc_release:-unknown}" >&2
  exit 2
fi

for patch_name in CMake.patch cmakelists.patch thread_queue.patch cuda13.patch getrf_shfl.patch getrf_nbparam.patch; do
  [[ -f "${PATCH_DIR}/${patch_name}" ]] || {
    echo "missing PyTorch MAGMA patch: ${patch_name}" >&2
    exit 2
  }
done

cd "$SRC"
patch < "${PATCH_DIR}/CMake.patch"
patch < "${PATCH_DIR}/cmakelists.patch"
patch -p0 < "${PATCH_DIR}/thread_queue.patch"
patch -p1 < "${PATCH_DIR}/cuda13.patch"
patch -p1 < "${PATCH_DIR}/getrf_shfl.patch"
patch -p1 < "${PATCH_DIR}/getrf_nbparam.patch"

rm -rf build
mkdir build
cd build

CMAKE="${CMAKE_PREFIX}/bin/cmake"
NINJA="${NINJA_PREFIX}/bin/ninja-build"
export PATH="${CMAKE_PREFIX}/bin:${NINJA_PREFIX}/bin:${CUDA_PREFIX}/bin:${PATH}"
export CUDA_HOME="$CUDA_PREFIX"
export CUDA_TOOLKIT_ROOT_DIR="$CUDA_PREFIX"
export CMAKE_PREFIX_PATH="${CUDA_PREFIX};${OPENBLAS_PREFIX};${CMAKE_PREFIX};${NINJA_PREFIX}"
export CMAKE_LIBRARY_PATH="${cuda_libdir};${openblas_libdir}"
export CMAKE_INCLUDE_PATH="${CUDA_PREFIX}/include;${OPENBLAS_PREFIX}/include"

"$CMAKE" -G Ninja .. \
  -DCMAKE_MAKE_PROGRAM:FILEPATH="$NINJA" \
  -DUSE_FORTRAN:BOOL=OFF \
  -DGPU_TARGET:STRING=All \
  "-DCMAKE_INSTALL_PREFIX:STRING=${PREFIX}" \
  "-DCMAKE_PREFIX_PATH:STRING=${CMAKE_PREFIX_PATH}" \
  "-DCMAKE_LIBRARY_PATH:STRING=${CMAKE_LIBRARY_PATH}" \
  "-DCMAKE_INCLUDE_PATH:STRING=${CMAKE_INCLUDE_PATH}" \
  "-DCUDA_TOOLKIT_ROOT_DIR:PATH=${CUDA_PREFIX}" \
  "-DLAPACK_LIBRARIES:STRING=${openblas_lib}" \
  "-DBLAS_LIBRARIES:STRING=${openblas_lib}" \
  "-DCUDA_ARCH_LIST:STRING=${CUDA_ARCH_LIST}" \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DCMAKE_POLICY_DEFAULT_CMP0146:STRING=OLD \
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF
"$NINJA" -v
"$NINJA" install

cd "$SRC"
mkdir -p "${PREFIX}/info/recipe" "${PREFIX}/info/licenses"
cp "${PATCH_DIR}/CMake.patch" "${PREFIX}/info/recipe/CMake.patch"
cp "${PATCH_DIR}/cmakelists.patch" "${PREFIX}/info/recipe/cmakelists.patch"
cp "${PATCH_DIR}/thread_queue.patch" "${PREFIX}/info/recipe/thread_queue.patch"
cp "${PATCH_DIR}/cuda13.patch" "${PREFIX}/info/recipe/cuda13.patch"
cp "${PATCH_DIR}/getrf_shfl.patch" "${PREFIX}/info/recipe/getrf_shfl.patch"
cp "${PATCH_DIR}/getrf_nbparam.patch" "${PREFIX}/info/recipe/getrf_nbparam.patch"
cp "${PATCH_DIR}/magma-2.6.1.sha256" "${PREFIX}/info/recipe/magma-2.6.1.sha256"
cp COPYRIGHT "${PREFIX}/info/licenses/COPYRIGHT"

test -f "${PREFIX}/include/magma_v2.h"
test -f "${PREFIX}/include/magma_types.h"
test -f "${PREFIX}/lib/libmagma.a"

header_version="$(
  python3 - "${PREFIX}/include/magma_types.h" <<'PY'
import re
import sys
text = open(sys.argv[1], encoding="utf-8").read()
defs = dict(re.findall(r"^#define\\s+(MAGMA_VERSION_(?:MAJOR|MINOR|MICRO))\\s+([0-9]+)\\b", text, re.M))
print(".".join(defs[k] for k in ("MAGMA_VERSION_MAJOR", "MAGMA_VERSION_MINOR", "MAGMA_VERSION_MICRO")))
PY
)"
if [[ "$header_version" != "$EXPECTED_VERSION" ]]; then
  echo "MAGMA header version mismatch: expected $EXPECTED_VERSION, got ${header_version:-unknown}" >&2
  exit 2
fi

python3 - "${PREFIX}/source_build.json" "$EXPECTED_VERSION" "$header_version" \
  "$DESIRED_CUDA" "$nvcc_release" "$CUDA_PREFIX" "$OPENBLAS_PREFIX" "$CMAKE_PREFIX" \
  "$NINJA_PREFIX" "$CUDA_ARCH_LIST" <<'PY'
import json
import sys

(
    out,
    expected,
    actual,
    desired_cuda,
    actual_cuda,
    cuda_prefix,
    openblas_prefix,
    cmake_prefix,
    ninja_prefix,
    cuda_arch_list,
) = sys.argv[1:11]
data = {
    "schema_version": 1,
    "mechanism": "cmake",
    "package": "magma",
    "expected_version": expected,
    "actual_header_version": actual,
    "provider": "pytorch-official-magma-cuda129",
    "provider_build": "magma-cuda129-2.6.1-1",
    "pytorch_release": "v2.14.0",
    "desired_cuda": desired_cuda,
    "actual_cuda": actual_cuda,
    "cuda_arch_list": cuda_arch_list,
    "dependency_prefixes": {
        "cuda": cuda_prefix,
        "openblas": openblas_prefix,
        "cmake": cmake_prefix,
        "ninja": ninja_prefix,
    },
    "patches": [
        "CMake.patch",
        "cmakelists.patch",
        "thread_queue.patch",
        "cuda13.patch",
        "getrf_shfl.patch",
        "getrf_nbparam.patch",
    ],
}
with open(out, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, sort_keys=True)
    fh.write("\\n")
PY
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(repository_ctx.path(label)).strip()
    if not value:
        fail("MAGMA native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _magma_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("MAGMA native build must run inside the hermetic insula (VASO_IN_INSULA=1)")
    if len(attr.patch_urls) != len(_PATCH_NAMES) or len(attr.patch_sha256) != len(_PATCH_NAMES):
        fail("MAGMA native build expects exactly {} PyTorch patch URLs and SHA256 values".format(len(_PATCH_NAMES)))

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("patches/.keep", "")
    for i in range(len(_PATCH_NAMES)):
        repository_ctx.download(
            url = attr.patch_urls[i],
            sha256 = attr.patch_sha256[i],
            output = "patches/" + _PATCH_NAMES[i],
        )
    repository_ctx.download(
        url = attr.sha_file_urls,
        sha256 = attr.sha_file_sha256,
        output = "patches/magma-2.6.1.sha256",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    cmake_prefix = _read_prefix(repository_ctx, attr.cmake_prefix_file, "cmake")
    ninja_prefix = _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja")
    cuda_prefix = _read_prefix(repository_ctx, attr.cuda_prefix_file, "cuda")
    openblas_prefix = _read_prefix(repository_ctx, attr.openblas_prefix_file, "openblas")

    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        [
            "./build.sh",
            str(repository_ctx.path("src")),
            str(repository_ctx.path("patches")),
            prefix,
            attr.package_version,
            attr.desired_cuda,
            attr.cuda_arch_list,
        ],
        timeout = 7200,
        quiet = False,
        environment = {
            "CMAKE_PREFIX": cmake_prefix,
            "NINJA_PREFIX": ninja_prefix,
            "CUDA_PREFIX": cuda_prefix,
            "OPENBLAS_PREFIX": openblas_prefix,
            "MAKE_JOBS": repository_ctx.os.environ.get("MAKE_JOBS", ""),
            "VASO_IN_INSULA": "1",
        },
    )
    if res.return_code != 0:
        fail("MAGMA native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    lib_dir = prefix + "/lib"
    cuda_lib = cuda_prefix + "/lib64"
    if repository_ctx.path("prefix/lib64").exists:
        lib_dir = prefix + "/lib64"
    if not repository_ctx.path(cuda_prefix + "/lib64").exists:
        cuda_lib = cuda_prefix + "/lib"
    openblas_lib = openblas_prefix + "/lib64"
    if not repository_ctx.path(openblas_prefix + "/lib64").exists:
        openblas_lib = openblas_prefix + "/lib"

    linkopts = [
        lib_dir + "/libmagma.a",
        "-L" + cuda_lib,
        "-L" + openblas_lib,
        "-Wl,-rpath," + cuda_lib,
        "-Wl,-rpath," + openblas_lib,
        "-lopenblas",
        "-lcusparse",
        "-lcublas",
        "-lcudart",
        "-lm",
        "-ldl",
        "-lpthread",
    ]

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.symlink("prefix/source_build.json", "source_build.json")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


magma_native = repository_rule(
    implementation = _magma_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "patch_urls": attr.string_list(mandatory = True),
        "patch_sha256": attr.string_list(mandatory = True),
        "sha_file_urls": attr.string_list(mandatory = True),
        "sha_file_sha256": attr.string(mandatory = True),
        "package_version": attr.string(default = "2.6.1"),
        "desired_cuda": attr.string(default = "12.9"),
        "cuda_arch_list": attr.string(default = "-gencode arch=compute_100,code=sm_100"),
        "cmake_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "cuda_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "openblas_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build PyTorch's patched MAGMA 2.6.1 CUDA provider into a PyTorch-consumable prefix.",
)
