"""Native (Bazel-owned) build of GNU Automake into a Spack-identical prefix.

The py-torch frontier captures automake@1.18.1 as an AutotoolsPackage. It is a
build/run tool prefix: generated Perl scripts embed the Automake install prefix,
so parity gates normalize the package prefix and dependency prefix spellings.
"""

_BUILD_TEMPLATE = """\
# GENERATED by automake_native. Native Bazel build of GNU Automake, intended to
# match the Spack automake install tree. Do not edit by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

# Automake is an executable/data build-tool prefix. It exposes no public C ABI,
# but @spack_automake//:lib must remain a valid provider target after migration.
cc_library(name = "lib")
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
SRC="$1"
PREFIX="$2"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "automake native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${AUTOCONF_PREFIX:-}" || ! -x "${AUTOCONF_PREFIX:-}/bin/autoconf" || ! -x "${AUTOCONF_PREFIX:-}/bin/autom4te" ]]; then
  echo "AUTOCONF_PREFIX must name the Bazel-built autoconf prefix" >&2
  exit 2
fi
if [[ -z "${PERL_PREFIX:-}" || ! -x "${PERL_PREFIX:-}/bin/perl" ]]; then
  echo "PERL_PREFIX must name the Bazel-built perl prefix" >&2
  exit 2
fi

# Match Spack's Automake.patch() for @1.16.3: generated entrypoints use
# /usr/bin/env perl instead of a concrete Perl prefix in their shebang.
python3 - <<'PY'
from pathlib import Path
for rel in ("bin/aclocal.in", "bin/automake.in"):
    p = Path("SRC_PLACEHOLDER") / rel
    s = p.read_text()
    s = s.replace("#!@PERL@", "#!/usr/bin/env perl")
    p.write_text(s)
PY

mkdir -p "$SRC/spack-build"
cd "$SRC/spack-build"

export PATH="${AUTOCONF_PREFIX}/bin:${PERL_PREFIX}/bin:${PATH:-}"
export PERL="${PERL_PREFIX}/bin/perl"

../configure --prefix="$PREFIX"
make V=1 -j"${MAKE_JOBS:-$(nproc)}"
make install

# Spack removes libtool archives from emitted prefixes.
find "$PREFIX" -type f -name '*.la' -delete || true
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("automake native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _automake_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("automake native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    build_sh = _BUILD_SH.replace("SRC_PLACEHOLDER", str(repository_ctx.path("src")))
    repository_ctx.file("build.sh", build_sh, executable = True)

    autoconf_prefix = _read_prefix(repository_ctx, attr.autoconf_prefix_file, "autoconf")
    perl_prefix = _read_prefix(repository_ctx, attr.perl_prefix_file, "perl")
    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    res = repository_ctx.execute(
        ["./build.sh", src, prefix],
        timeout = 1800,
        quiet = False,
        environment = {
            "AUTOCONF_PREFIX": autoconf_prefix,
            "PERL_PREFIX": perl_prefix,
        },
    )
    if res.return_code != 0:
        fail("automake native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE)


automake_native = repository_rule(
    implementation = _automake_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "autoconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "perl_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["MAKE_JOBS", "VASO_IN_INSULA"],
    doc = "Build GNU Automake from source into a Spack-prefix-identical tree.",
)
