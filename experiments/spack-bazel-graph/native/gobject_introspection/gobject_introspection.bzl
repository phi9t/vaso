"""Native (Bazel-owned) build of gobject-introspection into a Spack prefix.

The hermetic Spack v1.2.2 gobject-introspection@1.86.0 recipe uses Meson,
applies setuptools.patch for Python 3.12+, disables the optional cairo/doctool
test integrations when cairo/mako/markdown are absent, and consumes
glib-bootstrap, libffi, Python, py-setuptools, Bison, Flex, Meson, Ninja, and
pkgconf from the concrete DAG. This repository rule keeps those inputs as
Bazel-owned prefix files and refuses to run outside the sealed insula.
"""

load("//native/common:python_abi.bzl", "python_abi_from_prefix")

_BUILD_TEMPLATE = """\
# GENERATED by gobject_introspection_native. Native Bazel build of
# gobject-introspection, intended to match the Spack install tree. Do not edit
# by hand.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prefix",
    srcs = glob(["prefix/**"], allow_empty = False),
)

exports_files(["prefix_path.txt"])

cc_library(
    name = "lib",
    hdrs = glob(["prefix/include/**"], allow_empty = True),
    includes = ["prefix/include/gobject-introspection-1.0"],
    linkopts = {linkopts},
    data = [":prefix"],
)
"""

_BUILD_SH = """\
#!/usr/bin/env bash
set -euo pipefail
# spack-build-system: meson
SRC="$1"
PREFIX="$2"
SETUPTOOLS_PATCH="$3"
BUILD_DIR="$PWD/build"

if [[ "${VASO_IN_INSULA:-0}" != "1" ]]; then
  echo "gobject-introspection native build must run inside the hermetic insula (VASO_IN_INSULA=1)" >&2
  exit 2
fi
if [[ -z "${PYTHON_ABI:-}" ]]; then
  echo "PYTHON_ABI must be derived from the native Python prefix" >&2
  exit 2
fi
if [[ -z "${BISON_PREFIX:-}" || ! -x "${BISON_PREFIX:-}/bin/bison" ]]; then
  echo "BISON_PREFIX must name the Bazel-built Bison prefix" >&2
  exit 2
fi
if [[ -z "${FLEX_PREFIX:-}" || ! -x "${FLEX_PREFIX:-}/bin/flex" ]]; then
  echo "FLEX_PREFIX must name the Bazel-built Flex prefix" >&2
  exit 2
fi
if [[ -z "${GLIB_BOOTSTRAP_PREFIX:-}" || ! -d "${GLIB_BOOTSTRAP_PREFIX:-}/lib/pkgconfig" ]]; then
  echo "GLIB_BOOTSTRAP_PREFIX must name the Bazel-built glib-bootstrap prefix" >&2
  exit 2
fi
if [[ -z "${LIBFFI_PREFIX:-}" || ! -f "${LIBFFI_PREFIX:-}/include/ffi.h" ]]; then
  echo "LIBFFI_PREFIX must name the Bazel-built libffi prefix" >&2
  exit 2
fi
if [[ -z "${LIBICONV_PREFIX:-}" || ! -d "${LIBICONV_PREFIX:-}/lib" ]]; then
  echo "LIBICONV_PREFIX must name the Bazel-built libiconv prefix" >&2
  exit 2
fi
if [[ -z "${MESON_PREFIX:-}" || ! -x "${MESON_PREFIX:-}/bin/meson" || ! -d "${MESON_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/mesonbuild" ]]; then
  echo "MESON_PREFIX must name the Bazel-built Meson prefix" >&2
  exit 2
fi
if [[ -z "${NINJA_PREFIX:-}" || ! -x "${NINJA_PREFIX:-}/bin/ninja" ]]; then
  echo "NINJA_PREFIX must name the Bazel-built Ninja prefix" >&2
  exit 2
fi
if [[ -z "${PKGCONF_PREFIX:-}" || ! -x "${PKGCONF_PREFIX:-}/bin/pkgconf" ]]; then
  echo "PKGCONF_PREFIX must name the Bazel-built pkgconf prefix" >&2
  exit 2
fi
if [[ -z "${PYTHON_PREFIX:-}" || ! -x "${PYTHON_PREFIX:-}/bin/python3" ]]; then
  echo "PYTHON_PREFIX must name the Bazel-built Python prefix" >&2
  exit 2
fi
if [[ ! -x "${PYTHON_PREFIX:-}/bin/python${PYTHON_ABI}" || ! -d "${PYTHON_PREFIX:-}/include/python${PYTHON_ABI}" ]]; then
  echo "PYTHON_ABI must match the native Python prefix" >&2
  exit 2
fi
if [[ -z "${PY_SETUPTOOLS_PREFIX:-}" || ! -d "${PY_SETUPTOOLS_PREFIX:-}/lib/python${PYTHON_ABI}/site-packages/setuptools" ]]; then
  echo "PY_SETUPTOOLS_PREFIX must name the Bazel-built py-setuptools prefix" >&2
  exit 2
fi
if [[ -z "${PCRE2_PREFIX:-}" || ! -f "${PCRE2_PREFIX:-}/lib/pkgconfig/libpcre2-8.pc" ]]; then
  echo "PCRE2_PREFIX must name the Bazel-built pcre2 prefix" >&2
  exit 2
fi
if [[ -z "${ZLIB_PREFIX:-}" || ! -f "${ZLIB_PREFIX:-}/lib/pkgconfig/zlib.pc" ]]; then
  echo "ZLIB_PREFIX must name the Bazel-built zlib-ng prefix" >&2
  exit 2
fi
if [[ -z "${SETUPTOOLS_PATCH:-}" || ! -f "${SETUPTOOLS_PATCH:-}" ]]; then
  echo "SETUPTOOLS_PATCH must name Spack's setuptools.patch for gobject-introspection" >&2
  exit 2
fi

rm -rf "$BUILD_DIR" "$PREFIX"
mkdir -p "$BUILD_DIR"

cd "$SRC"
patch -p1 < "$SETUPTOOLS_PATCH"

dep_libs=(
  "$GLIB_BOOTSTRAP_PREFIX/lib"
  "$LIBFFI_PREFIX/lib"
  "$LIBICONV_PREFIX/lib"
  "$PCRE2_PREFIX/lib"
  "$PYTHON_PREFIX/lib"
  "$ZLIB_PREFIX/lib"
)
dep_pkgconfigs=(
  "$GLIB_BOOTSTRAP_PREFIX/lib/pkgconfig"
  "$LIBFFI_PREFIX/lib/pkgconfig"
  "$LIBICONV_PREFIX/lib/pkgconfig"
  "$PCRE2_PREFIX/lib/pkgconfig"
  "$PYTHON_PREFIX/lib/pkgconfig"
  "$ZLIB_PREFIX/lib/pkgconfig"
)

spack_target_flags="-march=icelake-client -mtune=icelake-client"
export PATH="${MESON_PREFIX}/bin:${NINJA_PREFIX}/bin:${PKGCONF_PREFIX}/bin:${BISON_PREFIX}/bin:${FLEX_PREFIX}/bin:${PYTHON_PREFIX}/bin:${PATH}"
export PYTHONHOME=
export PYTHONPATH="${MESON_PREFIX}/lib/python${PYTHON_ABI}/site-packages:${PY_SETUPTOOLS_PREFIX}/lib/python${PYTHON_ABI}/site-packages${PYTHONPATH:+:${PYTHONPATH}}"
export PKG_CONFIG="${PKGCONF_PREFIX}/bin/pkgconf"
export PKG_CONFIG_PATH="$(IFS=:; echo "${dep_pkgconfigs[*]}")"
export GI_SCANNER_DISABLE_CACHE=1
export GI_TYPELIB_PATH="${GLIB_BOOTSTRAP_PREFIX}/lib/girepository-1.0${GI_TYPELIB_PATH:+:${GI_TYPELIB_PATH}}"
export XDG_DATA_DIRS="${GLIB_BOOTSTRAP_PREFIX}/share${XDG_DATA_DIRS:+:${XDG_DATA_DIRS}}"
export CPPFLAGS="-I${GLIB_BOOTSTRAP_PREFIX}/include -I${GLIB_BOOTSTRAP_PREFIX}/include/glib-2.0 -I${GLIB_BOOTSTRAP_PREFIX}/lib/glib-2.0/include -I${LIBFFI_PREFIX}/include ${CPPFLAGS:-}"
export CFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CFLAGS:-}"
export CXXFLAGS="-O3 -g0 ${spack_target_flags} ${CPPFLAGS} ${CXXFLAGS:-}"
export LDFLAGS="$(printf ' -L%s' "${dep_libs[@]}") -Wl,-rpath,$(IFS=:; echo "${dep_libs[*]}") -Wl,-rpath,${PREFIX}/lib -Wl,--disable-new-dtags ${LDFLAGS:-}"
export LD_LIBRARY_PATH="$(IFS=:; echo "${dep_libs[*]}")${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

"$MESON_PREFIX/bin/meson" setup "$BUILD_DIR" "$SRC" \
  -Dprefix="$PREFIX" \
  -Dlibdir="$PREFIX/lib" \
  -Dbuildtype=release \
  -Dstrip=false \
  -Ddefault_library=shared \
  -Dwrap_mode=nodownload \
  -Dpython="$PYTHON_PREFIX/bin/python3" \
  -Dcairo=disabled \
  -Ddoctool=disabled \
  -Dgtk_doc=false \
  -Dtests=false \
  -Dbuild_introspection_data=true

"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" -v
"$NINJA_PREFIX/bin/ninja" -C "$BUILD_DIR" install

find "$PREFIX" -type f -name '*.la' -delete || true

test -x "$PREFIX/bin/g-ir-scanner"
test -x "$PREFIX/bin/g-ir-compiler"
test -x "$PREFIX/bin/g-ir-generate"
test -f "$PREFIX/include/gobject-introspection-1.0/girepository.h"
test -f "$PREFIX/lib/pkgconfig/gobject-introspection-1.0.pc"
test -f "$PREFIX/share/aclocal/introspection.m4"
test -f "$PREFIX/share/gobject-introspection-1.0/Makefile.introspection"
test -d "$PREFIX/lib/girepository-1.0"
test -e "$PREFIX/lib/libgirepository-1.0.so" || test -e "$PREFIX/lib/libgirepository-1.0.so.1"
"""


def _read_prefix(repository_ctx, label, dep_name):
    value = repository_ctx.read(label).strip()
    if not value:
        fail("gobject-introspection native build requires a non-empty {} prefix path".format(dep_name))
    return value


def _gobject_introspection_native_impl(repository_ctx):
    attr = repository_ctx.attr

    if repository_ctx.os.environ.get("VASO_IN_INSULA") != "1":
        fail("gobject-introspection native build must run inside the hermetic insula (VASO_IN_INSULA=1)")

    repository_ctx.download_and_extract(
        url = attr.urls,
        sha256 = attr.sha256,
        stripPrefix = attr.strip_prefix,
        output = "src",
    )
    repository_ctx.file("build.sh", _BUILD_SH, executable = True)

    prefixes = {
        "BISON_PREFIX": _read_prefix(repository_ctx, attr.bison_prefix_file, "bison"),
        "FLEX_PREFIX": _read_prefix(repository_ctx, attr.flex_prefix_file, "flex"),
        "GLIB_BOOTSTRAP_PREFIX": _read_prefix(repository_ctx, attr.glib_bootstrap_prefix_file, "glib-bootstrap"),
        "LIBFFI_PREFIX": _read_prefix(repository_ctx, attr.libffi_prefix_file, "libffi"),
        "LIBICONV_PREFIX": _read_prefix(repository_ctx, attr.libiconv_prefix_file, "libiconv"),
        "MESON_PREFIX": _read_prefix(repository_ctx, attr.meson_prefix_file, "meson"),
        "NINJA_PREFIX": _read_prefix(repository_ctx, attr.ninja_prefix_file, "ninja"),
        "PCRE2_PREFIX": _read_prefix(repository_ctx, attr.pcre2_prefix_file, "pcre2"),
        "PKGCONF_PREFIX": _read_prefix(repository_ctx, attr.pkgconf_prefix_file, "pkgconf"),
        "PYTHON_PREFIX": _read_prefix(repository_ctx, attr.python_prefix_file, "python"),
        "PY_SETUPTOOLS_PREFIX": _read_prefix(repository_ctx, attr.py_setuptools_prefix_file, "py-setuptools"),
        "ZLIB_PREFIX": _read_prefix(repository_ctx, attr.zlib_prefix_file, "zlib-ng"),
    }
    prefixes["PYTHON_ABI"] = python_abi_from_prefix(repository_ctx, prefixes["PYTHON_PREFIX"], "python")

    src = str(repository_ctx.path("src"))
    prefix = str(repository_ctx.path("prefix"))
    env = dict(prefixes)
    env["VASO_IN_INSULA"] = "1"

    res = repository_ctx.execute(
        [
            "./build.sh",
            src,
            prefix,
            str(repository_ctx.path(attr.setuptools_patch)),
        ],
        timeout = 3600,
        quiet = False,
        environment = env,
    )
    if res.return_code != 0:
        fail("gobject-introspection native build failed (rc={}):\n{}\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))

    abs_lib = "{}/prefix/lib".format(repository_ctx.path("."))
    linkopts = [
        "-L" + abs_lib,
        "-Wl,-rpath," + abs_lib,
        "-lgirepository-1.0",
    ]
    for dep in (
        prefixes["GLIB_BOOTSTRAP_PREFIX"],
        prefixes["LIBFFI_PREFIX"],
        prefixes["PYTHON_PREFIX"],
    ):
        linkopts.extend([
            "-L{}/lib".format(dep),
            "-Wl,-rpath,{}/lib".format(dep),
        ])

    repository_ctx.file("prefix_path.txt", prefix + "\n")
    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(linkopts = repr(linkopts)),
    )


gobject_introspection_native = repository_rule(
    implementation = _gobject_introspection_native_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "setuptools_patch": attr.label(mandatory = True, allow_single_file = True),
        "bison_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "flex_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "glib_bootstrap_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libffi_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "libiconv_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "meson_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "ninja_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pcre2_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "pkgconf_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "python_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "py_setuptools_prefix_file": attr.label(mandatory = True, allow_single_file = True),
        "zlib_prefix_file": attr.label(mandatory = True, allow_single_file = True),
    },
    environ = ["VASO_IN_INSULA"],
    doc = "Build gobject-introspection@1.86.0 from source into a Spack-prefix-identical tree.",
)
